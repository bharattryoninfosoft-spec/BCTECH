@{
    ViewBag.Title = "Remaining Fees Reminders";
    ViewData["PageTitle"] = "Remaining Fees Reminders";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<style>
    /* Table layout overrides for style.css global table-layout: fixed */
    #tblFeesReminders {
        table-layout: auto !important;
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
    }

    #tblFeesReminders th, 
    #tblFeesReminders td {
        overflow: visible !important;
        text-overflow: clip !important;
        white-space: normal !important;
        vertical-align: middle !important;
        padding: 12px 14px !important;
    }

    /* Remove DataTables sorting arrows completely */
    #tblFeesReminders th::before,
    #tblFeesReminders th::after,
    #tblFeesReminders .sorting::before,
    #tblFeesReminders .sorting::after,
    #tblFeesReminders .sorting_asc::before,
    #tblFeesReminders .sorting_asc::after,
    #tblFeesReminders .sorting_desc::before,
    #tblFeesReminders .sorting_desc::after {
        display: none !important;
        content: "" !important;
    }

    .nowrap-cell {
        white-space: nowrap !important;
    }

    .reminders-hero-card {
        border-radius: 14px;
        background: #ffffff;
        border: 1px solid #edf2f7;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .reminders-hero-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }
    .icon-box-lg {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }
    .filter-btn-pill {
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        padding: 7px 18px;
        transition: all 0.2s ease;
    }
    .student-avatar-thumb {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #e2e8f0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.06);
    }
    .table-pro-fees thead th {
        background: #0f766e !important;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 13.5px;
        letter-spacing: 0.3px;
        border: none;
        cursor: default !important;
    }
    .table-pro-fees tbody tr:hover {
        background-color: #f8fafc;
    }
    .btn-whatsapp-action {
        background: #25D366;
        color: #fff !important;
        border: none;
        font-weight: 500;
        font-size: 12px;
        padding: 5px 12px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        box-shadow: 0 2px 6px rgba(37, 211, 102, 0.25);
        transition: background 0.2s;
    }
    .btn-whatsapp-action:hover {
        background: #1eb857;
    }
    .btn-collect-action {
        border: 1px solid #059669;
        color: #059669;
        background: #fff;
        font-weight: 500;
        font-size: 12px;
        padding: 5px 12px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        transition: all 0.2s;
    }
    .btn-collect-action:hover {
        background: #059669;
        color: #fff;
    }
    .badge-overdue-pill {
        background: #ffe4e6;
        color: #e11d48;
        border: 1px solid #fda4af;
        font-weight: 600;
    }
    .badge-due-today-pill {
        background: #ef4444;
        color: #ffffff;
        font-weight: 600;
    }
    .badge-upcoming-pill {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
        font-weight: 600;
    }

    /* Custom Search Input */
    .custom-search-input {
        height: 38px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 30px !important;
        padding-left: 38px !important;
        padding-right: 14px !important;
        font-size: 13.5px !important;
        background-color: #f8fafc !important;
        transition: all 0.2s ease;
    }
    .custom-search-input:focus {
        background-color: #ffffff !important;
        border-color: #0f766e !important;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15) !important;
    }

    /* DataTables Info & Pagination */
    .dataTables_info {
        font-size: 13.5px !important;
        color: #64748b !important;
        padding: 0 !important;
    }
    .dataTables_paginate {
        padding: 0 !important;
    }
    .dataTables_paginate .paginate_button {
        padding: 6px 14px !important;
        margin: 0 2px !important;
        border-radius: 6px !important;
        border: 1px solid #e2e8f0 !important;
        background: #fff !important;
        color: #475569 !important;
        font-size: 13px !important;
        cursor: pointer !important;
    }
    .dataTables_paginate .paginate_button.current,
    .dataTables_paginate .paginate_button.current:hover {
        background: #0f766e !important;
        color: #fff !important;
        border-color: #0f766e !important;
        font-weight: 600 !important;
    }
    .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #1e293b !important;
        border-color: #cbd5e1 !important;
    }
</style>

<div class="student-fees-wrapper pt-2 pb-5">
    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-body p-3 p-md-4">
            <!-- Sleek Single-Row Toolbar (Filters on left, Search on right) -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
                <div class="d-flex flex-wrap gap-2" id="feesFilterGroup">
                    <button type="button" class="btn btn-success filter-btn-pill active" data-filter="7days" onclick="filterFees('7days', this)">
                        7-Day Window
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="ago7" onclick="filterFees('ago7', this)">
                        Due 7 Days Ago
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="today" onclick="filterFees('today', this)">
                        Due Today
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="upcoming7" onclick="filterFees('upcoming7', this)">
                        Due Next 7 Days
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="overdue" onclick="filterFees('overdue', this)">
                        All Overdue
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="all" onclick="filterFees('all', this)">
                        All Pending Fees
                    </button>
                </div>

                <!-- Custom Search on Right -->
                <div class="d-flex align-items-center gap-2">
                    <div class="position-relative" style="min-width: 250px;">
                        <input type="text" id="txtCustomFeesSearch" class="form-control custom-search-input" placeholder="Search student, course, enroll...">
                        <i class="material-symbols-outlined position-absolute start-0 top-50 translate-middle-y ms-2 text-muted fs-18">search</i>
                    </div>
                </div>
            </div>

            <!-- Table (Proper Layout, No Horizontal Scrollbar on Desktop) -->
            <div class="table-responsive rounded-3 border">
                <table id="tblFeesReminders" class="table table-pro-fees align-middle w-100 mb-0">
                    <thead>
                        <tr>
                            <th class="text-center nowrap-cell" style="width: 45px;">#</th>
                            <th class="nowrap-cell" style="width: 130px;">Enrollment No.</th>
                            <th style="min-width: 170px;">Student Name</th>
                            <th style="min-width: 160px;">Course</th>
                            <th class="text-end nowrap-cell" style="width: 95px;">Total Fee</th>
                            <th class="text-end nowrap-cell" style="width: 95px;">Paid Fee</th>
                            <th class="text-end nowrap-cell" style="width: 115px;">Balance</th>
                            <th class="nowrap-cell" style="width: 105px;">Due Date</th>
                            <th class="nowrap-cell text-center" style="width: 110px;">Status</th>
                            <th class="nowrap-cell text-center" style="width: 120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblFeesRemindersBody">
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="ri-loader-4-line ri-spin fs-24 align-middle me-1 text-success"></i> Loading Remaining Fees Data...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var feesDataTable = null;
        var currentFilter = "7days";

        $(document).ready(function () {
            loadRemainingFeesReminders(currentFilter);

            // Connect custom search input
            $("#txtCustomFeesSearch").on("keyup", function () {
                if (feesDataTable) {
                    feesDataTable.search(this.value).draw();
                }
            });
        });

        function filterFees(filterType, btn) {
            $("#feesFilterGroup button").removeClass("btn-success active").addClass("btn-outline-secondary");
            $(btn).removeClass("btn-outline-secondary").addClass("btn-success active");
            currentFilter = filterType;
            loadRemainingFeesReminders(filterType);
        }

        function loadRemainingFeesReminders(filterType) {
            if (feesDataTable) {
                feesDataTable.destroy();
                feesDataTable = null;
            }
            $("#tblFeesRemindersBody").html('<tr><td colspan="10" class="text-center py-5 text-muted"><i class="ri-loader-4-line ri-spin fs-24 align-middle me-1 text-success"></i> Loading Remaining Fees Data...</td></tr>');

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetRemainingFeesRemindersList",
                data: { filter: filterType },
                dataType: "json",
                success: function (res) {
                    if (res && res.Status && res.Data) {
                        var list = res.Data;

                        // Update KPI counts
                        var overdueCount = 0;
                        var todayCount = 0;
                        var upcomingFeesCount = 0;
                        $.each(list, function(i, item) {
                            if (item.DaysDiff < 0) overdueCount++;
                            else if (item.DaysDiff === 0) todayCount++;
                            else if (item.DaysDiff > 0 && item.DaysDiff <= 7) upcomingFeesCount++;
                        });
                        if (filterType === "7days" || filterType === "all") {
                            $("#kpiFeesOverdue").text(overdueCount);
                            $("#kpiFeesDueToday").text(todayCount);
                            $("#kpiFeesUpcoming").text(upcomingFeesCount);
                            $("#kpiFeesTotal").text(list.length);
                        }

                        if (list.length === 0) {
                            $("#tblFeesRemindersBody").html('<tr><td colspan="10" class="text-center py-5 text-muted"><i class="material-symbols-outlined fs-36 text-success d-block mb-2">check_circle</i>No remaining fees pending for this filter.</td></tr>');
                            return;
                        }

                        var rows = [];
                        $.each(list, function (i, item) {
                            var cleanPhone = (item.Mobile || "").replace(/\D/g, '');
                            if (cleanPhone.length === 10) cleanPhone = "91" + cleanPhone;

                            var feeMsg = encodeURIComponent("Dear " + item.StudentName + ", this is a friendly reminder from BC Tech Computer Education regarding your pending course fee installment of Rs." + item.BalanceFee + " for " + item.CourseTitle + ". Due Date: " + item.DueDateFormatted + ". Please clear it at the earliest.");
                            var waLink = cleanPhone ? 'https://api.whatsapp.com/send?phone=' + cleanPhone + '&text=' + feeMsg : '#';

                            var studentCol = '<div class="d-flex align-items-center gap-2">' +
                                             '<img src="' + item.Photo + '" class="student-avatar-thumb flex-shrink-0" onerror="this.onerror=null;this.src=\'/Content/Admin/assets/images/no-image.png\';" />' +
                                             '<div>' +
                                             '<div class="fw-bold text-dark fs-13">' + escapeHtml(item.StudentName) + '</div>' +
                                             '<small class="text-muted"><i class="ri-phone-line"></i> ' + (escapeHtml(item.Mobile) || '-') + '</small>' +
                                             '</div>' +
                                             '</div>';

                            var badgeClass = 'bg-secondary text-white';
                            if (item.DaysDiff === 0) badgeClass = 'badge-due-today-pill';
                            else if (item.DaysDiff < 0) badgeClass = 'badge-overdue-pill';
                            else if (item.DaysDiff > 0 && item.DaysDiff <= 7) badgeClass = 'badge-upcoming-pill';

                            var badgeHtml = '<span class="badge ' + badgeClass + ' px-2 py-1 fs-12 rounded-pill nowrap-cell">' +
                                            escapeHtml(item.StatusText) +
                                            '</span>';

                            var actionHtml = cleanPhone
                                ? '<a href="' + waLink + '" target="_blank" class="btn btn-whatsapp-action" title="Send WhatsApp Fee Reminder">' +
                                  '<i class="ri-whatsapp-line fs-14"></i> Remind' +
                                  '</a>'
                                : '<span class="text-muted fs-12">-</span>';

                            rows.push('<tr>' +
                                      '<td class="text-center text-muted fw-semibold nowrap-cell">' + (i + 1) + '</td>' +
                                      '<td class="nowrap-cell"><span class="badge bg-light text-dark border fw-medium px-2 py-1">' + (escapeHtml(item.EnrollmentNo) || '-') + '</span></td>' +
                                      '<td>' + studentCol + '</td>' +
                                      '<td><span class="badge bg-light text-dark border px-2 py-1">' + escapeHtml(item.CourseTitle) + '</span></td>' +
                                      '<td class="text-end text-muted nowrap-cell">&#8377; ' + item.TotalFee.toLocaleString('en-IN') + '</td>' +
                                      '<td class="text-end text-success fw-medium nowrap-cell">&#8377; ' + item.TotalPaid.toLocaleString('en-IN') + '</td>' +
                                      '<td class="text-end fw-bold text-danger fs-14 nowrap-cell">&#8377; ' + item.BalanceFee.toLocaleString('en-IN') + '</td>' +
                                      '<td class="fw-semibold text-secondary nowrap-cell">' + item.DueDateFormatted + '</td>' +
                                      '<td class="text-center nowrap-cell">' + badgeHtml + '</td>' +
                                      '<td class="text-center nowrap-cell">' + actionHtml + '</td>' +
                                      '</tr>');
                        });

                        $("#tblFeesRemindersBody").html(rows.join(""));
                        feesDataTable = $("#tblFeesReminders").DataTable({
                            pageLength: 20,
                            ordering: false,
                            autoWidth: false,
                            dom: 'rt<"d-flex justify-content-between align-items-center px-3 py-3 border-top flex-wrap gap-2"ip>',
                            language: {
                                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                                paginate: {
                                    previous: "Previous",
                                    next: "Next"
                                },
                                emptyTable: "No pending fees found."
                            }
                        });

                        // Re-apply custom search if text is present
                        var searchVal = $("#txtCustomFeesSearch").val();
                        if (searchVal) {
                            feesDataTable.search(searchVal).draw();
                        }
                    } else {
                        $("#tblFeesRemindersBody").html('<tr><td colspan="10" class="text-center py-4 text-danger">' + (res.Message || 'Failed to load fee data.') + '</td></tr>');
                    }
                },
                error: function (xhr, status, error) {
                    $("#tblFeesRemindersBody").html('<tr><td colspan="10" class="text-center py-4 text-danger">Error loading fee data: ' + error + '</td></tr>');
                }
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }
    </script>
}
