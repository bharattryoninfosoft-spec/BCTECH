
@{
    ViewBag.Title = "Course";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}
<style>
    .dataTables_length {
        display: none;
    }
</style>
<div class="card bg-white rounded-10 border border-white mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">
        <form class="table-src-form position-relative m-0">
            <input type="text" id="txtSearch" class="form-control w-350" placeholder="Search Course ...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
         

        <a href="/bctechadmin/CreateCourse" class="btn btn-primary text-white">
            <i class="ri-add-line"></i> Add New Course
        </a>


    </div>
    <div class="default-table-area mx-minus-1 table-contact-list">
        <div class="table-responsive">
            <table class="table-common" id="tblFinancialYear">
                <thead class="text-center">
                    <tr>
                        <th>Sr.</th>
                        <th>Operation</th>
                        <th>Image</th>
                        <th>Course Code</th>
                        <th>Course Title</th>
                        <th>Duration</th>
                        <th>Course Fee</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody id="tblCourseBody"></tbody>
            </table>
        </div>

        <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
            <span class="fs-15" id="lblShowing"></span>

            <nav class="custom-pagination" aria-label="Page navigation example">
                <ul class="pagination mb-0 justify-content-center" id="pagination">
                </ul>
            </nav>
        </div>
    </div>
</div>
@section Scripts{
    <script>
    var currentPage = 1;
    var pageSize = 10;
    $(document).ready(function () {
                GetCourseList(currentPage);
            });
    function GetCourseList(page) {
        var search = $("#txtSearch").val().trim();
                $.ajax({
                    url: "/bctechadmin/GetCourseList",
                    type: "GET",
                    data: {
                        page: page,
                        pageSize: pageSize,
                        search: search
                    },
                    success: function (res) {

                        $("#tblCourseBody").html("");

                        $.each(res.data, function (i, item) {

                        var img = '@Url.Content("~/Content/Upload/CourseImage/")' + item.CourseImage;

                            var html = "";
                            html += "<tr>";
                            html += "<td class='text-center'>" + (((page - 1) * pageSize) + i + 1) + "</td>";
                            html += "<td class='text-center'>";

                            html += "<a href='/bctechadmin/CreateCourse?id=" + item.EditEncryptedID + "' class='text-primary me-2'>" +
                                "<i class='ri-edit-line fs-18 '></i></a>";

                            html += "<a href='javascript:DeleteCourse(" + item.CourseID + ")' class='text-danger me-2'>" +
                                "<i class='ri-delete-bin-line fs-18'></i></a>";

                            html += "<a href='/bctechadmin/CreateCourse?id=" + item.ViewEncryptedID + "' class='text-success'>" +
                                "<i class='ri-eye-line fs-18'></i></a>";

                            html += "</td>";
                            html += "<td class='text-center'><img src='" + img + "' width='120' height='70' style='object-fit:cover'></td>";
                            html += "<td class='text-center'>" + item.CourseCode + "</td>";
                            html += "<td class='text-center'>" + item.CourseTitle + "</td>";
                            html += "<td class='text-center'>" + item.Duration + " " + item.DurationType + "</td>";
                            html += "<td class='text-center'>₹ " + parseFloat(item.CourseFee).toFixed(2) + "</td>";
                            if (item.IsActive == "1") {
                                html += "<td class='text-center'>  <span class='badge bg-success'>Active</span></td>";
                            }
                            else
                            {
                                html += "<td class='text-center'>  <span class='badge bg-danger'>Deactive</span></td>";
                            }
                            
                            html += "</tr>";
                            $("#tblCourseBody").append(html);
                        });

                        BindPagination(res.totalRecords, page);
                    }
                });

            }
    function BindPagination(totalRecords, currentPage) {

                var totalPages = Math.ceil(totalRecords / pageSize);

                $("#customPagination").html("");

                $("#lblShowing").text(
                    "Showing " +
                    (((currentPage - 1) * pageSize) + 1) +
                    " to " +
                    Math.min(currentPage * pageSize, totalRecords) +
                    " of " +
                    totalRecords +
                    " entries"
                );

                if (currentPage > 1) {
                    $("#customPagination").append(
                        '<li class="page-item"><a class="page-link" href="javascript:GetCourseList(' + (currentPage - 1) + ')">Previous</a></li>'
                    );
                }

                for (var i = 1; i <= totalPages; i++) {

                    $("#customPagination").append(
                        '<li class="page-item ' + (i == currentPage ? "active" : "") + '">' +
                        '<a class="page-link" href="javascript:GetCourseList(' + i + ')">' + i + '</a>' +
                        '</li>'
                    );
                }

                if (currentPage < totalPages) {
                    $("#customPagination").append(
                        '<li class="page-item"><a class="page-link" href="javascript:GetCourseList(' + (currentPage + 1) + ')">Next</a></li>'
                    );
                }

                }
        $("#txtSearch").on("keyup", function () {
                    currentPage = 1;
                    GetCourseList(currentPage);
        }); 
        function DeleteCourse(id) {

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to recover this course!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, Delete",
                cancelButtonText: "Cancel",
                reverseButtons: true
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: "/BCTECHAdmin/DeleteCourse",
                        type: "POST",
                        data: {
                            CourseID: id
                        },
                        success: function (response) {

                            if (response.Status == 1) {

                                Swal.fire({
                                    icon: "success",
                                    title: "Deleted!",
                                    text: response.Message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });

                                GetCourseList(currentPage);
                            }
                            else {

                                Swal.fire({
                                    icon: "error",
                                    title: "Error",
                                    text: response.Message
                                });

                            }
                        },
                        error: function () {

                            Swal.fire({
                                icon: "error",
                                title: "Oops...",
                                text: "Something went wrong!"
                            });

                        }
                    });

                }

            });

        }
    </script>
}
