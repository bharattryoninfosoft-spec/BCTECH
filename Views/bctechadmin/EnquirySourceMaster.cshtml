@{
    ViewBag.Title = "Enquiry Source Master";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<div class="card bg-white rounded-10 border border-white mb-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">

        <!-- Search -->

        <form class="table-src-form position-relative m-0">

            <input type="text"
                   id="txtSearch"
                   class="form-control w-350"
                   placeholder="Search Enquiry Source...">

            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>

        </form>

        <!-- Add Button -->
        <!--
        <a href="javascript:void(0);"
           class="text-primary fs-16 text-decoration-none"
           onclick="OpenEnquirySourceModal()">

            + Add Enquiry Source

        </a>-->



        <a href="javascript:void(0);" class="btn btn-primary text-white" onclick="OpenEnquirySourceModal()">
            <i class="ri-add-line"></i> Add Enquiry Source
        </a>

    </div>
    <div class="default-table-area mx-minus-1 table-contact-list">
        <div class="table-responsive">
            <table class="table-common" id="tblEnquirySource">
                <thead>
                    <tr>
                        <th>SR</th>
                        <th>Enquiry Source</th>
                        <th>Created Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>


    <div class="col-lg-12">
        <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
            <span class="fs-15" id="lblShowing"></span>

            <nav class="custom-pagination" aria-label="Page navigation example">
                <ul class="pagination mb-0 justify-content-center" id="pagination"></ul>
            </nav>
        </div>
    </div>
</div>
<div class="modal fade" id="EnquirySourceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Enquiry Source
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hfEnquirySourceID" value="0" />
                <div class="mb-3">
                    <label class="form-label">
                        Enquiry Source
                    </label>
                    <input type="text" id="txtEnquirySourceType" class="form-control" maxlength="200"
                           placeholder="Enter Enquiry Source" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>
                <button class="btn btn-primary text-white" onclick="SaveEnquirySource()">
                    Save
                </button>
            </div>

        </div>

    </div>

</div>

@section Scripts{

    <script>
        var enquirySources = [];
        var filteredEnquirySources = [];
        var currentPage = 1;
        var pageSize = 10;

        $(document).ready(function () {

            GetEnquirySource();

            $("#txtSearch").on("keyup", function () {

                var search = $(this).val().toLowerCase().trim();

                filteredEnquirySources = enquirySources.filter(function (x) {

                    return x.EnquirySourceType.toLowerCase().includes(search);

                });

                currentPage = 1;

                BindGrid();

            });

        });
        function GetEnquirySource() {

            $.ajax({

                url: "/BCTECHAdmin/GetEnquirySourceList",

                type: "GET",

                dataType: "json",

                success: function (data) {

                    enquirySources = data;
                    filteredEnquirySources = data;

                    currentPage = 1;

                    BindGrid();

                },

                error: function () {

                    toastr.error("Failed to load Enquiry Source.");

                }

            });

        }
        function BindGrid() {

            var html = "";

            var start = (currentPage - 1) * pageSize;
            var end = Math.min(start + pageSize, filteredEnquirySources.length);

            for (var i = start; i < end; i++) {

                var item = filteredEnquirySources[i];

                html += `
                                <tr>
                                    <td>${i + 1}</td>
                                    <td hidden>${item.EnquirySourceID}</td>
                                    <td>${item.EnquirySourceType}</td>
                                    <td>${item.DateAndTime}</td>
                                    <td>
                                      <a href="javascript:void(0)" onclick="EditEnquirySource(${item.EnquirySourceID})">
                                         <i class="ri-edit-line text-primary"></i>
                                        </a>
                                        &nbsp;&nbsp;
                                        <a href="javascript:void(0)" onclick="DeleteEnquirySource(${item.EnquirySourceID})">
                                             <i class="ri-delete-bin-line text-danger"></i>
                                        </a>
                                    </td>
                                </tr>`;
            }

            $("#tblEnquirySource tbody").html(html);

            $("#lblShowing").text(
                `Showing ${filteredEnquirySources.length == 0 ? 0 : start + 1}
                                 to ${end}
                                 of ${filteredEnquirySources.length} entries`
            );

            CreatePagination();
        }
        function CreatePagination() {

            var totalPages = Math.ceil(filteredEnquirySources.length / pageSize);

            var start = filteredEnquirySources.length == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
            var end = Math.min(currentPage * pageSize, filteredEnquirySources.length);

            $("#lblShowing").text(
                "Showing " + start + " to " + end + " of " + filteredEnquirySources.length + " entries"
            );

            var html = "";

            html += `
<li class="page-item ${currentPage == 1 ? "disabled" : ""}">
                    <button class="page-link icon" id="btnPrev">
                        <i class="material-symbols-outlined">west</i>
                    </button>
</li>`;

            for (var i = 1; i <= totalPages; i++) {

                html += `
                    <li class="page-item">
                        <button class="page-link ${currentPage == i ? "active" : ""}" data-page="${i}">
                            ${i}
                        </button>
                    </li>`;
            }

            html += `
<li class="page-item ${currentPage == totalPages ? "disabled" : ""}">
                    <button class="page-link icon" id="btnNext">
                        <i class="material-symbols-outlined">east</i>
                    </button>
</li>`;


            $("#pagination").html(html);

        }
        function ChangePage(page) {

            var totalPages = Math.ceil(filteredEnquirySources.length / pageSize);

            if (page < 1 || page > totalPages)
                return;

            currentPage = page;

            BindGrid();

        }
        function OpenEnquirySourceModal() {

            // Reset Form
            $("#hfEnquirySourceID").val(0);
            $("#txtEnquirySourceType").val("");

            // Change Modal Title
            $(".modal-title").text("Add Enquiry Source");

            // Open Modal
            $("#EnquirySourceModal").modal("show");

            // Focus
            $("#txtEnquirySourceType").focus();

        }
        function SaveEnquirySource() {

            var enquirySourceID = $("#hfEnquirySourceID").val();
            var enquirySourceType = $("#txtEnquirySourceType").val().trim();

            // Validation
            if (enquirySourceType == "") {

                toastr.warning("Please Enter Enquiry Source.");

                $("#txtEnquirySourceType").focus();

                return;
            }

            $.ajax({

                url: "/BCTECHAdmin/SaveEnquirySource",

                type: "POST",

                data: {

                    EnquirySourceID: enquirySourceID,
                    EnquirySourceType: enquirySourceType

                },

                success: function (res) {

                    if (res.Status) {
                        toastr.success(res.Message);
                        $("#EnquirySourceModal").modal("hide");
                        GetEnquirySource();
                    }
                    else {
                        toastr.warning(res.Message);
                    }
                },

                error: function () {

                    toastr.error("Something went wrong.");

                }

            });

        }
        function EditEnquirySource(id) {

            $.ajax({

                url: "/BCTECHAdmin/GetEnquirySourceByID",

                type: "GET",

                data: { id: id },

                dataType: "json",

                success: function (item) {

                    $("#hfEnquirySourceID").val(item.EnquirySourceID);

                    $("#txtEnquirySourceType").val(item.EnquirySourceType);

                    // Change Modal Title
                    $(".modal-title").text("Edit Enquiry Source");

                    // Show Modal
                    $("#EnquirySourceModal").modal("show");

                    $("#txtEnquirySourceType").focus();

                },

                error: function () {

                    toastr.error("Failed to load Enquiry Source.");

                }

            });

        }
        function DeleteEnquirySource(id) {

            Swal.fire({

                title: "Are you sure?",

                text: "You won't be able to recover this record!",

                icon: "warning",

                showCancelButton: true,

                confirmButtonColor: "#3085d6",

                cancelButtonColor: "#d33",

                confirmButtonText: "Yes, Delete",

                cancelButtonText: "Cancel"

            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({

                        url: "/BCTECHAdmin/DeleteEnquirySource",

                        type: "POST",

                        data: { id: id },

                        success: function (response) {

                            if (response == "Success") {

                                Swal.fire({

                                    icon: "success",

                                    title: "Deleted!",

                                    text: "Enquiry Source Deleted Successfully.",

                                    timer: 1500,

                                    showConfirmButton: false

                                });

                                GetEnquirySource();

                            }
                            else {

                                toastr.error(response);

                            }

                        },

                        error: function () {

                            toastr.error("Something went wrong.");

                        }

                    });

                }

            });

        }

    </script>

}
