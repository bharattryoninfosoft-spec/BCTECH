
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}
<style>
    #header-area,
    .sidebar-area,
    #sidebar-area,
    .footer-area,
    .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-4.mt-1 {
        display: none !important;
    }

    /* Make main-content take full screen */
    .main-content {
        width: 100% !important;
        max-width: 100% !important;
        min-height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
    }   
</style>
<!-- Start Main Content Area -->
<div class="container-fluid p-0 overflow-hidden">
    <div class="row g-0">
        <div class="col-lg-5">
            <div class="gradient-bg vh-100 position-relative coming-soon">
                <div class="main-content d-flex flex-column p-0">
                    <div class="m-auto p-3 p-md-4">
                        <img src="~/Content/Admin/assets/Images/coming-soon1.png" alt="coming-soon" />                     
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card bg-white border-0 vh-100 position-relative coming-soon">
                <div class="main-content d-flex flex-column p-0 justify-content-center align-items-center" style="min-height: 100vh;">
                    <div class="p-4 p-md-6 w-100" style="max-width: 600px;">
                        <div class="p-md-5 p-4 p-lg-0">
                            <div class="text-center mb-4">
                                <h3 class="fs-26 fw-medium" style="margin-bottom: 6px;">Sign In</h3>
                                <div id="error-alert" class="alert alert-danger mt-2" style="display:none;"></div>
                            </div>
                            <form>
                                <div class="mb-20">
                                    <label class="label fs-16 mb-2">Email Address</label>
                                    <div class="form-floating">
                                        <input type="email"  class="form-control" id="emailaddress"  placeholder="Enter Email, Mobile No or Username" onblur="validate(this)">
                                        <label for="floatingInput1">Enter email address *</label>
                                    </div>
                                </div>
                                <div class="mb-20">
                                    <label class="label fs-16 mb-2">Your Password</label>
                                    <div class="form-floating" id="password-show-hide">
                                        <input type="password" class="form-control" id="password" placeholder="Enter Password">
                                        <label for="floatingInput1">Enter Password *</label>
                                        <i style="color: #A9A9C8; font-size: 22px; right: 15px;" class="ri-eye-off-line password-toggle-icon translate-middle-y top-50 position-absolute cursor text-secondary" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <div class="mb-20">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault">
                                            <label class="form-check-label fs-16" for="flexCheckDefault">
                                                Remember me
                                            </label>
                                        </div>
                                        <a href="@Url.Action("ForgotPassword","bctechadmin")"
                                           class="fs-16 text-primary fw-normal text-decoration-none">
                                            Forgot Password?
                                        </a>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <button type="button"
                                            class="btn btn-primary w-100 btn-login text-white"
                                            onclick="checkLogin()">
                                        Sign In
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>                
                <img src="~/Content/Admin/assets/images/shape1.png" class="shape d-none d-xxl-block position-absolute top-0 start-0" style="margin-left: -1px;" alt="shape1">
                <img src="~/Content/Admin/assets/images/shape2.png" class="shape d-none d-xxl-block position-absolute top-0 start-50" alt="shape2">
                <img src="~/Content/Admin/assets/images/shape3.png" class="shape d-none d-xxl-block position-absolute top-0 end-0" alt="shape3">
                <img src="~/Content/Admin/assets/images/shape4.png" class="shape d-none d-xxl-block position-absolute bottom-0 start-0" style="margin-left: -1px;" alt="shape4">
                <img src="~/Content/Admin/assets/images/shape5.png" class="shape d-none d-xxl-block position-absolute" style="left: 38%; bottom: 1%;" alt="shape5">
                <img src="~/Content/Admin/assets/images/shape6.png" class="shape d-none d-xxl-block position-absolute bottom-0 end-0" alt="shape6">
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>     
        $(document).ready(function () {      
            $('.password-toggle-icon').click(function () {
                let passwordInput = $('#password');
                let icon = $(this);

                // Check current input type
                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('ri-eye-off-line').addClass('ri-eye-line'); // Switch to open eye icon
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('ri-eye-line').addClass('ri-eye-off-line'); // Switch back to closed eye icon
                }
            });
            logout();
            if (localStorage.getItem("rememberMe") == "true") {
                $("#flexCheckDefault").prop("checked", true);
                $("#emailaddress").val(localStorage.getItem("username"));
                $("#password").val(localStorage.getItem("password"));
            }
        });
        function validate(control) {

            var value = $.trim($(control).val());

            $(control).removeClass("is-valid is-invalid");

            if (value == "") {

                $(control).addClass("is-invalid");
                return false;
            }

            $.ajax({

                type: "POST",
                url: "/bctechadmin/CheckLoginUsername",

                data: {
                    username: value
                },

                success: function (result) {

                    if (result == true) {

                        $(control).removeClass("is-invalid")
                            .addClass("is-valid");

                    }
                    else {

                        $(control).removeClass("is-valid")
                            .addClass("is-invalid");

                    }

                },

                error: function () {

                    $(control).removeClass("is-valid")
                        .addClass("is-invalid");

                }

            });

            return true;
        }
        function logout() {

            $.ajax({

                type: "POST",

                url: "/bctechadmin/Logout",

                success: function () {

                    console.log("Logout Success");

                },

                error: function () {

                    console.log("Logout Error");

                }

            });

        }
        function checkLogin() {

            var username = $("#emailaddress").val().trim();
            var password = $("#password").val().trim();

            $("#error-alert").hide();

            $("#emailaddress").removeClass("is-invalid is-valid");
            $("#password").removeClass("is-invalid is-valid");

            if (username == "") {

                $("#emailaddress").addClass("is-invalid");

                $("#error-alert")
                    .html("Please enter Email, Mobile No or Username.")
                    .show();

                return;
            }

            if (password == "") {

                $("#password").addClass("is-invalid");

                $("#error-alert")
                    .html("Please enter Password.")
                    .show();

                return;
            }

            $("#emailaddress").addClass("is-valid");
            $("#password").addClass("is-valid");

            $.ajax({

                type: "POST",

                url: "/bctechadmin/GetLoginDetails",

                data: {

                    username: username,
                    password: password

                },

                beforeSend: function () {

                    $(".btn-login").prop("disabled", true);

                    Swal.fire({
                        title: "Signing In...",
                        text: "Please wait",
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        showConfirmButton: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                },

                success: function (result) {

                    Swal.close();

                    if (result == "done") {

                        if ($("#flexCheckDefault").is(":checked")) {
                            localStorage.setItem("rememberMe", "true");
                            localStorage.setItem("username", username);
                            localStorage.setItem("password", password);
                        }
                        else {
                            localStorage.clear();
                        }

                        Swal.fire({
                            icon: "success",
                            title: "Login Successful",
                            text: "Welcome to BCTECH ERP",
                            timer: 1200,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = "/bctechadmin/Dashboard";
                        });

                    }
                    else if (result == "deactivate") {

                        Swal.fire({
                            icon: "warning",
                            title: "Account Deactivated",
                            text: "Your account has been deactivated.",
                            confirmButtonColor: "#f59e0b"
                        });

                    }
                    else {

                        Swal.fire({
                            icon: "error",
                            title: "Login Failed",
                            text: "Invalid Username or Password.",
                            confirmButtonColor: "#dc3545"
                        });

                    }

                },

                error: function () {

                    Swal.close();

                    Swal.fire({
                        icon: "error",
                        title: "Server Error",
                        text: "Something went wrong. Please try again.",
                        confirmButtonColor: "#dc3545"
                    });

                },

                complete: function () {

                    $(".btn-login")
                        .prop("disabled", false)
                        .html("Sign In");

                },

            });

        }
        history.pushState(null, null, location.href);

        window.onpopstate = function () {
            history.go(1);
        };

    </script>
    }