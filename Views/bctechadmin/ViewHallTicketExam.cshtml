<div class="card bg-white rounded-10 border border-white mb-4">
    <div class="card-body p-4">

        <!-- Top Action Buttons -->
        <div class="d-flex align-items-center flex-wrap gap-2 mb-4">
            <a href="/bctechAdmin/HallTicketGenerate" class="btn btn-teal">
                <i class="ri-add-line fs-17 align-middle me-1"></i> Generate Hall Titcket
            </a>
            <a href="/bctechAdmin/ReExamHallTicketGenerate" class="btn btn-amber">
                <i class="ri-add-line fs-17 align-middle me-1"></i> Re-Exam Generate Hall Titcket
            </a>
        </div>

        <!-- Table Responsive Container -->
        <div class="table-responsive">
            <table class="table table-hover align-middle border-bottom w-100" id="tblHallTicketExam">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 140px;">Operations</th>
                        <th class="text-center" style="width: 60px;">No.</th>                        
                        <th>Exam Schedule Date</th>
                        <th>Course</th>
                        <th>Practical Exam Time</th>
                        <th>Theory Exam Time</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        int rowNum = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <!-- Operations Icons -->
                                <td class="text-center">
                                    <!-- 1. Delete (Red Cross) -->
                                    <a href="javascript:void(0);" 
                                       onclick="confirmDelete(@item.Schedule_Exam_Id, '@escapeJs(item.Course)')" 
                                       class="op-action-icon text-danger" 
                                       title="Delete Hall Ticket">
                                        <i class="fa fa-times text-danger"></i>
                                    </a>

                                    <span class="op-separator">|</span>

                                    <!-- 2. Print (Black Printer) -->
                                    <a href="/bctechAdmin/PrintHallTicket/@item.Schedule_Exam_Id" 
                                       target="_blank" 
                                       class="op-action-icon text-dark" 
                                       title="Print Hall Ticket">
                                        <i class="fa fa-print text-dark"></i>
                                    </a>

                                    <span class="op-separator">|</span>

                                    <!-- 3. View (Green Eye) -->
                                    <a href="javascript:void(0);" 
                                       onclick="showExamModal(@item.Schedule_Exam_Id, '@escapeJs(item.Course)', '@escapeJs(item.Exam_schedule_Date)', '@escapeJs(item.Branch)', '@escapeJs(item.Practical_Exam_Time)', '@escapeJs(item.Theory_Exam_Time)', '@escapeJs(item.NoOfQuestion)', '@escapeJs(item.ExamTime)', '@escapeJs(item.ExamTotalMarks)', @(item.branch_id ?? 0))" 
                                       class="op-action-icon text-success" 
                                       title="View Details">
                                        <i class="fa fa-eye text-success"></i>
                                    </a>

                                    <span class="op-separator">|</span>

                                    <!-- 4. SMS (Blue Envelope) -->
                                    <a href="javascript:void(0);" 
                                       onclick="confirmSendSMS(@item.Schedule_Exam_Id, '@escapeJs(item.Course)')" 
                                       class="op-action-icon text-primary" 
                                       title="Send SMS">
                                        <i class="fa fa-envelope text-primary"></i>
                                    </a>
                                </td>

                                <!-- No. -->
                                <td class="text-center text-muted fw-semibold">@item.No</td>                      

                                <!-- Exam Schedule Date -->
                                <td>@(string.IsNullOrEmpty(item.Exam_schedule_Date) ? "-" : item.Exam_schedule_Date)</td>

                                <!-- Course -->
                                <td class="fw-semibold text-dark">@(string.IsNullOrEmpty(item.Course) ? "-" : item.Course)</td>

                                <!-- Practical Exam Time -->
                                <td>@(string.IsNullOrEmpty(item.Practical_Exam_Time) ? "-" : item.Practical_Exam_Time)</td>

                                <!-- Theory Exam Time -->
                                <td>@(string.IsNullOrEmpty(item.Theory_Exam_Time) ? "-" : item.Theory_Exam_Time)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @{
            int curPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
            int pSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 10;
            int totRecords = ViewBag.TotalRecords != null ? (int)ViewBag.TotalRecords : (Model != null ? Model.Count : 0);
            int totPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : (int)Math.Ceiling((double)totRecords / pSize);
            if (totPages < 1) { totPages = 1; }

            int startRec = totRecords > 0 ? ((curPage - 1) * pSize) + 1 : 0;
            int endRec = totRecords > 0 ? Math.Min(curPage * pSize, totRecords) : 0;
        }

        <!-- Server-side Pagination & Info Controls -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top">
            <div class="d-flex align-items-center gap-2 text-secondary fs-13">
                @if (totRecords > 0)
                {
                    <span>Showing @startRec to @endRec of @totRecords entries</span>
                }
                else
                {
                    <span>Showing 0 to 0 of 0 entries</span>
                }
                <span class="text-muted ms-2">|</span>
                <span class="text-muted">Per Page:</span>
                <select class="form-select form-select-sm d-inline-block" style="width: 75px; padding: 2px 8px; font-size: 13px;" onchange="window.location.href='/bctechAdmin/ViewHallTicketExam?page=1&pageSize=' + this.value;">
                    <option value="10" @(pSize == 10 ? "selected" : "")>10</option>
                    <option value="25" @(pSize == 25 ? "selected" : "")>25</option>
                    <option value="50" @(pSize == 50 ? "selected" : "")>50</option>
                    <option value="100" @(pSize == 100 ? "selected" : "")>100</option>
                </select>
            </div>
            <div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Previous button -->
                        <li class="page-item @(curPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@(curPage <= 1 ? "javascript:void(0);" : "/bctechAdmin/ViewHallTicketExam?page=" + (curPage - 1) + "&pageSize=" + pSize)">Previous</a>
                        </li>

                        @{
                            int window = 2;
                            int startPage = Math.Max(1, curPage - window);
                            int endPage = Math.Min(totPages, curPage + window);

                            if (startPage > 1)
                            {
                                <li class="page-item @(curPage == 1 ? "active" : "")">
                                    <a class="page-link" href="/bctechAdmin/ViewHallTicketExam?page=1&pageSize=@pSize">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            for (int p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(curPage == p ? "active" : "")">
                                    <a class="page-link" href="/bctechAdmin/ViewHallTicketExam?page=@p&pageSize=@pSize">@p</a>
                                </li>
                            }

                            if (endPage < totPages)
                            {
                                if (endPage < totPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item @(curPage == totPages ? "active" : "")">
                                    <a class="page-link" href="/bctechAdmin/ViewHallTicketExam?page=@totPages&pageSize=@pSize">@totPages</a>
                                </li>
                            }
                        }

                        <!-- Next button -->
                        <li class="page-item @(curPage >= totPages ? "disabled" : "")">
                            <a class="page-link" href="@(curPage >= totPages ? "javascript:void(0);" : "/bctechAdmin/ViewHallTicketExam?page=" + (curPage + 1) + "&pageSize=" + pSize)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>
</div>

