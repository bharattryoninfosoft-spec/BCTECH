                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="btnModalSMS" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1">
                        <i class="fa fa-envelope"></i> Send SMS
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public static string escapeJs(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Replace("'", "\\'").Replace("\"", "&quot;").Replace("\r", "").Replace("\n", " ");
    }
}

@section Scripts {
    <!-- DataTables Buttons Extensions JS -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        var selectedExamId = 0;
        var allExamStudents = @Html.Raw(studentsJson);
        var allExamMeta = @Html.Raw(metaJson);

        $(document).ready(function () {
            // Initialize DataTable with export buttons (Paging & Info handled server-side)
            $('#tblHallTicketExam').DataTable({
                responsive: true,
                paging: false,
                info: false,
                dom: '<"d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"<"dt-buttons-box"B><"dt-search-box"f>>rt',
                buttons: [
                    { extend: 'copy', text: 'Copy', className: 'btn btn-primary btn-sm' },
                    { extend: 'csv', text: 'CSV', className: 'btn btn-primary btn-sm' },
                    { extend: 'excel', text: 'Excel', className: 'btn btn-primary btn-sm' },
                    { extend: 'pdf', text: 'PDF', className: 'btn btn-primary btn-sm' },
                    { extend: 'print', text: 'Print', className: 'btn btn-primary btn-sm' }
                ],
                order: [[1, 'asc']],
                language: {
                    search: "Search:",
                    searchPlaceholder: "Type to search..."
                }
            });

            $('#btnModalSMS').on('click', function () {
                if (selectedExamId > 0) {
                    confirmSendSMS(selectedExamId, $('#course_title_and_Date').text());
                }
            });

            // Real-time student search in modal
            $('#modalStudentSearch').on('keyup', function () {
                var searchVal = $(this).val().toLowerCase().trim();
                $('#tblStudentModalBody tr').each(function () {
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.indexOf(searchVal) > -1);
                });
            });

            // Handle Print Hall Ticket click from modal: print ONLY checked students
            $('#btnModalPrint').on('click', function (e) {
                var selectedIds = [];
                $('.chk-student-select:checked').each(function () {
                    var val = $(this).val();
                    if (val && val !== '0') {
                        selectedIds.push(val);
                    }
                });

                if (selectedIds.length === 0) {
                    e.preventDefault();
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'No Student Selected',
                            text: 'Please select at least one student checkbox to print hall ticket.',
                            icon: 'warning',
                            confirmButtonColor: '#3085d6'
                        });
                    } else {
                        alert('Please select at least one student checkbox to print hall ticket.');
                    }
                    return false;
                }

                var url = '/bctechAdmin/PrintHallTicket/' + selectedExamId + '?studentIds=' + selectedIds.join(',');
                $(this).attr('href', url);
                return true;
            });

            // Select all / deselect all students
            $(document).on('change', '#chkSelectAllStudents', function () {
                var isChecked = $(this).is(':checked');
                $('.chk-student-select').prop('checked', isChecked);
            });

            $(document).on('change', '.chk-student-select', function () {
                var total = $('.chk-student-select').length;
                var checked = $('.chk-student-select:checked').length;
                $('#chkSelectAllStudents').prop('checked', total > 0 && total === checked);
            });
        });

        var selectedExamId = 0;
        var selectedBranchId = 0;

        // View Exam Modal Detail - Instant Rendering
        function showExamModal(id, course, date, branch, practical, theory, noOfQuestion, examTime, examTotalMarks, branchId) {
            myFunction(id, course, date, practical, theory, noOfQuestion, examTime, examTotalMarks, branchId);
        }

        function myFunction(examId, course, date, practical, theory, noOfQuestion, examTime, examTotalMarks, branchId) {
            selectedExamId = examId;
            selectedBranchId = branchId || 0;
            $('#modal_Schedule_Exam_Id').val(examId);
            $('#btnModalPrint').attr('href', '/bctechAdmin/PrintHallTicket/' + examId);
            $('#modalStudentSearch').val('');

            // Set Title
            if (course || date) {
                $('#course_title_and_Date').text((course || '') + (date ? ' | ' + date : ''));
            }

            // Fallback to meta map if row parameters were missing or 0
            if (allExamMeta && allExamMeta[examId]) {
                var m = allExamMeta[examId];
                if ((!noOfQuestion || noOfQuestion === '0' || noOfQuestion === '-') && m.NoOfQuestion) noOfQuestion = m.NoOfQuestion;
                if ((!examTime || examTime === '0' || examTime === '-') && m.ExamTime) examTime = m.ExamTime;
                if ((!examTotalMarks || examTotalMarks === '0' || examTotalMarks === '-') && m.ExamTotalMarks) examTotalMarks = m.ExamTotalMarks;
                if ((!practical || practical === '-') && m.PracticalExamTime) practical = m.PracticalExamTime;
                if ((!theory || theory === '-') && m.TheoryExamTime) theory = m.TheoryExamTime;
            }

            // Populate Top Stats Table Immediately
            $('#No_Of_Question').text(noOfQuestion && noOfQuestion !== '0' ? noOfQuestion : '0');
            var timeFormatted = examTime && examTime !== '0' ? examTime : '0';
            if (timeFormatted !== '0' && !timeFormatted.toLowerCase().includes('min')) {
                timeFormatted += ' Min';
            }
            $('#Exam_Time').text(timeFormatted);
            $('#Exam_Total_Marks').text(examTotalMarks && examTotalMarks !== '0' ? examTotalMarks : '0');
            $('#Practical_Exam_Time').text(practical || '-');
            $('#Theory_Exam_Time').text(theory || '-');

            // Render Students immediately from preloaded data
            var compositeKey = examId + '_' + selectedBranchId;
            var preloadedList = null;
            if (allExamStudents) {
                if (selectedBranchId > 0 && allExamStudents[compositeKey] && allExamStudents[compositeKey].length > 0) {
                    preloadedList = allExamStudents[compositeKey];
                } else if (allExamStudents[examId]) {
                    preloadedList = allExamStudents[examId];
                    if (selectedBranchId > 0) {
                        preloadedList = preloadedList.filter(function (s) { return !s.branch_id || s.branch_id == selectedBranchId; });
                    }
                }
            }

            if (preloadedList && preloadedList.length > 0) {
                renderStudentList(preloadedList);
            } else {
                $('#tblStudentModalBody').html('<tr><td colspan="7" class="text-center py-3 text-muted"><i class="fa fa-spinner fa-spin me-1"></i> Loading students...</td></tr>');
                loadStudentsViaAjax(examId, selectedBranchId);
            }

            var modalEl = document.getElementById('modalExamDetail');
            var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }

        // Render Student Rows in Modal Table
        function renderStudentList(list) {
            $('#modalStudentCount').text(list ? list.length : 0);

            if (list && list.length > 0) {
                var markup = '';
                $.each(list, function (i, st) {
                    var no = i + 1;
                    var sId = st.student_id || st.StudentID || 0;
                    var sName = st.student_full_name || st.StudentFullName || '';
                    var sGender = st.student_gender || st.Gender || '-';
                    var sEn = st.student_String_En_No || st.StudentStringEnrollmentNo || '';
                    var sMob = st.student_mobile_no || st.StudentMobileNo || '';

                    markup += '<tr id="row_student_' + sId + '">';
                    markup += '<td class="text-center"><input type="checkbox" class="chk-student-select" value="' + sId + '" checked style="cursor: pointer; transform: scale(1.15);" /></td>';
                    markup += '<td class="text-center text-muted fw-semibold">' + no + '</td>';
                    markup += '<td class="fw-bold text-dark">' + sName + '</td>';
                    markup += '<td class="text-center text-secondary">' + sGender + '</td>';
                    markup += '<td class="text-secondary">' + sEn + '</td>';
                    markup += '<td class="text-secondary">' + sMob + '</td>';
                    markup += '<td class="text-center">';
                    markup += '<button type="button" class="btn btn-sm btn-danger py-1 px-2" style="background-color: #ef4444; border-color: #ef4444; border-radius: 6px;" title="Delete" onclick="functionStudentDelete(' + sId + ');">';
                    markup += '<i class="fa fa-trash text-white"></i>';
                    markup += '</button>';
                    markup += '</td>';
                    markup += '</tr>';
                });
                $('#tblStudentModalBody').html(markup);
                $('#chkSelectAllStudents').prop('checked', true);
            } else {
                $('#tblStudentModalBody').html('<tr><td colspan="7" class="text-center py-3 text-muted">No students found for this hall ticket.</td></tr>');
                $('#chkSelectAllStudents').prop('checked', false);
            }
        }

        // Fallback AJAX student loader
        function loadStudentsViaAjax(examId, branchId) {
            var bId = branchId || selectedBranchId || 0;
            $.ajax({
                type: "POST",
                url: "/bctechadmin/GetExamHallTicketStudentDetails",
                data: { Schedule_Exam_Id: examId, id: examId, branchId: bId },
                dataType: "json",
                success: function (res) {
                    var list = [];
                    if (res && res.data && Array.isArray(res.data)) list = res.data;
                    else if (res && res.d) {
                        try { list = JSON.parse(res.d); } catch (e) { }
                    }

                    if (allExamStudents) {
                        var cKey = examId + '_' + bId;
                        allExamStudents[cKey] = list;
                        allExamStudents[examId] = list;
                    }
                    renderStudentList(list);
                },
                error: function () {
                    // If AJAX also fails, show friendly empty state rather than scary red error
                    renderStudentList([]);
                }
            });
        }

        // Delete individual student from hall ticket
        function functionStudentDelete(studentId) {
            if (!studentId || !selectedExamId) return;

            var doDelete = function () {
                $.ajax({
                    type: "POST",
                    url: "/bctechadmin/DeleteHallTicket",
                    data: { student_id: studentId, Schedule_Exam_Id: selectedExamId },
                    dataType: "json",
                    success: function (res) {
                        // Remove from preloaded array
                        if (allExamStudents && allExamStudents[selectedExamId]) {
                            allExamStudents[selectedExamId] = allExamStudents[selectedExamId].filter(function (s) {
                                return (s.student_id || s.StudentID) != studentId;
                            });
                            renderStudentList(allExamStudents[selectedExamId]);
                        } else {
                            $('#row_student_' + studentId).remove();
                            var count = $('#tblStudentModalBody tr').length;
                            $('#modalStudentCount').text(count);
                        }

                        if (typeof Swal !== 'undefined') {
                            Swal.fire({ title: 'Deleted', text: 'Student removed from Hall Ticket.', icon: 'success', timer: 1500, showConfirmButton: false });
                        }
                    },
                    error: function () {
                        // Even if server returns error or 404, remove visually
                        $('#row_student_' + studentId).remove();
                        var count = $('#tblStudentModalBody tr').length;
                        $('#modalStudentCount').text(count);
                    }
                });
            };

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Remove Student?',
                    text: 'Are you sure you want to remove this student from this exam hall ticket?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, remove'
                }).then((result) => {
                    if (result.isConfirmed) doDelete();
                });
            } else {
                if (confirm('Are you sure you want to remove this student from this exam hall ticket?')) {
                    doDelete();
                }
            }
        }

        // Export student table to Excel
        function saveDetail() {
            var htmltable = document.getElementById('tblstudent');
            if (!htmltable) return;
            var html = htmltable.outerHTML;
            window.open('data:application/vnd.ms-excel,' + encodeURIComponent(html));
        }

        // Delete Whole Scheduled Exam Hall Tickets
        function confirmDelete(id, courseName) {
            if (!id) return;

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Do you want to delete the Hall Ticket for ' + (courseName || 'this exam') + '?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/bctechAdmin/HallTicketDelete/' + id;
                    }
                });
            } else {
                if (confirm('Are you sure you want to delete this hall ticket record?')) {
                    window.location.href = '/bctechAdmin/HallTicketDelete/' + id;
                }
            }
        }

        // Send SMS Confirmation
        function confirmSendSMS(id, courseName) {
            if (!id) return;

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Send Hall Ticket SMS?',
                    text: 'Are you sure you want to send hall ticket SMS to all students enrolled in ' + (courseName || 'this course') + '?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#2f80ed',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, send SMS'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/bctechAdmin/SMSHallTicket/' + id;
                    }
                });
            } else {
                if (confirm('Are you sure you want to send SMS to students?')) {
                    window.location.href = '/bctechAdmin/SMSHallTicket/' + id;
                }
            }
        }
    </script>
}
