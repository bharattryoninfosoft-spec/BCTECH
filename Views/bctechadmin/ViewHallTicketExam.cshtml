@model List<BCTECHERP.Models.HallTicketExamViewModel>
@using System.Data;
@using System.Data.SqlClient;
@using System.Configuration;
@using System.Web.Script.Serialization;
@{
    ViewBag.Title = "Hall Ticket Exam List";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
    ViewData["ParentMenu"] = "Student Exam";
    ViewData["PageTitle"] = "Generate Hall Ticket";

    string conStr = ConfigurationManager.ConnectionStrings["con"].ConnectionString;
    var examStudentsMap = new Dictionary<string, List<object>>();
    var examMetaMap = new Dictionary<string, object>();

    if (Model != null && Model.Count > 0)
    {
        var examIds = Model.Select(m => m.Schedule_Exam_Id).Where(id => id > 0).Distinct().ToList();
        if (examIds.Count > 0)
        {
            int cookieBranchId = ViewBag.ActiveBranchId != null ? (int)ViewBag.ActiveBranchId : 0;
            if (cookieBranchId == 0 && Request.Cookies["BranchID"] != null && !string.IsNullOrEmpty(Request.Cookies["BranchID"].Value))
            {
                int.TryParse(Request.Cookies["BranchID"].Value, out cookieBranchId);
            }

            string idList = string.Join(",", examIds);
            try
            {
                using (SqlConnection con = new SqlConnection(conStr))
                {
                    con.Open();

                    // 1. Fetch Students for all exams on this page (filtered by branch cookie if active)
                    string sqlStudents = @"
                        IF OBJECT_ID('HallTicketMaster', 'U') IS NOT NULL AND OBJECT_ID('StudentMaster', 'U') IS NOT NULL
                        BEGIN
                            DECLARE @colExam NVARCHAR(50) = CASE WHEN COL_LENGTH('HallTicketMaster', 'ScheduleExamId') IS NOT NULL THEN 'ScheduleExamId' ELSE 'Schedule_Exam_Id' END;
                            DECLARE @colStudent NVARCHAR(50) = CASE WHEN COL_LENGTH('HallTicketMaster', 'StudentID') IS NOT NULL THEN 'StudentID' ELSE 'student_id' END;

                            DECLARE @sql NVARCHAR(MAX) = N'
                                SELECT 
                                    HT.' + @colExam + N' AS Schedule_Exam_Id,
                                    HT.' + @colStudent + N' AS student_id,
                                    ISNULL(SD.BranchID, HT.BranchID) AS BranchID,
                                    ISNULL(SD.StudentFullName, '''') AS student_full_name,
                                    ISNULL(SD.Gender, '''') AS student_gender,
                                    CASE 
                                        WHEN SD.StudentStringEnrollmentNo IS NOT NULL AND RTRIM(LTRIM(SD.StudentStringEnrollmentNo)) <> '''' THEN SD.StudentStringEnrollmentNo 
                                        ELSE CAST(ISNULL(SD.StudentEnrollmentNo, SD.StudentID) AS NVARCHAR(50)) 
                                    END AS student_String_En_No,
                                    ISNULL(SD.StudentMobileNo, '''') AS student_mobile_no
                                FROM HallTicketMaster HT
                                INNER JOIN StudentMaster SD ON SD.StudentID = HT.' + @colStudent + N'
                                WHERE HT.' + @colExam + N' IN (" + idList + @")
                                  AND (" + cookieBranchId + @" = 0 OR ISNULL(SD.BranchID, HT.BranchID) = " + cookieBranchId + @")
                                ORDER BY student_full_name ASC';
                            EXEC sp_executesql @sql;
                        END";

                    using (SqlCommand cmd = new SqlCommand(sqlStudents, con))
                    {
                        using (SqlDataReader dr = cmd.ExecuteReader())
                        {
                            while (dr.Read())
                            {
                                string seKey = dr["Schedule_Exam_Id"].ToString();
                                string bKey = dr["BranchID"] != DBNull.Value ? dr["BranchID"].ToString() : "0";
                                string compositeKey = seKey + "_" + bKey;

                                var studentObj = new
                                {
                                    student_id = Convert.ToInt32(dr["student_id"]),
                                    student_full_name = dr["student_full_name"].ToString(),
                                    student_gender = dr["student_gender"].ToString(),
                                    student_String_En_No = dr["student_String_En_No"].ToString(),
                                    student_mobile_no = dr["student_mobile_no"].ToString(),
                                    branch_id = Convert.ToInt32(dr["BranchID"] != DBNull.Value ? dr["BranchID"] : 0)
                                };

                                if (!examStudentsMap.ContainsKey(compositeKey))
                                {
                                    examStudentsMap[compositeKey] = new List<object>();
                                }
                                examStudentsMap[compositeKey].Add(studentObj);

                                if (!examStudentsMap.ContainsKey(seKey))
                                {
                                    examStudentsMap[seKey] = new List<object>();
                                }
                                examStudentsMap[seKey].Add(studentObj);
                            }
                        }
                    }

                    // Fallback to tbl_hall_ticket if no students found in HallTicketMaster
                    if (examStudentsMap.Count == 0)
                    {
                        string sqlLegacy = @"
                            IF OBJECT_ID('tbl_hall_ticket', 'U') IS NOT NULL AND OBJECT_ID('tbl_student_details', 'U') IS NOT NULL
                            BEGIN
                                SELECT 
                                    ht.Schedule_Exam_Id,
                                    s.student_id,
                                    ISNULL(s.student_full_name, '') AS student_full_name,
                                    ISNULL(s.student_gender, '') AS student_gender,
                                    ISNULL(s.student_String_En_No, '') AS student_String_En_No,
                                    ISNULL(s.student_mobile_no, '') AS student_mobile_no
                                FROM tbl_hall_ticket ht
                                INNER JOIN tbl_student_details s ON s.student_id = ht.student_id
                                WHERE ht.Schedule_Exam_Id IN (" + idList + @")
                                ORDER BY s.student_full_name ASC
                            END";
                        using (SqlCommand cmd = new SqlCommand(sqlLegacy, con))
                        {
                            using (SqlDataReader dr = cmd.ExecuteReader())
                            {
                                while (dr.Read())
                                {
                                    string seKey = dr["Schedule_Exam_Id"].ToString();
                                    if (!examStudentsMap.ContainsKey(seKey))
                                    {
                                        examStudentsMap[seKey] = new List<object>();
                                    }
                                    examStudentsMap[seKey].Add(new
                                    {
                                        student_id = Convert.ToInt32(dr["student_id"]),
                                        student_full_name = dr["student_full_name"].ToString(),
                                        student_gender = dr["student_gender"].ToString(),
                                        student_String_En_No = dr["student_String_En_No"].ToString(),
                                        student_mobile_no = dr["student_mobile_no"].ToString()
                                    });
                                }
                            }
                        }
                    }

                    // 2. Fetch Exam Metadata (NoOfQuestion, ExamTime, ExamTotalMarks) in case Model had 0/null
                    string sqlMeta = @"
                        SELECT 
                            ScheduleExamId,
                            CAST(ISNULL(NoOfQuestion, 0) AS VARCHAR(20)) AS NoOfQuestion,
                            CAST(ISNULL(ExamTime, 0) AS VARCHAR(20)) AS ExamTime,
                            CAST(ISNULL(ExamTotalMarks, 0) AS VARCHAR(20)) AS ExamTotalMarks,
                            ISNULL(PracticalExamTime, '-') AS PracticalExamTime,
                            ISNULL(TheoryExamTime, '-') AS TheoryExamTime
                        FROM ScheduleExamMaster
                        WHERE ScheduleExamId IN (" + idList + @")";
                    using (SqlCommand cmd = new SqlCommand(sqlMeta, con))
                    {
                        using (SqlDataReader dr = cmd.ExecuteReader())
                        {
                            while (dr.Read())
                            {
                                string seIdKey = dr["ScheduleExamId"].ToString();
                                examMetaMap[seIdKey] = new
                                {
                                    NoOfQuestion = dr["NoOfQuestion"].ToString(),
                                    ExamTime = dr["ExamTime"].ToString(),
                                    ExamTotalMarks = dr["ExamTotalMarks"].ToString(),
                                    PracticalExamTime = dr["PracticalExamTime"].ToString(),
                                    TheoryExamTime = dr["TheoryExamTime"].ToString()
                                };
                            }
                        }
                    }
                }
            }
            catch { }
        }
    }
    string studentsJson = "{}";
    string metaJson = "{}";
    try
    {
        studentsJson = new JavaScriptSerializer().Serialize(examStudentsMap);
        metaJson = new JavaScriptSerializer().Serialize(examMetaMap);
    }
    catch { }
}

