        function ValidatePurchase() {
            if ($("#hfPartyID").val() == "0" || $("#hfPartyID").val() == "") {
                toastr.warning("Please select a supplier.");
                return false;
            }

            // Validate From Inv No (Ref Order No) is not empty and is numeric
            var refOrderNo = $("#txtRefOrderNo").val().trim();
            if (refOrderNo === "" || isNaN(refOrderNo)) {
                toastr.warning("Please enter a valid numeric From Inv No.");
                $("#txtRefOrderNo").focus();
                return false;
            }

            if ($("#tbodyPurchase tr.DataRow").length == 0) {
                toastr.warning("Please add at least one item.");
                return false;
            }
            return true;
        }

        function SavePurchase() {
            if (!ValidatePurchase()) return;

            var formData = GetPurchaseMaster();
            formData.PurchaseDetails = GetPurchaseDetail();
            var isEdit = parseInt(formData.PurchaseInvoiceID) > 0;
            var targetUrl = isEdit ? "/bctechadmin/UpdatePurchase" : "/bctechadmin/SavePurchase";

            $.ajax({
                type: "POST",
                url: targetUrl,
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify(formData),
                dataType: "json",
                success: function (response) {
                    if (response.Status) {
                        toastr.success(response.Message);
                        window.location.href = "/bctechadmin/PurchaseMaster";
                    } else {
                        toastr.error(response.Message);
                    }
                },
                error: function () {
                    toastr.error("Something went wrong.");
                }
            });
        }

        function GetPurchaseMaster() {
            var branchId = $("#ddlBranch").val() || $("#hfUserBranchID").val() || 1;
            var loggedInUserId = $("#hfLoggedInUserID").val() || 1;

            var discountRate = parseFloat($("#txtInvoiceDiscountRate").val()) || 0;
            var discountPct = parseFloat($("#txtInvoiceDiscountPercentage").val()) || 0;
            var financialYearId = $("#ddlFinancialYear").val() || 1;

            return {
                PurchaseInvoiceID: $("#hfPurchaseInvoiceID").val() || 0,
                PurchaseInvoiceNo: $("#txtPurchaseInvoiceNo").val(),
                PurchaseInvoiceDate: $("#txtPurchaseInvoiceDate").val(),
                RefOrderNo: $("#txtRefOrderNo").val(),
                IsOutOfState: false,
                PartyId: $("#hfPartyID").val(),
                PaymentTerm: "",
                DueDate: null,
                SubTotal: $("#lblSubTotal").text().replace("₹", "").trim() || 0,
                GSTTax: $("#lblGSTTotal").text().replace("₹", "").trim() || 0,
                Amount: $("#lblGrandTotal").text().replace("₹", "").trim() || 0,
                NotesRemarks: $("#txtRemark").val(),
                PurchaseBillDiscountRate: discountRate,
                PurchaseBillDiscountPercentage: discountPct,
                TotalAmount: $("#lblGrandTotal").text().replace("₹", "").trim() || 0,
                FinancialYearID: financialYearId,
                BranchId: branchId,
                UserId: loggedInUserId,
                RoundOff: $("#lblRoundOff").text().replace("₹", "").trim() || 0
            };
        }

        function GetPurchaseDetail() {
            var Detail = [];
            var currentFinancialYearId = $("#ddlFinancialYear").val() || 1;
            var currentBranchId = $("#ddlBranch").val() || $("#hfUserBranchID").val() || 1;

            $("#tbodyPurchase tr.DataRow").each(function () {
                var row = $(this);
                var gstRate = parseFloat(row.find(".GST").val()) || 0;
                var rate = parseFloat(row.find(".Rate").val()) || 0;
                var discount = parseFloat(row.find(".Discount").val()) || 0;

                Detail.push({
                    MaterialID: row.find(".MaterialID").val(),
                    MaterialDescription: row.find(".MaterialDescription").val() || "",
                    HSNCode: row.find(".HSNCode").val() || "",
                    Qty: row.find(".Qty").val(),
                    UnitID: row.find(".UnitID").val() || 1,
                    PurchasePrice: rate,
                    PurchaseDiscount: discount,
                    PurchaseRateAfterDiscount: rate - ((rate * discount) / 100),
                    GSTSLABId: row.find(".GSTSLABId").val() || 1,
                    CGST: 0,
                    CGSTRate: 0,
                    SGST: 0,
                    SGSTRate: 0,
                    IGST: 0,
                    IGSTPer: gstRate,
                    Amount: row.find(".Amount").val(),
                    FinancialYearID: currentFinancialYearId,
                    BranchId: currentBranchId
                });
            });

            return Detail;
        }

