        function CheckUserBranchPermission() {
            $.ajax({
                type: "POST",
                url: "/bctechadmin/GetLoggedInUserInfo",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response.Status) {
                        var category = response.UserCategory;
                        var userBranchId = response.BranchId;
                        var userId = response.UserId;
                        $("#hfLoggedInUserID").val(userId);

                        if (category === "Admin") {
                            $("#divBranchContainer").show();
                        }
                        else if (category === "Branch Head") {
                            $("#divBranchContainer").show();
                            $("#ddlBranch").val(userBranchId).prop("disabled", true);
                        }
                        else {
                            $("#divBranchContainer").hide();
                            if ($("#hfUserBranchID").length === 0) {
                                $("form").append("<input type='hidden' id='hfUserBranchID' value='" + userBranchId + "'>");
                            }
                        }
                    }
                },
                error: function () {
                    console.log("Failed to check user permissions.");
                }
            });
        }
