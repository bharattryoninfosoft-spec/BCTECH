
@{
    ViewBag.Title = "FunctionEventType";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<div class="card bg-white rounded-10 border border-white mb-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">

        <form class="table-src-form position-relative m-0">
            <input type="text" id="txtSearch" class="form-control w-350" placeholder="Search Event Type...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>

        <!--<a href="javascript:void(0);" class="text-primary fs-16 text-decoration-none"
           onclick="OpenFunctionEventTypeModal()">
            + Add Event Type
        </a>-->

        <a href="javascript:void(0);" class="btn btn-primary text-white" onclick="OpenFunctionEventTypeModal()">
            <i class="ri-add-line"></i> Add Event Type
        </a>

    </div>

    <div class="default-table-area mx-minus-1 table-contact-list">

        <div class="table-responsive">

            <table class="table-common" id="tblFunctionEventType">

                <thead>

                    <tr>
                        <th>SR</th>
                        <th>Event Type</th>
                        <th>Description</th>
                        <th>Is Active</th>
                        <th>Created Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="col-lg-12">
            <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                <span class="fs-15" id="lblShowing"></span>

                <nav class="custom-pagination" aria-label="Page navigation example">
                    <ul class="pagination mb-0 justify-content-center" id="pagination"></ul>
                </nav>
            </div>
        </div>

    </div>

    <!-- Modal -->

    <div class="modal fade" id="FunctionEventTypeModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">Event Type</h5>

                    <button class="btn-close" data-bs-dismiss="modal"></button>

                </div>

                <div class="modal-body">

                    <input type="hidden" id="hfEventTypeID" value="0" />

                    <div class="mb-3">

                        <label class="form-label">Event Type <sup style="color:red;">*</sup></label>

                        <input type="text"
                               id="txtEventTypeName"
                               class="form-control"
                               maxlength="50"
                               placeholder="Enter Event Type" />

                    </div>
                    
                    <div class="mb-3">

                        <label class="form-label">Event Description</label>

                        <input type="text"
                               id="txtDescription"
                               class="form-control"
                               maxlength="50"
                               placeholder="Enter Event Description" />

                    </div>

                    <!-- Active -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chkIsActive"
                                   checked>

                            <label class="form-check-label" for="chkIsActive">
                                Active
                            </label>
                        </div>
                    </div>




                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button class="btn btn-primary text-white"
                            onclick="SaveFunctionEventType()">
                        Save
                    </button>

                </div>

            </div>

        </div>

    </div>

    @section Scripts{
        <script>

            var FunctionEventTypes = [];
            var filteredFunctionEventTypes = [];
            var currentPage = 1;
            var pageSize = 10;

            $(document).ready(function () {

                GetFunctionEventType();

                $("#txtSearch").on("keyup", function () {

                    var search = $(this).val().toLowerCase().trim();

                    filteredFunctionEventTypes = FunctionEventTypes.filter(function (x) {

                        return x.EventTypeName.toLowerCase().includes(search);

                    });

                    currentPage = 1;

                    BindGrid();

                });

            });

            function GetFunctionEventType() {

                $.ajax({

                    url: "/BCTECHAdmin/GetFunctionEventType",

                    type: "GET",

                    dataType: "json",

                    success: function (data) {

                        FunctionEventTypes = data;
                        filteredFunctionEventTypes = data;

                        currentPage = 1;

                        BindGrid();

                    }

                });

            }

            function BindGrid() {

                var html = "";

                var start = (currentPage - 1) * pageSize;
                var end = Math.min(start + pageSize, filteredFunctionEventTypes.length);

                for (var i = start; i < end; i++) {

                    var item = filteredFunctionEventTypes[i];

                    var isactivecss = "";
                    if (item.IsActive) {
                        isactivecss = "<td><span class='badge bg-success'>Active</span></td>";
                    }
                    else {
                        isactivecss = "<td><span class='badge bg-danger'>Inactive</span></td>";
                    }


                    html += `
                                <tr>

                                     <td>${i + 1}</td>
                                    <td hidden>${item.EventTypeID}</td>
                                    <td>${item.EventTypeName}</td>
                                    <td>${item.Description}</td>
                                     ${isactivecss}
                                    <td>${item.CreatedDateTime}</td>

                                    <td>

                                        <a href="javascript:void(0)"
                                           onclick="EditFunctionEventType(${item.EventTypeID})">

                                            <i class="ri-edit-line text-primary"></i>

                                        </a>

                                        &nbsp;&nbsp;

                                        <a href="javascript:void(0)"
                                           onclick="DeleteFunctionEventType(${item.EventTypeID})">

                                            <i class="ri-delete-bin-line text-danger"></i>

                                        </a>

                                    </td>

                                </tr>`;
                }

                $("#tblFunctionEventType tbody").html(html);

                $("#lblShowing").text(

                    `Showing ${filteredFunctionEventTypes.length == 0 ? 0 : start + 1}
                                 to ${end}
                                 of ${filteredFunctionEventTypes.length} entries`

                );

                CreatePagination();

            }

            function CreatePagination() {

                var totalPages = Math.ceil(filteredFunctionEventTypes.length / pageSize);

                var html = "";

                html += `
                            <li class="page-item ${currentPage == 1 ? 'disabled' : ''}">
                                <a class="page-link"
                                   href="javascript:void(0)"
                                   ${currentPage == 1 ? '' : `onclick="ChangePage(${currentPage - 1})"`}>
                                    <i class="material-symbols-outlined">west</i>
                                </a>
                            </li>`;

                for (var i = 1; i <= totalPages; i++) {

                    html += `
                                <li class="page-item">

                                    <a class="page-link ${currentPage == i ? 'active' : ''}"
                                       href="javascript:void(0)"
                                       onclick="ChangePage(${i})">

                                        ${i}

                                    </a>

                                </li>`;

                }

                html += `
                            <li class="page-item ${currentPage == totalPages ? 'disabled' : ''}">
                                <a class="page-link"
                                   href="javascript:void(0)"
                                   ${currentPage == totalPages ? '' : `onclick="ChangePage(${currentPage + 1})"`}>
                                    <i class="material-symbols-outlined">east</i>
                                </a>
                            </li>`;

                $("#pagination").html(html);

            }

            function ChangePage(page) {

                var totalPages = Math.ceil(filteredFunctionEventTypes.length / pageSize);

                if (page < 1 || page > totalPages)
                    return;

                currentPage = page;

                BindGrid();

            }

            function OpenFunctionEventTypeModal() {

                $("#hfEventTypeID").val(0);

                $("#txtEventTypeName").val("");
                $("#txtDescription").val("");

                $("#FunctionEventTypeModal").modal("show");

            }

            function SaveFunctionEventType() {

                if ($("#txtEventTypeName").val().trim() == "") {
                    toastr.warning("Please Enter Event Type.");
                    $("#txtEventTypeName").focus();
                    return;
                }
                 

                $.ajax({

                    url: "/BCTECHAdmin/SaveFunctionEventType",

                    type: "POST",

                    data: {
                        EventTypeID: $("#hfEventTypeID").val(),
                        EventTypeName: $("#txtEventTypeName").val(),
                        Description: $("#txtDescription").val(),
                        IsActive: $("#chkIsActive").is(":checked")
                        //IsActive: $("#chkIsActive").is(":checked")
                    },

                    success: function (res) {

                        if (res.Status) {
                            toastr.success(res.Message);
                            $("#FunctionEventTypeModal").modal("hide");
                            GetFunctionEventType();
                        }
                        else {
                            toastr.warning(res.Message);
                        }
                    }

                });

            }

            function EditFunctionEventType(id) {

                $.ajax({

                    url: "/BCTECHAdmin/GetFunctionEventTypeByID",

                    type: "GET",

                    data: { id: id },

                    success: function (item) {

                        $("#hfEventTypeID").val(item.EventTypeID);

                        $("#txtEventTypeName").val(item.EventTypeName);
                        $("#txtDescription").val(item.Description);

                        $("#FunctionEventTypeModal").modal("show");

                    }

                });

            }

            function DeleteFunctionEventType(id) {

                Swal.fire({

                    title: "Are you sure?",

                    text: "You won't be able to recover this record!",

                    icon: "warning",

                    showCancelButton: true,

                    confirmButtonText: "Yes, Delete",

                    cancelButtonText: "Cancel"

                }).then((result) => {

                    if (result.isConfirmed) {

                        $.ajax({

                            url: "/BCTECHAdmin/DeleteEventType",

                            type: "POST",

                            data: { id: id },

                            success: function (response) {

                                if (response == "Success") {

                                    Swal.fire({

                                        icon: "success",

                                        title: "Deleted",

                                        text: "Event Type Deleted Successfully",

                                        timer: 1500,

                                        showConfirmButton: false

                                    });

                                    GetFunctionEventType();

                                }

                            }

                        });

                    }

                });

            }

        </script>
    }

</div>
