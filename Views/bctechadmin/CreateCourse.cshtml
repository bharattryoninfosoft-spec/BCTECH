
@{
    ViewBag.Title = "CreateCourse";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<div class="card bg-white p-20 rounded-10 border border-white mb-4">

    <div class="card-header bg-primary bg-opacity-10 mb-4 rounded-3">
        <h5 class="mb-0">
            <i class="ri-book-open-line me-2"></i>
            Course Information
        </h5>
    </div>

    <div class="card-body">

        <input type="hidden" id="hfCourseID" value="0" />

        <div class="row">

            <!-- Course Code -->
            <div class="col-lg-4">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Course Code <span class="text-danger">*</span>
                    </label>

                    <div class="position-relative">
                        <input type="text"
                               id="txtCourseCode"
                               class="form-control"
                               placeholder="Enter Course Code">
                    </div>
                </div>
            </div>

            <!-- Course Title -->
            <div class="col-lg-8">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Course Title <span class="text-danger">*</span>
                    </label>

                    <div class="position-relative">
                        <input type="text"
                               id="txtCourseTitle"
                               class="form-control"
                               placeholder="Enter Course Title">
                    </div>
                </div>
            </div>

        </div>

        <div class="row">

            <!-- Short Name -->
            <div class="col-lg-6">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Short Name
                    </label>

                    <div class="position-relative">
                        <input type="text"
                               id="txtShortName"
                               class="form-control"
                               placeholder="Enter Short Name">
                    </div>
                </div>
            </div>

            <!-- Course URL -->
            <div class="col-lg-6">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Course URL
                    </label>

                    <div class="position-relative">
                        <input type="text"
                               id="txtCourseURL"
                               class="form-control"
                               placeholder="Enter Course URL">
                    </div>
                </div>
            </div>

        </div>

        <div class="row">

            <!-- Course Image -->
            <div class="col-lg-6">

                <div class="mb-20">

                    <label class="label fs-16 mb-2">
                        Course Image
                    </label>

                    <input type="file"
                           id="fuCourseImage"
                           class="form-control">

                </div>

            </div>

            <!-- Preview -->
            <div class="col-lg-2">

                <div class="mb-20">

                    <label class="label fs-16 mb-2">
                        Preview
                    </label>

                    <img id="imgCourse"
                         src="~/Content/Admin/assets/images/no-image.png"
                         class="img-thumbnail rounded"
                         style="height:90px;width:90px;" />

                </div>

            </div>

        </div>

    </div>

</div>
<div class="card bg-white p-20 rounded-10 border border-white mb-4">

    <div class="card-header bg-primary bg-opacity-10 mb-4 rounded-3">
        <h5 class="mb-0">
            <i class="ri-time-line me-2"></i>
            Duration & Fees
        </h5>
    </div>

    <div class="card-body">

        <div class="row">

            <!-- Duration -->
            <div class="col-lg-3">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Duration <span class="text-danger">*</span>
                    </label>

                    <div class="position-relative">
                        <input type="number"
                               id="txtDuration"
                               class="form-control"
                               placeholder="Duration">
                    </div>
                </div>
            </div>

            <!-- Duration Type -->
            <div class="col-lg-3">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Duration Type <span class="text-danger">*</span>
                    </label>

                    <div class="position-relative">
                        <select id="ddlDurationType" class="form-select">

                            <option value="">Select Duration</option>

                            <option value="Days">Days</option>

                            <option value="Weeks">Weeks</option>

                            <option value="Months">Months</option>

                            <option value="Years">Years</option>

                        </select>
                    </div>
                </div>
            </div>

            <!-- Course Fee -->
            <div class="col-lg-2">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Course Fee
                    </label>

                    <div class="position-relative">
                        <input type="number"
                               id="txtCourseFee"
                               class="form-control"
                               placeholder="0.00">
                    </div>
                </div>
            </div>

            <!-- Registration Fee -->
            <div class="col-lg-2">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Registration Fee
                    </label>

                    <div class="position-relative">
                        <input type="number"
                               id="txtRegistrationFee"
                               class="form-control"
                               placeholder="0.00">
                    </div>
                </div>
            </div>

            <!-- Exam Fee -->
            <div class="col-lg-2">
                <div class="mb-20">
                    <label class="label fs-16 mb-2">
                        Exam Fee
                    </label>

                    <div class="position-relative">
                        <input type="number"
                               id="txtExamFee"
                               class="form-control"
                               placeholder="0.00">
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
<div class="card bg-white p-20 rounded-10 border border-white mb-4">

    <div class="card-header bg-success bg-opacity-10 mb-4 rounded-3">
        <h5 class="mb-0">
            <i class="ri-settings-3-line me-2"></i>
            Course Options
        </h5>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-lg-4">

                <div class="form-check form-switch mt-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="chkCertificate">

                    <label class="form-check-label ms-2">
                        Certificate Available
                    </label>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="form-check form-switch mt-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="chkMasterCourse">

                    <label class="form-check-label ms-2">
                        Master Course
                    </label>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="form-check form-switch mt-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="chkActive"
                           checked>

                    <label class="form-check-label ms-2">
                        Active
                    </label>

                </div>

            </div>

        </div>

    </div>

</div>
<div class="card bg-white p-20 rounded-10 border border-white mb-4">

    <div class="card-header bg-info bg-opacity-10 mb-4 rounded-3">
        <h5 class="mb-0">
            <i class="ri-file-text-line me-2"></i>
            Course Description
        </h5>
    </div>

    <div class="card-body">

        <div class="row">

            <!-- Short Description -->
            <div class="col-lg-12">

                <div class="mb-20">

                    <label class="label fs-16 mb-2">
                        Short Description
                    </label>

                    <div class="position-relative">
                        <input id="txtShortDescription" class="form-control" placeholder="Enter Short Description"></input>
                    </div>
                </div>

            </div>

            <!-- Full Description -->
            <div class="col-lg-12">
                <div class="mb-20">
                    <label class="label fs-16 mb-2"> Full Description</label>
                    <div class="position-relative">
                        <textarea id="txtFullDescription"></textarea>
                    </div>
                </div>
            </div>

            <!-- Remarks -->
            <div class="col-lg-12">

                <div class="mb-20">

                    <label class="label fs-16 mb-2">
                        Remarks
                    </label>

                    <div class="position-relative">

                        <input id="txtRemarks" class="form-control" placeholder="Enter Remarks"></input>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<div class="card bg-white p-20 rounded-10 border border-white mb-4"
     id="divMasterCourseSection"
     style="display:none;">

    <div class="card-header bg-warning bg-opacity-10 mb-4 rounded-3">
        <h5 class="mb-0">
            <i class="ri-stack-line me-2"></i>
            Master Course Mapping
        </h5>
    </div>

    <div class="card-body">

        <label class="label fs-16 mb-3">
            Select Master Courses
        </label>

        <div id="divMasterCourse" class="border rounded p-3 bg-light">
        </div>

    </div>
</div>
<div class="card bg-white p-20 rounded-10 border border-white mb-4">
    <div class="d-flex justify-content-end mt-4">
        <a href="/bctechadmin/CourseManage"
           class="btn btn-secondary fw-normal fs-16 me-2">
            <i class="ri-arrow-left-line me-1"></i>
            Back
        </a>

        <button type="button"
                id="btnSave"
                class="btn btn-primary text-white">
            <i class="ri-save-line me-2"></i>
            Save Course
        </button>
    </div>
</div>

@section Scripts{

    <script>
     $(function () {
         var CourseID = '@ViewBag.CourseID';
         var mode = '@ViewBag.Mode';

         if (CourseID != "" && CourseID != "0") {
             EditCourse(CourseID);
         }
         if (mode == "E")
             $("#btnSave").html('<i class="ri-save-line me-2"></i> Update Course');
         else
             $("#btnSave").html('<i class="ri-save-line me-2"></i> Save Course');

         if (mode == "V") {
             $("input,select,textarea").prop("disabled", true);

             $(".chkMasterCourse").prop("disabled", true);

             $("#txtFullDescription").summernote("disable");

             $("#btnSave").hide();

             $("#fuCourseImage").hide();


                 ToggleMasterCourse();

                 $(".chkMasterCourse").prop("disabled", true);

         }
 });
        $(document).ready(function () {

            LoadCourse();

            InitializeControls();

            ToggleMasterCourse();

        });

        function InitializeControls() {

            $("#txtFullDescription").summernote({
                height: 250
            });

        }
        $("#fuCourseImage").change(function () {

            if (this.files && this.files[0]) {

                var reader = new FileReader();

                reader.onload = function (e) {

                    $("#imgCourse").attr("src", e.target.result);

                };

                reader.readAsDataURL(this.files[0]);

            }

        });
        $("#btnReset").click(function () {

            ClearForm();

        });
        $(document).on("change", "#chkMasterCourse", function () {
            ToggleMasterCourse();
        });
        function ToggleMasterCourse() {

            if ($("#chkMasterCourse").is(":checked")) {

                $("#divMasterCourseSection").slideDown();

                BindMasterCourse($("#hfCourseID").val());

            }
            else {

                $("#divMasterCourseSection").slideUp();

                $("#divMasterCourse").empty();

            }
        }
        function ClearForm() {

            $("#hfCourseID").val(0);

            $("#txtCourseCode").val("");

            $("#txtCourseTitle").val("");

            $("#txtShortName").val("");

            $("#txtCourseURL").val("");

            $("#txtDuration").val("");

            $("#ddlDurationType").val("");

            $("#txtCourseFee").val("");

            $("#txtRegistrationFee").val("");

            $("#txtExamFee").val("");

            $("#txtShortDescription").val("");

            $("#txtRemarks").val("");

            $("#chkCertificate").prop("checked", false);

            $("#chkMasterCourse").prop("checked", false);

            $("#chkActive").prop("checked", true);

            $("#txtFullDescription").summernote('code', '');

            $("#imgCourse").attr("src", "/Content/Admin/assets/images/no-image.png");

            $("#fuCourseImage").val("");

        }
        function BindMasterCourse(courseId) {

            $.ajax({
                url: "/BCTECHAdmin/GetMasterCourseList",
                type: "GET",
                data: { CourseID: courseId },
                success: function (res) {

                    var html = "";

                    $.each(res, function (i, item) {

                        html += `
                <div class="form-check mb-2">
                    <input type="checkbox"
                           class="form-check-input chkMasterCourse"
                           value="${item.CourseID}"
                           id="chk_${item.CourseID}"
                           ${item.IsSelected ? "checked" : ""}>

                    <label class="form-check-label" for="chk_${item.CourseID}">
                        ${item.CourseTitle}
                    </label>
                </div>`;
                    });

                    $("#divMasterCourse").html(html);
                }
            });
        }

        function LoadCourse() {

            if ($.fn.DataTable.isDataTable("#tblCourse")) {

                $("#tblCourse").DataTable().destroy();

            }

            $("#tblCourse").DataTable({

                ajax: {

                    url: "/BCTECHAdmin/GetCourse",

                    dataSrc: ""

                },

                columns: [

                    { data: "CourseID" },

                    { data: "CourseCode" },

                    { data: "CourseTitle" },

                    {
                        data: null,

                        render: function (data) {

                            return data.Duration + " " + data.DurationType;

                        }

                    },

                    { data: "CourseFee" },

                    {

                        data: "IsActive",

                        render: function (data) {

                            if (data)

                                return '<span class="badge bg-success">Active</span>';

                            else

                                return '<span class="badge bg-danger">Inactive</span>';

                        }

                    },

                    {

                        data: null,

                        render: function (data) {

                            return '<button class="btn btn-sm btn-primary btnEdit" data-id="' + data.CourseID + '"><i class="ri-edit-line"></i></button> ' +

                                '<button class="btn btn-sm btn-danger btnDelete" data-id="' + data.CourseID + '"><i class="ri-delete-bin-line"></i></button>';

                        }

                    }

                ]

            });

        }
        $(document).on("click", ".btnEdit", function () {

            var id = $(this).data("id");

            EditCourse(id);

        });
        $(document).on("click", ".btnDelete", function () {

            var id = $(this).data("id");

            DeleteCourse(id);

        });
        $("#btnSave").click(function () {

            SaveCourse();

        });
        function ValidateCourse() {

            if ($("#txtCourseCode").val().trim() == "") {

                toastr.warning("Please Enter Course Code.");

                $("#txtCourseCode").focus();

                return false;
            }

            if ($("#txtCourseTitle").val().trim() == "") {

                toastr.warning("Please Enter Course Title.");

                $("#txtCourseTitle").focus();

                return false;
            }

            if ($("#txtDuration").val().trim() == "") {

                toastr.warning("Please Enter Duration.");

                $("#txtDuration").focus();

                return false;
            }

            if ($("#ddlDurationType").val() == "") {

                toastr.warning("Please Select Duration Type.");

                $("#ddlDurationType").focus();

                return false;
            }

            if ($("#txtCourseFee").val().trim() == "") {

                toastr.warning("Please Enter Course Fee.");

                $("#txtCourseFee").focus();

                return false;
            }

            return true;

        }
            function SaveCourse() {

                if (!ValidateCourse())
                    return;

                var formData = new FormData();

                formData.append("CourseID", $("#hfCourseID").val());
                formData.append("CourseCode", $("#txtCourseCode").val());
                formData.append("CourseTitle", $("#txtCourseTitle").val());
                formData.append("CourseShortName", $("#txtShortName").val());
                formData.append("CourseURL", $("#txtCourseURL").val());
                formData.append("Duration", $("#txtDuration").val());
                formData.append("DurationType", $("#ddlDurationType").val());
                formData.append("CourseFee", $("#txtCourseFee").val());
                formData.append("RegistrationFee", $("#txtRegistrationFee").val());
                formData.append("ExamFee", $("#txtExamFee").val());

                formData.append("CertificateAvailable", $("#chkCertificate").is(":checked"));
                formData.append("IsMasterCourse", $("#chkMasterCourse").is(":checked"));
                formData.append("IsActive", $("#chkActive").is(":checked"));

                formData.append("ShortDescription", $("#txtShortDescription").val());
                formData.append("FullDescription", $("#txtFullDescription").summernote("code"));
                formData.append("Remarks", $("#txtRemarks").val());

                // ==========================
                // Master Course Checkbox List
                // ==========================
                if ($("#chkMasterCourse").is(":checked")) {

                    $(".chkMasterCourse:checked").each(function () {

                        formData.append("MasterCourse[]", $(this).val());

                    });

                }

                // ==========================
                // Course Image
                // ==========================
                var file = $("#fuCourseImage")[0].files;

                if (file.length > 0) {

                    formData.append("CourseImage", file[0]);

                }

                $.ajax({

                    url: "/BCTECHAdmin/SaveCourse",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,

                    beforeSend: function () {

                        $("#btnSave").prop("disabled", true);

                    },

                    success: function (response) {

                        $("#btnSave").prop("disabled", false);

                        if (response.Status == 1) {

                            toastr.success(response.Message);

                            setTimeout(function () {
                                window.location.href = "/BCTECHAdmin/CourseManage";
                            }, 1000);

                        }
                        else {

                            toastr.error(response.Message);

                        }

                    },

                    error: function (xhr) {

                        $("#btnSave").prop("disabled", false);

                        toastr.error("Something went wrong.");

                        console.log(xhr.responseText);

                    }

                });

            }
        function EditCourse(id) {

            $.ajax({

                url: "/BCTECHAdmin/GetCourseByID",

                type: "GET",

                data: {

                    CourseID: id

                },

                success: function (data) {

                    $("#hfCourseID").val(data.CourseID);
                    $("#txtCourseCode").val(data.CourseCode);
                    $("#txtCourseTitle").val(data.CourseTitle);
                    $("#txtShortName").val(data.CourseShortName);
                    $("#txtCourseURL").val(data.CourseURL);

                    $("#txtDuration").val(data.Duration);
                    $("#ddlDurationType").val(data.DurationType);

                    $("#txtCourseFee").val(data.CourseFee);
                    $("#txtRegistrationFee").val(data.RegistrationFee);
                    $("#txtExamFee").val(data.ExamFee);

                    $("#chkCertificate").prop("checked", data.CertificateAvailable);
                    $("#chkMasterCourse").prop("checked", data.IsMasterCourse);
                    $("#chkActive").prop("checked", data.IsActive);

                    $("#txtShortDescription").val(data.ShortDescription);
                    $("#txtRemarks").val(data.Remarks);

                    $("#txtFullDescription").summernote("code", data.FullDescription);

                    if (data.CourseImage != "") {
                        $("#imgCourse").attr("src",
                            "/Content/Upload/CourseImage/" + data.CourseImage);
                    }
                    $("#chkMasterCourse").prop("checked", data.IsMasterCourse);
                    ToggleMasterCourse();
                    $("html,body").animate({
                        scrollTop: 0
                    }, 500);
                }

            });

        }

       

    </script>
}

