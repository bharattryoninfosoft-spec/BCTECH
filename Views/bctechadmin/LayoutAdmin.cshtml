            var controller = ViewContext.RouteData.Values["controller"]?.ToString();
            var action = ViewContext.RouteData.Values["action"]?.ToString();

            bool isHome = action == "Index";
            bool isUtility = new[]
            {  "OrganizationMaster","BranchMaster","UserMaster","FinancialYearMaster","FeesTypeMaster","PaymentTypeMaster","EnquirySourceMaster","StudentChargeMaster", "AdmissionTermCondMaster", "FeeTermCondMaster", "StudentDocumentMaster" }.Contains(action);
            bool isCourse = new[]
            {  "Course","CourseManage","CourseInquiries" }.Contains(action);
            bool isInventory = new[]
            {  "MaterialCategoryMaster", "MaterialMaster", "UnitMaster","StockMaster", "PurchaseMaster", "SupplierPartyMaster" }.Contains(action);
            bool isStudent = new[]
            {  "StudentEnquiryMaster", "CreateStudentEnquiry", "StudentEnquiryFollowUp", "StudentAdmissionMaster", "CreateStudentAdmission", "StudentList", "StudentFollowUp", "StudentFeeReceipt" }.Contains(action);
            bool isStudentExam = new[]
            {  "CoursequestionView", "QuestionBank", "ScheduleExam", "ScheduleExamAdd", "ViewHallTicketExam", "HallTicketGenerate", "ReExamHallTicketGenerate", "PrintHallTicket", "ManageExamResult", "GenerateSecureCode" }.Contains(action);
            bool isLibrary = new[]
            {  "BookCategory", "BookSource", "BookMaster", "CreateBookMaster"}.Contains(action);
            bool isEvent = new[]
            {  "FunctionEventType", "FunctionEventDetail"}.Contains(action);
            string[] cookies =
            {  "UserID", "UserName","UserCategory" };
            string userName = "";
            if (Request.Cookies["UserName"] != null)
            {
                userName = Request.Cookies["UserName"].Value;
            }

            string userCategory = "";

            if (Request.Cookies["UserCategory"] != null)
            {
                userCategory = Request.Cookies["UserCategory"].Value;
            }

            string activeBranchName = "";
            if (Request.Cookies["BranchName"] != null && !string.IsNullOrEmpty(Request.Cookies["BranchName"].Value))
            {
                try { activeBranchName = System.Web.HttpUtility.UrlDecode(Request.Cookies["BranchName"].Value); } catch { activeBranchName = Request.Cookies["BranchName"].Value; }
            }

        }
        @using System.Configuration
        @using System.Data.SqlClient
        @{
            string profilePhoto = "~/Content/Admin/assets/images/admin.png";
            if (Request.Cookies["UserID"] != null)
            {
                using (SqlConnection con = new SqlConnection(
                    ConfigurationManager.ConnectionStrings["con"].ConnectionString))
                {
                    con.Open();

                    SqlCommand cmd = new SqlCommand(
                        "SELECT ProfilePhoto FROM UserMaster WHERE UserID=@UserID", con);

                    cmd.Parameters.AddWithValue("@UserID",
                        Convert.ToInt32(Request.Cookies["UserID"].Value));

                    object obj = cmd.ExecuteScalar();

                    if (obj != null &&
                        obj != DBNull.Value &&
                        !string.IsNullOrWhiteSpace(obj.ToString()))
                    {
                        profilePhoto = "~/Content/Upload/UserProfilePhoto/" + obj.ToString();
                    }
                }
            }
        }
