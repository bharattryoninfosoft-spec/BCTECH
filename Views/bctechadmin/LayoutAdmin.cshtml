    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        document.getElementById("currentYear").textContent = new Date().getFullYear();
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };

        function logout() {

            $.ajax({

                type: "POST",
                url: "/bctechadmin/Logout",
                success: function () {
                    console.log("Logout Success");
                    window.location.href = "/bctechadmin/index";
                },
                error: function () {
                    console.log("Logout Error");
                }
            });

        }

        function loadHeaderReminderBadges() {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetHeaderReminderCounts",
                dataType: "json",
                success: function (res) {
                    if (res && res.Status) {
                        // 1. Birthday Badge & Dropdown
                        if (res.BirthdayCount > 0) {
                            $("#hdrBirthdayBadge").text(res.BirthdayCount).show();
                            $("#hdrBdayDropdownBadge").text(res.BirthdayCount + " Upcoming").show();
                        } else {
                            $("#hdrBirthdayBadge").hide();
                            $("#hdrBdayDropdownBadge").text("0");
                        }

                        if (res.BirthdayList && res.BirthdayList.length > 0) {
                            var bHtml = '';
                            res.BirthdayList.forEach(function (item) {
                                bHtml += '<div class="d-flex align-items-center p-2 rounded mb-1 border-bottom border-light hover-bg" style="cursor: pointer;" onclick="window.location.href=\'/bctechadmin/StudentBirthdayReminders\'">';
                                bHtml += '  <img src="' + item.Photo + '" class="rounded-circle me-3 flex-shrink-0" style="width: 44px; height: 44px; object-fit: cover; border: 2px solid #fce7f3;" onerror="this.src=\'/Content/Admin/assets/images/no-image.png\'" />';
                                bHtml += '  <div class="flex-grow-1 overflow-hidden">';
                                bHtml += '      <div class="fw-semibold text-dark text-truncate fs-13" title="' + item.StudentName + '">' + item.StudentName + '</div>';
                                bHtml += '      <div class="text-muted fs-11 mt-1 d-flex align-items-center gap-1">';
                                bHtml += '          <span>' + item.Age + ' Year Old</span>';
                                if (item.Gender && item.Gender !== 'N/A') {
                                    bHtml += '      <span>&bull; ' + item.Gender + '</span>';
                                }
                                bHtml += '      </div>';
                                bHtml += '  </div>';
                                bHtml += '  <span class="badge ' + (item.StatusBadgeClass || 'bg-secondary') + ' rounded-pill fs-10 px-2 py-1 ms-2 flex-shrink-0">' + item.StatusText + '</span>';
                                bHtml += '</div>';
                            });
                            $("#hdrBdayDropdownList").html(bHtml);
                        } else {
                            $("#hdrBdayDropdownList").html('<div class="text-center text-muted py-4 fs-13"><i class="material-symbols-outlined fs-24 d-block mb-1 text-secondary">cake</i>No birthdays in next 7 days</div>');
                        }

                        // 2. Remaining Fees Badge & Dropdown
                        if (res.FeesDueCount > 0) {
                            $("#hdrFeesBadge").text(res.FeesDueCount).show();
                            $("#hdrFeesDropdownBadge").text(res.FeesDueCount + " Due").show();
                        } else {
                            $("#hdrFeesBadge").hide();
                            $("#hdrFeesDropdownBadge").text("0");
                        }

                        if (res.FeesList && res.FeesList.length > 0) {
                            var fHtml = '';
                            res.FeesList.forEach(function (item) {
                                fHtml += '<div class="d-flex align-items-center p-2 rounded mb-1 border-bottom border-light hover-bg" style="cursor: pointer;" onclick="window.location.href=\'/bctechadmin/StudentFeesReminders\'">';
                                fHtml += '  <img src="' + item.Photo + '" class="rounded-circle me-3 flex-shrink-0" style="width: 44px; height: 44px; object-fit: cover; border: 2px solid #d1fae5;" onerror="this.src=\'/Content/Admin/assets/images/no-image.png\'" />';
                                fHtml += '  <div class="flex-grow-1 overflow-hidden">';
                                fHtml += '      <div class="fw-semibold text-dark text-truncate fs-13" title="' + item.StudentName + '">' + item.StudentName + '</div>';
                                fHtml += '      <div class="text-danger fw-bold fs-12 mt-1">&#8377; ' + item.BalanceFee.toLocaleString('en-IN') + ' Due</div>';
                                fHtml += '      <div class="text-muted fs-11 text-truncate">' + item.CourseTitle + '</div>';
                                fHtml += '  </div>';
                                fHtml += '  <span class="badge ' + (item.StatusBadgeClass || 'bg-danger') + ' rounded-pill fs-10 px-2 py-1 ms-2 flex-shrink-0">' + item.StatusText + '</span>';
                                fHtml += '</div>';
                            });
                            $("#hdrFeesDropdownList").html(fHtml);
                        } else {
                            $("#hdrFeesDropdownList").html('<div class="text-center text-muted py-4 fs-13"><i class="material-symbols-outlined fs-24 d-block mb-1 text-success">check_circle</i>No remaining fees due</div>');
                        }
                    }
                }
            });
        }

        function updateTopNavbarBranch() {
            var match = document.cookie.match(new RegExp('(^| )BranchName=([^;]+)'));
            if (match && match[2]) {
                var bName = decodeURIComponent(match[2]);
                if (bName) {
                    $("#hdrActiveBranchName").text(bName);
                }
            }
        }

        $(document).ready(function () {
            updateTopNavbarBranch();
            loadHeaderReminderBadges();
        });

    </script>
    @RenderSection("Scripts", required: false)
