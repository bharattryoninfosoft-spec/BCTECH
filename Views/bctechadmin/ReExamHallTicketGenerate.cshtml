@model BCTECHERP.Models.HallTicket
@{
    ViewBag.Title = "Re Exam Generate Hall Ticket";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
    ViewData["ParentMenu"] = "Student Exam";
    ViewData["PageTitle"] = "Re Exam Generate Hall Ticket";
}

<style>
    .card-custom-header {
        background-color: #2f80ed !important;
        color: #ffffff !important;
        padding: 12px 20px;
        font-weight: 600;
        font-size: 15px;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    .btn-purple {
        background-color: #6f42c1 !important;
        border-color: #6f42c1 !important;
        color: #ffffff !important;
        transition: all 0.2s ease-in-out;
    }
    .btn-purple:hover {
        background-color: #59359a !important;
        box-shadow: 0 4px 8px rgba(111, 66, 193, 0.3);
    }

    .btn-save-view {
        background-color: #00c292 !important;
        border-color: #00c292 !important;
        color: #ffffff !important;
        transition: all 0.2s ease-in-out;
    }
    .btn-save-view:hover {
        background-color: #00a87e !important;
        box-shadow: 0 4px 8px rgba(0, 194, 146, 0.3);
    }

    .btn-back-coral {
        background-color: #fb9678 !important;
        border-color: #fb9678 !important;
        color: #ffffff !important;
        transition: all 0.2s ease-in-out;
    }
    .btn-back-coral:hover {
        background-color: #e58265 !important;
        box-shadow: 0 4px 8px rgba(251, 150, 120, 0.3);
    }

    #tblStudentsRecords {
        table-layout: auto !important;
        width: 100% !important;
    }

    #tblStudentsRecords th {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding: 10px 12px;
        white-space: nowrap !important;
        overflow: visible !important;
        text-overflow: unset !important;
    }
    #tblStudentsRecords td {
        font-size: 13px;
        color: #334155;
        padding: 10px 12px;
        vertical-align: middle;
        white-space: nowrap !important;
        overflow: visible !important;
        text-overflow: unset !important;
    }

    #tblStudentsRecords th:nth-child(2),
    #tblStudentsRecords td:nth-child(2) {
        min-width: 240px !important;
        white-space: nowrap !important;
    }

    body[data-theme="dark"] #tblStudentsRecords th {
        background-color: #1e293b !important;
        color: #94a3b8 !important;
        border-bottom-color: #334155 !important;
    }

    body[data-theme="dark"] #tblStudentsRecords td {
        color: #e2e8f0 !important;
        border-bottom-color: #334155 !important;
    }

    .filled-in {
        cursor: pointer;
        width: 16px;
        height: 16px;
    }
</style>

<!-- Top Title & Breadcrumbs -->
<div class="row g-4">
    <div class="col-12">
        <form method="post" action="/bctechAdmin/ReExamHallTicketGenerate" id="frmReExamHallTicket" onsubmit="return false;">

            <!-- Hidden Inputs -->
            <input type="hidden" id="branch_id" name="branch_id" value="@(ViewBag.SelectedBranchId ?? "0")" />
            <input type="hidden" name="all_Student_id" id="all_Student_id" value="" />
            <input type="hidden" name="SecureCode" id="SecureCode" value="0" />

            <div class="row g-4">
                <!-- Left Column: Form Controls -->
                <div class="col-lg-4 col-md-4">
                    <div class="card bg-white rounded-10 border border-light shadow-sm">
                        <div class="card-custom-header d-flex align-items-center">
                            Re Exam Generate Hall Ticket
                        </div>
                        <div class="card-body p-4">

                            <!-- Schedule Exam Dropdown -->
                            <div class="mb-3">
                                <label class="form-label text-secondary fs-13 fw-semibold">Select Schedule Exam</label>
                                @if (ViewBag.DropDownValue != null)
                                {
                                    @Html.DropDownList("Schedule_Exam_Id", (SelectList)ViewBag.DropDownValue, new { @class = "form-select", @id = "Schedule_Exam_Id", onchange = "OnCourseSelected(this.value)" })
                                }
                                else
                                {
                                    <select class="form-select" id="Schedule_Exam_Id" name="Schedule_Exam_Id" onchange="OnCourseSelected(this.value)">
                                        <option value="0">Select Schedule Exam</option>
                                    </select>
                                }
                            </div>

                            <!-- Previous Exam Date Dropdown -->
                            <div class="mb-4">
                                <label class="form-label text-secondary fs-13 fw-semibold">Previous Exam Date</label>
                                <div id="DDLScheduleExamId">
                                    <select class="form-select" id="PreviousExamDate" name="PreviousExamDate">
                                        <option value="0">Select Previous Exam Date</option>
                                    </select>
                                </div>
                            </div>

                            <!-- View Students Details Button -->
                            <div class="mb-4">
                                <button type="button" id="btnViewStudents" class="btn btn-purple w-100 py-2 fw-medium rounded-6" onclick="loadStudentsRecordsAjax();">
                                    <i class="fa fa-check me-1"></i> <span id="btnViewStudentsText">View Students Details</span>
                                </button>
                            </div>

                            <!-- Save & View / Back Buttons -->
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" id="btnSave" class="btn btn-save-view px-3 py-2 fw-medium rounded-6" onclick="saveReExamHallTicketsAjax();">
                                    <i class="fa fa-eye me-1"></i> Save & View
                                </button>
                                <a href="/bctechAdmin/ViewHallTicketExam" class="btn btn-back-coral px-3 py-2 fw-medium rounded-6">
                                    <i class="fa fa-arrow-left me-1"></i> Back
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Right Column: Students Records Table -->
                <div class="col-lg-8 col-md-8">
                    <div class="card bg-white rounded-10 border border-light shadow-sm">
                        <div class="card-custom-header d-flex align-items-center">
                            Students Records
                        </div>
                        <div class="card-body p-4">

                            <!-- Total Selected Students Counter -->
                            <p id="TotalSelect" class="text-secondary fs-13 fw-semibold mb-3">Total Selected Students : <span id="lblSelectedCount" class="text-primary fw-bold">0</span></p>

                            <!-- Students Table -->
                            <div class="table-responsive" style="max-height: 520px; overflow-y: auto; overflow-x: auto;">
                                <table class="table table-hover align-middle border-bottom w-100" id="tblStudentsRecords">
                                    <thead>
                                        <tr>
                                            <th style="width: 50px; text-align: center;">
                                                <input type="checkbox" id="chkSelectAll" class="form-check-input" />
                                            </th>
                                            <th style="min-width: 240px;">Student Name</th>
                                            <th style="min-width: 130px;">Enrollment</th>
                                            <th style="min-width: 120px;">Mobile No</th>
                                            <th style="min-width: 110px;">Total Fees</th>
                                            <th style="min-width: 110px;">Paid Fees</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th style="text-align: center;">Select</th>
                                            <th>Student Name</th>
                                            <th>Enrollment</th>
                                            <th>Mobile No</th>
                                            <th>Total Fees</th>
                                            <th>Paid Fees</th>
                                        </tr>
                                    </tfoot>
                                    <tbody id="tblStudentsBody">
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                Select Schedule Exam and Previous Exam Date, then click "View Students Details".
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        function getCookie(name) {
            var match = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
            return match ? decodeURIComponent(match[3]) : null;
        }

        $(document).ready(function () {
            // Auto bind branch_id from cookie if available
            var cBranch = getCookie('BranchID');
            if (cBranch && cBranch !== "0") {
                $('#branch_id').val(cBranch);
            }

            // Master Select All checkbox toggle
            $('#chkSelectAll').on('change', function () {
                var isChecked = $(this).is(':checked');
                var ids = "";
                var total = 0;
                var chkRows = $("#tblStudentsBody input[type='checkbox']");

                chkRows.each(function () {
                    $(this).prop('checked', isChecked);
                    if (isChecked && $(this).val()) {
                        ids += $(this).val() + '|';
                        total += 1;
                    }
                });

                $('#lblSelectedCount').text(total);
                $('#all_Student_id').val(ids);
            });
        });

        function OnCourseSelected(examId) {
            var code = examId;
            var branchId = $('#branch_id').val() || getCookie('BranchID') || 0;

            // Reset dependent elements
            $('#PreviousExamDate').html('<option value="0">Loading previous dates...</option>');
            $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center py-4 text-muted">Select Schedule Exam and Previous Exam Date, then click "View Students Details".</td></tr>');
            $('#all_Student_id').val('');
            $('#lblSelectedCount').text('0');
            $('#chkSelectAll').prop('checked', false);

            if (!code || code == 0 || code == "0") {
                $('#SecureCode').val('0');
                $('#PreviousExamDate').html('<option value="0">Select Previous Exam Date</option>');
                return;
            }

            $.ajax({
                type: "POST",
                url: "/bctechAdmin/GetPreviousExamDates",
                data: { scheduleExamId: code, branchId: branchId },
                dataType: "json",
                success: function (data) {
                    var list = [];
                    if (data && data.dates && Array.isArray(data.dates)) {
                        list = data.dates;
                    } else if (data && data.data && Array.isArray(data.data)) {
                        list = data.data;
                    }

                    var markup = "<option value='0'>Select Previous Exam Date</option>";
                    if (list && list.length > 0) {
                        for (var i = 0; i < list.length; i++) {
                            var dVal = list[i];
                            markup += "<option value='" + dVal + "'>" + dVal + "</option>";
                        }
                    }
                    $('#PreviousExamDate').html(markup);
                },
                error: function () {
                    $('#PreviousExamDate').html('<option value="0">Select Previous Exam Date</option>');
                }
            });
        }

        function SelectCheck(chk) {
            var ids = "";
            var total = 0;
            var chkRows = $("#tblStudentsBody input[type='checkbox']");

            chkRows.each(function () {
                if ($(this).is(':checked') && $(this).val()) {
                    ids += $(this).val() + '|';
                    total += 1;
                }
            });

            $('#lblSelectedCount').text(total);
            $('#all_Student_id').val(ids);

            var totalCheckboxes = chkRows.length;
            $('#chkSelectAll').prop('checked', totalCheckboxes > 0 && totalCheckboxes === total);
        }

        function validateStudentRecords() {
            var seId = $('#Schedule_Exam_Id').val();
            if (!seId || seId === "0" || seId === "") {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Warning', 'Please select a Schedule Exam first.', 'warning');
                } else {
                    alert('Please select a Schedule Exam first.');
                }
                $('#Schedule_Exam_Id').focus();
                return false;
            }
            var prevDate = $('#PreviousExamDate').val();
            if (!prevDate || prevDate === "0" || prevDate === "") {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Warning', 'Please select a Previous Exam Date first.', 'warning');
                } else {
                    alert('Please select a Previous Exam Date first.');
                }
                $('#PreviousExamDate').focus();
                return false;
            }
            return true;
        }

        function loadStudentsRecordsAjax() {
            if (!validateStudentRecords()) {
                return false;
            }

            var seId = $('#Schedule_Exam_Id').val();
            var prevDate = $('#PreviousExamDate').val();
            var branchId = $('#branch_id').val() || getCookie('BranchID') || 0;
            var $btn = $('#btnViewStudents');
            var $btnText = $('#btnViewStudentsText');
            var originalText = $btnText.text();

            $btn.prop('disabled', true);
            $btnText.html('<i class="fa fa-spinner fa-spin me-1"></i> Loading...');
            $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center py-4 text-secondary"><i class="fa fa-spinner fa-spin me-2"></i> Loading student records...</td></tr>');

            $.ajax({
                type: "POST",
                url: "/bctechAdmin/GetStudentsForReExam",
                data: {
                    scheduleExamId: seId,
                    previousExamDate: prevDate,
                    branchId: branchId
                },
                dataType: "json",
                success: function (res) {
                    $btn.prop('disabled', false);
                    $btnText.text(originalText);

                    if (res && res.status) {
                        if (res.secureCode) {
                            $('#SecureCode').val(res.secureCode);
                        }

                        if (!res.students || res.students.length === 0) {
                            $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center text-muted py-4">No eligible students found for selected previous exam date.</td></tr>');
                            $('#lblSelectedCount').text('0');
                            $('#all_Student_id').val('');
                            $('#chkSelectAll').prop('checked', false);
                            return;
                        }

                        var html = '';
                        var ids = '';
                        var count = res.students.length;

                        $.each(res.students, function (i, s) {
                            var chkId = 'chk_reexam_' + (i + 1);
                            ids += s.studentId + '|';

                            html += '<tr>';
                            html += '<td style="text-align: center;"><input type="checkbox" id="' + chkId + '" class="filled-in form-check-input" value="' + s.studentId + '" checked="checked" onclick="SelectCheck(this);" /></td>';
                            html += '<td style="min-width:240px; white-space:nowrap;">' + (s.studentName || '') + '</td>';
                            html += '<td style="min-width:130px; white-space:nowrap;">' + (s.enrollment || '') + '</td>';
                            html += '<td style="min-width:120px; white-space:nowrap;">' + (s.mobileNo || '') + '</td>';
                            html += '<td style="min-width:110px; white-space:nowrap;">' + (s.totalFees || '₹ 0.00') + '</td>';
                            html += '<td style="min-width:110px; white-space:nowrap;">' + (s.paidFees || '₹ 0.00') + '</td>';
                            html += '</tr>';
                        });

                        $('#tblStudentsBody').html(html);
                        $('#all_Student_id').val(ids);
                        $('#lblSelectedCount').text(count);
                        $('#chkSelectAll').prop('checked', true);
                    } else {
                        $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center text-muted py-4">' + (res.message || 'No records found.') + '</td></tr>');
                        $('#lblSelectedCount').text('0');
                        $('#all_Student_id').val('');
                        $('#chkSelectAll').prop('checked', false);
                    }
                },
                error: function () {
                    $btn.prop('disabled', false);
                    $btnText.text(originalText);
                    $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center py-4 text-danger">Failed to load student records. Please try again.</td></tr>');
                }
            });
        }

        function saveReExamHallTicketsAjax() {
            var seId = $('#Schedule_Exam_Id').val();
            var bId = $('#branch_id').val() || getCookie('BranchID') || 0;
            var scCode = $('#SecureCode').val() || 0;
            var sIds = $('#all_Student_id').val();

            if (!seId || seId === "0" || seId === "") {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Warning', 'Please select a Schedule Exam.', 'warning');
                } else {
                    alert('Please select a Schedule Exam.');
                }
                return false;
            }

            var ids = (sIds || '').split('|').filter(function (x) { return x.trim() !== ''; });
            if (ids.length === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Notice', 'Please select at least one student before saving.', 'info');
                } else {
                    alert('Please select at least one student before saving.');
                }
                return false;
            }

            var $btn = $('#btnSave');
            var origHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i> Saving...');

            $.ajax({
                url: '/bctechAdmin/SaveHallTicketAjax',
                type: 'POST',
                data: {
                    scheduleExamId: seId,
                    branchId: bId,
                    secureCode: scCode,
                    studentIds: sIds
                },
                dataType: 'json',
                success: function (res) {
                    $btn.prop('disabled', false).html(origHtml);
                    if (res && res.status) {
                        window.location.href = res.redirectUrl || '/bctechAdmin/ViewHallTicketExam';
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire('Error', res.message || 'Failed to save hall tickets.', 'error');
                        } else {
                            alert(res.message || 'Failed to save hall tickets.');
                        }
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html(origHtml);
                    alert('Server error occurred while saving.');
                }
            });
        }
    </script>
}
