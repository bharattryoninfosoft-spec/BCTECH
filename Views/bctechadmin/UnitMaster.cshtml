@{
    ViewBag.Title = "UnitMaster";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<div class="card bg-white rounded-10 border border-white mb-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">

        <form class="table-src-form position-relative m-0">

            <input type="text"
                   id="txtSearch"
                   class="form-control"
                   placeholder="Search Unit Name...">

            <i class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y">
                search
            </i>

        </form>

        <!--
    <a href="javascript:void(0);"
       class="text-primary fs-16 text-decoration-none"
       onclick="AddUnit()">
        + Add Supplier
    </a>-->

        <a href="javascript:void(0);" class="btn btn-primary text-white" onclick="AddUnit()">
            <i class="ri-add-line me-1"></i> Add Unit
        </a>


    </div>

    <div class="default-table-area style-two">

        <div class="table-responsive">

            <table class="table align-middle" id="tblUnit">

                <thead>

                    <tr>

                        <th width="100">Sr No</th>

                        <th>Unit Name</th>

                        <th>Short Name</th>

                        <th width="100">Status</th>

                        <th width="150" class="text-center">Action</th>

                    </tr>

                </thead>

                <tbody>
                </tbody>

            </table>

        </div>

    </div>

    <div class="p-3">

        <div id="pagination"></div>

    </div>

</div>

<!-- =================== Modal =================== -->

<div class="modal fade" id="UnitModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    Unit Master

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="hfUnitID"
                       value="0" />

                <div class="row">

                    <!-- Unit Name -->

                    <div class="col-md-8 mb-3">

                        <label class="form-label">

                            Unit Name
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               id="txtUnitName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter Unit Name">

                    </div>

                    <!-- Short Name -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label">

                            Short Name
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               id="txtShortName"
                               class="form-control"
                               maxlength="20"
                               placeholder="KG">

                    </div>

                    <!-- Status -->

                    <div class="col-md-12">

                        <div class="form-check form-switch">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="chkIsActive"
                                   checked>

                            <label class="form-check-label">

                                Active

                            </label>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

                <button type="button"
                        id="btnSaveUnit"
                        class="btn btn-primary"
                        onclick="SaveUnit()">

                    Save

                </button>

            </div>

        </div>

    </div>

</div>
@section Scripts{
    <script>

        var pageNumber = 1;

        $(document).ready(function () {

            GetUnitList(1);

            $("#txtSearch").keyup(function () {
                GetUnitList(1);
            });

        });
        function GetData(pageNumber) {
            GetUnitList(pageNumber);
        }
        function AddUnit() {

            ClearUnitForm();

            ShowUnitModal();

        }

        function ShowUnitModal() {

            var modal = bootstrap.Modal.getOrCreateInstance(
                document.getElementById("UnitModal")
            );

            modal.show();

        }

        function HideUnitModal() {

            var modal = bootstrap.Modal.getOrCreateInstance(
                document.getElementById("UnitModal")
            );

            modal.hide();

        }

        function ClearUnitForm() {

            $("#hfUnitID").val(0);

            $("#txtUnitName").val("").prop("readonly", false);

            $("#txtShortName").val("").prop("readonly", false);

            $("#chkIsActive").prop("checked", true);

            $("#chkIsActive").prop("disabled", false);

            $("#btnSaveUnit").prop("disabled", false);

        }

        function GetUnitList(PageNo) {

            pageNumber = PageNo;

            $.ajax({

                type: "POST",

                url: "/bctechadmin/GetUnitList",

                data: {

                    SearchText: $("#txtSearch").val(),
                    PageNumber: PageNo

                },

                success: function (response) {

                    var html = "";

                    if (response.Status == 1 && response.Data.length > 0) {

                        $.each(response.Data, function (index, item) {

                            var sr = ((PageNo - 1) * 10) + index + 1;

                            html += "<tr>";

                            html += "<td>" + sr + "</td>";

                            html += "<td>" + item.UnitName + "</td>";

                            html += "<td>" + item.ShortName + "</td>";

                            if (item.IsActive) {
                                html += "<td><span class='badge bg-success'>Active</span></td>";
                            }
                            else {
                                html += "<td><span class='badge bg-danger'>Inactive</span></td>";
                            }
                            html += "<td class='text-center'>";
                            html += "<a href='javascript:void(0)' class='text-info me-2' onclick='ViewUnit(" + item.UnitID + ")'>";
                            html += "<i class='ri-eye-line fs-18'></i>";
                            html += "</a>";
                            html += "<a href='javascript:void(0)' class='text-primary me-2' onclick='EditUnit(" + item.UnitID + ")'>";
                            html += "<i class='ri-edit-line fs-18'></i>";
                            html += "</a>";
                            html += "<a href='javascript:void(0)' class='text-danger' onclick='DeleteUnit(" + item.UnitID + ")'>";
                            html += "<i class='ri-delete-bin-line fs-18'></i>";
                            html += "</a>";
                            html += "</td>";
                            html += "</tr>";

                        });

                    }
                    else {

                        html = "<tr>";
                        html += "<td colspan='5' class='text-center text-danger'>";
                        html += "No Record Found";
                        html += "</td>";
                        html += "</tr>";

                    }

                    $("#tblUnit tbody").html(html);

                    $("#pagination").html(response.Pagination);

                },

                error: function () {

                    toastr.error("Unable to load data.");

                }

            });

        }

        function EditUnit(id) {

            ClearUnitForm();

            $.ajax({

                type: "POST",

                url: "/bctechadmin/GetUnitByID",

                data: {
                    UnitID: id
                },

                success: function (response) {

                    if (response.Status == 1) {

                        var item = response.Data;

                        $("#hfUnitID").val(item.UnitID);

                        $("#txtUnitName").val(item.UnitName);

                        $("#txtShortName").val(item.ShortName);

                        $("#chkIsActive").prop("checked", item.IsActive);

                        $("#btnSaveUnit").prop("disabled", false);

                        ShowUnitModal();

                    }
                    else {

                        toastr.error(response.Message);

                    }

                },

                error: function () {

                    toastr.error("Unable to load record.");

                }

            });

        }

        function ViewUnit(id) {

            ClearUnitForm();

            $.ajax({

                type: "POST",

                url: "/bctechadmin/GetUnitByID",

                data: {
                    UnitID: id
                },

                success: function (response) {

                    if (response.Status == 1) {

                        var item = response.Data;

                        $("#hfUnitID").val(item.UnitID);

                        $("#txtUnitName").val(item.UnitName).prop("readonly", true);

                        $("#txtShortName").val(item.ShortName).prop("readonly", true);

                        $("#chkIsActive").prop("checked", item.IsActive);
                        $("#chkIsActive").prop("disabled", true);

                        $("#btnSaveUnit").prop("disabled", true);

                        ShowUnitModal();

                    }
                    else {

                        toastr.error(response.Message);

                    }

                },

                error: function () {

                    toastr.error("Unable to load record.");

                }

            });

        }

        function SaveUnit() {

            var UnitID = $("#hfUnitID").val();

            var UnitName = $.trim($("#txtUnitName").val());

            var ShortName = $.trim($("#txtShortName").val());

            var IsActive = $("#chkIsActive").is(":checked");

            // Validation

            if (UnitName == "") {

                toastr.warning("Please Enter Unit Name.");

                $("#txtUnitName").focus();

                return;

            }

            if (ShortName == "") {

                toastr.warning("Please Enter Short Name.");

                $("#txtShortName").focus();

                return;

            }

            $("#btnSaveUnit").prop("disabled", true);

            var formData = new FormData();

            formData.append("UnitID", UnitID);
            formData.append("UnitName", UnitName);
            formData.append("ShortName", ShortName);
            formData.append("IsActive", IsActive);

            $.ajax({

                type: "POST",

                url: "/bctechadmin/SaveUnit",

                data: formData,

                processData: false,

                contentType: false,

                success: function (response) {

                    $("#btnSaveUnit").prop("disabled", false);

                    if (response.Status == 1) {

                        toastr.success(response.Message);

                        HideUnitModal();

                        GetUnitList(pageNumber);

                    }
                    else {

                        toastr.error(response.Message);

                    }

                },

                error: function () {

                    $("#btnSaveUnit").prop("disabled", false);

                    toastr.error("Something went wrong.");

                }

            });

        }

        function DeleteUnit(UnitID) {

            Swal.fire({

                title: "Are you sure?",

                text: "You won't be able to recover this record!",

                icon: "warning",

                showCancelButton: true,

                confirmButtonColor: "#3085d6",

                cancelButtonColor: "#d33",

                confirmButtonText: "Yes, Delete it!"

            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({

                        type: "POST",

                        url: "/bctechadmin/DeleteUnit",

                        data: {
                            UnitID: UnitID
                        },

                        success: function (response) {

                            if (response.Status == 1) {

                                toastr.success(response.Message);

                                GetUnitList(pageNumber);

                            }
                            else {

                                toastr.error(response.Message);

                            }

                        },

                        error: function () {

                            toastr.error("Unable to delete record.");

                        }

                    });

                }

            });

        }

    </script>
    }