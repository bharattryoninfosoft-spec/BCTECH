                <span class="material-symbols-outlined">search</span>
            </div>
        </form>


        <a href="/bctechadmin/CreateFunctionEvent" class="btn btn-primary text-white">
            <i class="ri-add-line"></i> Add Function / Event
        </a>


    </div>


