@{
    ViewBag.Title = "Student Charge Master";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}


<style>
    #tblStudentCharge {
        width: 100%;
        table-layout: fixed;
    }

        #tblStudentCharge th,
        #tblStudentCharge td {
            padding: 6px 8px !important;
            font-size: 12px !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            /* Column Width */
            #tblStudentCharge th:nth-child(1),
            #tblStudentCharge td:nth-child(1) {
                width: 40px;
            }

            #tblStudentCharge th:nth-child(2),
            #tblStudentCharge td:nth-child(2) {
                width: 120px;
            }

            #tblStudentCharge th:nth-child(3),
            #tblStudentCharge td:nth-child(3) {
                width: 90px;
            }

            #tblStudentCharge th:nth-child(4),
            #tblStudentCharge td:nth-child(4) {
                width: 140px;
            }

            #tblStudentCharge th:nth-child(5),
            #tblStudentCharge td:nth-child(5) {
                width: 80px;
            }

            #tblStudentCharge th:nth-child(6),
            #tblStudentCharge td:nth-child(6) {
                width: 90px;
            }

            #tblStudentCharge th:nth-child(7),
            #tblStudentCharge td:nth-child(7) {
                width: 75px;
            }

            /* Action Icons */
            #tblStudentCharge td:last-child a {
                margin-right: 5px !important;
            }

            #tblStudentCharge td:last-child i {
                font-size: 15px !important;
            }
</style>


<div class="card bg-white rounded-10 border border-white mb-4">

    <!-- Header & Search Controls -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">

        <form class="table-src-form position-relative m-0" onsubmit="return false;">
            <input type="text" id="txtSearch" class="form-control w-350" placeholder="Search Student Charge Name or Description...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>

        <a href="javascript:void(0);" class="btn btn-primary text-white" onclick="OpenStudentChargeModal()">
            <i class="ri-add-line me-1"></i> Add Student Charge
        </a>

    </div>

    <!-- Data Table Area -->
    <div class="default-table-area mx-minus-1 table-contact-list">

        <div class="table-responsive p-3 pt-0">
            <table class="table table-hover align-middle border-bottom mb-0" id="tblStudentCharge">
                <thead class="bg-light">
                    <tr class="text-secondary fs-13">
                        <th width="60" class="text-center">SR</th>
                        <th>Charge Name</th>
                        <th width="150" class="text-end">Amount (&#8377;)</th>
                        <th>Description</th>
                        <th width="110" class="text-center">Status</th>
                        <th width="130">Created Date</th>
                        <th width="120" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="tblStudentChargeBody">
                    <!-- Dynamic Rows -->
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <div class="col-lg-12">
            <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                <span class="fs-15 text-muted" id="lblShowing">Showing 0 to 0 of 0 entries</span>

                <nav class="custom-pagination" aria-label="Page navigation">
                    <ul class="pagination mb-0 justify-content-center" id="pagination"></ul>
                </nav>
            </div>
        </div>

    </div>

</div>

<!-- Add / Edit Modal -->
<div class="modal fade" id="StudentChargeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-light">
                <h5 class="modal-title" id="modalTitle">Student Charge</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <input type="hidden" id="hfStudentChargeID" value="0" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Charge Name <span class="text-danger">*</span></label>
                    <input type="text" id="txtChargeName" class="form-control" maxlength="200" placeholder="e.g. Admission, Exam, Certificate" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Charge Amount (&#8377;) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" id="txtChargeAmount" class="form-control" placeholder="Enter Charge Amount (e.g. 500.00)" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea id="txtChargeDescription" class="form-control" rows="3" placeholder="Enter optional details or notes..."></textarea>
                </div>

                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="chkIsActive" checked>
                    <label class="form-check-input-label fw-semibold" for="chkIsActive">Active Status</label>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary text-white" onclick="SaveStudentCharge()">Save Charge</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        var studentCharges = [];
        var filteredStudentCharges = [];
        var currentPage = 1;
        var pageSize = 10;

        $(document).ready(function () {
            GetStudentCharges();

            // Search Filter
            $("#txtSearch").on("keyup", function () {
                var search = $(this).val().toLowerCase().trim();
                filteredStudentCharges = studentCharges.filter(function (x) {
                    return (x.ChargeName || '').toLowerCase().includes(search) ||
                           (x.ChargeDescription || '').toLowerCase().includes(search);
                });
                currentPage = 1;
                BindGrid();
            });
        });

        // Fetch All Charges
        function GetStudentCharges() {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentChargeList",
                dataType: "json",
                beforeSend: function () {
                    $("#tblStudentChargeBody").html("<tr><td colspan='7' class='text-center py-4'><div class='spinner-border spinner-border-sm text-primary' role='status'></div></td></tr>");
                },
                success: function (data) {
                    studentCharges = data || [];
                    filteredStudentCharges = studentCharges;
                    BindGrid();
                },
                error: function () {
                    $("#tblStudentChargeBody").html("<tr><td colspan='7' class='text-center text-danger py-4'>Failed to load Student Charge data.</td></tr>");
                }
            });
        }

        // Render Grid & Pagination
        function BindGrid() {
            var totalRecords = filteredStudentCharges.length;
            var startIndex = (currentPage - 1) * pageSize;
            var pageData = filteredStudentCharges.slice(startIndex, startIndex + pageSize);

            var html = "";
            if (pageData.length > 0) {
                $.each(pageData, function (i, item) {
                    var srNo = startIndex + i + 1;
                    var amount = parseFloat(item.ChargeAmount || 0).toFixed(2);
                    var statusBadge = item.IsActive
                        ? "<span class='badge bg-success-subtle text-success fw-medium fs-12 px-2 py-1'><i class='ri-checkbox-circle-fill me-1'></i>Active</span>"
                        : "<span class='badge bg-danger-subtle text-danger fw-medium fs-12 px-2 py-1'><i class='ri-close-circle-fill me-1'></i>Inactive</span>";

                    html += "<tr>";
                    html += "<td class='text-center fw-bold text-muted fs-13'>" + srNo + "</td>";
                    html += "<td><strong class='text-dark fs-14'>" + (item.ChargeName || '-') + "</strong></td>";
                    html += "<td class='text-end fw-bold text-success fs-14'>&#8377; " + amount + "</td>";
                    html += "<td class='text-muted fs-13'>" + (item.ChargeDescription || '-') + "</td>";
                    html += "<td class='text-center'>" + statusBadge + "</td>";
                    html += "<td class='text-secondary fs-13'>" + (item.CreatedDateFormatted || '-') + "</td>";
                    html += "<td class='text-center'>";
                    html += "<a href='javascript:void(0);' onclick='EditStudentCharge(" + item.StudentChargeID + ")' class='me-2' title='Edit'><i class='ri-edit-box-line text-primary fs-16'></i></a>";
                    html += "<a href='javascript:void(0);' onclick='DeleteStudentCharge(" + item.StudentChargeID + ")' title='Delete'><i class='ri-delete-bin-line text-danger fs-16'></i></a>";
                    html += "</td>";
                    html += "</tr>";
                });
                $("#tblStudentChargeBody").html(html);
                RenderPagination(totalRecords);
            } else {
                $("#tblStudentChargeBody").html("<tr><td colspan='7' class='text-center text-muted py-4'>No Student Charge records found.</td></tr>");
                $("#lblShowing").text("Showing 0 to 0 of 0 entries");
                $("#pagination").empty();
            }
        }

        // Pagination HTML generator
        function RenderPagination(totalRecords) {
            var totalPages = Math.ceil(totalRecords / pageSize);
            var start = totalRecords === 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
            var end = Math.min(currentPage * pageSize, totalRecords);

            $("#lblShowing").text("Showing " + start + " to " + end + " of " + totalRecords + " entries");

            if (totalPages <= 1) {
                $("#pagination").empty();
                return;
            }

            var html = "";
            html += "<li class='page-item " + (currentPage === 1 ? "disabled" : "") + "'>";
            html += "<a class='page-link' href='javascript:void(0);' onclick='ChangePage(" + (currentPage - 1) + ")'>Previous</a>";
            html += "</li>";

            for (var i = 1; i <= totalPages; i++) {
                html += "<li class='page-item " + (i === currentPage ? "active" : "") + "'>";
                html += "<a class='page-link' href='javascript:void(0);' onclick='ChangePage(" + i + ")'>" + i + "</a>";
                html += "</li>";
            }

            html += "<li class='page-item " + (currentPage === totalPages ? "disabled" : "") + "'>";
            html += "<a class='page-link' href='javascript:void(0);' onclick='ChangePage(" + (currentPage + 1) + ")'>Next</a>";
            html += "</li>";

            $("#pagination").html(html);
        }

        function ChangePage(page) {
            currentPage = page;
            BindGrid();
        }

        // Open Modal for New Charge
        function OpenStudentChargeModal() {
            $("#hfStudentChargeID").val(0);
            $("#modalTitle").text("Add Student Charge");
            $("#txtChargeName").val("");
            $("#txtChargeAmount").val("");
            $("#txtChargeDescription").val("");
            $("#chkIsActive").prop("checked", true);
            $("#StudentChargeModal").modal("show");
        }

        // Save (Insert / Update) Student Charge
        function SaveStudentCharge() {
            var chargeName = $("#txtChargeName").val().trim();
            var chargeAmount = parseFloat($("#txtChargeAmount").val());
            var chargeDescription = $("#txtChargeDescription").val().trim();
            var isActive = $("#chkIsActive").is(":checked");

            if (!chargeName) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please Enter Charge Name' });
                return;
            }
            if (isNaN(chargeAmount) || chargeAmount < 0) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please Enter Valid Charge Amount' });
                return;
            }

            var model = {
                StudentChargeID: parseInt($("#hfStudentChargeID").val()),
                ChargeName: chargeName,
                ChargeAmount: chargeAmount,
                ChargeDescription: chargeDescription,
                IsActive: isActive
            };

            $.ajax({
                type: "POST",
                url: "/bctechadmin/SaveStudentCharge",
                data: model,
                success: function (res) {
                    if (res.Status) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved Successfully',
                            text: res.Message,
                            timer: 1500,
                            showConfirmButton: false
                        });
                        $("#StudentChargeModal").modal("hide");
                        GetStudentCharges();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: res.Message });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Server Error', text: 'An unexpected error occurred.' });
                }
            });
        }

        // Edit Student Charge
        function EditStudentCharge(id) {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentChargeByID",
                data: { id: id },
                success: function (res) {
                    if (res) {
                        $("#hfStudentChargeID").val(res.StudentChargeID);
                        $("#modalTitle").text("Edit Student Charge");
                        $("#txtChargeName").val(res.ChargeName);
                        $("#txtChargeAmount").val(res.ChargeAmount);
                        $("#txtChargeDescription").val(res.ChargeDescription || "");
                        $("#chkIsActive").prop("checked", res.IsActive);
                        $("#StudentChargeModal").modal("show");
                    }
                }
            });
        }

        // Delete Student Charge
        function DeleteStudentCharge(id) {
            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to delete this Student Charge record?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, Delete",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: "/bctechadmin/DeleteStudentCharge",
                        data: { id: id },
                        success: function (res) {
                            if (res.Status) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted',
                                    text: res.Message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                GetStudentCharges();
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: res.Message });
                            }
                        },
                        error: function () {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to delete record.' });
                        }
                    });
                }
            });
        }
    </script>
}
