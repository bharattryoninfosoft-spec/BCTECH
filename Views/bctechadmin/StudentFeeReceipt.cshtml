        // Helper Date Formatter
        function FormatJsonDate(dateStr) {
            if (!dateStr) return '-';
            var d = ParseDateObj(dateStr);
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            var year = d.getFullYear();
            var hours = d.getHours();
            var minutes = String(d.getMinutes()).padStart(2, '0');
            var ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            var strHours = String(hours).padStart(2, '0');
            return day + '/' + month + '/' + year + ' ' + strHours + ':' + minutes + ' ' + ampm;
        }

        function FormatDateForInput(dStr) {
            if (!dStr || dStr === '-') return '';
            var parts = dStr.split('/');
            if (parts.length === 3) {
                return parts[2] + '-' + parts[1].padStart(2, '0') + '-' + parts[0].padStart(2, '0');
            }
            return dStr;
        }

        function SaveNextDueDate(feesInstallmentId, newDateStr) {
            if (!feesInstallmentId || feesInstallmentId <= 0 || !newDateStr) return;
            $.ajax({
                type: "POST",
                url: "/bctechadmin/UpdateInstallmentDueDate",
                data: { feesInstallmentId: feesInstallmentId, dueDate: newDateStr },
                success: function (res) {
                    if (res && res.IsSuccess) {
                        if (currentInstallmentsList) {
                            $.each(currentInstallmentsList, function (i, item) {
                                if (item.FeesInstallmentID === feesInstallmentId) {
                                    var parts = newDateStr.split('-');
                                    if (parts.length === 3) {
                                        item.DueDate = parts[2] + '/' + parts[1] + '/' + parts[0];
                                    }
                                }
                            });
                        }
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000
                        });
                        Toast.fire({
                            icon: 'success',
                            title: 'Next Due Date updated!'
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: res.Message || 'Failed to update due date.' });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Error updating due date.' });
                }
            });
        }

        function ParseDateObj(dateVal) {
            if (typeof dateVal === 'string' && dateVal.indexOf('/Date(') !== -1) {
                var milli = parseInt(dateVal.replace(/\/Date\((.*?)\)\//, '$1'));
                return new Date(milli);
            }
            return new Date(dateVal);
        }

            function validateFloatKeyPress(el, evt) {
                var charCode = (evt.which) ? evt.which : event.keyCode;
                var number = el.value.split('.');
                if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
                    return false;
                }
                //just one dot (thanks ddlab)
                if (number.length > 1 && charCode == 46) {
                    return false;
                }
                //get the carat position
                var caratPos = getSelectionStart(el);
                var dotPos = el.value.indexOf(".");
                if (caratPos > dotPos && dotPos > -1 && (number[1].length > 6)) {
                    return false;
                }
                return true;
            }

            function getSelectionStart(o) {
                if (o.createTextRange) {
                    var r = document.selection.createRange().duplicate()
                    r.moveEnd('character', o.value.length)
                    if (r.text == '') return o.value.length
                    return o.value.lastIndexOf(r.text)
                } else return o.selectionStart
            }

    </script>
