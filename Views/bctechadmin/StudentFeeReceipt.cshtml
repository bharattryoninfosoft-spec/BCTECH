                    <!-- Invoice Top Header -->
                    <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-2">
                        <div>
                            <h3 id="printBranchName" class="fw-bold text-dark mb-1" style="font-size: 24px;">Branch</h3>
