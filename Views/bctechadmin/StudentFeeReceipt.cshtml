        // Edit Fee Receipt
        function EditFeeReceipt(id) {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentFeeReceiptByID",
                data: { id: id },
                success: function (res) {
                    $("#hfStudentFeeReceiptID").val(res.StudentFeeReceiptID);
                    $("#modalTitle").text("Edit Student Fee Receipt");

                    LoadStudentDropdown(res.StudentID, res.StudentID, function () {
                        var match = studentDropdownData.find(x => x.StudentID == res.StudentID);
                        if (match) {
                            $("#lblStudentName").text(match.StudentFullName || '-');
                            $("#lblStudentEnrollment").text(match.StudentEnrollmentNo || '-');
                            $("#lblStudentMobile").text(match.StudentMobileNo || '-');
                            $("#lblFatherName").text(match.FatherName || '-');

                            ShowStudentPhotoOrAvatar(match.StudentPhoto);
                        }

                        FetchStudentInstallments(res.StudentID, res.StudentFeeReceiptID, res.FeesTypeID);

                        if (res.ReceiptDate) {
                            var d = ParseDateObj(res.ReceiptDate);
                            var formatted = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0') + 'T' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
                            $("#txtReceiptDate").val(formatted);
                        }

                        $("#txtFeeReceiptNo").val(res.FeeReceiptNo);
                        $("#txtAmountReceived").val(res.AmountReceived);
                        $("#ddlPaymentTypeID").val(res.PaymentTypeID);
                        $("#txtTransactionNo").val(res.TransactionNo);
                        $("#txtBankName").val(res.BankName || "");
                        $("#ddlReceivedByUserID").val(res.ReceivedByUserID || currentLoggedInUserID);
                        $("#txtRemarks").val(res.Remarks);

                        $("#StudentFeeReceiptModal").modal("show");
                    });
                }
            });
        }

        // Delete Fee Receipt
        function DeleteFeeReceipt(id) {
            Swal.fire({
                title: "Are you sure?",
                text: "Deleting this receipt will also remove its corresponding Branch Ledger entry!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, Delete",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: "/bctechadmin/DeleteStudentFeeReceipt",
                        data: { id: id },
                        success: function (res) {
                            if (res.IsSuccess) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted',
                                    text: res.Message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                GetFeeReceiptList(parseInt($("#hfPageNumber").val()));
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: res.Message });
                            }
                        }
                    });
                }
            });
        }

        // Print Fee Receipt & Student Ledger Report
        function PrintFeeReceiptLedger(receiptId) {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentFeeLedgerPrintDetails",
                data: { id: receiptId },
                success: function (res) {
                    if (!res || !res.IsSuccess) {
                        Swal.fire({ icon: 'error', title: 'Error', text: (res ? res.Message : 'Failed to load ledger print details.') });
                        return;
                    }

                    var rec = res.Receipt || {};
                    var stu = res.Student || {};
                    var summary = res.Summary || {};
                    var insts = res.Installments || [];
                    var history = res.PaymentHistory || [];

                    // Populate Top Header & Receipt Info
                    var branch = rec.BranchName || stu.BranchName || "Branch";
                    $("#printBranchName").text(branch);
                    $("#printSignBranch").text(branch);
                    $("#stubBranchTitle").text(branch);

                    var recNo = rec.FeeReceiptNo || (receiptId ? receiptId.toString() : "0");
                    $("#printReceiptNo").text(recNo);
                    $("#printBarcodeText").text(recNo);

                    // Dynamic Barcode Generation using JsBarcode with Font Fallback
                    try {
                        if (typeof JsBarcode === "function") {
                            JsBarcode("#printBarcodeSVG", recNo, {
                                format: "CODE128",
                                width: 1.5,
                                height: 35,
                                displayValue: false,
                                margin: 0
                            });
                            $("#printBarcodeSVG").show();
                            $("#printBarcodeText").hide();
                        } else {
                            $("#printBarcodeText").show();
                            $("#printBarcodeSVG").hide();
                        }
                    } catch (e) {
                        $("#printBarcodeText").show();
                        $("#printBarcodeSVG").hide();
                    }

                    $("#printReceiptDate").text(rec.ReceiptDateShort || '-');
                    $("#printPaymentType").text(rec.PaymentTypeTitle || 'Cash');
                    $("#printTransactionNo").text(rec.TransactionNo || '-');

                    var recFeeAmt = parseFloat(rec.AmountReceived || 0);
                    $("#printReceivedFee").html("&#8377; " + recFeeAmt.toFixed(2));

                    var balFeeAmt = parseFloat(summary.BalanceFee || 0);
                    $("#printBalanceFee").html("&#8377; " + balFeeAmt.toFixed(2));

                    var stuEnrClean = (stu.StudentEnrollmentNo && !stu.StudentEnrollmentNo.startsWith("AUTO-")) ? stu.StudentEnrollmentNo : '-';
                    $("#printStudentName").text(stu.StudentFullName || '-');
                    $("#printEnrollmentNo").text(stuEnrClean);
                    $("#printBatchTime").text(stu.BatchTime || '-');
                    $("#printHighlightAmount").text(recFeeAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }));


                    // Populate FeesInstallment & Paid History Table
                    var htmlLedger = "";
                    if (history && history.length > 0) {
                        $.each(history, function (i, item) {
                            var amt = parseFloat(item.AmountReceived || 0).toFixed(2);

                            htmlLedger += "<tr>";
                            htmlLedger += "<td class='fw-semibold text-nowrap'>" + (item.FeeReceiptNo || (stu.StudentEnrollmentNo || '-')) + "</td>";
                            htmlLedger += "<td style='white-space: normal; word-break: break-word;'>" + (stu.CourseTitle || 'General Course') + "</td>";
                            htmlLedger += "<td>" + (item.FeesTypeTitle || ('Installment ' + (i + 1))) + "</td>";
                            htmlLedger += "<td class='text-nowrap'>" + (item.ReceiptDateShort || item.ReceiptDateFormatted || '-') + "</td>";
                            htmlLedger += "<td class='text-end fw-bold text-success text-nowrap'>&#8377; " + amt + "</td>";
                            htmlLedger += "</tr>";
                        });
                    } else if (insts && insts.length > 0) {
                        $.each(insts, function (i, item) {
                            htmlLedger += "<tr>";
                            htmlLedger += "<td class='fw-semibold text-nowrap'>" + (stu.StudentEnrollmentNo || '-') + "</td>";
                            htmlLedger += "<td style='white-space: normal; word-break: break-word;'>" + (stu.CourseTitle || 'General Course') + "</td>";
                            htmlLedger += "<td>" + (item.InstallmentName || ('Installment ' + (i + 1))) + "</td>";
                            htmlLedger += "<td class='text-nowrap'>" + (item.DueDate || '-') + "</td>";
                            htmlLedger += "<td class='text-end text-muted text-nowrap'>0.00</td>";
                            htmlLedger += "</tr>";
                        });
                    } else {
                        htmlLedger = "<tr><td colspan='5' class='text-center text-muted'>No fee installment details found.</td></tr>";
                    }

                    $("#printLedgerTableBody, #printStubLedgerTableBody").html(htmlLedger);

                    // Populate Stub Details (Office Use Portion)
                    $("#stubSignBranch").text(branch);
                    $("#stubStudentName").text(stu.StudentFullName || '-');
                    $("#stubEnrollmentNo").text(stuEnrClean);
                    $("#stubInvoiceNo").text(stuEnrClean !== '-' ? stuEnrClean : (rec.FeeReceiptNo || '-'));
                    $("#stubJoiningDate").text(stu.JoiningDateFormatted || '-');

                    var totFee = parseFloat(summary.TotalFeeAmount || 0);
                    var totPaid = parseFloat(summary.TotalReceived || 0);

                    $("#stubFeesPayable").html("&#8377; " + totFee.toFixed(2));
                    $("#stubFeesPaid").html("&#8377; " + totPaid.toFixed(2));
                    $("#stubBalanceFees").html("&#8377; " + balFeeAmt.toFixed(2));

                    $("#stubReceiptNo").text(rec.FeeReceiptNo || receiptId);
                    $("#stubReceiptDate").text(rec.ReceiptDateFormatted || '-');
                    $("#stubReceivedAmount").html("&#8377; " + recFeeAmt.toFixed(2));
                    $("#stubPaymentMode").text(rec.PaymentTypeTitle || 'Cash');
                    $("#stubTranNo").text(rec.TransactionNo || '-');
                    $("#stubBankName").text(rec.BankName || 'Cash');
                    $("#stubCourseTitle").text(stu.CourseTitle || 'General');
                    $("#stubReceivedBy").text(rec.ReceivedByUserName || 'Admin');
                    $("#stubReceivedBySignature").text(rec.ReceivedByUserName || 'Admin');
                    $("#stubComment").text(rec.Remarks || '-');

                    $("#FeeLedgerPrintModal").modal("show");
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to fetch ledger report details.' });
                }
            });
        }

