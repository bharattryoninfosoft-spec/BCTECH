@{
    ViewBag.Title = "Student Fee Receipt";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";

    ViewData["ParentMenu"] = "Student";
    ViewData["PageTitle"] = "Student Fee Receipt";

    int currentUserID = ViewBag.CurrentUserID != null ? (int)ViewBag.CurrentUserID : 1;
    string currentUserName = ViewBag.CurrentUserName != null ? ViewBag.CurrentUserName.ToString() : "Admin";
}



<input type="hidden" id="hfPageNumber" value="1" />
<input type="hidden" id="hfPageSize" value="10" />

<div class="card bg-white rounded-10 border border-white mb-4">

    <!-- Header & Search Controls -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3">

        <div class="position-relative" style="min-width: 300px; max-width: 400px; flex: 1;">
            <input type="text"
                   id="txtSearch"
                   class="form-control ps-5"
                   placeholder="Search Receipt No, Student Name, Enrollment, Mobile..." />

            <button type="button"
                    id="btnSearch"
                    class="btn p-0 position-absolute top-50 start-0 translate-middle-y ms-3 text-muted border-0 bg-transparent">
                <span class="material-symbols-outlined align-middle fs-20">search</span>
            </button>
        </div>

        <a href="javascript:void(0);" class="btn btn-primary text-white px-3" onclick="OpenFeeReceiptModal()">
            <i class="ri-add-line me-1 fs-15 align-middle"></i> Add Fee Receipt
        </a>

    </div>

    <!-- Data Table -->
    <div class="table-responsive p-3 pt-0">
        <table class="table table-hover align-middle border-bottom mb-0" id="tblFeeReceipt" style="min-width: 1250px; width: 100%;">
            <thead class="bg-light">
                <tr class="text-secondary fs-13 text-nowrap">

                    <th class="text-center" style="width: 50px; min-width: 50px;">SR</th>
                    <th class="text-center" style="width: 140px; min-width: 140px;">Action</th>
                    <th style="width: 100px; min-width: 100px;">Receipt No</th>
                    <th style="width: 150px; min-width: 155px;">Receipt Date</th>
                    <th style="width: 150px; min-width: 250px;">Student Name</th>
                    <th class="text-end" style="width: 120px; min-width: 120px;">Amount (&#8377;) <br /></th>
                    <!--<th class="text-center" style="width: 120px; min-width: 120px;">Received In</th>-->
                    <th class="text-center" style="width: 140px; min-width: 140px;">Receipt Type</th>
                    <th style="width: 130px; min-width: 130px;">Received By</th>

                </tr>
            </thead>
            <tbody id="tblFeeReceiptBody">
                <!-- Dynamic Data Rows -->
            </tbody>
        </table>
    </div>

    <!-- Custom Pagination -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3 border-top">
        <span id="lblShowing" class="text-muted fs-14">
            Showing 0 to 0 of 0 entries
        </span>

        <nav>
            <ul class="pagination pagination-sm mb-0 gap-1" id="pagination">
                <!-- Dynamic Pagination Buttons -->
            </ul>
        </nav>
    </div>

</div>

<!-- Add / Edit Modal -->
<div class="modal fade" id="StudentFeeReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header bg-light">
                <h5 class="modal-title" id="modalTitle">Add Student Fee Receipt</h5>
                <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <input type="hidden" id="hfStudentFeeReceiptID" value="0" />

                <div class="row">

                    <!-- Left Column: Receipt Form -->
                    <div class="col-lg-7 border-end pe-lg-4">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Student Name <span class="text-danger">*</span></label>
                            <select id="ddlStudentID" class="form-select select2">
                                <option value="">Select Student</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Receipt Date <span class="text-danger">*</span></label>
                            <input type="datetime-local" id="txtReceiptDate" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Receipt No <span class="text-danger">*</span></label>
                            <input type="text" id="txtFeeReceiptNo" class="form-control" placeholder="Receipt Number (Auto-generated on student select)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Received Amount (&#8377;) <span class="text-danger">*</span></label>
                            <input type="tel" step="0.01" id="txtAmountReceived" class="form-control" placeholder="Enter Amount" maxlength="15" onkeypress="return validateFloatKeyPress(this,event);" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Received In <span class="text-danger">*</span></label>
                                <select id="ddlPaymentTypeID" class="form-select">
                                    <option value="">Select Payment Type</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Receipt Type</label>
                                <select id="ddlFeesTypeID" class="form-select">
                                    <option value="">Select Receipt Type</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label fw-semibold">Transaction Number / Cheque No</label>
                                <input type="text" id="txtTransactionNo" class="form-control" placeholder="Enter Transaction Number" />
                            </div>
                            <div class="col-md-6" id="divBankName">
                                <label class="form-label fw-semibold">Bank Name</label>
                                <input type="text" id="txtBankName" class="form-control" placeholder="Enter Bank Name (e.g. HDFC, SBI)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Received By <span class="text-danger">*</span></label>
                            <select id="ddlReceivedByUserID" class="form-select" disabled style="background-color: #e9ecef; pointer-events: none;">
                                <option value="">Select User</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Receipt Remark</label>
                            <textarea id="txtRemarks" class="form-control" rows="3" placeholder="Enter internal remarks of student"></textarea>
                        </div>

                    </div>

                    <!-- Right Column: Student Summary & Fee Details -->
                    <div class="col-lg-5 ps-lg-4 mt-3 mt-lg-0">

                        <div class="card bg-light border-0 mb-3">
                            <div class="card-body">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div id="divStudentPhotoReceipt" class="flex-shrink-0 d-none">
                                        <img id="imgStudentPhotoReceipt" src="" alt="Student Photo" class="rounded-circle border border-2 border-primary shadow-sm" style="width: 55px; height: 55px; object-fit: cover;" />
                                    </div>
                                    <div id="avatarStudentPhotoReceipt" class="flex-shrink-0 bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 55px; height: 55px;">
                                        <i class="ri-user-line fs-24"></i>
                                    </div>
                                    <div>
                                        <h6 class="card-title text-primary mb-1"><i class="ri-user-3-line me-1"></i> Selected Student Info</h6>
                                        <div class="fw-bold text-dark fs-14" id="lblStudentName">-</div>
                                    </div>
                                </div>
                                <p class="mb-1 text-muted fs-13"><strong>Enrollment No:</strong> <span id="lblStudentEnrollment" class="text-dark">-</span></p>
                                <p class="mb-1 text-muted fs-13"><strong>Mobile No:</strong> <span id="lblStudentMobile" class="text-dark">-</span></p>
                                <p class="mb-0 text-muted fs-13"><strong>Father Name:</strong> <span id="lblFatherName" class="text-dark">-</span></p>
                            </div>
                        </div>

                        <div class="border rounded p-3 mb-3 bg-white">
                            <h6 class="fw-bold text-secondary mb-2 fs-14">FeesInstallment Amount Table</h6>
                            <table class="table table-sm table-bordered fs-12 mb-0" id="tblFeesInstallment">
                                <thead class="table-light">
                                    <tr>
                                        <th>Installment</th>
                                        <th>Due Date</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody id="tblFeesInstallmentBody">
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-2">Select a student to view installments</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="border rounded p-3 bg-white">
                            <h6 class="fw-bold text-secondary mb-2 fs-14">Received Total Amount table</h6>
                            <div class="d-flex justify-content-between align-items-center fs-13 py-1 border-bottom">
                                <span>Total FeesInstallment:</span>
                                <span class="fw-bold text-dark fs-14" id="lblTotalFeeAmount">&#8377; 0.00</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center fs-13 py-1 border-bottom">
                                <span>Previous Received:</span>
                                <span class="fw-bold text-info fs-14" id="lblPreviousReceived">&#8377; 0.00</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center fs-13 py-1 border-bottom">
                                <span>Current Payment:</span>
                                <span class="fw-bold text-success fs-14" id="lblCurrentReceived">&#8377; 0.00</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center fs-13 py-1 border-bottom bg-light px-2 my-1 rounded">
                                <span class="fw-bold text-dark">Total Remaining Amount:</span>
                                <span class="fw-bold text-danger fs-15" id="lblRemainingAmount">&#8377; 0.00</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center fs-13 py-1">
                                <span>Status:</span>
                                <span class="badge bg-success">Branch Ledger Sync Active</span>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary text-white" onclick="SaveFeeReceipt()">Save Fee Receipt</button>
            </div>

        </div>
    </div>
</div>

<!-- View Details Modal -->
<div class="modal fade" id="ViewStudentFeeReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="ri-file-list-3-line me-2 text-info"></i> View Fee Receipt Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <tr>
                            <th class="w-35 bg-light">Receipt ID</th>
                            <td id="vReceiptID"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Receipt No</th>
                            <td id="vReceiptNo" class="fw-bold text-primary"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Receipt Date</th>
                            <td id="vReceiptDate"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Student Name</th>
                            <td id="vStudentName" class="fw-bold"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Enrollment No</th>
                            <td id="vEnrollmentNo"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Amount Received</th>
                            <td id="vAmountReceived" class="fw-bold text-success fs-16"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Received In (Payment Type)</th>
                            <td id="vPaymentType"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Receipt Type (Fees Type)</th>
                            <td id="vFeesType"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Transaction Number</th>
                            <td id="vTransactionNo"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Bank Name</th>
                            <td id="vBankName"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Received By</th>
                            <td id="vReceivedBy"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Remarks</th>
                            <td id="vRemarks"></td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<!-- Fee Ledger & Invoice Print Modal -->
<div class="modal fade" id="FeeLedgerPrintModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow">

