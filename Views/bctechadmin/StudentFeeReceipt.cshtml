@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        var studentDropdownData = [];
        var currentInstallmentsList = [];
        var currentLoggedInUserID = "@currentUserID";
        var globalTotalFeeAmount = 0;
        var globalPreviousReceived = 0;

        $(document).ready(function () {
            // Fetch initial receipt list
            GetFeeReceiptList(1);

            // Load Master Dropdowns
            LoadAllDropdowns();

            // Search Handlers
            $("#btnSearch").click(function () {
                GetFeeReceiptList(1);
            });

            var searchTimer = null;
            $("#txtSearch").keyup(function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    GetFeeReceiptList(1);
                }, 400);
            });

            // Student selection change handler: Update student info & photo, load installments & generate Receipt No
            $("#ddlStudentID").change(function () {
                var stuId = $(this).val();
                var currentReceiptId = parseInt($("#hfStudentFeeReceiptID").val()) || 0;
                if (stuId) {
                    var match = studentDropdownData.find(x => x.StudentID == stuId);
                    if (match) {
                        var cleanEnr = (match.StudentEnrollmentNo && !match.StudentEnrollmentNo.startsWith("AUTO-")) ? match.StudentEnrollmentNo : '-';
                        $("#lblStudentName").text(match.StudentFullName || '-');
                        $("#lblStudentEnrollment").text(cleanEnr);
                        $("#lblStudentMobile").text(match.StudentMobileNo || '-');
                        $("#lblFatherName").text(match.FatherName || '-');

                        ShowStudentPhotoOrAvatar(match.StudentPhoto);
                    }

                    // Load Student's Installments dynamically
                    FetchStudentInstallments(stuId, currentReceiptId);

                    // Auto-generate receipt number based on selected student's branch if adding new receipt
                    if ($("#hfStudentFeeReceiptID").val() == "0") {
                        FetchReceiptNoByStudent(stuId);
                    }
                } else {
                    $("#lblStudentName").text('-');
                    $("#lblStudentEnrollment").text('-');
                    $("#lblStudentMobile").text('-');
                    $("#lblFatherName").text('-');
                    ShowStudentPhotoOrAvatar("");
                    currentInstallmentsList = [];
                    globalTotalFeeAmount = 0;
                    globalPreviousReceived = 0;
                    UpdateFeeSummary();
                    $("#tblFeesInstallmentBody").html("<tr><td colspan='3' class='text-center text-muted py-2'>Select a student to view installments</td></tr>");

                    if ($("#hfStudentFeeReceiptID").val() == "0") {
                        $("#txtFeeReceiptNo").val('');
                    }
                }
            });

            // Amount input & Receipt Type change sync
            $("#txtAmountReceived").on("input keyup", function () {
                UpdateFeeSummary();
            });
            $("#ddlFeesTypeID").on("change", function () {
                UpdateFeeSummary();
            });



 
        });



        function LoadStudentDataID(encryptedId) {

             
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetEncryptStudentByID",
                data: { id: encryptedId },
                dataType: "json",
                success: function (res) {
                    //var d = (res && res.Data) ? res.Data : (res && res.IsSuccess ? res : null);
                    //if (d && d.StudentID > 0) {
                        
                    //}
                    if (res.IsSuccess == true)
                    {
                        alert(res.Message);
                    }

                    
                },
                error: function () {
                    LoadEnquiryIntoAdmission(encryptedId);
                }
            });
        }





        // Toggle Student Photo image vs Avatar cleanly
        function ShowStudentPhotoOrAvatar(photoUrl) {
            var $imgDiv = $("#divStudentPhotoReceipt");
            var $avatarDiv = $("#avatarStudentPhotoReceipt");
            var $img = $("#imgStudentPhotoReceipt");

            if (photoUrl && photoUrl.trim() !== "" && photoUrl.trim() !== "null") {
                var formattedUrl = photoUrl.trim();
                if (!formattedUrl.startsWith('/') && !formattedUrl.startsWith('http')) {
                    formattedUrl = '/' + (formattedUrl.startsWith('Content/') ? formattedUrl : 'Content/profile/' + formattedUrl);
                }

                $img.off('load error');
                $img.on('load', function () {
                    $avatarDiv.removeClass("d-flex").addClass("d-none");
                    $imgDiv.removeClass("d-none");
                });
                $img.on('error', function () {
                    $imgDiv.addClass("d-none");
                    $avatarDiv.removeClass("d-none").addClass("d-flex");
                });

                $img.attr("src", formattedUrl);
            } else {
                $img.attr("src", "");
                $imgDiv.addClass("d-none");
                $avatarDiv.removeClass("d-none").addClass("d-flex");
            }
        }

        // Recalculate and update Fee Summary labels & color coded installment table rows
        function UpdateFeeSummary() {
            var currentPay = parseFloat($("#txtAmountReceived").val()) || 0;
            var totalRec = globalPreviousReceived + currentPay;
            var remaining = globalTotalFeeAmount - totalRec;

            $("#lblTotalFeeAmount").html("&#8377; " + globalTotalFeeAmount.toFixed(2));
            $("#lblPreviousReceived").html("&#8377; " + globalPreviousReceived.toFixed(2));
            $("#lblCurrentReceived").html("&#8377; " + currentPay.toFixed(2));

            var displayRemaining = remaining < 0 ? 0 : remaining;
            var remainingClass = remaining > 0 ? "text-danger" : "text-success";

            $("#lblRemainingAmount")
                .removeClass("text-danger text-success")
                .addClass(remainingClass)
                .html("&#8377; " + displayRemaining.toFixed(2));

            // Live update FeesInstallment Amount Table with Color Coding & Editable Next Due Date
            var html = "";
            if (currentInstallmentsList && currentInstallmentsList.length > 0) {
                var runningPaid = totalRec;
                $.each(currentInstallmentsList, function (i, item) {
                    var instAmt = parseFloat(item.Amount || 0);
                    var instName = item.InstallmentName || ("Installment " + (i + 1));
                    var dueDate = item.DueDate || '-';
                    var instId = item.FeesInstallmentID || 0;
                    var dateInputVal = FormatDateForInput(dueDate);

                    var dateDisplayHtml = "";
                    if (runningPaid >= instAmt) {
                        dateDisplayHtml = dueDate;
                    } else {
                        dateDisplayHtml = "<input type='date' class='form-control form-control-sm py-0 px-1 fs-12 border-primary-subtle' value='" + dateInputVal + "' onchange='SaveNextDueDate(" + instId + ", this.value)' title='Change Next Due Date' />";
                    }

                    if (runningPaid >= instAmt) {
                        // Fully Paid -> Green Row
                        runningPaid -= instAmt;
                        html += "<tr class='table-success align-middle'>";
                        html += "<td class='fw-semibold text-success'><i class='ri-checkbox-circle-fill me-1'></i>" + instName + "</td>";
                        html += "<td>" + dateDisplayHtml + "</td>";
                        html += "<td class='text-end fw-bold text-success'>&#8377; " + instAmt.toFixed(2) + " <span class='badge bg-success ms-1 fs-11'>Paid</span></td>";
                        html += "</tr>";
                    } else if (runningPaid > 0) {
                        // Partially Paid -> Yellow Row
                        var paidHere = runningPaid;
                        var dueHere = instAmt - runningPaid;
                        runningPaid = 0;
                        html += "<tr class='table-warning align-middle'>";
                        html += "<td class='fw-semibold text-dark'><i class='ri-time-fill text-warning me-1'></i>" + instName + "</td>";
                        html += "<td>" + dateDisplayHtml + "</td>";
                        html += "<td class='text-end fw-bold text-dark'>";
                        html += "<div>&#8377; " + instAmt.toFixed(2) + "</div>";
                        html += "<div class='fs-11 text-muted mt-1' style='line-height: 1.3;'>(Paid: &#8377; " + paidHere.toFixed(2) + " | <br />Rem. B/s: &#8377; " + dueHere.toFixed(2) + ")</div>";
                        html += "</td>";
                        html += "</tr>";
                    } else {
                        // Pending / Unpaid -> Standard Row
                        html += "<tr class='align-middle'>";
                        html += "<td class='text-secondary'>" + instName + "</td>";
                        html += "<td>" + dateDisplayHtml + "</td>";
                        html += "<td class='text-end fw-semibold text-dark'>&#8377; " + instAmt.toFixed(2) + "</td>";
                        html += "</tr>";
                    }
                });
            } else {
                html = "<tr><td colspan='3' class='text-center text-muted py-2'>Select a student to view installments</td></tr>";
            }
            $("#tblFeesInstallmentBody").html(html);

            // Validate if entered amount exceeds total remaining fee balance
            var maxAllowed = globalTotalFeeAmount - globalPreviousReceived;
            if (maxAllowed < 0) maxAllowed = 0;

            if (globalTotalFeeAmount > 0 && currentPay > maxAllowed) {
                $("#txtAmountReceived").addClass("is-invalid");
                var errMsg = 'Amount cannot be greater than total remaining balance of &#8377; ' + maxAllowed.toFixed(2);
                if ($("#lblAmountError").length === 0) {
                    $("#txtAmountReceived").after('<div id="lblAmountError" class="invalid-feedback d-block fw-semibold mt-1">' + errMsg + '</div>');
                } else {
                    $("#lblAmountError").html(errMsg);
                }
            } else {
                $("#txtAmountReceived").removeClass("is-invalid");
                $("#lblAmountError").remove();
            }
        }

        // Fetch Student Fee Installments and Total Received
        function FetchStudentInstallments(stuId = 0, receiptId = 0, targetFeesTypeId = 0) {
            receiptId = receiptId || parseInt($("#hfStudentFeeReceiptID").val()) || 0;
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentInstallmentDetails",
                data: { studentId: stuId, receiptId: receiptId },
                success: function (res) {
                    currentInstallmentsList = (res && res.Installments) ? res.Installments : [];
                    globalTotalFeeAmount = parseFloat(res.TotalFeeAmount || 0);
                    globalPreviousReceived = parseFloat(res.TotalReceived || 0);

                    // Filter Receipt Type Dropdown: Only show unpaid / pending installment receipt types
                    FilterReceiptTypeDropdown(targetFeesTypeId);

                    // Update Fee Summary and color coded installment rows
                    UpdateFeeSummary();

                    // Check if fees are fully paid when adding new receipt
                    if (receiptId === 0 && globalTotalFeeAmount > 0) {
                        var maxAllowed = globalTotalFeeAmount - globalPreviousReceived;
                        if (maxAllowed <= 0) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Fees Fully Paid',
                                text: 'Total Fees for this student are already fully paid! You cannot create a new fee receipt.'
                            });
                        }
                    }
                },
                error: function () {
                    $("#tblFeesInstallmentBody").html("<tr><td colspan='3' class='text-center text-danger py-2'>Error loading installments</td></tr>");
                }
            });
        }

        // Filter & populate Receipt Type Dropdown: Show all installment types sequentially
        function FilterReceiptTypeDropdown(targetFeesTypeId) {
            var html = "<option value=''>Select Receipt Type</option>";
            if (currentInstallmentsList && currentInstallmentsList.length > 0) {
                var tempPrev = globalPreviousReceived;
                var firstUnpaidIndex = -1;

                // Find index of the first unpaid installment
                $.each(currentInstallmentsList, function (i, item) {
                    var instAmt = parseFloat(item.Amount || 0);
                    if (tempPrev >= instAmt) {
                        tempPrev -= instAmt;
                    } else {
                        if (firstUnpaidIndex === -1) {
                            firstUnpaidIndex = i;
                        }
                    }
                });

                var activeFeesTypeId = 0;
                $.each(currentInstallmentsList, function (i, item) {
                    var feesTypeId = item.FeesTypeID || 0;
                    var title = item.InstallmentName || item.FeesTypeTitle || ("Installment " + (i + 1));

                    if (firstUnpaidIndex !== -1 && i < firstUnpaidIndex) {
                        // Preceding installment: Paid
                        html += "<option value='" + feesTypeId + "' disabled class='text-muted'>" + title + " (Paid)</option>";
                    } else if (firstUnpaidIndex !== -1 && i === firstUnpaidIndex) {
                        // Active current installment
                        html += "<option value='" + feesTypeId + "'>" + title + "</option>";
                        activeFeesTypeId = feesTypeId;
                    } else {
                        // Future installment: Locked until previous is paid
                        html += "<option value='" + feesTypeId + "' disabled class='text-muted'>" + title + " (Locked - Pay previous first)</option>";
                    }
                });

                if (firstUnpaidIndex === -1) {
                    html = "<option value=''>All Installments Paid</option>";
                }

                $("#ddlFeesTypeID").html(html);

                if (targetFeesTypeId && targetFeesTypeId > 0) {
                    $("#ddlFeesTypeID").val(targetFeesTypeId);
                } else if (activeFeesTypeId > 0) {
                    $("#ddlFeesTypeID").val(activeFeesTypeId);
                }
            } else {
                $("#ddlFeesTypeID").html(html);
            }
        }

        // Fetch Receipt No based on Student's Branch
        function FetchReceiptNoByStudent(stuId) {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetReceiptNoByStudent",
                data: { studentId: stuId },
                success: function (res) {
                    if (res && res.ReceiptNo) {
                        $("#txtFeeReceiptNo").val(res.ReceiptNo);
                    }
                }
            });
        }

        // Fetch Fee Receipts with Pagination
        function GetFeeReceiptList(pageNumber) {
            $("#hfPageNumber").val(pageNumber);

            var param = {
                searchText: $("#txtSearch").val().trim(),
                pageNumber: parseInt($("#hfPageNumber").val()),
                pageSize: parseInt($("#hfPageSize").val())
            };

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentFeeReceiptList",
                data: param,
                dataType: "json",
                beforeSend: function () {
                    $("#tblFeeReceiptBody").html("<tr><td colspan='9' class='text-center py-4'><div class='spinner-border spinner-border-sm text-primary' role='status'></div></td></tr>");
                },
                success: function (response) {
                    var html = "";
                    var totalRecords = response.TotalRecords || 0;
                    var data = response.Data || [];

                    if (data.length > 0) {
                        var srNo = (param.pageNumber - 1) * param.pageSize;

                        $.each(data, function (i, item) {
                            srNo++;
                            var recDate = FormatJsonDate(item.ReceiptDate);
                            var amount = parseFloat(item.AmountReceived || 0).toFixed(2);

                            var enrClean = (item.StudentEnrollmentNo && item.StudentEnrollmentNo.trim() !== '' && item.StudentEnrollmentNo !== '-' && !item.StudentEnrollmentNo.startsWith('AUTO-')) ? item.StudentEnrollmentNo.trim() : '';
                            var mobile = (item.StudentMobileNo && item.StudentMobileNo.trim() !== '' && item.StudentMobileNo !== '-') ? item.StudentMobileNo.trim() : '';

                            var payTitle = item.PaymentTypeTitle || 'Cash';
                            var isUPI = payTitle.toLowerCase().includes('upi');
                            var payBadgeClass = isUPI ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'bg-success-subtle text-success border border-success-subtle';

                            html += "<tr>";
                            html += "<td class='text-center fw-bold text-muted fs-13 text-nowrap'>" + srNo + "</td>";
                            html += "<td class='text-center text-nowrap'>";
                            html += "<div class='d-inline-flex align-items-center justify-content-center gap-2'>";
                            html += "<a href='javascript:void(0)' onclick='ViewFeeReceipt(" + item.StudentFeeReceiptID + ")' class='btn btn-sm btn-outline-info p-1 px-2' title='View'><i class='ri-eye-line fs-14'></i></a>";
                            html += "<a href='javascript:void(0)' onclick='EditFeeReceipt(" + item.StudentFeeReceiptID + ")' class='btn btn-sm btn-outline-primary p-1 px-2' title='Edit'><i class='ri-edit-box-line fs-14'></i></a>";
                            html += "<a href='javascript:void(0)' onclick='PrintFeeReceiptLedger(" + item.StudentFeeReceiptID + ")' class='btn btn-sm btn-outline-success p-1 px-2' title='Print Invoice'><i class='ri-printer-line me-1'></i></a>";
                            //html += "<a href='javascript:void(0)' onclick='PrintFeeReceiptLedger(" + item.StudentFeeReceiptID + ")' title='Print Invoice' class='btn btn-sm btn-success p-1 px-2 text-white fs-12 text-decoration-none'><i class='ri-printer-line me-1'></i>Invoice</a>";
                            html += "</div>";
                            html += "</td>";
                            html += "<td class='text-nowrap'><span class='fw-bold text-primary fs-13'>" + (item.FeeReceiptNo || '-') + "</span></td>";
                            html += "<td class='text-secondary fs-13 text-nowrap'><i class='ri-calendar-line me-1 text-muted'></i>" + recDate + "</td>";

                            // Student Name Column (Properly Viewable)
                            html += "<td class='text-nowrap' style='min-width: 250px;'>";
                            html += "<div class='fw-bold text-dark fs-13 text-nowrap'><i class='ri-user-3-line text-primary me-1'></i>" + (item.StudentFullName || '-') + "</div>";
                            var metaHtml = "";
                            if (enrClean) {
                                metaHtml += "<span class='badge bg-light text-secondary border px-1 py-0 fs-11 me-1'><i class='ri-barcode-line me-1'></i>" + enrClean + "</span>";
                            }
                            if (mobile) {
                                metaHtml += "<span class='text-muted fs-11'><i class='ri-phone-line text-success me-1'></i>" + mobile + "</span>";
                            }
                            if (metaHtml !== "") {
                                html += "<div class='d-flex align-items-center flex-wrap gap-1 mt-1'>" + metaHtml + "</div>";
                            }
                            html += "</td>";

                            html += "<td class='text-end fw-bold text-success fs-13 text-nowrap'>&#8377; " + amount + " <br /> <span class='badge " + payBadgeClass + " fw-medium fs-12 px-2 py-1'>" + payTitle + "</span></td>";
                            //html += "<td class='text-center text-nowrap'> </td>";
                            html += "<td class='text-center text-nowrap'><span class='badge bg-secondary-subtle text-secondary border border-secondary-subtle fw-medium fs-12 px-2 py-1'>" + (item.FeesTypeTitle || 'General') + "</span></td>";
                            html += "<td class='text-secondary fs-13 text-nowrap'><i class='ri-user-line me-1 text-muted'></i>" + (item.ReceivedByUserName || 'Admin') + "</td>";
                            
                            html += "</tr>";
                        });

                        $("#tblFeeReceiptBody").html(html);
                        RenderPagination(totalRecords, param.pageNumber, param.pageSize);
                    } else {
                        $("#tblFeeReceiptBody").html("<tr><td colspan='9' class='text-center text-muted py-4'>No Fee Receipt records found.</td></tr>");
                        $("#lblShowing").text("Showing 0 to 0 of 0 entries");
                        $("#pagination").empty();
                    }
                },
                error: function () {
                    $("#tblFeeReceiptBody").html("<tr><td colspan='9' class='text-center text-danger py-4'>Failed to load receipt data. Please try again.</td></tr>");
                }
            });
        }

        // Render Pagination
        function RenderPagination(totalRecords, currentPage, pageSize) {
            var totalPages = Math.ceil(totalRecords / pageSize);
            var start = totalRecords === 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
            var end = Math.min(currentPage * pageSize, totalRecords);

            $("#lblShowing").text("Showing " + start + " to " + end + " of " + totalRecords + " entries");

            var html = "";
            if (totalPages <= 1) {
                $("#pagination").empty();
                return;
            }

            html += "<li class='page-item " + (currentPage === 1 ? "disabled" : "") + "'>";
            html += "<a class='page-link' href='javascript:void(0)' onclick='GetFeeReceiptList(" + (currentPage - 1) + ")'>Previous</a>";
            html += "</li>";

            for (var i = 1; i <= totalPages; i++) {
                html += "<li class='page-item " + (i === currentPage ? "active" : "") + "'>";
                html += "<a class='page-link' href='javascript:void(0)' onclick='GetFeeReceiptList(" + i + ")'>" + i + "</a>";
                html += "</li>";
            }

            html += "<li class='page-item " + (currentPage === totalPages ? "disabled" : "") + "'>";
            html += "<a class='page-link' href='javascript:void(0)' onclick='GetFeeReceiptList(" + (currentPage + 1) + ")'>Next</a>";
            html += "</li>";

            $("#pagination").html(html);
        }

        // Load Student Dropdown (filters out fully paid students unless editing)
        function LoadStudentDropdown(currentReceiptStudentId = 0, selectedStudentId = 0, callback = null) {
            currentReceiptStudentId = currentReceiptStudentId || 0;
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentDropdownForReceipt",
                data: { currentReceiptStudentId: currentReceiptStudentId },
                success: function (data) {
                    studentDropdownData = data || [];
                    var html = "<option value=''>Select Student</option>";
                    $.each(studentDropdownData, function (i, item) {
                        html += "<option value='" + item.StudentID + "'>" + item.DisplayText + "</option>";
                    });
                    $("#ddlStudentID").html(html);
                    if (selectedStudentId && selectedStudentId > 0) {
                        $("#ddlStudentID").val(selectedStudentId);
                    }
                    if (callback) callback();
                }
            });
        }

        // Load Master Dropdowns
        function LoadAllDropdowns() {
            LoadStudentDropdown(0);

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetPaymentTypeDropdownForReceipt",
                success: function (data) {
                    var html = "<option value=''>Select Payment Type</option>";
                    $.each(data, function (i, item) {
                        html += "<option value='" + item.PaymentTypeID + "'>" + item.PaymentTypeTitle + "</option>";
                    });
                    $("#ddlPaymentTypeID").html(html);
                }
            });

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetUserDropdownForReceipt",
                success: function (data) {
                    var html = "<option value=''>Select User</option>";
                    $.each(data, function (i, item) {
                        html += "<option value='" + item.UserID + "'>" + item.UserName + "</option>";
                    });
                    $("#ddlReceivedByUserID").html(html);
                    // Default select currently logged-in user
                    if (currentLoggedInUserID) {
                        $("#ddlReceivedByUserID").val(currentLoggedInUserID);
                    }
                }
            });
        }

        // Open Modal for New Add
        function OpenFeeReceiptModal() {
            $("#hfStudentFeeReceiptID").val(0);
            $("#modalTitle").text("Add Student Fee Receipt");
            LoadStudentDropdown(0, 0, function() {
                $("#ddlStudentID").val("").trigger("change");
            });
            SetCurrentDateTime();
            $("#txtFeeReceiptNo").val("");
            $("#txtAmountReceived").val("");
            $("#ddlPaymentTypeID").val("");
            $("#ddlFeesTypeID").val("");
            $("#txtTransactionNo").val("");
            $("#txtBankName").val("");
            $("#ddlReceivedByUserID").val(currentLoggedInUserID);
            $("#txtRemarks").val("");
            currentInstallmentsList = [];
            globalTotalFeeAmount = 0;
            globalPreviousReceived = 0;
            UpdateFeeSummary();
            $("#tblFeesInstallmentBody").html("<tr><td colspan='3' class='text-center text-muted py-2'>Select a student to view installments</td></tr>");
            $("#StudentFeeReceiptModal").modal("show");
        }

        // Set Current Date Time in input
        function SetCurrentDateTime() {
            var now = new Date();
            var year = now.getFullYear();
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var day = String(now.getDate()).padStart(2, '0');
            var hours = String(now.getHours()).padStart(2, '0');
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var formatted = year + '-' + month + '-' + day + 'T' + hours + ':' + minutes;
            $("#txtReceiptDate").val(formatted);
        }

        // Save Fee Receipt
        function SaveFeeReceipt() {
            var studentID = $("#ddlStudentID").val();
            var receiptDate = $("#txtReceiptDate").val();
            var feeReceiptNo = $("#txtFeeReceiptNo").val().trim();
            var amountReceived = parseFloat($("#txtAmountReceived").val());
            var paymentTypeID = $("#ddlPaymentTypeID").val();
            var feesTypeID = $("#ddlFeesTypeID").val();
            var receivedByUserID = $("#ddlReceivedByUserID").val() || currentLoggedInUserID;

            if (!studentID) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please Select Student' });
                return;
            }
            if (!receiptDate) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please Select Receipt Date' });
                return;
            }
            if (!feeReceiptNo) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please Enter Fee Receipt No' });
                return;
            }
            if (isNaN(amountReceived) || amountReceived <= 0) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please Enter Valid Received Amount' });
                return;
            }
            if (!paymentTypeID) {
                Swal.fire({ icon: 'warning', title: 'Validation', text: 'Please Select Received In (Payment Type)' });
                return;
            }

            var receiptId = parseInt($("#hfStudentFeeReceiptID").val()) || 0;
            if (globalTotalFeeAmount > 0) {
                var maxAllowed = globalTotalFeeAmount - globalPreviousReceived;
                if (maxAllowed < 0) maxAllowed = 0;

                if (receiptId === 0 && maxAllowed <= 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Fees Fully Paid',
                        text: 'Total Fees for this student are already fully paid! You cannot create a new fee receipt.'
                    });
                    return;
                }

                if (amountReceived > maxAllowed) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Invalid Received Amount',
                        text: 'Received Amount (₹ ' + amountReceived.toFixed(2) + ') cannot be greater than total remaining balance of ₹ ' + maxAllowed.toFixed(2) + '.'
                    });
                    return;
                }
            }

            var model = {
                StudentFeeReceiptID: parseInt($("#hfStudentFeeReceiptID").val()),
                StudentID: parseInt(studentID),
                ReceiptDate: receiptDate,
                FeeReceiptNo: feeReceiptNo,
                AmountReceived: amountReceived,
                PaymentTypeID: parseInt(paymentTypeID),
                FeesTypeID: feesTypeID ? parseInt(feesTypeID) : 0,
                TransactionNo: $("#txtTransactionNo").val().trim(),
                BankName: $("#txtBankName").val().trim(),
                ReceivedByUserID: parseInt(receivedByUserID),
                Remarks: $("#txtRemarks").val().trim()
            };

            $.ajax({
                type: "POST",
                url: "/bctechadmin/SaveStudentFeeReceipt",
                data: model,
                success: function (res) {
                    if (res.IsSuccess) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved Successfully',
                            text: res.Message,
                            timer: 1500,
                            showConfirmButton: false
                        });
                        $("#StudentFeeReceiptModal").modal("hide");
                        GetFeeReceiptList(parseInt($("#hfPageNumber").val()));
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: res.Message });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Server Error', text: 'An unexpected error occurred.' });
                }
            });
        }

        // View Fee Receipt
        function ViewFeeReceipt(id) {
            $.ajax({
