                    <i class="ri-file-list-3-line me-2"></i>Student Fee Receipt Invoice
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 bg-white" id="printableLedgerArea">
