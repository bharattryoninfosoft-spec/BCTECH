                    $("#vPaymentType").text(res.PaymentTypeTitle || 'Cash');
                    $("#vFeesType").text(res.FeesTypeTitle || 'General');
                    $("#vTransactionNo").text(res.TransactionNo || '-');
                    $("#vBankName").text(res.BankName || '-');
                    $("#vReceivedBy").text(res.ReceivedByUserName || 'Admin');
