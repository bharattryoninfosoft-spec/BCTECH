@{
    ViewBag.Title = ViewBag.PageTitle ?? "Create Function Event";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<input type="hidden" id="hfStudentEnquiryID" value="@ViewBag.StudentEnquiryID" />
<input type="hidden" id="hfMode" value="@ViewBag.Mode" />
<input type="hidden" id="hfLoggedInUserID" value="@ViewBag.LoggedInUserID" />

<style>
    .item-photo__preview {
        width: 150px;
        height: 150px;
    }
    /* Add a grab cursor to indicate draggable gallery cards */
    #files-list-container .uploaded-image-item {
        cursor: grab;
    }

        #files-list-container .uploaded-image-item:active {
            cursor: grabbing;
        }
</style>

<form id="frmStudentEnquiry" autocomplete="off">
    <!-- ================= Event Code Details ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom">
            <h5 class="mb-0 text-dark font-weight-bold">Enquiry Detail</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Event No/Code <span class="text-danger">*</span></label>
                    <input type="text" id="txtEventCode" class="form-control" readonly placeholder="Auto Generated" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Select Branch <span class="text-danger">*</span></label>
                    <select id="ddlBranch" class="form-select select2">
                        <option value="">Select Branch</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Event Type <span class="text-danger">*</span></label>
                    <select id="ddlEventType" class="form-select select2">
                        <option value="">Select Event Type</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Event Information ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom">
            <h5 class="mb-0 text-dark font-weight-bold">Event Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Event Title <span class="text-danger">*</span></label>
                    <input type="text" id="txtEventTitle" maxlength="150" class="form-control" placeholder="Event Title" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Start Date <span class="text-danger">*</span></label>
                    <input type="date" id="txtEventDate" class="form-control" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Start Time <span class="text-danger">*</span></label>
                    <input type="time" id="txtEventStartTime" class="form-control" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">End Time <span class="text-danger">*</span></label>
                    <input type="time" id="txtEventEndTime" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Event Venue <span class="text-danger">*</span></label>
                    <input type="text" id="txtEventVenue" maxlength="150" class="form-control" placeholder="Event Venue" />
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="chkIsPublished" checked />
                        <label class="form-check-label fw-bold text-primary" for="chkIsPublished">Is Published</label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="chkIsActive" checked />
                        <label class="form-check-label fw-bold text-primary" for="chkIsActive">Is Active</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Event Description & Gallery Photos ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom">
            <h5 class="mb-0 text-dark font-weight-bold">Event Description & Photos</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Event Description</label>
                    <div class="position-relative">
                        <textarea id="txtEventDescription"></textarea>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="form-group mb-4 only-file-upload" id="file-upload">
                        <label class="label text-secondary fs-16">Upload Event Images</label>
                        <div class="form-control h-100 text-center position-relative p-4 p-lg-5">
                            <div class="item-upload">
                                <label class="file-upload mb-0" style="line-height: 54px;">
                                    <i class="ri-folder-image-line bg-primary bg-opacity-10 p-2 rounded-1 text-primary"></i>
                                    <span class="d-block text-body fs-14"> <span class="text-primary text-decoration-underline">Browse Images</span></span>
                                </label>
                                <label class="position-absolute top-0 bottom-0 start-0 end-0 cursor" id="upload-container">
                                    <input class="form__file bottom-0" id="photo-upload" type="file" multiple="multiple" accept=".jpg, .jpeg, .png">
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================= Event Gallery Card Grid Layout ================= -->
            <div class="card bg-white border border-white rounded-10 p-4 pb-0 mb-4">
                <h3 class="mb-20">Event Gallery <small class="text-muted fs-12">(Drag & drop cards to reorder sequence)</small></h3>
                <div id="files-list-container" class="row"></div>
            </div>
        </div>
    </div>
</form>

<!-- ================= Footer Buttons ================= -->
<div class="card bg-white rounded-10 border border-white mb-4">
    <div class="card-body text-end">
        <a href="@Url.Action("FunctionEventDetail", "bctechadmin")" class="btn btn-secondary me-2">
            <i class="ri-arrow-left-line"></i> Back
        </a>
        <button type="button" id="btnSave" class="btn btn-primary">
            <i class="ri-save-line"></i> Save Event
        </button>
    </div>
</div>

<!-- ================= Image Preview Modal ================= -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Image Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-content-body text-center p-3">
                <img id="modalPreviewImg" src="" class="img-fluid rounded" style="max-height: 500px; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var dtFiles = new DataTransfer();
        var fileCounter = 0;
        var nativeFilesArray = [];

        $(document).ready(function () {
            InitializeControls();
            $("body").attr("sidebar-data-theme", "sidebar-hide");

            $(".select2").select2({
                width: '100%',
                placeholder: 'Select',
                allowClear: true
            });

            // Initialize SortableJS on the gallery container grid
            var galleryContainer = document.getElementById('files-list-container');
            if (galleryContainer) {
                Sortable.create(galleryContainer, {
                    animation: 150,
                    ghostClass: 'bg-light' // Changed from 'bg-light opacity-50' to a single valid class name
                });
            }

            var urlParams = new URLSearchParams(window.location.search);
            var encryptedId = urlParams.get('id') || "";
            LoadDropdowns(function () {
                if (encryptedId !== "") {
                    LoadEventDataByID(encryptedId);
                }
            });

            $("#ddlBranch").on("change", function () {
                var branchID = parseInt($(this).val()) || 0;
                var currentID = parseInt($("#hfStudentEnquiryID").val()) || 0;
                if (branchID > 0 && currentID === 0) {
                    $.ajax({
                        type: "POST",
                        url: "/bctechadmin/GetNextEventCode",
                        data: JSON.stringify({ branchID: branchID }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (res) {
                            if (res && res.EnquiryNo) {
                                $("#txtEventCode").val(res.EnquiryNo);
                            }
                        }
                    });
                } else if (branchID === 0 && currentID === 0) {
                    $("#txtEventCode").val("");
                }
            });

            $("#btnSave").click(function () {
                SaveFunctionEvent();
            });
        });

        function openImageModal(imgSrc) {
            $("#modalPreviewImg").attr("src", imgSrc);
            var myModal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
            myModal.show();
        }

        function deleteImage(button, uniqueFileKey) {
            Swal.fire({
                title: "Are you sure?",
                text: "You want to delete this image?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, Delete",
                cancelButtonText: "Cancel",
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    var $item = $(button).closest('.uploaded-image-item');
                    var isNew = $item.attr("data-new") === "true";

                    if (isNew) {
                        nativeFilesArray = nativeFilesArray.filter(function (item) {
                            return item.id !== uniqueFileKey;
                        });
                    }

                    $item.remove();

                    Swal.fire({
                        icon: "success",
                        title: "Deleted!",
                        text: "Image has been removed.",
                        timer: 1200,
                        showConfirmButton: false
                    });
                }
            });
        }

        function InitializeControls() {
            $("#txtEventDescription").summernote({
                height: 250
            });
        }

        // Handle file selection and render preview cards in a Bootstrap grid
        document.querySelector('#photo-upload').addEventListener('change', (e) => {
            const files = e.target.files;
            if (!files || files.length === 0) return;

            const container = $('#files-list-container');

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const fileKey = 'file_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);

                nativeFilesArray.push({
                    id: fileKey,
                    fileObj: file
                });

                const objectUrl = URL.createObjectURL(file);

                var cardHtml = '<div class="col-xl-3 col-lg-4 col-md-6 mb-4 uploaded-image-item" data-new="true" data-file-key="' + fileKey + '">' +
                    '<div class="card border h-100 shadow-sm">' +
                    '<img src="' + objectUrl + '" class="card-img-top preview-img-thumb cursor" style="height: 160px; object-fit: cover;" onclick="openImageModal(\'' + objectUrl + '\')" title="Click to view" />' +
                    '<div class="card-body d-flex flex-column">' +
                    '<div class="mb-2">' +
                    '<input type="text" class="form-control form-control-sm img-title" placeholder="Image Title" />' +
                    '</div>' +
                    '<div class="mb-2 flex-grow-1">' +
                    '<textarea class="form-control form-control-sm img-desc" placeholder="Image Description" rows="2"></textarea>' +
                    '</div>' +
                    '<button type="button" class="btn btn-danger btn-sm w-100" title="Delete" onclick="deleteImage(this, \'' + fileKey + '\')">' +
                    '<i class="ri-delete-bin-line"></i> Delete' +
                    '</button>' +
                    '</div>' +
                    '</div>' +
                    '</div>';

                container.append(cardHtml);
            }

            $(e.target).val('');
        });

        function ParseResponseData(res) {
            if (!res) return [];
            var data = Array.isArray(res) && res.length > 1 && res[1] === "success" ? res[0] : res;
            if (typeof data === "string") {
                try { data = JSON.parse(data); } catch (e) { data = []; }
            }
            return Array.isArray(data) ? data : [];
        }

        function RenderSelectOptions(elementId, dataList, valueKey, textKey, defaultText) {
            var html = "<option value=''>" + defaultText + "</option>";
            $.each(dataList, function (i, item) {
                var val = item[valueKey] || item.ID;
                var txt = item[textKey] || item.Name;
                html += "<option value='" + val + "'>" + txt + "</option>";
            });
            $("#" + elementId).html(html).trigger("change");
        }

        function BindBranchDropdown(data) {
            var branchList = ParseResponseData(data);
            RenderSelectOptions("ddlBranch", branchList, "BranchID", "BranchName", "Select Branch");
        }

        function BindEventTypeDropdowns(data) {
            var userList = ParseResponseData(data);
            var userHtml = "<option value=''>Select Event Type</option>";
            $.each(userList, function (i, item) {
                var id = item.ID;
                var name = item.Name;
                userHtml += "<option value='" + id + "'>" + name + "</option>";
            });
            $("#ddlEventType").html(userHtml).trigger("change");
        }

        function LoadDropdowns(callback) {
            $.when(
                $.ajax({ type: "POST", url: "/bctechadmin/GetBranchDropdown", contentType: "application/json; charset=utf-8", dataType: "json", data: "{}" }),
                $.ajax({ type: "POST", url: "/bctechadmin/GetEventTypeDropdown", contentType: "application/json; charset=utf-8", dataType: "json", data: "{}" })
            ).done(function (branchesRes, EventTypeRes) {
                BindBranchDropdown(branchesRes);
                BindEventTypeDropdowns(EventTypeRes);
                if (typeof callback === "function") { callback(); }
            }).fail(function (err) {
                console.error("AJAX Error:", err);
                toastr.error("Error loading dropdown data.");
            });
        }

        function SaveFunctionEvent() {
            if ($("#ddlBranch").val() === "") {
                toastr.warning("Please select Branch.");
                $("#ddlBranch").focus();
                return;
            }
            if ($("#ddlEventType").val() === "") {
                toastr.warning("Please select Event Type.");
                $("#ddlEventType").focus();
                return;
            }
            if ($("#txtEventTitle").val().trim() === "") {
                toastr.warning("Please enter Event Title.");
                $("#txtEventTitle").focus();
                return;
            }
            if ($("#txtEventDate").val() === "") {
                toastr.warning("Please select Start Date.");
                $("#txtEventDate").focus();
                return;
            }

            var formData = new FormData();
            formData.append("FunctionEventID", parseInt($("#hfStudentEnquiryID").val()) || 0);
            formData.append("BranchID", parseInt($("#ddlBranch").val()) || 0);
            formData.append("EventCode", $("#txtEventCode").val());
            formData.append("EventTypeID", parseInt($("#ddlEventType").val()) || 0);
            formData.append("EventTitle", $("#txtEventTitle").val().trim());
            formData.append("EventDate", $("#txtEventDate").val());
            formData.append("EventStartTime", $("#txtEventStartTime").val());
            formData.append("EventEndTime", $("#txtEventEndTime").val());
            formData.append("EventVenue", $("#txtEventVenue").val().trim());
            formData.append("EventDescription", $("#txtEventDescription").summernote('code'));
            formData.append("IsPublished", $("#chkIsPublished").is(":checked"));
            formData.append("IsActive", $("#chkIsActive").is(":checked"));

            // This reads the cards strictly in their current DOM sequence (respects drag-and-drop ordering)
            $("#files-list-container .uploaded-image-item").each(function () {
                var isNew = $(this).attr("data-new") === "true";
                var title = $(this).find(".img-title").val() || "";
                var desc = $(this).find(".img-desc").val() || "";

                if (isNew) {
                    var fileKey = $(this).attr("data-file-key");
                    var found = nativeFilesArray.find(function (item) { return item.id === fileKey; });
                    if (found) {
                        formData.append("eventImages", found.fileObj);
                    }
                    formData.append("ExistingGalleryPaths", "__NEW_FILE__");
                } else {
                    var existingPath = $(this).find("img").attr("src");
                    formData.append("ExistingGalleryPaths", existingPath);
                }

                formData.append("ImageTitles", title);
                formData.append("ImageDescriptions", desc);
            });

            var actionUrl = (parseInt($("#hfStudentEnquiryID").val()) || 0) > 0 ? "/bctechadmin/UpdateFunctionEvent" : "/bctechadmin/SaveFunctionEvent";

            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to save this Function Event?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Save it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: actionUrl,
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function (response) {
                            if (response.IsSuccess) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Saved Successfully',
                                    text: response.Message
                                }).then(function () {
                                    window.location.href = "/bctechadmin/FunctionEventDetail";
                                });
                            } else {
                                Swal.fire('Error', response.Message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'An unexpected error occurred.', 'error');
                        }
                    });
                }
            });
        }

        function LoadEventDataByID(encryptedId) {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetFunctionEventByID",
                data: { id: encryptedId },
                dataType: "json",
                success: function (res) {
                    if (res) {
                        $("#hfStudentEnquiryID").val(res.FunctionEventID);
                        $("#txtEventCode").val(res.EventCode);
                        $("#ddlBranch").val(res.BranchID).trigger("change");
                        $("#ddlEventType").val(res.EventTypeID).trigger("change");
                        $("#txtEventTitle").val(res.EventTitle);

                        if (res.EventDate) {
                            var formattedDate = res.EventDate.includes('T') ? res.EventDate.split('T')[0] : res.EventDate;
                            $("#txtEventDate").val(formattedDate);
                        }

                        if (res.EventStartTime) $("#txtEventStartTime").val(res.EventStartTime.substring(0, 5));
                        if (res.EventEndTime) $("#txtEventEndTime").val(res.EventEndTime.substring(0, 5));
                        $("#txtEventVenue").val(res.EventVenue);
                        $('#txtEventDescription').summernote('code', res.EventDescription || "");
                        $("#chkIsPublished").prop("checked", res.IsPublished);
                        $("#chkIsActive").prop("checked", res.IsActive);

                        if (res.GalleryList && res.GalleryList.length > 0) {
                            $("#files-list-container").empty();
                            $.each(res.GalleryList, function (i, item) {
                                var cardHtml = '<div class="col-xl-3 col-lg-4 col-md-6 mb-4 uploaded-image-item" data-new="false">' +
                                    '<div class="card border h-100 shadow-sm">' +
                                    '<img src="' + item.GalleryImage + '" class="card-img-top preview-img-thumb" onclick="openImageModal(\'' + item.GalleryImage + '\')" title="Click to view">' +
                                    '<div class="card-body d-flex flex-column">' +
                                    '<div class="mb-2">' +
                                    '<input type="text" class="form-control form-control-sm img-title" value="' + (item.ImageTitle || '') + '" placeholder="Image Title" />' +
                                    '</div>' +
                                    '<div class="mb-2 flex-grow-1">' +
                                    '<textarea class="form-control form-control-sm img-desc" placeholder="Image Description" rows="2">' + (item.ImageDescription || '') + '</textarea>' +
                                    '</div>' +
                                    '<button type="button" class="btn btn-danger btn-sm w-100" title="Delete" onclick="deleteImage(this)">' +
                                    '<i class="fa fa-trash text-white"></i> Delete' +
                                    '</button>' +
                                    '</div>' +
                                    '</div>' +
                                    '</div>';

                                $("#files-list-container").append(cardHtml);
                            });
                        }

                        if ($("#hfMode").val() === "V") {
                            $("form").find("input, select, textarea, button").prop("disabled", true);
                            $(".select2").prop("disabled", true).trigger("change");
                            $("#btnSave").hide();
                            $(".only-file-upload").hide();
                        }
                    }
                },
                error: function () {
                    toastr.error("Failed to fetch Event Details.");
                }
            });
        }
    </script>
}