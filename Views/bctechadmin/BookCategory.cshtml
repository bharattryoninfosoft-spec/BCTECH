
@{
    ViewBag.Title = "BookCategory";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<div class="card bg-white rounded-10 border border-white mb-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">

        <form class="table-src-form position-relative m-0">
            <input type="text" id="txtSearch" class="form-control w-350" placeholder="Search Book Category...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>

        <!--<a href="javascript:void(0);" class="text-primary fs-16 text-decoration-none"
           onclick="OpenBookCategoryModal()">
            + Add Book Category
        </a>-->

        <a href="javascript:void(0);" class="btn btn-primary text-white" onclick="OpenBookCategoryModal()">
            <i class="ri-add-line"></i> Add Book Category
        </a>

    </div>

    <div class="default-table-area mx-minus-1 table-contact-list">

        <div class="table-responsive">

            <table class="table-common" id="tblBookCategory">

                <thead>

                    <tr>
                        <th>SR</th>
                        <th>Book Category</th>
                        <th>Is Active</th>
                        <th>Created Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="col-lg-12">
            <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                <span class="fs-15" id="lblShowing"></span>

                <nav class="custom-pagination" aria-label="Page navigation example">
                    <ul class="pagination mb-0 justify-content-center" id="pagination"></ul>
                </nav>
            </div>
        </div>

    </div>

    <!-- Modal -->

    <div class="modal fade" id="BookCategoryModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">Book Category</h5>

                    <button class="btn-close" data-bs-dismiss="modal"></button>

                </div>

                <div class="modal-body">

                    <input type="hidden" id="hfBookCategoryID" value="0" />

                    <div class="mb-3">

                        <label class="form-label">Book Category</label>

                        <input type="text"
                               id="txtBookCategoryTitle"
                               class="form-control"
                               maxlength="50"
                               placeholder="Enter Book Category" />

                    </div>

                    <!-- Active -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chkIsActive"
                                   checked>

                            <label class="form-check-label" for="chkIsActive">
                                Active
                            </label>
                        </div>
                    </div>




                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button class="btn btn-primary text-white"
                            onclick="SaveBookCategory()">
                        Save
                    </button>

                </div>

            </div>

        </div>

    </div>

    @section Scripts{
        <script>

            var BookCategorys = [];
            var filteredBookCategorys = [];
            var currentPage = 1;
            var pageSize = 10;

            $(document).ready(function () {

                GetBookCategory();

                $("#txtSearch").on("keyup", function () {

                    var search = $(this).val().toLowerCase().trim();

                    filteredBookCategorys = BookCategorys.filter(function (x) {

                        return x.BookCategoryTitle.toLowerCase().includes(search);

                    });

                    currentPage = 1;

                    BindGrid();

                });

            });

            function GetBookCategory() {

                $.ajax({

                    url: "/BCTECHAdmin/GetBookCategoryList",

                    type: "GET",

                    dataType: "json",

                    success: function (data) {

                        BookCategorys = data;
                        filteredBookCategorys = data;

                        currentPage = 1;

                        BindGrid();

                    }

                });

            }

            function BindGrid() {

                var html = "";

                var start = (currentPage - 1) * pageSize;
                var end = Math.min(start + pageSize, filteredBookCategorys.length);

                for (var i = start; i < end; i++) {

                    var item = filteredBookCategorys[i];

                    var isactivecss = "";
                    if (item.IsActive) {
                        isactivecss = "<td><span class='badge bg-success'>Active</span></td>";
                    }
                    else {
                        isactivecss = "<td><span class='badge bg-danger'>Inactive</span></td>";
                    }


                    html += `
                                <tr>

                                     <td>${i + 1}</td>
                                    <td hidden>${item.BookCategoryID}</td>
                                    <td>${item.BookCategoryTitle}</td>
                                     ${isactivecss}
                                    <td>${item.CreatedDateTime}</td>

                                    <td>

                                        <a href="javascript:void(0)"
                                           onclick="EditBookCategory(${item.BookCategoryID})">

                                            <i class="ri-edit-line text-primary"></i>

                                        </a>

                                        &nbsp;&nbsp;

                                        <a href="javascript:void(0)"
                                           onclick="DeleteBookCategory(${item.BookCategoryID})">

                                            <i class="ri-delete-bin-line text-danger"></i>

                                        </a>

                                    </td>

                                </tr>`;
                }

                $("#tblBookCategory tbody").html(html);

                $("#lblShowing").text(

                    `Showing ${filteredBookCategorys.length == 0 ? 0 : start + 1}
                                 to ${end}
                                 of ${filteredBookCategorys.length} entries`

                );

                CreatePagination();

            }

            function CreatePagination() {

                var totalPages = Math.ceil(filteredBookCategorys.length / pageSize);

                var html = "";

                html += `
                            <li class="page-item ${currentPage == 1 ? 'disabled' : ''}">
                                <a class="page-link"
                                   href="javascript:void(0)"
                                   ${currentPage == 1 ? '' : `onclick="ChangePage(${currentPage - 1})"`}>
                                    <i class="material-symbols-outlined">west</i>
                                </a>
                            </li>`;

                for (var i = 1; i <= totalPages; i++) {

                    html += `
                                <li class="page-item">

                                    <a class="page-link ${currentPage == i ? 'active' : ''}"
                                       href="javascript:void(0)"
                                       onclick="ChangePage(${i})">

                                        ${i}

                                    </a>

                                </li>`;

                }

                html += `
                            <li class="page-item ${currentPage == totalPages ? 'disabled' : ''}">
                                <a class="page-link"
                                   href="javascript:void(0)"
                                   ${currentPage == totalPages ? '' : `onclick="ChangePage(${currentPage + 1})"`}>
                                    <i class="material-symbols-outlined">east</i>
                                </a>
                            </li>`;

                $("#pagination").html(html);

            }

            function ChangePage(page) {

                var totalPages = Math.ceil(filteredBookCategorys.length / pageSize);

                if (page < 1 || page > totalPages)
                    return;

                currentPage = page;

                BindGrid();

            }

            function OpenBookCategoryModal() {

                $("#hfBookCategoryID").val(0);

                $("#txtBookCategoryTitle").val("");

                $("#BookCategoryModal").modal("show");

            }

            function SaveBookCategory() {

                if ($("#txtBookCategoryTitle").val().trim() == "") {
                    toastr.warning("Please Enter Book Category.");
                    $("#txtBookCategoryTitle").focus();
                    return;
                }
 
                $.ajax({

                    url: "/BCTECHAdmin/SaveBookCategory",

                    type: "POST",

                    data: {
                        BookCategoryID: $("#hfBookCategoryID").val(),
                        BookCategoryTitle: $("#txtBookCategoryTitle").val(),
                        IsActive: $("#chkIsActive").is(":checked")
                        //IsActive: $("#chkIsActive").is(":checked")
                    },

                    success: function (res) {

                        if (res.Status) {
                            toastr.success(res.Message);
                            $("#BookCategoryModal").modal("hide");
                            GetBookCategory();
                        }
                        else {
                            toastr.warning(res.Message);
                        }
                    }

                });

            }

            function EditBookCategory(id) {

                $.ajax({

                    url: "/BCTECHAdmin/GetBookCategoryByID",

                    type: "GET",

                    data: { id: id },

                    success: function (item) {

                        $("#hfBookCategoryID").val(item.BookCategoryID);

                        $("#txtBookCategoryTitle").val(item.BookCategoryTitle);

                        $("#BookCategoryModal").modal("show");

                    }

                });

            }

            function DeleteBookCategory(id) {

                Swal.fire({

                    title: "Are you sure?",

                    text: "You won't be able to recover this record!",

                    icon: "warning",

                    showCancelButton: true,

                    confirmButtonText: "Yes, Delete",

                    cancelButtonText: "Cancel"

                }).then((result) => {

                    if (result.isConfirmed) {

                        $.ajax({

                            url: "/BCTECHAdmin/DeleteBookCategory",

                            type: "POST",

                            data: { id: id },

                            success: function (response) {

                                if (response == "Success") {

                                    Swal.fire({

                                        icon: "success",

                                        title: "Deleted",

                                        text: "Book Category Deleted Successfully",

                                        timer: 1500,

                                        showConfirmButton: false

                                    });

                                    GetBookCategory();

                                }

                            }

                        });

                    }

                });

            }

        </script>
    }

</div>
