@{
    ViewBag.Title = "Student Birthday Reminders";
    ViewData["PageTitle"] = "Student Birthday Reminders";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<style>
    /* Table layout overrides for style.css global table-layout: fixed */
    #tblBirthdayReminders {
        table-layout: auto !important;
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
    }

    #tblBirthdayReminders th, 
    #tblBirthdayReminders td {
        overflow: visible !important;
        text-overflow: clip !important;
        white-space: normal !important;
        vertical-align: middle !important;
        padding: 12px 14px !important;
    }

    /* Remove DataTables sorting arrows completely */
    #tblBirthdayReminders th::before,
    #tblBirthdayReminders th::after,
    #tblBirthdayReminders .sorting::before,
    #tblBirthdayReminders .sorting::after,
    #tblBirthdayReminders .sorting_asc::before,
    #tblBirthdayReminders .sorting_asc::after,
    #tblBirthdayReminders .sorting_desc::before,
    #tblBirthdayReminders .sorting_desc::after {
        display: none !important;
        content: "" !important;
    }

    .nowrap-cell {
        white-space: nowrap !important;
    }

    .reminders-hero-card {
        border-radius: 14px;
        background: #ffffff;
        border: 1px solid #edf2f7;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .reminders-hero-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }
    .icon-box-lg {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }
    .filter-btn-pill {
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        padding: 7px 18px;
        transition: all 0.2s ease;
    }
    .student-avatar-thumb {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #e2e8f0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.06);
    }
    .table-pro-birthday thead th {
        background: #2563eb !important;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 13.5px;
        letter-spacing: 0.3px;
        border: none;
        cursor: default !important;
    }
    .table-pro-birthday tbody tr:hover {
        background-color: #f8fafc;
    }
    .btn-whatsapp-action {
        background: #25D366;
        color: #fff !important;
        border: none;
        font-weight: 500;
        font-size: 12px;
        padding: 6px 14px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        box-shadow: 0 2px 6px rgba(37, 211, 102, 0.25);
        transition: background 0.2s;
    }
    .btn-whatsapp-action:hover {
        background: #1eb857;
    }
    .badge-today-pill {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fca5a5;
        font-weight: 600;
    }
    .badge-upcoming-pill {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
        font-weight: 600;
    }

    /* Custom Search Input */
    .custom-search-input {
        height: 38px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 30px !important;
        padding-left: 38px !important;
        padding-right: 14px !important;
        font-size: 13.5px !important;
        background-color: #f8fafc !important;
        transition: all 0.2s ease;
    }
    .custom-search-input:focus {
        background-color: #ffffff !important;
        border-color: #2563eb !important;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    }

    /* DataTables Info & Pagination */
    .dataTables_info {
        font-size: 13.5px !important;
        color: #64748b !important;
        padding: 0 !important;
    }
    .dataTables_paginate {
        padding: 0 !important;
    }
    .dataTables_paginate .paginate_button {
        padding: 6px 14px !important;
        margin: 0 2px !important;
        border-radius: 6px !important;
        border: 1px solid #e2e8f0 !important;
        background: #fff !important;
        color: #475569 !important;
        font-size: 13px !important;
        cursor: pointer !important;
    }
    .dataTables_paginate .paginate_button.current,
    .dataTables_paginate .paginate_button.current:hover {
        background: #2563eb !important;
        color: #fff !important;
        border-color: #2563eb !important;
        font-weight: 600 !important;
    }
    .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        color: #1e293b !important;
        border-color: #cbd5e1 !important;
    }
</style>

<div class="student-birthday-wrapper pt-2 pb-5">
    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-body p-3 p-md-4">
            <!-- Sleek Single-Row Toolbar (Filters on left, Search on right) -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
                <div class="d-flex flex-wrap gap-2" id="birthdayFilterGroup">
                    <button type="button" class="btn btn-primary filter-btn-pill active" data-filter="7days" onclick="filterBirthday('7days', this)">
                        7-Day Window
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="today" onclick="filterBirthday('today', this)">
                        Today's Birthdays
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="upcoming7" onclick="filterBirthday('upcoming7', this)">
                        Next 7 Days
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="ago7" onclick="filterBirthday('ago7', this)">
                        Past 7 Days
                    </button>
                    <button type="button" class="btn btn-outline-secondary filter-btn-pill" data-filter="all" onclick="filterBirthday('all', this)">
                        All Birthdays
                    </button>
                </div>

                <!-- Custom Search on Right -->
                <div class="d-flex align-items-center gap-2">
                    <div class="position-relative" style="min-width: 250px;">
                        <input type="text" id="txtCustomBirthdaySearch" class="form-control custom-search-input" placeholder="Search student, enroll, mobile...">
                        <i class="material-symbols-outlined position-absolute start-0 top-50 translate-middle-y ms-2 text-muted fs-18">search</i>
                    </div>
                </div>
            </div>

            <!-- Table (Proper Layout, No Horizontal Scrollbar on Desktop) -->
            <div class="table-responsive rounded-3 border">
                <table id="tblBirthdayReminders" class="table table-pro-birthday align-middle w-100 mb-0">
                    <thead>
                        <tr>
                            <th class="text-center nowrap-cell" style="width: 45px;">#</th>
                            <th class="nowrap-cell" style="width: 140px;">Enrollment No.</th>
                            <th class="nowrap-cell" style="width: 110px;">Date Of Birth</th>
                            <th class="nowrap-cell text-center" style="width: 85px;">Age</th>
                            <th style="min-width: 200px;">Student Name</th>
                            <th class="nowrap-cell text-center" style="width: 80px;">Gender</th>
                            <th class="nowrap-cell" style="width: 125px;">Mobile</th>
                            <th class="nowrap-cell text-center" style="width: 110px;">Status</th>
                            <th class="nowrap-cell text-center" style="width: 140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblBirthdayRemindersBody">
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="ri-loader-4-line ri-spin fs-24 align-middle me-1 text-primary"></i> Loading Birthday Data...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var birthdayDataTable = null;
        var currentFilter = "7days";

        $(document).ready(function () {
            loadBirthdayReminders(currentFilter);

            // Connect custom search input
            $("#txtCustomBirthdaySearch").on("keyup", function () {
                if (birthdayDataTable) {
                    birthdayDataTable.search(this.value).draw();
                }
            });
        });

        function filterBirthday(filterType, btn) {
            $("#birthdayFilterGroup button").removeClass("btn-primary active").addClass("btn-outline-secondary");
            $(btn).removeClass("btn-outline-secondary").addClass("btn-primary active");
            currentFilter = filterType;
            loadBirthdayReminders(filterType);
        }

        function loadBirthdayReminders(filterType) {
            if (birthdayDataTable) {
                birthdayDataTable.destroy();
                birthdayDataTable = null;
            }
            $("#tblBirthdayRemindersBody").html('<tr><td colspan="9" class="text-center py-5 text-muted"><i class="ri-loader-4-line ri-spin fs-24 align-middle me-1 text-primary"></i> Loading Birthday Data...</td></tr>');

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetBirthdayRemindersList",
                data: { filter: filterType },
                dataType: "json",
                success: function (res) {
                    if (res && res.Status && res.Data) {
                        var list = res.Data;

                        // Update KPI counts
                        var todayCount = 0;
                        var upcomingCount = 0;
                        var pastCount = 0;
                        $.each(list, function(i, item) {
                            if (item.DaysDiff === 0) todayCount++;
                            else if (item.DaysDiff > 0 && item.DaysDiff <= 7) upcomingCount++;
                            else if (item.DaysDiff < 0 && item.DaysDiff >= -7) pastCount++;
                        });
                        if (filterType === "7days" || filterType === "all") {
                            $("#kpiTodayCount").text(todayCount);
                            $("#kpiUpcomingCount").text(upcomingCount);
                            $("#kpiPastCount").text(pastCount);
                            $("#kpiTotalCount").text(list.length);
                        }

                        if (list.length === 0) {
                            $("#tblBirthdayRemindersBody").html('<tr><td colspan="9" class="text-center py-5 text-muted"><i class="material-symbols-outlined fs-36 text-secondary d-block mb-2">cake</i>No birthdays found for the selected filter.</td></tr>');
                            return;
                        }

                        var rows = [];
                        $.each(list, function (i, item) {
                            var cleanPhone = (item.Mobile || "").replace(/\D/g, '');
                            if (cleanPhone.length === 10) cleanPhone = "91" + cleanPhone;

                            var wishMsg = encodeURIComponent("Dear " + item.StudentName + ", BC Tech Computer Education wishes you a very Happy Birthday! 🎂 May you achieve great success in your career and life!");
                            var waLink = cleanPhone ? 'https://api.whatsapp.com/send?phone=' + cleanPhone + '&text=' + wishMsg : '#';

                            var studentCol = '<div class="d-flex align-items-center gap-2">' +
                                             '<img src="' + item.Photo + '" class="student-avatar-thumb flex-shrink-0" onerror="this.onerror=null;this.src=\'/Content/Admin/assets/images/no-image.png\';" />' +
                                             '<div>' +
                                             '<div class="fw-bold text-dark fs-13">' + escapeHtml(item.StudentName) + '</div>' +
                                             '<small class="text-muted">' + escapeHtml(item.CourseTitle) + '</small>' +
                                             '</div>' +
                                             '</div>';

                            var badgeClass = item.DaysDiff === 0 ? 'badge-today-pill' : (item.DaysDiff > 0 ? 'badge-upcoming-pill' : 'bg-secondary text-white');
                            var badgeHtml = '<span class="badge ' + badgeClass + ' px-2 py-1 fs-12 rounded-pill nowrap-cell">' +
                                            (item.DaysDiff === 0 ? '🎂 ' : '') + escapeHtml(item.StatusText) +
                                            '</span>';

                            var actionHtml = cleanPhone
                                ? '<a href="' + waLink + '" target="_blank" class="btn btn-whatsapp-action">' +
                                  '<i class="ri-whatsapp-line fs-14"></i> Wish on WhatsApp' +
                                  '</a>'
                                : '<span class="text-muted fs-12">-</span>';

                            var genderBadge = item.Gender === 'Female' 
                                ? '<span class="badge bg-pink-subtle text-danger border border-danger-subtle nowrap-cell">Female</span>' 
                                : '<span class="badge bg-primary-subtle text-primary border border-primary-subtle nowrap-cell">Male</span>';

                            var ageText = (item.Age > 0) ? (item.Age + ' Year Old') : '-';

                            rows.push('<tr>' +
                                      '<td class="text-center text-muted fw-semibold nowrap-cell">' + (i + 1) + '</td>' +
                                      '<td class="nowrap-cell"><span class="badge bg-light text-dark border fw-medium px-2 py-1">' + (escapeHtml(item.EnrollmentNo) || '-') + '</span></td>' +
                                      '<td class="fw-semibold text-secondary nowrap-cell">' + item.DOBFormatted + '</td>' +
                                      '<td class="text-center nowrap-cell"><span class="fw-bold text-dark">' + ageText + '</span></td>' +
                                      '<td>' + studentCol + '</td>' +
                                      '<td class="text-center nowrap-cell">' + genderBadge + '</td>' +
                                      '<td class="nowrap-cell"><a href="tel:' + item.Mobile + '" class="text-decoration-none text-dark fw-medium"><i class="ri-phone-line text-muted me-1"></i>' + (escapeHtml(item.Mobile) || '-') + '</a></td>' +
                                      '<td class="text-center nowrap-cell">' + badgeHtml + '</td>' +
                                      '<td class="text-center nowrap-cell">' + actionHtml + '</td>' +
                                      '</tr>');
                        });

                        $("#tblBirthdayRemindersBody").html(rows.join(""));
                        birthdayDataTable = $("#tblBirthdayReminders").DataTable({
                            pageLength: 20,
                            ordering: false,
                            autoWidth: false,
                            dom: 'rt<"d-flex justify-content-between align-items-center px-3 py-3 border-top flex-wrap gap-2"ip>',
                            language: {
                                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                                paginate: {
                                    previous: "Previous",
                                    next: "Next"
                                },
                                emptyTable: "No students found."
                            }
                        });

                        // Re-apply custom search if text is present
                        var searchVal = $("#txtCustomBirthdaySearch").val();
                        if (searchVal) {
                            birthdayDataTable.search(searchVal).draw();
                        }
                    } else {
                        $("#tblBirthdayRemindersBody").html('<tr><td colspan="9" class="text-center py-4 text-danger">' + (res.Message || 'Failed to load birthday data.') + '</td></tr>');
                    }
                },
                error: function (xhr, status, error) {
                    $("#tblBirthdayRemindersBody").html('<tr><td colspan="9" class="text-center py-4 text-danger">Error loading birthday data: ' + error + '</td></tr>');
                }
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }
    </script>
}
