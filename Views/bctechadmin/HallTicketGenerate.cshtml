@model BCTECHERP.Models.HallTicket
@{
    ViewBag.Title = "Generate Hall Ticket";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
    ViewData["ParentMenu"] = "Student Exam";
    ViewData["PageTitle"] = "Generate Hall Ticket";
}

<style>
    .card-custom-header {
        background-color: #2f80ed !important;
        color: #ffffff !important;
        padding: 12px 20px;
        font-weight: 600;
        font-size: 15px;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    .btn-purple {
        background-color: #6f42c1 !important;
        border-color: #6f42c1 !important;
        color: #ffffff !important;
        transition: all 0.2s ease-in-out;
    }

        .btn-purple:hover {
            background-color: #59359a !important;
            box-shadow: 0 4px 8px rgba(111, 66, 193, 0.3);
        }

    .btn-save-view {
        background-color: #00c292 !important;
        border-color: #00c292 !important;
        color: #ffffff !important;
        transition: all 0.2s ease-in-out;
    }

        .btn-save-view:hover {
            background-color: #00a87e !important;
            box-shadow: 0 4px 8px rgba(0, 194, 146, 0.3);
        }

    .btn-back-coral {
        background-color: #fb9678 !important;
        border-color: #fb9678 !important;
        color: #ffffff !important;
        transition: all 0.2s ease-in-out;
    }

        .btn-back-coral:hover {
            background-color: #e58265 !important;
            box-shadow: 0 4px 8px rgba(251, 150, 120, 0.3);
        }

    #tblstudent {
        table-layout: auto !important;
        width: 100% !important;
    }

    #tblStudentsRecords th, #tblstudent th {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding: 10px 12px;
        white-space: nowrap !important;
        overflow: visible !important;
        text-overflow: unset !important;
    }

    #tblStudentsRecords td, #tblstudent td {
        font-size: 13px;
        color: #334155;
        padding: 10px 12px;
        vertical-align: middle;
        white-space: nowrap !important;
        overflow: visible !important;
        text-overflow: unset !important;
    }

    #tblstudent th:nth-child(2),
    #tblstudent td:nth-child(2) {
        min-width: 260px !important;
        white-space: nowrap !important;
        overflow: visible !important;
        text-overflow: unset !important;
    }

    body[data-theme="dark"] #tblstudent th,
    body[data-theme="dark"] #tblStudentsRecords th {
        background-color: #1e293b !important;
        color: #94a3b8 !important;
        border-bottom-color: #334155 !important;
    }

    body[data-theme="dark"] #tblstudent td,
    body[data-theme="dark"] #tblStudentsRecords td {
        color: #e2e8f0 !important;
        border-bottom-color: #334155 !important;
    }

    /* Support legacy filled-in checkbox class if generated by controller */
    .filled-in {
        cursor: pointer;
        width: 16px;
        height: 16px;
    }
</style>

<div class="row g-4">
    <div class="col-12">
        <form method="post" action="/bctechAdmin/HallTicketGenerate" id="frmHallTicket">

            <div class="row g-4">
                <!-- Left Column: Form Controls -->
                <div class="col-lg-3 col-md-3">
                    <div class="card bg-white rounded-10 border border-light shadow-sm">
                        <div class="card-custom-header d-flex align-items-center">
                            Generate Hall Ticket
                        </div>
                        <div class="card-body p-4">

                            <!-- Branch Dropdown -->
                            <div class="mb-3">
                                <label class="form-label text-secondary fs-13 fw-semibold">Select Branch</label>
                                @if (ViewBag.DropDownValueBranch != null)
                                {
                                    @Html.DropDownList("branch_id", (SelectList)ViewBag.DropDownValueBranch, new { @class = "form-select", @id = "branch_id", @disabled = "disabled" })
                                }
                                else
                                {
                                    <select class="form-select" id="branch_id" name="branch_id" disabled>
                                        <option value="0">Select Branch</option>
                                    </select>
                                }
                            </div>

                            <!-- Schedule Exam Dropdown -->
                            <div class="mb-4">
                                <label class="form-label text-secondary fs-13 fw-semibold">Select Schedule Exam</label>
                                @if (ViewBag.DropDownValue != null)
                                {
                                    @Html.DropDownList("Schedule_Exam_Id", (SelectList)ViewBag.DropDownValue, new { @class = "form-select", @id = "Schedule_Exam_Id", onchange = "OnCourseSelected(this.value)" })
                                }
                                else
                                {
                                    <select class="form-select" id="Schedule_Exam_Id" name="Schedule_Exam_Id" onchange="OnCourseSelected(this.value)">
                                        <option value="0">Select Schedule Exam</option>
                                    </select>
                                }
                            </div>

                            <!-- View Students Details Button -->
                            <div class="mb-4">
                                <button type="button" id="btnViewStudents" class="btn btn-purple w-100 py-2 fw-medium rounded-6" onclick="loadStudentsAjax();">
                                    <i class="fa fa-check me-1"></i> <span id="btnViewStudentsText">View Students Details</span>
                                </button>
                            </div>

                            <!-- Save & View / Back Buttons -->
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" id="btnSaveView" class="btn btn-save-view px-3 py-2 fw-medium rounded-6" onclick="saveHallTicketsAjax();">
                                    <i class="fa fa-eye me-1"></i> <span id="btnSaveViewText">Save & View</span>
                                </button>
                                <a href="/bctechAdmin/ViewHallTicketExam" class="btn btn-back-coral px-3 py-2 fw-medium rounded-6">
                                    <i class="fa fa-arrow-left me-1"></i> Back
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Students Records Table -->
                <div class="col-lg-9 col-md-9">
                    <div class="card bg-white rounded-10 border border-light shadow-sm">
                        <div class="card-custom-header d-flex align-items-center">
                            Students Records
                        </div>
                        <div class="card-body p-4">

                            <!-- Total Selected Students Counter -->
                            <p id="TotalSelect" class="text-secondary fs-13 fw-semibold mb-3">
                                Total Selected Students : <span id="lblSelectedCount" class="text-primary fw-bold">0</span>
                            </p>

                            <!-- Students Table -->
                            <div class="table-responsive" style="max-height: 520px; overflow-y: auto; overflow-x: auto;">
                                <table class="table table-hover align-middle border-bottom w-100" id="tblstudent">
                                    <thead>
                                        <tr>
                                            <th style="width: 50px;">
                                                <input type="checkbox" id="chkboxbasic" class="filled-in" value="swaroop" />
                                                <label for="chkboxbasic" style="height: 0px; margin-bottom: 0px;"></label>
                                            </th>
                                            <th style="min-width: 260px;">Student Name</th>
                                            <th style="min-width: 130px;">Enrollment</th>
                                            <th style="min-width: 120px;">Mobile No</th>
                                            <th style="min-width: 110px;">Total Fees</th>
                                            <th style="min-width: 110px;">Paid Fees</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblStudentsBody">
                                        @if (ViewBag.studtable != null && !string.IsNullOrEmpty(ViewBag.studtable.ToString()))
                                        {
                                            @Html.Raw(ViewBag.studtable)
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>
                                                    <div class="form-check m-0 d-flex align-items-center gap-1">
                                                        <input type="checkbox" id="chkSelectPlaceholder" class="form-check-input" />
                                                        <label for="chkSelectPlaceholder" class="form-check-label fs-13 cursor-pointer">Select</label>
                                                    </div>
                                                </td>
                                                <td>Student Name</td>
                                                <td>Enrollment</td>
                                                <td>Mobile No</td>
                                                <td>Total Fees</td>
                                                <td>Paid Fees</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Hidden input containing '|'-separated student IDs -->
                            <input type="hidden" name="all_Student_id" id="all_Student_id" value="@(ViewBag.studid ?? "")" />
                            <input type="hidden" name="SecureCode" id="SecureCode" value="@(Model != null ? Model.SecureCode.ToString() : "")" />

                        </div>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        function SelectCheck(chk) {
            var ids = "";
            var total = 0;
            var chkRows = $("#tblstudent tbody input[type=checkbox]");

            chkRows.each(function () {
                if ($(this).is(':checked') && $(this).val()) {
                    ids = ids + $(this).val() + '|';
                    total += 1;
                }
            });

            if (document.getElementById("lblSelectedCount")) {
                document.getElementById("lblSelectedCount").innerHTML = total;
            }
            if (document.getElementById("TotalSelect")) {
                document.getElementById("TotalSelect").innerHTML = "Total Selected Students : " + total;
            }
            document.getElementById("all_Student_id").value = ids;

            var totalCheckboxes = chkRows.length;
            $('#chkboxbasic').prop('checked', totalCheckboxes > 0 && totalCheckboxes === total);
        }

        function getCookie(name) {
            var match = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
            return match ? decodeURIComponent(match[3]) : null;
        }

        $(function () {
            // Auto bind Select Branch from cookie if not already set by server
            var currentVal = $('#branch_id').val();
            if (!currentVal || currentVal === "0") {
                var cBranchId = getCookie('BranchID');
                var cBranchName = getCookie('BranchName');
                if (cBranchId && cBranchId !== "0" && $('#branch_id option[value="' + cBranchId + '"]').length > 0) {
                    $('#branch_id').val(cBranchId);
                } else if (cBranchName) {
                    $('#branch_id option').each(function () {
                        if ($(this).text().trim().toLowerCase() === cBranchName.trim().toLowerCase()) {
                            $('#branch_id').val($(this).val());
                            return false;
                        }
                    });
                }
            }

            // Master checkbox Select All / Deselect All
            $("#chkboxbasic").click(function () {
                var ids = "";
                var isChecked = this.checked;
                var chkRows = $("#tblstudent tbody input[type=checkbox]");
                var total = 0;

                chkRows.each(function () {
                    $(this).prop('checked', isChecked);
                    if (isChecked && $(this).val()) {
                        ids = ids + $(this).val() + '|';
                        total += 1;
                    }
                });

                if (document.getElementById("lblSelectedCount")) {
                    document.getElementById("lblSelectedCount").innerHTML = total;
                }
                if (document.getElementById("TotalSelect")) {
                    document.getElementById("TotalSelect").innerHTML = "Total Selected Students : " + total;
                }
                document.getElementById("all_Student_id").value = ids;
            });
        });

        function OnBranchChanged(branchId) {
            var bId = parseInt(branchId) || 0;
            $.ajax({
                url: '/bctechAdmin/GetScheduleExamsByBranch',
                type: 'POST',
                data: { branchId: bId },
                dataType: 'json',
                success: function (res) {
                    if (res && res.status && res.exams) {
                        var $ddl = $('#Schedule_Exam_Id');
                        $ddl.empty();
                        $ddl.append($('<option>', { value: '0', text: 'Select Schedule Exam' }));
                        $.each(res.exams, function (i, item) {
                            $ddl.append($('<option>', { value: item.id, text: item.text }));
                        });
                    }
                }
            });
        }

        function OnCourseSelected(abc) {
            var code = abc;
            if (!code || code == "0") {
                document.getElementById("SecureCode").value = "0";
                return;
            }
            document.getElementById("SecureCode").value = code;
        }

        function loadStudentsAjax() {
            var seId = $('#Schedule_Exam_Id').val();
            if (!seId || seId === "0" || seId === "") {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Warning', 'Please select a Schedule Exam first.', 'warning');
                } else {
                    alert('Please select a Schedule Exam first.');
                }
                $('#Schedule_Exam_Id').focus();
                return;
            }

            var bId = $('#branch_id').val() || 0;
            var $btn = $('#btnViewStudents');
            var $btnText = $('#btnViewStudentsText');
            var originalText = $btnText.text();

            $btn.prop('disabled', true);
            $btnText.html('<i class="fa fa-spinner fa-spin me-1"></i> Loading...');

            $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center py-4 text-secondary"><i class="fa fa-spinner fa-spin me-2"></i>Loading student records...</td></tr>');

            $.ajax({
                url: '/bctechAdmin/GetStudentsForHallTicket',
                type: 'POST',
                data: { scheduleExamId: seId, branchId: bId },
                dataType: 'json',
                success: function (res) {
                    $btn.prop('disabled', false);
                    $btnText.text(originalText);

                    if (res && res.status) {
                        if (res.secureCode) {
                            $('#SecureCode').val(res.secureCode);
                        }

                        if (!res.students || res.students.length === 0) {
                            $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center text-muted py-4">No eligible students found for this exam.</td></tr>');
                            $('#lblSelectedCount').text('0');
                            $('#TotalSelect').text('Total Selected Students : 0');
                            $('#all_Student_id').val('');
                            $('#chkboxbasic').prop('checked', false);
                            return;
                        }

                        var html = '';
                        var ids = '';
                        var count = res.students.length;

                        $.each(res.students, function (i, s) {
                            var chkId = 'basic_checkbox_' + (i + 1);
                            ids += s.studentId + '|';

                            html += '<tr>';
                            html += '<td><input type="checkbox" id="' + chkId + '" class="filled-in form-check-input" value="' + s.studentId + '" checked="checked" onclick="SelectCheck(this.value);" /> <label for="' + chkId + '" style="height:0px;"></label></td>';
                            html += '<td style="min-width:260px; white-space:nowrap;">' + (s.studentName || '') + '</td>';
                            html += '<td style="min-width:130px; white-space:nowrap;">' + (s.enrollment || '') + '</td>';
                            html += '<td style="min-width:120px; white-space:nowrap;">' + (s.mobileNo || '') + '</td>';
                            html += '<td style="min-width:110px; white-space:nowrap;">' + (s.totalFees || '₹ 0.00') + '</td>';
                            html += '<td style="min-width:110px; white-space:nowrap;">' + (s.paidFees || '₹ 0.00') + '</td>';
                            html += '</tr>';
                        });

                        $('#tblStudentsBody').html(html);
                        $('#all_Student_id').val(ids);
                        $('#lblSelectedCount').text(count);
                        $('#TotalSelect').text('Total Selected Students : ' + count);
                        $('#chkboxbasic').prop('checked', true);
                    } else {
                        var errMsg = (res && res.message) ? res.message : 'Error fetching students.';
                        $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center text-danger py-4">' + errMsg + '</td></tr>');
                    }
                },
                error: function (xhr, status, error) {
                    $btn.prop('disabled', false);
                    $btnText.text(originalText);
                    $('#tblStudentsBody').html('<tr><td colspan="6" class="text-center text-danger py-4">Failed to load student records. Please try again.</td></tr>');
                }
            });
        }

        function saveHallTicketsAjax() {
            var seId = $('#Schedule_Exam_Id').val();
            if (!seId || seId === "0" || seId === "") {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Warning', 'Please select a Schedule Exam first.', 'warning');
                } else {
                    alert('Please select a Schedule Exam first.');
                }
                return;
            }

            var allIds = $('#all_Student_id').val() || '';
            var ids = allIds.split('|').filter(function (x) { return x.trim() !== ''; });
            if (ids.length === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Notice', 'Please select at least one student before saving.', 'info');
                } else {
                    alert('Please select at least one student before saving.');
                }
                return;
            }

            var bId = $('#branch_id').val() || 0;
            var scCode = $('#SecureCode').val() || 0;

            var $btn = $('#btnSaveView');
            var $btnText = $('#btnSaveViewText');
            var originalText = $btnText.text();

            $btn.prop('disabled', true);
            $btnText.html('<i class="fa fa-spinner fa-spin me-1"></i> Saving...');

            $.ajax({
                url: '/bctechAdmin/SaveHallTicketAjax',
                type: 'POST',
                data: {
                    scheduleExamId: seId,
                    branchId: bId,
                    secureCode: scCode,
                    studentIds: allIds
                },
                dataType: 'json',
                success: function (res) {
                    $btn.prop('disabled', false);
                    $btnText.text(originalText);

                    if (res && res.status) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: res.message || 'Record save successfully.',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(function () {
                                window.location.href = res.redirectUrl || '/bctechAdmin/ViewHallTicketExam';
                            });
                        } else {
                            alert(res.message || 'Record save successfully.');
                            window.location.href = res.redirectUrl || '/bctechAdmin/ViewHallTicketExam';
                        }
                    } else {
                        var errMsg = (res && res.message) ? res.message : 'Error saving hall tickets.';
                        if (typeof Swal !== 'undefined') {
                            Swal.fire('Error', errMsg, 'error');
                        } else {
                            alert(errMsg);
                        }
                    }
                },
                error: function () {
                    $btn.prop('disabled', false);
                    $btnText.text(originalText);
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Error', 'An error occurred while saving. Please try again.', 'error');
                    } else {
                        alert('An error occurred while saving. Please try again.');
                    }
                }
            });
        }
    </script>
}
