
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Student Fee Receipt Print</title>
    <link rel="stylesheet" href="~/Content/Admin/assets/css/sidebar-menu.css">
    <link rel="stylesheet" href="~/Content/Admin/assets/css/simplebar.css">
    <link rel="stylesheet" href="~/Content/Admin/assets/css/prism.css">
    <link rel="stylesheet" href="~/Content/Admin/assets/css/quill.snow.css">
    <link rel="stylesheet" href="~/Content/Admin/assets/css/remixicon.css">
    <link rel="stylesheet" href="~/Content/Admin/assets/css/swiper-bundle.min.css">
    <link rel="stylesheet" href="~/Content/Admin/assets/css/jsvectormap.min.css">
    <link rel="stylesheet" href="~/Content/Admin/assets/css/style.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>



    <input type="hidden" id="hfreceiptId" value="@ViewBag.StudentID" />

    <style type="text/css">
        .invoice-container {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #212529;
            background: #fff;
            padding: 15px;
        }

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }

            .invoice-table th, .invoice-table td {
                border: 1px solid #dee2e6;
                padding: 6px 10px;
                font-size: 13px;
            }

            .invoice-table th {
                background-color: #f8f9fa;
                font-weight: 600;
            }

        .bg-label {
            background-color: #f1f3f5 !important;
            font-weight: 600;
            color: #495057;
        }

        .highlight-amount-box {
            background-color: #e2e3e5;
            border: 1px solid #ced4da;
            text-align: center;
            font-size: 22px;
            font-weight: 700;
            padding: 10px 15px;
            border-radius: 4px;
            color: #111;
            margin-top: 10px;
        }

        @@import url('https://fonts.googleapis.com/css2?family=Libre+Barcode+128&display=swap');

        .barcode-box {
            font-family: 'Libre Barcode 128', monospace;
            font-size: 38px;
            line-height: 1;
            letter-spacing: 0;
            color: #000;
        }

        .stub-table th, .stub-table td {
            padding: 4px 8px;
            font-size: 12px;
            border: 1px solid #ced4da;
        }

        @@media print {
            /* Hide entire web app UI, sidebars, headers, backdrops */
            body, html {
                background: #ffffff !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
                height: auto !important;
                overflow: visible !important;
            }

            .sidebar-area, .header-area, .footer-area, .card, .modal-backdrop, .modal-header, .modal-footer, .d-print-none, nav, header, aside, .layout-wrapper {
                display: none !important;
            }

            .modal {
                position: absolute !important;
                display: block !important;
                left: 0 !important;
                top: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                height: auto !important;
                overflow: visible !important;
                background: #fff !important;
                box-shadow: none !important;
            }

            .modal-dialog, .modal-content {
                max-width: 100% !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                border: none !important;
                box-shadow: none !important;
                background: #fff !important;
            }

            #printableLedgerArea {
                display: block !important;
                position: absolute !important;
                left: 0 !important;
                top: 0 !important;
                width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

                #printableLedgerArea .table-responsive {
                    display: block !important;
                    overflow: visible !important;
                }

            .invoice-container {
                padding: 0 !important;
                margin: 0 !important;
            }

            .invoice-table {
                margin-bottom: 4px !important;
            }

                .invoice-table th, .invoice-table td {
                    padding: 2px 4px !important;
                    font-size: 10px !important;
                }

            .stub-table th, .stub-table td {
                padding: 1px 3px !important;
                font-size: 9px !important;
            }

            .highlight-amount-box {
                font-size: 16px !important;
                padding: 3px 8px !important;
                margin-top: 2px !important;
            }

            .barcode-box {
                font-size: 16px !important;
            }

            h3 {
                font-size: 18px !important;
                margin-bottom: 0 !important;
            }

            h5 {
                font-size: 13px !important;
                margin-bottom: 2px !important;
            }

            h6 {
                font-size: 11px !important;
                margin-bottom: 2px !important;
            }

            .my-4 {
                margin-top: 4px !important;
                margin-bottom: 4px !important;
            }

            .mb-3 {
                margin-bottom: 4px !important;
            }

            .mb-2 {
                margin-bottom: 2px !important;
            }

            .p-3 {
                padding: 4px !important;
            }

            .pt-3, .pb-3 {
                padding-top: 2px !important;
                padding-bottom: 2px !important;
            }

            .mt-4 {
                margin-top: 4px !important;
            }

            @@page {
                size: A4 portrait;
                margin: 4mm;
            }
        }
    </style>

    <div class="invoice-container">

        <!-- Invoice Top Header -->
        <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-2">
            <div>
                <h3 id="printBranchName" class="fw-bold text-dark mb-1" style="font-size: 24px;">Branch</h3>
                <div class="text-muted fs-13">Student Fee Receipt Invoice</div>
            </div>
            <div class="text-end">
                <div class="fw-bold text-success" style="font-size: 22px;">Receipt # <span id="printReceiptNo">18</span></div>
                <div class="barcode-box text-dark mt-1" id="printBarcodeText">BR002-2026-0007</div>
                <svg id="printBarcodeSVG" class="mt-1" style="max-height: 38px; max-width: 220px; display: none;"></svg>
            </div>
        </div>

        <!-- 2-Column Info Block & Amount Box -->
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <table class="invoice-table m-0">
                    <tr>
                        <td class="bg-label" width="40%">Receipt Date</td>
                        <td id="printReceiptDate" width="60%">18 August 2026</td>
                    </tr>
                    <tr>
                        <td class="bg-label">Received In</td>
                        <td id="printPaymentType">Online</td>
                    </tr>
                    <tr>
                        <td class="bg-label">Cheque/Tran. Number</td>
                        <td id="printTransactionNo">-</td>
                    </tr>
                    <tr>
                        <td class="bg-label">Received Fee</td>
                        <td id="printReceivedFee" class="fw-bold text-success"><i class="fa fa-inr"></i> 5,000.00</td>
                    </tr>
                    <tr>
                        <td class="bg-label">Balance Fee</td>
                        <td id="printBalanceFee" class="fw-bold text-danger"><i class="fa fa-inr"></i> 12,700.00</td>
                    </tr>
                </table>
            </div>

            <div class="col-md-6">
                <div class="bg-light p-2 border rounded-1 mb-2" style="border-color: #dee2e6 !important;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="bg-label pe-2">Received From :</span>
                        <span id="printStudentName" class="fw-bold text-dark fs-14">Shekhar Patil</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="bg-label pe-2">ID Card No. :</span>
                        <span id="printEnrollmentNo" class="fw-semibold">48</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="bg-label pe-2">Section/ Admis Batch :</span>
                        <span id="printBatchTime" class="fw-semibold">10.00 to 11.30 AM</span>
                    </div>
                </div>

                <div class="highlight-amount-box">
                    <i class="fa fa-inr"></i> <span id="printHighlightAmount">5,000.00</span>
                </div>
            </div>
        </div>




        <!-- Signatures Top Section -->
        <div class="row pt-3 pb-3">
            <div class="col-6">
                <div class="fw-bold text-dark mt-4">Authorised Signatory</div>
            </div>
            <div class="col-6 text-end">
                <div class="fw-bold text-dark mt-4">For <span id="printSignBranch">Branch</span></div>
            </div>
        </div>

        <!-- Dotted Separator / OFFICE USE ONLY -->
        <div class="text-center position-relative my-4">
            <hr style="border-top: 2px dashed #6c757d; opacity: 0.8;" />
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 fw-bold text-secondary fs-12 tracking-wider">OFFICE USE ONLY</span>
        </div>

        <!-- OFFICE USE STUB PORTION -->
        <div class="border p-3 rounded bg-white">
            <h5 id="stubBranchTitle" class="text-center fw-bold mb-3 text-dark">Branch</h5>

            <div class="table-responsive mb-3">
                <table class="invoice-table stub-table m-0">
                    <tbody>
                        <tr>
                            <td class="bg-label" width="20%">Student Name</td>
                            <td id="stubStudentName" width="30%" class="fw-bold">Shekhar Patil</td>
                            <td class="bg-label" width="20%">Receipt Number</td>
                            <td id="stubReceiptNo" width="30%" class="fw-bold text-success">18</td>
                        </tr>
                        <tr>
                            <td class="bg-label">Student ID Card No.</td>
                            <td id="stubEnrollmentNo">48</td>
                            <td class="bg-label">Receipt Date</td>
                            <td id="stubReceiptDate">18/08/2026 03:32 PM</td>
                        </tr>
                        <tr>
                            <td class="bg-label">Invoice Number</td>
                            <td id="stubInvoiceNo">48</td>
                            <td class="bg-label">Received Amount</td>
                            <td id="stubReceivedAmount" class="fw-bold text-success"><i class="fa fa-inr"></i> 5,000.00</td>
                        </tr>
                        <tr>
                            <td class="bg-label">Course Joining Date</td>
                            <td id="stubJoiningDate">18/08/2026 03:25 PM</td>
                            <td class="bg-label">Payment Mode</td>
                            <td id="stubPaymentMode">Online</td>
                        </tr>
                        <tr>
                            <td class="bg-label">Fees Payable</td>
                            <td id="stubFeesPayable" class="fw-bold"><i class="fa fa-inr"></i> 17,700.00</td>
                            <td class="bg-label">Cheque/ Tran. Number</td>
                            <td id="stubTranNo">-</td>
                        </tr>
                        <tr>
                            <td class="bg-label">Fees Paid Till Date</td>
                            <td id="stubFeesPaid" class="fw-bold text-success"><i class="fa fa-inr"></i> 5,000.00</td>
                            <td class="bg-label">Account</td>
                            <td id="stubBankName">baroda bank</td>
                        </tr>
                        <tr>
                            <td class="bg-label">Balance Fees</td>
                            <td id="stubBalanceFees" class="fw-bold text-danger"><i class="fa fa-inr"></i> 12,700.00</td>
                            <td class="bg-label">Admission for</td>
                            <td id="stubCourseTitle" class="fw-bold text-primary">SQL</td>
                        </tr>
                        <tr>
                            <td class="bg-label">Concession</td>
                            <td id="stubConcession"><i class="fa fa-inr"></i> 0.00</td>
                            <td class="bg-label">Received By</td>
                            <td id="stubReceivedBy">Admin</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Fees Installment Amount & Paid History Table in Stub -->
            <h6 class="fw-bold text-dark mb-2 border-bottom pb-1"><i class="ri-list-check-2 me-1"></i> Fees Installment Amount & Paid History Table</h6>
            <div class="table-responsive mb-3">
                <table class="invoice-table stub-table">
                    <thead>
                        <tr class="bg-light text-dark">
                            <th style="min-width: 120px;">Invoice #</th>
                            <th style="min-width: 180px;">Package Details</th>
                            <th style="min-width: 120px;">Fees Details</th>
                            <th width="110" class="text-nowrap">Invoice Date</th>
                            <th width="120" class="text-end text-nowrap">Received Fee</th>
                        </tr>
                    </thead>
                    <tbody id="printStubLedgerTableBody">
                        <!-- Dynamic Installment and Receipt Ledger Rows -->
                    </tbody>
                </table>
            </div>

            <div class="row pt-2 pb-1">
                <div class="col-6">
                    <div class="fw-bold text-dark fs-13">Authorised Signatory</div>
                </div>
                <div class="col-6 text-end">
                    <div class="fw-bold text-dark fs-13">For <span id="stubSignBranch">Branch</span></div>
                </div>
            </div>

        </div>

    </div>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
     
    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js" type="text/javascript"></script>



    <script>

        $(document).ready(function () {

            var freceiptId = $("#hfreceiptId").val();

            if (freceiptId != "") {

                LoadStudentDataID(freceiptId);

            }


        });

        function LoadStudentDataID(encryptedId) {


            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetEncryptStudentByID",
                data: { id: encryptedId },
                dataType: "json",
                success: function (res) {
                    //var d = (res && res.Data) ? res.Data : (res && res.IsSuccess ? res : null);
                    //if (d && d.StudentID > 0) {

                    //}
                    if (res.IsSuccess == true) {
                        //alert(res.Message);
                        PrintFeeReceiptLedger(res.Message);
                    }


                },
                error: function () {
                    LoadEnquiryIntoAdmission(encryptedId);
                }
            });
        }



        // Print Fee Receipt & Student Ledger Report
        function PrintFeeReceiptLedger(receiptId) {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentFeeLedgerPrintDetails",
                data: { id: receiptId },
                success: function (res) {
                    if (!res || !res.IsSuccess) {
                        Swal.fire({ icon: 'error', title: 'Error', text: (res ? res.Message : 'Failed to load ledger print details.') });
                        return;
                    }

                    var rec = res.Receipt || {};
                    var stu = res.Student || {};
                    var summary = res.Summary || {};
                    var insts = res.Installments || [];
                    var history = res.PaymentHistory || [];

                    // Populate Top Header & Receipt Info
                    var branch = rec.BranchName || stu.BranchName || "Branch";
                    $("#printBranchName").text(branch);
                    $("#printSignBranch").text(branch);
                    $("#stubBranchTitle").text(branch);

                    var recNo = rec.FeeReceiptNo || (receiptId ? receiptId.toString() : "0");
                    $("#printReceiptNo").text(recNo);
                    $("#printBarcodeText").text(recNo);

                    // Dynamic Barcode Generation using JsBarcode with Font Fallback
                    try {
                        if (typeof JsBarcode === "function") {
                            JsBarcode("#printBarcodeSVG", recNo, {
                                format: "CODE128",
                                width: 1.5,
                                height: 35,
                                displayValue: false,
                                margin: 0
                            });
                            $("#printBarcodeSVG").show();
                            $("#printBarcodeText").hide();
                        } else {
                            $("#printBarcodeText").show();
                            $("#printBarcodeSVG").hide();
                        }
                    } catch (e) {
                        $("#printBarcodeText").show();
                        $("#printBarcodeSVG").hide();
                    }

                    $("#printReceiptDate").text(rec.ReceiptDateShort || '-');
                    $("#printPaymentType").text(rec.PaymentTypeTitle || 'Cash');
                    $("#printTransactionNo").text(rec.TransactionNo || '-');

                    var recFeeAmt = parseFloat(rec.AmountReceived || 0);
                    $("#printReceivedFee").html("<i class='fa fa-inr'></i> " + recFeeAmt.toFixed(2));

                    var balFeeAmt = parseFloat(summary.BalanceFee || 0);
                    $("#printBalanceFee").html("<i class='fa fa-inr'></i> " + balFeeAmt.toFixed(2));

                    var stuEnrClean = (stu.StudentEnrollmentNo && !stu.StudentEnrollmentNo.startsWith("AUTO-")) ? stu.StudentEnrollmentNo : '-';
                    $("#printStudentName").text(stu.StudentFullName || '-');
                    $("#printEnrollmentNo").text(stuEnrClean);
                    $("#printBatchTime").text(stu.BatchTime || '-');
                    $("#printHighlightAmount").text(recFeeAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }));


                    // Populate FeesInstallment & Paid History Table
                    var htmlLedger = "";
                    if (history && history.length > 0) {
                        $.each(history, function (i, item) {
                            var amt = parseFloat(item.AmountReceived || 0).toFixed(2);

                            htmlLedger += "<tr>";
                            htmlLedger += "<td class='fw-semibold text-nowrap'>" + (item.FeeReceiptNo || (stu.StudentEnrollmentNo || '-')) + "</td>";
                            htmlLedger += "<td style='white-space: normal; word-break: break-word;'>" + (stu.CourseTitle || 'General Course') + "</td>";
                            htmlLedger += "<td>" + (item.FeesTypeTitle || ('Installment ' + (i + 1))) + "</td>";
                            htmlLedger += "<td class='text-nowrap'>" + (item.ReceiptDateShort || item.ReceiptDateFormatted || '-') + "</td>";
                            htmlLedger += "<td class='text-end fw-bold text-success text-nowrap'><i class='fa fa-inr'></i> " + amt + "</td>";
                            htmlLedger += "</tr>";
                        });
                    } else if (insts && insts.length > 0) {
                        $.each(insts, function (i, item) {
                            htmlLedger += "<tr>";
                            htmlLedger += "<td class='fw-semibold text-nowrap'>" + (stu.StudentEnrollmentNo || '-') + "</td>";
                            htmlLedger += "<td style='white-space: normal; word-break: break-word;'>" + (stu.CourseTitle || 'General Course') + "</td>";
                            htmlLedger += "<td>" + (item.InstallmentName || ('Installment ' + (i + 1))) + "</td>";
                            htmlLedger += "<td class='text-nowrap'>" + (item.DueDate || '-') + "</td>";
                            htmlLedger += "<td class='text-end text-muted text-nowrap'>0.00</td>";
                            htmlLedger += "</tr>";
                        });
                    } else {
                        htmlLedger = "<tr><td colspan='5' class='text-center text-muted'>No fee installment details found.</td></tr>";
                    }

                    $("#printLedgerTableBody, #printStubLedgerTableBody").html(htmlLedger);

                    // Populate Stub Details (Office Use Portion)
                    $("#stubSignBranch").text(branch);
                    $("#stubStudentName").text(stu.StudentFullName || '-');
                    $("#stubEnrollmentNo").text(stuEnrClean);
                    $("#stubInvoiceNo").text(stuEnrClean !== '-' ? stuEnrClean : (rec.FeeReceiptNo || '-'));
                    $("#stubJoiningDate").text(stu.JoiningDateFormatted || '-');

                    var totFee = parseFloat(summary.TotalFeeAmount || 0);
                    var totPaid = parseFloat(summary.TotalReceived || 0);

                    $("#stubFeesPayable").html("<i class='fa fa-inr'></i> " + totFee.toFixed(2));
                    $("#stubFeesPaid").html("<i class='fa fa-inr'></i> " + totPaid.toFixed(2));
                    $("#stubBalanceFees").html("<i class='fa fa-inr'></i> " + balFeeAmt.toFixed(2));

                    $("#stubReceiptNo").text(rec.FeeReceiptNo || receiptId);
                    $("#stubReceiptDate").text(rec.ReceiptDateFormatted || '-');
                    $("#stubReceivedAmount").html("<i class='fa fa-inr'></i> " + recFeeAmt.toFixed(2));
                    $("#stubPaymentMode").text(rec.PaymentTypeTitle || 'Cash');
                    $("#stubTranNo").text(rec.TransactionNo || '-');
                    $("#stubBankName").text(rec.BankName || 'Cash');
                    $("#stubCourseTitle").text(stu.CourseTitle || 'General');
                    $("#stubReceivedBy").text(rec.ReceivedByUserName || 'Admin');
                    $("#stubReceivedBySignature").text(rec.ReceivedByUserName || 'Admin');
                    $("#stubComment").text(rec.Remarks || '-');


 
                  
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to fetch ledger report details.' });
                }
            });
        }

    </script>

</body>
</html>
