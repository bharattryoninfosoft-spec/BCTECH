
@{
    ViewBag.Title = "BranchMaster";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}


<div class="social-profile">
    <div class="card border-0 bg-white rounded-10 mb-4">
        <div class="position-relative">
            <img src="~/Content/Admin/assets/Images/Bannerpage.png" class="rounded-top-3 w-100" alt="profile-cover">
            <div class="position-absolute z-1" style="bottom: 20px; right: 20px;">
                @*<button class="btn btn-primary text-white fs-16 fw-normal hover rounded-1" style="padding: 14px 26px;">
                        Edit Cover Photo
                    </button>*@
            </div>
        </div>
        <div class="card border-0 rounded-10 p-20 pb-0 rounded-top-0 profile-info" style="background-color: transparent !important;">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
                <div class="d-flex align-items-end">
                    <div class="flex-shrink-0 position-relative">
                        <div class="avatar-upload">
                            <div class="avatar-edit" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Image Size (190x190)">
                                <input type='file' id="imageUpload" accept=".png, .jpg, .jpeg" />
                                <label for="imageUpload"></label>
                            </div>
                            <div class="avatar-preview">
                                <div id="imagePreview"></div>
                            </div>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-20 mb-45">
                        <h3 class="mb-1" id="lblOrganizationName"></h3>
                        <span class="fs-16">
                            <a href="#" id="lblOfficialEmail"></a>
                        </span>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-sm-4">
                    <a href="/bctechadmin/CreateBranchMaster"
                       class="btn btn-outline-border-color-70 text-secondary fw-normal fs-16 hover-bg"
                       style="padding:12px 15px;">
                        Add Branch Master
                    </a>
                </div>
            </div>

            <ul class="nav nav-tabs profile-tabs border-0 justify-content-center gap-2" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-0 fs-16 border-0 bg-transparent text-body"
                            id="branch-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#branch"
                            type="button"
                            role="tab"
                            aria-controls="branch"
                            aria-selected="true">
                        Branch
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>
<div class="row" id="branchList"></div>
<div class="modal fade" id="staffModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center">
                    <i class="ri-team-line fs-20 me-2 text-primary"></i>

                    <div>
                        <div class="fw-semibold">Add Staff</div>
                        <small class="text-muted fs-15" id="lblBranchName"></small>
                    </div>
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="hfBranchID" />

                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th width="50">
                                <input type="checkbox" id="chkAll" />
                            </th>
                            <th>Staff Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                        </tr>
                    </thead>

                    <tbody id="staffList"></tbody>

                </table>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button class="btn btn-primary"
                        id="btnSaveStaff"
                        style="color:#ffffff;">
                    Assign Staff
                </button>
            </div>

        </div>
    </div>
</div>
@section Scripts{
    <script>

        $(function () {
            GetOrganization();
            GetBranchList();

            // Delete Click Event (Dynamic)
            $(document).on("click", ".deleteBranch", function () {

                var id = $(this).data("id");
                DeleteBranch(id);

            });

        });

        function GetBranchList() {

            $.ajax({
                url: "/bctechadmin/GetBranchList",
                type: "GET",
                success: function (res) {

                    if (res.Status == 1) {

                        var html = "";

                        $.each(res.Data, function (i, item) {

                            // Staff HTML
                            var staffHtml = "";

                            if (item.Staff && item.Staff.length > 0) {

                                $.each(item.Staff, function (j, staff) {

                                    var photo = (staff.ProfilePhoto && staff.ProfilePhoto != "")
                                        ? "/Uploads/UserProfilePhoto/" + staff.ProfilePhoto
                                        : "/Content/Admin/assets/Images/admin.png";

                                    staffHtml += `
                                    <li style="margin-right:-12px;" title="${staff.Username}">

                                        <img src="${photo}"
                                             alt="${staff.Username}"
                                             onerror="this.src='/Content/Admin/assets/Images/admin.png'"
                                             class="rounded-circle border border-white border-2"
                                             style="width:42px;height:42px;object-fit:cover;cursor:pointer;">

                                    </li>`;
                                });

                            }
                            else {

                                staffHtml = `
                            <li class="text-muted">
                                No Staff Assigned
                            </li>`;
                            }

                            html += `
                    <div class="col-xxl-3 col-xxxl-4 col-lg-4 col-md-6">

                        <div class="card bg-white p-20 rounded-10 border border-white mb-4 for-mobile-sellers">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div class="d-flex align-items-center">

                                    <div class="flex-shrink-0">
                                        <img src="/Content/Admin/assets/Images/branch.png"
                                             style="width:100px;height:100px;"
                                             class="rounded-circle" />
                                    </div>

                                    <div class="flex-grow-1 ms-3">
                                        <h4 class="mb-1">${item.BranchName}</h4>
                                        <span class="fs-16">${item.BranchCode}</span>
                                    </div>

                                </div>

                                <div class="dropdown">

                                    <button class="bg-transparent border-0"
                                            data-bs-toggle="dropdown">
                                        <i class="material-symbols-outlined">more_horiz</i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end bg-white border-0 box-shadow rounded-10">

                                        <li>
                                            <a href="/bctechadmin/CreateBranchMaster?id=${item.EditEncryptedID}"
                                               class="dropdown-item text-secondary">
                                                <i class="ri-edit-line me-2 text-primary"></i>
                                                Edit
                                            </a>
                                        </li>

                                        <li>
                                            <a href="/bctechadmin/CreateBranchMaster?id=${item.ViewEncryptedID}"
                                               class="dropdown-item text-secondary">
                                                <i class="ri-eye-line me-2 text-info"></i>
                                                View
                                            </a>
                                        </li>

                                        <li>
                                            <a href="javascript:void(0)"
                                               class="dropdown-item text-danger deleteBranch"
                                               data-id="${item.BranchID}">
                                                <i class="ri-delete-bin-line me-2"></i>
                                                Delete
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <a href="javascript:void(0)"
                                               class="dropdown-item text-success addStaff"
                                               data-id="${item.BranchID}"
                                               data-branch="${item.BranchName}">
                                                <i class="ri-user-add-line me-2"></i>
                                                Add Staff
                                            </a>
                                        </li>

                                    </ul>

                                </div>

                            </div>

                            <ul class="list-unstyled">
                                <li><b>Address :</b> ${item.Address}</li>
                                <li><b>Mobile :</b> ${item.MobileNo}</li>
                                <li><b>Email :</b> ${item.EmailAddress ?? ""}</li>
                                <li><b>City :</b> ${item.City}</li>
                            </ul>

                            <hr>

                            <span class="fs-16 d-block mb-2 fw-semibold">
                                Staff:
                            </span>

                            <ul class="list-unstyled d-flex align-items-center mb-0">
                                ${staffHtml}
                            </ul>

                        </div>

                    </div>`;
                        });

                        $("#branchList").html(html);

                    }
                    else {

                        toastr.error(res.Message);

                    }

                },
                error: function () {

                    toastr.error("Something went wrong.");

                }

            });

        }
        function GetOrganization() {

            $.ajax({
                url: "/bctechadmin/GetOrganization",
                type: "GET",
                dataType: "json",
                success: function (data) {

                    if (data != null) {

                        // Organization Name
                        $("#lblOrganizationName").text(data.OrganizationName);

                        // Email
                        $("#lblOfficialEmail").html(
                            '<a href="mailto:' + data.OfficialEmail + '">' +
                            data.OfficialEmail +
                            '</a>'
                        );

                        // Logo
                        var logo = data.OrganizationLogo;

                        if (logo != null && logo != "") {

                            $("#imagePreview").css("background-image","url('/Content/Admin/assets/Images/" + logo + "')");
                        }
                        else {

                            $("#imagePreview").css("background-image","url('/Content/Admin/assets/Images/admin.png')"
                            );
                        }
                    }
                },
                error: function () {
                    toastr.error("Unable to load Organization Details.");
                }
            });

        }
        function DeleteBranch(id) {

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to recover this branch!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: "/bctechadmin/DeleteBranch",
                        type: "POST",
                        data: { BranchID: id },

                        success: function (res) {

                            if (res.Status == 1) {

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: res.Message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });

                                GetBranchList();

                            }
                            else {

                                Swal.fire({
                                    icon: 'error',
                                    title: 'Oops...',
                                    text: res.Message
                                });

                            }

                        },

                        error: function () {

                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Something went wrong.'
                            });

                        }

                    });

                }

            });

        }
        $(document).on("click", ".addStaff", function () {
            var branchId = $(this).data("id");
            var branchName = $(this).data("branch");
            $("#hfBranchID").val(branchId);
            $("#lblBranchName").text(branchName);            
            LoadStaff(branchId);
            $("#staffModal").modal("show");
        });
        function LoadStaff(branchId) {

            $.ajax({
                url: "/bctechadmin/GetStaffList",
                type: "GET",
                data: { BranchID: branchId },

                success: function (res) {

                    var html = "";

                    $.each(res.Data, function (i, item) {

                        var photo = item.ProfilePhoto && item.ProfilePhoto != ""
                            ? "/Uploads/UserProfilePhoto/" + item.ProfilePhoto
                            : "/Content/Admin/assets/Images/admin.png";

                        html += `
                            <tr>
                                <td>
                                    <input type="checkbox"
                                               class="chkStaff"
                                               value="${item.UserID}"
                                               ${item.IsAssigned ? "checked" : ""}>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">

                                        <img src="${photo}"
                                             class="rounded-circle border me-2"
                                             style="width:45px;height:45px;object-fit:cover;">

                                        <div>
                                            <div class="fw-semibold">${item.Username}</div>
                                        </div>

                                    </div>
                                </td>

                                <td>${item.MobileNo}</td>
                                <td>${item.EmailAddress}</td>
                            </tr>`;
                    });

                    $("#staffList").html(html);
                }
            });
        }
        $("#btnSaveStaff").click(function () {
            var staffIds = [];
            $(".chkStaff:checked").each(function () {
                staffIds.push($(this).val());
            });
            if (staffIds.length == 0) {
                toastr.warning("Please select at least one staff.");
                return;
            }
            $.ajax({
                url: "/bctechadmin/AssignStaff",
                type: "POST",
                traditional: true,
                data: {
                    BranchID: $("#hfBranchID").val(),
                    StaffIDs: staffIds
                },
                success: function (res) {

                    if (res.Status == 1) {
                        toastr.success(res.Message);
                        $("#staffModal").modal("hide");
                    }
                    else {
                        toastr.error(res.Message);
                    }
                }
            });

        });
        $(document).on("change", "#chkAll", function () {

            $(".chkStaff").prop("checked", $(this).is(":checked"));

        });
        $(document).on("change", ".chkStaff", function () {

            var total = $(".chkStaff").length;
            var checked = $(".chkStaff:checked").length;

            $("#chkAll").prop("checked", total === checked);

        });
    </script>
}
