
@{
    ViewBag.Title = "UserMaster";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}
<style>
    .dataTables_length {
        display: none;
    }
</style>

<div class="card bg-white rounded-10 border border-white p-20 mb-4">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <a href="/bctechadmin/createuser" class="btn btn-primary text-white">
                <i class="ri-add-line me-1"></i> Add New User
            </a>

            <select id="ddlUserCategory" class="form-select" style="min-width: 170px; width: auto;">
                <option value="">All Categories</option>
                @if (ViewBag.UserCategoryList != null)
                {
                    foreach (var cat in (List<string>)ViewBag.UserCategoryList)
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>

        <form class="table-src-form position-relative m-0" onsubmit="return false;">
            <input type="text" id="txtSearch" class="form-control" placeholder="Search User...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
    </div>
</div>
<div class="row" id="userList"></div>
<div class="col-lg-12">
    <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap mb-4">
        <span class="fs-15" id="lblShowing"></span>
        <nav class="custom-pagination" aria-label="Page navigation example">
            <ul class="pagination mb-0 justify-content-center" id="customPagination"></ul>
        </nav>
    </div>
</div>

@section Scripts{
    <script>
        var allUsers = [];
        var filteredUsers = [];
        var currentPage = 1;
        var pageSize = 9;
        $(document).ready(function () {

            if ($("#ddlUserCategory option").length <= 1) {
                $.ajax({
                    url: '/bctechadmin/GetUserCategoryList',
                    type: 'GET',
                    success: function (res) {
                        if (res.Status == 1 && res.Data && res.Data.length > 0) {
                            $.each(res.Data, function (i, cat) {
                                $("#ddlUserCategory").append($('<option>', { value: cat, text: cat }));
                            });
                        }
                    }
                });
            }

            LoadUserList();

        });
        function LoadUserList() {

            $.ajax({
                url: '/bctechadmin/GetUserMasterList',
                type: 'GET',
                success: function (res) {

                    if (res.Status == 1) {

                        allUsers = res.Data;
                        ApplyUserFilter();

                    }

                }

            });

        }
        function BindCards() {

            $("#userList").empty();

            var start = (currentPage - 1) * pageSize;
            var end = start + pageSize;

            var pageData = filteredUsers.slice(start, end);

            $.each(pageData, function (i, item) {
                var photo = item.ProfilePhoto
                    ? "/Content/Upload/UserProfilePhoto/" + item.ProfilePhoto
                    : "/Content/Admin/assets/images/no-image.png";
               
                var html = `
                <div class="col-xxl-3 col-xxxl-4 col-lg-4 col-md-6">
                    <div class="card bg-white p-20 rounded-10 border border-white mb-4 for-mobile-sellers">

                        <div class="d-flex justify-content-between align-items-start mb-3">

                            <div class="d-flex align-items-center">

                                <div class="flex-shrink-0">
                                    <img src="${photo}" style="width:100px;height:100px;"
                                         class="rounded-circle" alt="">
                                </div>

                                <div class="flex-grow-1 ms-3 position-relative top-2">
                                    <h3 class="mb-1">${item.FirstName} ${item.LastName}</h3>
                                    <span class="fs-16">${item.UserCategory}</span>
                                </div>

                            </div>

                            <div class="dropdown select-dropdown without-border">

                                <button class="bg-transparent border-0 p-0 position-relative top-3 text-body"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                    <i class="material-symbols-outlined fs-24 text-secondary">
                                        more_horiz
                                    </i>

                                </button>

                 <ul class="dropdown-menu dropdown-menu-end bg-white border-0 box-shadow rounded-10">

                        <li>
                            <a href="/bctechadmin/CreateUser?id=${item.EditEncryptedID}"
                               class="dropdown-item">
                                <i class="ri-edit-line me-2 text-primary"></i> Edit
                            </a>
                        </li>

                        <li>
                            <a href="/bctechadmin/CreateUser?id=${item.ViewEncryptedID}"
                               class="dropdown-item">
                                <i class="ri-eye-line me-2 text-info"></i> View
                            </a>
                        </li>

                        <li>
                            <a href="javascript:void(0);"
                               class="dropdown-item text-danger deleteUser"
                               data-id="${item.UserID}">
                                <i class="ri-delete-bin-line me-2"></i> Delete
                            </a>
                        </li>

                    </ul>

                            </div>

                        </div>

                        <ul class="p-0 mb-3 list-unstyled last-child-none">

                            <li class="fs-16 mb-10">
                                Joined Date :
                                <span class="text-secondary">
                                    ${moment(item.JoiningDate).format("DD MMM YYYY")}
                                </span>
                            </li>

                            <li class="fs-16 mb-10">
                                Contact Phone :
                                <span class="text-secondary">
                                    ${item.MobileNo}
                                </span>
                            </li>

                            <li class="fs-16 mb-10">
                                Email :
                                <span class="text-secondary">
                                    ${item.EmailAddress}
                                </span>
                            </li>

                            <li class="fs-16 mb-10">
                                Location :
                                <span class="text-secondary">
                                    ${item.City}
                                </span>
                            </li>

                        </ul>

                    </div>
                </div>`;

                $("#userList").append(html);

            });
            RenderPagination();
        }
        function RenderPagination() {

            var totalPages = Math.ceil(filteredUsers.length / pageSize);

            var start = filteredUsers.length == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
            var end = Math.min(currentPage * pageSize, filteredUsers.length);

            $("#lblShowing").text(
                "Showing " + start + " to " + end + " of " + filteredUsers.length + " entries"
            );

            var html = "";

            html += `
        <li class="page-item ${currentPage == 1 ? "disabled" : ""}">
            <button class="page-link icon" id="btnPrev">
                <i class="material-symbols-outlined">west</i>
            </button>
        </li>`;

            for (var i = 1; i <= totalPages; i++) {

                html += `
            <li class="page-item">
                <button class="page-link ${currentPage == i ? "active" : ""}" data-page="${i}">
                    ${i}
                </button>
            </li>`;
            }

            html += `
        <li class="page-item ${currentPage == totalPages ? "disabled" : ""}">
            <button class="page-link icon" id="btnNext">
                <i class="material-symbols-outlined">east</i>
            </button>
        </li>`;

            $("#customPagination").html(html);

        }
        $(document).on("click", "#customPagination .page-link[data-page]", function () {

            currentPage = parseInt($(this).data("page"));

            BindCards();

        });
        $(document).on("click", "#btnNext", function () {

            var totalPages = Math.ceil(filteredUsers.length / pageSize);

            if (currentPage < totalPages) {

                currentPage++;

                BindCards();

            }

        });
        function ApplyUserFilter() {

            var value = ($("#txtSearch").val() || "").toLowerCase().trim();
            var category = ($("#ddlUserCategory").val() || "").trim();

            filteredUsers = allUsers.filter(function (x) {

                var matchesSearch = !value || (
                    ((x.FirstName || "") + " " + (x.LastName || "")).toLowerCase().includes(value) ||
                    (x.EmailAddress || "").toLowerCase().includes(value) ||
                    (x.MobileNo || "").toLowerCase().includes(value) ||
                    (x.City || "").toLowerCase().includes(value) ||
                    (x.UserCategory || "").toLowerCase().includes(value)
                );

                var matchesCategory = !category || ((x.UserCategory || "").toLowerCase() === category.toLowerCase());

                return matchesSearch && matchesCategory;

            });

            currentPage = 1;

            BindCards();

        }

        $("#txtSearch").on("keyup change", function () {
            ApplyUserFilter();
        });

        $("#ddlUserCategory").on("change", function () {
            ApplyUserFilter();
        });
        $(document).on("click", ".deleteUser", function () {

            var id = $(this).data("id");

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to recover this user!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({

                        url: "/bctechadmin/DeleteUser",
                        type: "POST",
                        data: { UserID: id },

                        success: function (res) {

                            if (res.Status == 1) {

                                Swal.fire({
                                    icon: "success",
                                    title: "Deleted!",
                                    text: res.Message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });

                                LoadUserList();

                            } else {

                                Swal.fire({
                                    icon: "error",
                                    title: "Error",
                                    text: res.Message
                                });

                            }

                        },

                        error: function () {

                            Swal.fire({
                                icon: "error",
                                title: "Oops...",
                                text: "Something went wrong."
                            });

                        }

                    });

                }

            });

        });
    </script>

}
