@{
    ViewBag.Title = "BookMaster";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<div class="card bg-white rounded-10 border border-white mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">
        <form class="table-src-form position-relative m-0" onsubmit="return false;">
            <input type="text" id="txtSearch" class="form-control w-350" placeholder="Search Book Master...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>

        <a href="/bctechadmin/CreateBookMaster" class="btn btn-primary text-white">
            <i class="ri-add-line"></i> Add Book Master
        </a>
    </div>

    <div class="default-table-area mx-minus-1 table-contact-list">
        <div class="table-responsive">
            <table class="table-common" id="tblBookMaster">
                <thead>
                    <tr>
                        <th>SR</th>
                        <th>Cover</th>
                        <th>Book Code</th>
                        <th>Book Title</th>
                        <th>Category</th>
                        <th>Source</th>
                        <th>Course</th>
                        <th>Price (&#8377;)</th>
                        <th>Min Stock</th>
                        <th>E-Book</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="col-lg-12">
            <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                <span class="fs-15" id="lblShowing">Showing 0 of 0 entries</span>
                <nav class="custom-pagination" aria-label="Page navigation">
                    <ul class="pagination mb-0 justify-content-center" id="pagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var booksList = [];
        var filteredBooks = [];
        var currentPage = 1;
        var pageSize = 10;

        $(document).ready(function () {
            GetBookMaster();

            $("#txtSearch").on("keyup", function () {
                var search = $(this).val().toLowerCase().trim();
                filteredBooks = booksList.filter(function (x) {
                    return (x.BookTitle && x.BookTitle.toLowerCase().includes(search)) ||
                           (x.BookCode && x.BookCode.toLowerCase().includes(search)) ||
                           (x.BookCategoryTitle && x.BookCategoryTitle.toLowerCase().includes(search)) ||
                           (x.AuthorName && x.AuthorName.toLowerCase().includes(search));
                });
                currentPage = 1;
                BindGrid();
            });
        });

        function GetBookMaster() {
            $.ajax({
                url: "/BCTECHAdmin/GetBookMasterList",
                type: "GET",
                dataType: "json",
                success: function (data) {
                    booksList = data || [];
                    filteredBooks = booksList;
                    currentPage = 1;
                    BindGrid();
                },
                error: function (err) {
                    console.error("Error loading book list:", err);
                }
            });
        }

        function BindGrid() {
            var html = "";
            var start = (currentPage - 1) * pageSize;
            var end = Math.min(start + pageSize, filteredBooks.length);

            if (filteredBooks.length === 0) {
                html = "<tr><td colspan='12' class='text-center text-muted p-4'>No book records found</td></tr>";
            } else {
                for (var i = start; i < end; i++) {
                    var item = filteredBooks[i];

                    var coverImg = item.BookCoverImage ? item.BookCoverImage : "/Content/Admin/assets/images/no-image.png";
                    var statusBadge = item.IsActive
                        ? "<span class='badge bg-success'>Active</span>"
                        : "<span class='badge bg-danger'>Inactive</span>";
                    var ebookBadge = item.IsEBook
                        ? "<span class='badge bg-info text-white'><i class='ri-file-download-line me-1'></i> Yes</span>"
                        : "<span class='badge bg-secondary'>No</span>";

                    html += "<tr>";
                    html += "<td>" + (i + 1) + "</td>";
                    html += "<td><img src='" + coverImg + "' class='rounded img-thumbnail' style='width: 40px; height: 40px; object-fit: cover;' onerror=\"this.src='/Content/Admin/assets/images/no-image.png'\" /></td>";
                    html += "<td><strong>" + (item.BookCode || '-') + "</strong></td>";
                    html += "<td><div><strong>" + (item.BookTitle || '') + "</strong></div><small class='text-muted'>" + (item.AuthorName ? "Author: " + item.AuthorName : "") + "</small></td>";
                    html += "<td>" + (item.BookCategoryTitle || '-') + "</td>";
                    html += "<td>" + (item.BookSourceTitle || '-') + "</td>";
                    html += "<td>" + (item.CourseTitle || '-') + "</td>";
                    html += "<td>&#8377; " + parseFloat(item.Price || 0).toFixed(2) + "</td>";
                    html += "<td>" + (item.MinimumStock || 0) + "</td>";
                    html += "<td>" + ebookBadge + "</td>";
                    html += "<td>" + statusBadge + "</td>";
                    html += "<td>";
                    html += "<a href='/bctechadmin/CreateBookMaster?id=" + item.BookID + "' title='Edit'><i class='ri-edit-line text-primary fs-18'></i></a>";
                    html += "&nbsp;&nbsp;";
                    html += "<a href='javascript:void(0);' onclick='DeleteBookMaster(" + item.BookID + ")' title='Delete'><i class='ri-delete-bin-line text-danger fs-18'></i></a>";
                    html += "</td>";
                    html += "</tr>";
                }
            }

            $("#tblBookMaster tbody").html(html);
            RenderPagination(filteredBooks.length);
        }

        function RenderPagination(totalRecords) {
            var totalPages = Math.ceil(totalRecords / pageSize);
            var startEntry = totalRecords > 0 ? (currentPage - 1) * pageSize + 1 : 0;
            var endEntry = Math.min(currentPage * pageSize, totalRecords);

            $("#lblShowing").text("Showing " + startEntry + " to " + endEntry + " of " + totalRecords + " entries");

            var paginationHtml = "";
            if (totalPages > 1) {
                var prevDisabled = currentPage === 1 ? "disabled" : "";
                paginationHtml += "<li class='page-item " + prevDisabled + "'><a class='page-link' href='javascript:void(0);' onclick='ChangePage(" + (currentPage - 1) + ")'>Previous</a></li>";

                for (var p = 1; p <= totalPages; p++) {
                    var activeClass = p === currentPage ? "active" : "";
                    paginationHtml += "<li class='page-item " + activeClass + "'><a class='page-link' href='javascript:void(0);' onclick='ChangePage(" + p + ")'>" + p + "</a></li>";
                }

                var nextDisabled = currentPage === totalPages ? "disabled" : "";
                paginationHtml += "<li class='page-item " + nextDisabled + "'><a class='page-link' href='javascript:void(0);' onclick='ChangePage(" + (currentPage + 1) + ")'>Next</a></li>";
            }
            $("#pagination").html(paginationHtml);
        }

        function ChangePage(page) {
            currentPage = page;
            BindGrid();
        }

        function DeleteBookMaster(id) {
            if (typeof Swal !== "undefined") {
                Swal.fire({
                    title: "Are you sure?",
                    text: "Do you really want to delete this book?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then(function (result) {
                    if (result.isConfirmed) {
                        ExecuteDelete(id);
                    }
                });
            } else {
                if (confirm("Are you sure you want to delete this book?")) {
                    ExecuteDelete(id);
                }
            }
        }

        function ExecuteDelete(id) {
            $.ajax({
                url: "/BCTECHAdmin/DeleteBookMaster",
                type: "POST",
                data: { id: id },
                dataType: "json",
                success: function (res) {
                    if (res.Status) {
                        if (typeof toastr !== "undefined") {
                            toastr.success(res.Message || "Book deleted successfully.");
                        } else {
                            alert(res.Message || "Book deleted successfully.");
                        }
                        GetBookMaster();
                    } else {
                        if (typeof toastr !== "undefined") {
                            toastr.error(res.Message);
                        } else {
                            alert(res.Message);
                        }
                    }
                },
                error: function (err) {
                    console.error("Delete error:", err);
                }
            });
        }
    </script>
}
