@model System.Data.DataTable
@using System.Data
@{
    Layout = null;
    ViewBag.Title = "Print Hall Ticket";

    System.Data.DataTable displayTable = Model;
    string reqStudents = Request["studentIds"] ?? Request["students"] ?? Request["student_id"];
    if (!string.IsNullOrEmpty(reqStudents) && Model != null && Model.Rows.Count > 0 && Model.Columns.Contains("student_id"))
    {
        var targetIdSet = new System.Collections.Generic.HashSet<string>(
            reqStudents.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                       .Select(s => s.Trim()));

        if (targetIdSet.Count > 0)
        {
            displayTable = Model.Clone();
            foreach (DataRow row in Model.Rows)
            {
                if (targetIdSet.Contains(row["student_id"].ToString()))
                {
                    displayTable.ImportRow(row);
                }
            }
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Print Hall Ticket</title>
    <style>
        @@page {
            size: A4 portrait;
            margin: 5mm 8mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
            color: #000;
            background-color: #fff;
            margin: 10px auto;
            padding: 0;
            max-width: 210mm;
        }

        .no-print-toolbar {
            background: #f1f5f9;
            padding: 10px 15px;
            border-radius: 6px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #cbd5e1;
        }

        .btn-toolbar {
            padding: 7px 18px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .btn-print {
            background-color: #007bff;
            color: #fff;
            border: 1px solid #007bff;
        }

        .btn-back {
            background-color: #6c757d;
            color: #fff;
            border: 1px solid #6c757d;
        }

        /* Full A4 Page Container holding exactly 2 Hall Tickets */
        .print-page {
            width: 100%;
            height: 284mm;
            max-height: 284mm;
            margin: 0 auto 25px auto;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            page-break-after: always;
            break-after: page;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .print-page:last-of-type {
            page-break-after: auto;
            break-after: auto;
            margin-bottom: 0;
        }

        /* Each Hall Ticket fills approximately half of the A4 page height */
        .hall-ticket-wrapper {
            width: 100%;
            height: 138mm;
            max-height: 138mm;
            box-sizing: border-box;
            page-break-inside: avoid;
            break-inside: avoid;
            display: flex;
            flex-direction: column;
        }

        .hall-ticket-table {
            width: 100%;
            height: 100%;
            border-collapse: collapse;
            border: 2px solid #000;
            background: #fff;
            table-layout: fixed;
        }

        .hall-ticket-table td {
            border: 1px solid #000;
            vertical-align: middle;
        }

        .ticket-title {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            padding: 4px !important;
            letter-spacing: 2px;
            text-transform: uppercase;
            background-color: #f8fafc;
            height: 30px;
        }

        .logo-row {
            height: 72px;
        }

        .logo-row td {
            padding: 4px 10px !important;
        }

        .exam-title {
            text-align: center;
            font-size: 15px;
            font-weight: bold;
            padding: 4px !important;
            letter-spacing: 0.5px;
            background-color: #f1f5f9;
            height: 28px;
        }

        .photo-cell {
            text-align: center;
            vertical-align: middle;
            width: 145px;
            padding: 6px !important;
        }

        .photo-cell img {
            width: 125px;
            height: 145px;
            object-fit: cover;
            border: 1.5px solid #222;
            display: block;
            margin: 0 auto;
        }

        .details-table {
            width: 100%;
            height: 100%;
            border-collapse: collapse;
        }

        .details-table td {
            padding: 6px 10px !important;
            font-size: 13px;
            border: none !important;
            border-bottom: 1px solid #000 !important;
        }

        .instructions-cell {
            padding: 6px 14px !important;
            vertical-align: top;
        }

        .instructions-list {
            margin: 2px 0 2px 20px;
            padding: 0;
            font-size: 11.5px;
            line-height: 1.55;
            color: #111;
        }

        .instructions-list li {
            margin-bottom: 2px;
        }

        /* Cut line between top and bottom tickets */
        .cut-line {
            height: 6mm;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            text-align: center;
            box-sizing: border-box;
        }

        .cut-line::before,
        .cut-line::after {
            content: "";
            flex: 1;
            border-bottom: 1.5px dashed #444;
        }

        .cut-line .cut-text {
            padding: 0 14px;
            font-size: 11px;
            color: #333;
            font-weight: bold;
            letter-spacing: 1.5px;
            white-space: nowrap;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            html, body {
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
                width: 100% !important;
                max-width: 100% !important;
            }

            .print-page {
                height: 284mm !important;
                max-height: 284mm !important;
                page-break-after: always;
                break-after: page;
                page-break-inside: avoid;
                break-inside: avoid;
                margin: 0 !important;
                padding: 0 !important;
            }

            .print-page:last-of-type {
                page-break-after: auto;
                break-after: auto;
            }

            .hall-ticket-wrapper {
                height: 138mm !important;
                max-height: 138mm !important;
                page-break-inside: avoid;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body onload="window.print()">

    <!-- Screen Toolbar -->
    <div class="no-print no-print-toolbar">
        <div>
            <a href="/bctechAdmin/ViewHallTicketExam" class="btn-toolbar btn-back">&larr; Back to Hall Ticket List</a>
        </div>
        <div>
            <button onclick="window.print();" class="btn-toolbar btn-print">Print All Hall Tickets</button>
        </div>
    </div>

    @if (displayTable != null && displayTable.Rows.Count > 0)
    {
        for (int i = 0; i < displayTable.Rows.Count; i += 2)
        {
            <div class="print-page">
                @for (int j = i; j < i + 2 && j < displayTable.Rows.Count; j++)
                {
                    var row = displayTable.Rows[j];

                    string studentPhoto = row.Table.Columns.Contains("student_photo") && row["student_photo"] != DBNull.Value && !string.IsNullOrWhiteSpace(row["student_photo"].ToString())
                        ? row["student_photo"].ToString()
                        : "/Content/Admin/assets/images/no-image.png";

                    string studentName = row.Table.Columns.Contains("student_full_name") && row["student_full_name"] != DBNull.Value
                        ? row["student_full_name"].ToString()
                        : "-";

                    string courseCode = row.Table.Columns.Contains("course_code") && row["course_code"] != DBNull.Value && !string.IsNullOrWhiteSpace(row["course_code"].ToString())
                        ? row["course_code"].ToString()
                        : (row.Table.Columns.Contains("course_title") && row["course_title"] != DBNull.Value ? row["course_title"].ToString() : "-");

                    string regNo = row.Table.Columns.Contains("student_String_En_No") && row["student_String_En_No"] != DBNull.Value
                        ? row["student_String_En_No"].ToString()
                        : "-";

                    string examDate = row.Table.Columns.Contains("Exam_schedule_Date") && row["Exam_schedule_Date"] != DBNull.Value
                        ? row["Exam_schedule_Date"].ToString()
                        : "-";

                    string practicalTime = row.Table.Columns.Contains("Practical_Exam_Time") && row["Practical_Exam_Time"] != DBNull.Value
                        ? row["Practical_Exam_Time"].ToString()
                        : "-";

                    string theoryTime = row.Table.Columns.Contains("Theory_Exam_Time") && row["Theory_Exam_Time"] != DBNull.Value
                        ? row["Theory_Exam_Time"].ToString()
                        : "-";

                    <div class="hall-ticket-wrapper">
                        <table class="hall-ticket-table">
                            <tr>
                                <td class="ticket-title" colspan="2">
                                    Hall Ticket
                                </td>
                            </tr>

                            <tr class="logo-row">
                                <td style="text-align: center; width: 28%;">
                                    <img src="/Content/logo/VCSS_Logo_F1.jpg" style="max-height: 60px; max-width: 130px; margin: 2px;" onerror="this.onerror=null; this.src='/Content/Admin/assets/images/BCTECHlogo-icon.png';" alt="VCSS Logo" />
                                </td>
                                <td style="text-align: center; width: 72%;">
                                    <img src="/Content/logo/LOGO_MAIN.png" style="max-height: 64px; margin: 2px;" onerror="this.onerror=null; this.src='/Content/Admin/assets/images/BCTECHLogo1.png';" alt="B.C. Tech Logo" />
                                </td>
                            </tr>

                            <tr>
                                <td class="exam-title" colspan="2">
                                    Final Examination
                                </td>
                            </tr>

                            <tr>
                                <td class="photo-cell">
                                    <img src="@studentPhoto" onerror="this.onerror=null; this.src='/Content/Admin/assets/images/no-image.png';" alt="Photo" />
                                </td>
                                <td style="vertical-align: top; padding: 0;">
                                    <table class="details-table" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td style="width: 20%;"><b>Name<br />of Candidate</b></td>
                                            <td style="width: 32%;"><b>@studentName</b></td>
                                            <td style="width: 23%;"><b>Course</b></td>
                                            <td style="width: 25%;"><b>@courseCode</b></td>
                                        </tr>
                                        <tr>
                                            <td><b>Reg. No.</b></td>
                                            <td><b>@regNo</b></td>
                                            <td colspan="2" style="text-align: center; font-weight: bold; background-color: #f1f5f9; font-size: 13px;">Exam Time</td>
                                        </tr>
                                        <tr>
                                            <td><b>Exam Dt.</b></td>
                                            <td>@examDate</td>
                                            <td style="text-align: center;"><b>Practical</b></td>
                                            <td style="text-align: center;"><b>Theory</b></td>
                                        </tr>
                                        <tr style="border-bottom: none !important;">
                                            <td colspan="2" style="border-bottom: none !important;"></td>
                                            <td style="text-align: center; border-bottom: none !important; font-weight: bold;">@practicalTime</td>
                                            <td style="text-align: center; border-bottom: none !important; font-weight: bold;">@theoryTime</td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td class="instructions-cell" colspan="2">
                                    <ul class="instructions-list">
                                        <li>&#2309;&#2327;&#2352; &#2310;&#2346; &#2346;&#2352;&#2368;&#2325;&#2381;&#2359;&#2366; &#2350;&#2375;&#2306; Absent &#2361;&#2379;&#2340;&#2375; &#2361;&#2376; &#2340;&#2379;, &#2342;&#2369;&#2348;&#2366;&#2352;&#2366; &#2346;&#2352;&#2368;&#2325;&#2381;&#2359;&#2366; &#2342;&#2375;&#2344;&#2375; &#2325;&#2375; &#2354;&#2363;&#2319; &#2310;&#2346;&#2325;&#2379; 250/- &#2352;&#2370; &#2346;&#2352;&#2368;&#2325;&#2381;&#2359;&#2366; &#2358;&#2369;&#2354;&#2381;&#2325; &#2342;&#2375;&#2344;&#2366; &#2309;&#2344;&#2363;&#2357;&#2366;&#2352;&#2381;&#2351; &#2361;&#2376; &#2404;</li>
                                        <li>&#2310;&#2346;&#2325;&#2379; Exam &#2350;&#2375; &#2360;&#2350;&#2351; &#2346;&#2352; &#2310;&#2344;&#2366; &#2309;&#2344;&#2363;&#2357;&#2366;&#2352;&#2381;&#2351; &#2361;&#2376;, &#2360;&#2350;&#2351; &#2346;&#2352; &#2344;&#2361;&#2368;&#2306; &#2310;&#2344;&#2375; &#2346;&#2352; Exam &#2344;&#2363;&#2352;&#2360;&#2381;&#2340; &#2361;&#2379;&#2327;&#2366; &#2404;</li>
                                        <li>&#2310;&#2346;&#2325;&#2368; &#2346;&#2352;&#2368;&#2325;&#2381;&#2359;&#2366; &#2326;&#2381;&#2340;&#2381;&#2350; &#2361;&#2379;&#2344;&#2375; &#2325;&#2375; 2 &#2350;&#2361;&#2368;&#2344;&#2375; &#2325;&#2375; &#2309;&#2306;&#2342;&#2352; &#2310;&#2346;&#2325;&#2379; &#2360;&#2352;&#2381;&#2335;&#2363;&#2347;&#2363;&#2325;&#2375;&#2335; &#2314;&#2352; &#2350;&#2366;&#2352;&#2381;&#2325;&#2358;&#2368;&#2335; &#2350;&#2363;&#2354;&#2375;&#2327;&#2366; &#2404;</li>
                                        <li>&#2310;&#2346; Exam &#2325;&#2366; Result 15 &#2342;&#2363;&#2344; &#2325;&#2375; &#2348;&#2366;&#2342; bctech.org.in &#2346;&#2352; &#2342;&#2375;&#2326; &#2360;&#2325;&#2340;&#2375; &#2361;&#2376; &#2404;</li>
                                    </ul>
                                </td>
                            </tr>
                        </table>
                    </div>

                    if (j == i && j + 1 < displayTable.Rows.Count)
                    {
                        <div class="cut-line">
                            <span class="cut-text">&#9986; - - - - - - - - Cut Here - - - - - - - - &#9986;</span>
                        </div>
                    }
                }
            </div>
        }
    }
    else
    {
        <div style="text-align: center; padding: 50px;">
            <h3>No hall ticket records found for this exam.</h3>
            <p><a href="/bctechAdmin/ViewHallTicketExam" class="btn-toolbar btn-back">Back to List</a></p>
        </div>
    }

</body>
</html>
