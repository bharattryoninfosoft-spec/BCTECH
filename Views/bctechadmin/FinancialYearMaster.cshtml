
@{
    ViewBag.Title = "FinancialYearMaster";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}


<div class="card bg-white rounded-10 border border-white mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">
        <form class="table-src-form position-relative m-0">
            <input type="text" id="txtSearch" class="form-control w-350" placeholder="Search Financial Year...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
        <a href="javascript:void(0);" class="text-primary fs-16 text-decoration-none"
           onclick="OpenFinancialYearModal()">
            + Add Financial Year
        </a>
    </div>
    <div class="default-table-area mx-minus-1 table-contact-list">
        <div class="table-responsive">
            <table class="table-common" id="tblFinancialYear">
                <thead>
                    <tr>
                        <th>SR</th>
                        <th>FinancialYear</th>
                        <th>AssessmentYear</th>
                        <th>StartDate</th>
                        <th>EndDate</th>
                        <th>IsDefault</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
            <span class="fs-15" id="lblShowing"></span>

            <nav class="custom-pagination" aria-label="Page navigation example">
                <ul class="pagination mb-0 justify-content-center" id="pagination">                   
                </ul>
            </nav>
        </div>
    </div>
</div>
<div class="modal fade" id="FinancialYearModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Financial Year</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="hfFinancialYearID" value="0" />

                <div class="row">

                    <!-- Current Year -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Current Year <span class="text-danger">*</span>
                        </label>
                        <input type="number"
                               id="txtCurrentYear"
                               class="form-control"
                               placeholder="Current Year"
                               onkeyup="GenerateFinancialYear()"
                               onchange="GenerateFinancialYear()">
                    </div>

                    <!-- Default -->
                    <div class="col-md-6 d-flex align-items-end mb-3">
                        <div class="form-check">
                            <input type="checkbox"
                                   id="chkDefault"
                                   class="form-check-input">
                            <label class="form-check-label">
                                Set As Default
                            </label>
                        </div>
                    </div>

                    <!-- Financial Year -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Financial Year</label>
                        <input type="text"
                               id="txtFinancialYear"
                               class="form-control"
                               readonly>
                    </div>

                    <!-- Assessment Year -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Assessment Year</label>
                        <input type="text"
                               id="txtAssessmentYear"
                               class="form-control"
                               readonly>
                    </div>

                    <!-- Hidden Dates -->
                    <input type="hidden" id="txtStartDate">
                    <input type="hidden" id="txtEndDate">

                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>

                <button class="btn btn-primary text-white" onclick="SaveFinancialYear()">
                    Save
                </button>
            </div>

        </div>
    </div>
</div>
@section Scripts{
    <script>
        var financialYears = [];
        var filteredFinancialYears = [];
        var currentPage = 1;
        var pageSize = 10;
        $(document).ready(function () {
            GetFinancialYear();
            $("#txtSearch").on("keyup", function () {

                var search = $(this).val().toLowerCase().trim();

                filteredFinancialYears = financialYears.filter(function (x) {

                    return x.FinancialYear.toLowerCase().includes(search) ||
                        x.AssessmentYear.toLowerCase().includes(search);

                });

                currentPage = 1;
                BindGrid();

            });
        });
        function GetFinancialYear() {

            $.ajax({
                url: '/bctechadmin/GetFinancialYearList',
                type: 'GET',
                dataType: 'json',
                success: function (data) {

                    financialYears = data;
                    filteredFinancialYears = data;

                    currentPage = 1;
                    BindGrid();
                }
            });
        }
        function BindGrid() {

            var html = "";

            var start = (currentPage - 1) * pageSize;
            var end = Math.min(start + pageSize, filteredFinancialYears.length);

            for (var i = start; i < end; i++) {

                var item = filteredFinancialYears[i];

                html += `
        <tr>
             <td>${i + 1}</td>
            <td>${item.FinancialYear}</td>
            <td>${item.AssessmentYear}</td>
            <td>${item.StartDate}</td>
            <td>${item.EndDate}</td>
            <td>${item.IsDefault
                        ? '<span class="badge bg-success">Yes</span>'
                        : '<span class="badge bg-secondary">No</span>'}</td>
            <td>
               <a href="javascript:void(0)"
                       onclick="EditFinancialYear(${item.FinancialYearID})">
                        <i class="ri-edit-line text-primary"></i>
                    </a>
                &nbsp;
               <a href="javascript:void(0)"
                   onclick="DeleteFinancialYear(${item.FinancialYearID})">
                    <i class="ri-delete-bin-line text-danger"></i>
                </a>
            </td>
        </tr>`;
            }

            $("#tblFinancialYear tbody").html(html);

            $("#lblShowing").text(
                `Showing ${filteredFinancialYears.length == 0 ? 0 : start + 1} to ${end} of ${filteredFinancialYears.length} entries`
            );

            CreatePagination();
        }
        function CreatePagination() {

            var totalPages = Math.ceil(filteredFinancialYears.length / pageSize);

            var html = "";
            html += `
                <li class="page-item ${currentPage == 1 ? 'disabled' : ''}">
                    <a class="page-link" href="javascript:void(0)"
                       ${currentPage == 1 ? '' : `onclick="ChangePage(${currentPage - 1})"`}>
                        <i class="material-symbols-outlined">west</i>
                    </a>
                </li>`;
            for (var i = 1; i <= totalPages; i++) {

                html += `
                    <li class="page-item">
                        <a class="page-link ${currentPage == i ? 'active' : ''}"
                           href="javascript:void(0)"
                           onclick="ChangePage(${i})">
                            ${i}
                        </a>
                    </li>`;
            }
           html += `
            <li class="page-item ${currentPage == totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)"
                   ${currentPage == totalPages ? '' : `onclick="ChangePage(${currentPage + 1})"`}>
                    <i class="material-symbols-outlined">east</i>
                </a>
            </li>`;

            $("#pagination").html(html);
        }
        function ChangePage(page) {

            var totalPages = Math.ceil(financialYears.length / pageSize);

            if (page < 1 || page > totalPages)
                return;

            currentPage = page;

            BindGrid();
        }
        function OpenFinancialYearModal() {

            $("#hfFinancialYearID").val(0);
            $("#txtFinancialYear").val("");
            $("#txtAssessmentYear").val("");
            $("#txtStartDate").val("");
            $("#txtEndDate").val("");
            $("#chkDefault").prop("checked", false);                          
            var year = new Date().getFullYear();
            $("#txtCurrentYear").val(year);
            GenerateFinancialYear();
            $("#FinancialYearModal").modal("show");
        }
        function SaveFinancialYear() {

            var financialYear = $("#txtFinancialYear").val().trim();
            var assessmentYear = $("#txtAssessmentYear").val().trim();
            var startDate = $("#txtStartDate").val().trim();
            var endDate = $("#txtEndDate").val().trim();

            if (financialYear == "") {
                toastr.warning("Please enter Financial Year.");
                $("#txtFinancialYear").focus();
                return false;
            }

            if (assessmentYear == "") {
                toastr.warning("Please enter Assessment Year.");
                $("#txtAssessmentYear").focus();
                return false;
            }

            if (startDate == "") {
                toastr.warning("Please select Start Date.");
                $("#txtStartDate").focus();
                return false;
            }

            if (endDate == "") {
                toastr.warning("Please select End Date.");
                $("#txtEndDate").focus();
                return false;
            }
            if (new Date(startDate.split("-").reverse().join("-")) >=
                new Date(endDate.split("-").reverse().join("-"))) {

                toastr.warning("End Date must be greater than Start Date.");
                $("#txtEndDate").focus();
                return false;
            }
            $.ajax({
                url: "/BCTECHAdmin/SaveFinancialYear",
                type: "POST",
                data: {
                    FinancialYearID: $("#hfFinancialYearID").val(),
                    FinancialYear: financialYear,
                    AssessmentYear: assessmentYear,
                    StartDate: startDate,
                    EndDate: endDate,
                    IsDefault: $("#chkDefault").is(":checked")
                },
                success: function (res) {

                    if (res.Status) {
                        toastr.success(res.Message);
                        $("#FinancialYearModal").modal("hide");
                        GetFinancialYear();
                    }
                    else {
                        toastr.warning(res.Message);
                    }
                },
                error: function () {
                    toastr.error("Something went wrong.");
                }
            });
        }
        function EditFinancialYear(id) {

            $.ajax({
                url: '/BCTECHAdmin/GetFinancialYearByID',
                type: 'GET',
                data: { id: id },
                dataType: 'json',
                success: function (item) {

                    $("#hfFinancialYearID").val(item.FinancialYearID);

                    // FinancialYear = "2029-2030"
                    var currentYear = item.FinancialYear.split('-')[0];

                    $("#txtCurrentYear").val(currentYear);

                    // Auto Generate
                    GenerateFinancialYear();

                    // Dates (optional)
                    $("#txtStartDate").val(item.StartDate);
                    $("#txtEndDate").val(item.EndDate);

                    $("#chkDefault").prop("checked", item.IsDefault);

                    $("#FinancialYearModal").modal("show");
                }
            });

        }
        function DeleteFinancialYear(id) {

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to recover this Financial Year!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Delete!',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: '/BCTECHAdmin/DeleteFinancialYear',
                        type: 'POST',
                        data: { id: id },

                        success: function (response) {

                            if (response.Status) {

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: response.Message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });

                                GetFinancialYear();
                            }
                            else {

                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Warning',
                                    text: response.Message
                                });

                            }
                        },
                        error: function () {

                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Something went wrong.'
                            });

                        }
                    });

                }

            });

        }
        function GenerateFinancialYear() {

            var year = parseInt($("#txtCurrentYear").val());

            if (isNaN(year) || year.toString().length != 4) {

                $("#txtFinancialYear").val("");
                $("#txtAssessmentYear").val("");
                $("#txtStartDate").val("");
                $("#txtEndDate").val("");

                return;
            }

            // Financial Year
            $("#txtFinancialYear").val(year + "-" + (year + 1));

            // Assessment Year
            $("#txtAssessmentYear").val((year + 1) + "-" + (year + 2));

            // Start Date (01-Apr)
            $("#txtStartDate").val(year + "-04-01");

            // End Date (31-Mar)
            $("#txtEndDate").val((year + 1) + "-03-31");
        }
        </script>
    }