@{
    ViewBag.Title = "Student Enquiry Follow Up";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<style>
    .followup-tabs {
        border-bottom: 2px solid #e5e7eb;
        background: #f9fafb;
        padding-top: 10px;
        padding-left: 15px;
        padding-right: 15px;
        border-radius: 8px 8px 0 0;
    }

    .followup-tabs .nav-link {
        color: #4b5563;
        font-weight: 600;
        font-size: 0.95rem;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 10px 24px;
        background: transparent;
        border-radius: 0;
        transition: all 0.2s ease-in-out;
    }

    .followup-tabs .nav-link:hover {
        color: #f97316;
    }

    .followup-tabs .nav-link.active {
        color: #ea580c;
        background: #ffffff;
        border-bottom: 3px solid #ea580c;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        box-shadow: 0 -2px 5px rgba(0,0,0,0.03);
    }

    .badge-tab-count {
        font-size: 0.75rem;
        padding: 3px 8px;
        border-radius: 12px;
        margin-left: 6px;
    }

    .btn-orange-go {
        background-color: #ff5722;
        color: #ffffff;
        border: none;
        padding: 6px 16px;
        border-radius: 4px;
        font-weight: 600;
    }

    .btn-orange-go:hover {
        background-color: #e64a19;
        color: #ffffff;
    }

    .btn-orange-refresh {
        background-color: #ff5722;
        color: #ffffff;
        border: none;
        padding: 6px 14px;
        border-radius: 4px;
    }

    .btn-orange-refresh:hover {
        background-color: #e64a19;
        color: #ffffff;
    }

    .table-followup thead th {
        background-color: #f3f4f6;
        color: #374151;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        border-bottom: 2px solid #e5e7eb;
        vertical-align: middle;
    }

    .table-followup tbody td {
        font-size: 0.88rem;
        vertical-align: middle;
        color: #1f2937;
    }

    .due-date-badge {
        font-weight: 700;
        color: #dc2626;
        background-color: #fee2e2;
        padding: 4px 8px;
        border-radius: 6px;
        display: inline-block;
    }
</style>

<div class="card border-0 shadow-sm rounded-3">

    <!-- Tab Header Bar -->
    <div class="followup-tabs">
        <ul class="nav nav-tabs border-0" id="followUpTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="today-tab" data-bs-toggle="tab" data-tab="today" type="button">
                    <i class="ri-star-fill text-warning me-1"></i> Today's Due Followup(s)
                    <span class="badge bg-danger badge-tab-count" id="cntToday">0</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pending-tab" data-bs-toggle="tab" data-tab="pending" type="button">
                    Pending Followup(s)
                    <span class="badge bg-secondary badge-tab-count" id="cntPending">0</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="upcoming-tab" data-bs-toggle="tab" data-tab="upcoming" type="button">
                    Upcoming Followup(s)
                    <span class="badge bg-info badge-tab-count text-white" id="cntUpcoming">0</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="closed-tab" data-bs-toggle="tab" data-tab="donotfollowup" type="button">
                    Do not Followup(s)
                    <span class="badge bg-dark badge-tab-count" id="cntClosed">0</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body p-3">

        <!-- Toolbar / Filter Bar -->
        <div class="row g-2 align-items-center mb-3">
            <div class="col-auto d-flex align-items-center gap-2">
                <select id="ddlPageSize" class="form-select form-select-sm" style="width: 75px;" onchange="FetchFollowUpData()">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <small class="text-muted fw-semibold">records per page</small>
            </div>

            <div class="col-auto ms-auto d-flex align-items-center gap-2 flex-wrap">
                <div class="input-group input-group-sm" style="width: 320px;">
                    <span class="input-group-text bg-white"><i class="ri-calendar-line"></i></span>
                    <input type="date" id="txtFromDate" class="form-control" />
                    <span class="input-group-text bg-light text-muted fs-12">to</span>
                    <input type="date" id="txtToDate" class="form-control" />
                    <button type="button" class="btn btn-orange-go" onclick="FetchFollowUpData()" title="Filter Date Range">
                        <i class="ri-arrow-right-line"></i>
                    </button>
                </div>

                <div class="input-group input-group-sm" style="width: 220px;">
                    <input type="text" id="txtSearch" class="form-control" placeholder="Search student..." onkeyup="OnSearchKeyup(event)">
                    <button type="button" class="btn btn-orange-refresh" onclick="FetchFollowUpData()" title="Refresh">
                        <i class="ri-refresh-line"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Table View -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle table-followup mb-0" id="tblFollowUp">
                <thead>
                    <tr>
                        <th class="text-center" width="110">DUE DATE</th>
                        <th class="text-center" width="120">ENQUIRY/WALK <br/> IN DATE</th>
                        <th width="150" style="min-width: 140px;">STUDENT</th>
                        <th width="125">STUDENT<br/> MOBILE NO</th>
                        <th width="125">FATHER <br/>MOBILE NO</th>
                        <th width="125">MOTHER<br/> MOBILE NO</th>
                        <th width="110">AREA</th>
                        <th width="120">FOLLOWUP BY</th>
                        <th width="110">LEAD <br/>STAGE</th>
                        <th width="110">LEAD <br/>SOURCE</th>
                        <th>LAST REMARK</th>
                        <th class="text-center" width="100">ACTION</th>
                    </tr>
                </thead>
                <tbody id="tbodyFollowUp">
                    <tr>
                        <td colspan="12" class="text-center py-4 text-muted">
                            <i class="ri-loader-4-line spin fs-24 d-block mb-1"></i> Loading follow-up data...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

<!-- ================= Modal: Follow Up History & Add Modal ================= -->
<div class="modal fade" id="mdlAddFollowUp" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title text-white mb-0" id="lblModalStudentTitle">Student Follow Up History</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="hfMdlStudentEnquiryID" value="0" />

                <!-- Existing Follow-up Records Table -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-primary mb-0 fs-13"><i class="ri-history-line me-1"></i> Follow Up History</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fs-12" id="btnViewFollowUpHistory" onclick="LoadFollowUpHistory()" title="View All Follow Up History">
                        <i class="ri-eye-line me-1"></i> View All History
                    </button>
                </div>
                <div class="table-responsive mb-3" style="max-height: 220px; overflow-y: auto;">
                    <table class="table table-sm table-bordered align-middle mb-0" id="tblMdlFollowUpHistory">
                        <thead class="table-light fs-12">
                            <tr>
                                <th width="40" class="text-center">#</th>
                                <th width="130">Date</th>
                                <th width="90">Type</th>
                                <th>Discussion</th>
                                <th>Next Action / Remark</th>
                                <th width="110">FollowUp By</th>
                                <th width="130">Next Date</th>
                            </tr>
                        </thead>
                        <tbody id="tblMdlFollowUpHistoryBody" class="fs-12">
                            <!-- Dynamic Follow Up Rows -->
                        </tbody>
                    </table>
                </div>

                <hr class="my-2" />

                <!-- Quick Add Follow-up Form -->
                <h6 class="text-primary mb-2 fs-13"><i class="ri-add-circle-line me-1"></i> Add New Follow Up</h6>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label fs-12 mb-1">Follow Up Date <span class="text-danger">*</span></label>
                        <input type="datetime-local" id="txtMdlFollowUpDate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fs-12 mb-1">Next Follow Up Date</label>
                        <input type="datetime-local" id="txtMdlNextFollowUpDate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fs-12 mb-1">Follow Up Type <span class="text-danger">*</span></label>
                        <select id="ddlMdlFollowUpType" class="form-select form-select-sm">
                            <option value="Call" selected>Call</option>
                            <option value="WhatsApp">WhatsApp</option>
                            <option value="Visit">Visit</option>
                            <option value="Email">Email</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fs-12 mb-1">Discussion <span class="text-danger">*</span></label>
                        <textarea id="txtMdlDiscussion" rows="2" class="form-control form-control-sm" placeholder="Discussion details..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fs-12 mb-1">Next Action / Remark</label>
                        <textarea id="txtMdlNextAction" rows="2" class="form-control form-control-sm" placeholder="Next action or remark..."></textarea>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" id="chkMdlDoNotFollowUp">
                            <label class="form-check-label fw-bold text-danger fs-12" for="chkMdlDoNotFollowUp">Mark as "Do Not Follow Up" / Closed</label>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-success px-3" id="btnSaveMdlFollowUp" onclick="SubmitFollowUpModal()">
                    <i class="ri-save-line me-1"></i> Save Follow Up
                </button>
                <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentTab = "today";

        $(document).ready(function () {
            // Set Default Dates
            var now = new Date();
            var localIso = new Date(now.getTime() - (now.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
            $("#txtMdlFollowUpDate").val(localIso);

            // Tab Switching Event
            $("#followUpTabs button").on("click", function () {
                $("#followUpTabs button").removeClass("active");
                $(this).addClass("active");
                currentTab = $(this).data("tab");
                FetchFollowUpData();
            });

            FetchFollowUpData();
        });

        function OnSearchKeyup(e) {
            if (e.key === "Enter" || e.keyCode === 13) {
                FetchFollowUpData();
            }
        }

        function FetchFollowUpData() {
            var pageSize = parseInt($("#ddlPageSize").val()) || 25;
            var fromDate = $("#txtFromDate").val() || "";
            var toDate = $("#txtToDate").val() || "";
            var search = $("#txtSearch").val().trim();

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentEnquiryFollowUpData",
                data: {
                    tab: currentTab,
                    fromDate: fromDate,
                    toDate: toDate,
                    search: search,
                    pageSize: pageSize
                },
                dataType: "json",
                beforeSend: function () {
                    $("#tbodyFollowUp").html("<tr><td colspan='12' class='text-center py-4 text-muted'><i class='ri-loader-4-line spin fs-24 d-block mb-1'></i> Loading follow-up data...</td></tr>");
                },
                success: function (res) {
                    if (res && res.Status) {
                        // Counts
                        if (res.Counts) {
                            $("#cntToday").text(res.Counts.Today || 0);
                            $("#cntPending").text(res.Counts.Pending || 0);
                            $("#cntUpcoming").text(res.Counts.Upcoming || 0);
                            $("#cntClosed").text(res.Counts.Closed || 0);
                        }

                        var dataList = res.Data || [];
                        var html = "";

                        if (dataList.length === 0) {
                            html = "<tr><td colspan='12' class='text-center py-4 text-muted'><i class='ri-inbox-line fs-28 d-block mb-1'></i> No follow-up records found.</td></tr>";
                        } else {
                            $.each(dataList, function (i, item) {
                                var dueDateStr = item.DueDate || item.NextFollowUpDate || "-";
                                var enqDateStr = item.EnquiryDate || "-";
                                var recordId = item.EncryptedID || item.StudentEnquiryID;
                                var viewId = item.ViewEncryptedID || recordId;

                                html += "<tr>";
                                html += "<td class='text-center'><span class='due-date-badge'>" + dueDateStr + "</span></td>";
                                html += "<td class='text-center text-secondary'>" + enqDateStr + "</td>";
                                html += "<td style='min-width: 140px;'><strong>" + (item.StudentName || item.StudentFullName || '-') + "</strong></td>";
                                html += "<td><a href='tel:" + item.StudentMobileNo + "' class='text-decoration-none fw-semibold text-primary'><i class='ri-phone-line me-1'></i>" + (item.StudentMobileNo || '-') + "</a></td>";
                                html += "<td>" + (item.FatherMobileNo ? ("<a href='tel:" + item.FatherMobileNo + "' class='text-decoration-none text-secondary'><i class='ri-phone-line me-1'></i>" + item.FatherMobileNo + "</a>") : '-') + "</td>";
                                html += "<td>" + (item.MotherMobileNo ? ("<a href='tel:" + item.MotherMobileNo + "' class='text-decoration-none text-secondary'><i class='ri-phone-line me-1'></i>" + item.MotherMobileNo + "</a>") : '-') + "</td>";
                                html += "<td>" + (item.AreaLocation || item.City || '-') + "</td>";
                                html += "<td><span class='badge bg-light text-dark border'>" + (item.FollowUpByUserName || item.FollowUpBy || '-') + "</span></td>";
                                html += "<td><span class='badge bg-warning text-dark'>" + (item.LeadStage || item.FollowUpType || 'Pending') + "</span></td>";
                                html += "<td><span class='badge bg-info text-white'>" + (item.SourceName || item.LeadSource || '-') + "</span></td>";
                                html += "<td><small class='text-muted'>" + (item.LastRemark || item.Discussion || '-') + "</small></td>";
                                html += "<td class='text-center'>";
                                html += "<a href='/bctechadmin/CreateStudentEnquiry?id=" + viewId + "' target='_blank' class='me-2' title='View Enquiry'><i class='ri-eye-line text-info fs-16'></i></a>";
                                html += "<a href='javascript:void(0)' onclick='OpenFollowUpModal(\"" + recordId + "\", \"" + escape(item.StudentName || '') + "\")' title='Follow Up History & Add'><i class='ri-edit-box-line text-primary fs-16'></i></a>";
                                html += "</td>";
                                html += "</tr>";
                            });
                        }
                        $("#tbodyFollowUp").html(html);
                    } else {
                        $("#tbodyFollowUp").html("<tr><td colspan='12' class='text-center py-4 text-danger'>Failed to load data.</td></tr>");
                    }
                },
                error: function (err) {
                    console.error("Fetch error:", err);
                    $("#tbodyFollowUp").html("<tr><td colspan='12' class='text-center py-4 text-danger'>Error connecting to server.</td></tr>");
                }
            });
        }

        function LoadFollowUpHistory() {
            var encryptedId = $("#hfMdlStudentEnquiryID").val();
            if (!encryptedId || encryptedId === "0") return;

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentEnquiryByID",
                data: { id: encryptedId },
                dataType: "json",
                beforeSend: function () {
                    $("#tblMdlFollowUpHistoryBody").html("<tr><td colspan='7' class='text-center py-3'><div class='spinner-border spinner-border-sm text-primary'></div></td></tr>");
                },
                success: function (res) {
                    var html = "";
                    var dataObj = res ? (res.Data || res) : null;
                    var list = (dataObj && dataObj.FollowUpList && dataObj.FollowUpList.length > 0) ? dataObj.FollowUpList : (dataObj && dataObj.FollowUpObj ? [dataObj.FollowUpObj] : []);

                    if (list && list.length > 0) {
                        $.each(list, function (idx, item) {
                            html += "<tr>";
                            html += "<td class='text-center fw-bold'>" + (idx + 1) + "</td>";
                            html += "<td>" + FormatDateTime(item.FollowUpDate) + "</td>";
                            html += "<td><span class='badge bg-soft-primary text-primary'>" + (item.FollowUpType || 'Call') + "</span></td>";
                            html += "<td>" + (item.Discussion || '-') + "</td>";
                            html += "<td>" + (item.NextActionRemark || '-') + "</td>";
                            html += "<td><span class='badge bg-light text-dark border'>" + (item.FollowUpByUserName || '-') + "</span></td>";
                            html += "<td>" + FormatDateTime(item.NextFollowUpDate) + "</td>";
                            html += "</tr>";
                        });
                        $("#tblMdlFollowUpHistoryBody").html(html);
                    } else {
                        $("#tblMdlFollowUpHistoryBody").html("<tr><td colspan='7' class='text-center text-muted py-3'>No previous follow-up records.</td></tr>");
                    }
                },
                error: function () {
                    $("#tblMdlFollowUpHistoryBody").html("<tr><td colspan='7' class='text-center text-muted py-3'>No previous follow-up records.</td></tr>");
                }
            });
        }

        function OpenFollowUpModal(encryptedId, studentNameEsc) {
            var studentName = unescape(studentNameEsc || "");
            $("#hfMdlStudentEnquiryID").val(encryptedId);
            $("#lblModalStudentTitle").text("Student Follow Up History - " + studentName);

            var now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            $("#txtMdlFollowUpDate").val(now.toISOString().slice(0, 16));
            $("#txtMdlNextFollowUpDate").val("");
            $("#txtMdlDiscussion").val("");
            $("#txtMdlNextAction").val("");
            $("#chkMdlDoNotFollowUp").prop("checked", false);

            LoadFollowUpHistory();
            $("#mdlAddFollowUp").modal("show");
        }

        function OpenAddFollowUpModal(enquiryId, studentNameEsc, enquiryNo) {
            OpenFollowUpModal(enquiryId, studentNameEsc);
        }

        function SubmitFollowUpModal() {
            var enquiryId = $("#hfMdlStudentEnquiryID").val();
            var followUpDate = $("#txtMdlFollowUpDate").val();
            var nextFollowUpDate = $("#txtMdlNextFollowUpDate").val();
            var followUpType = $("#ddlMdlFollowUpType").val();
            var followUpBy = parseInt($("#ddlMdlFollowUpBy").val()) || 0;
            var discussion = $("#txtMdlDiscussion").val().trim();
            var nextAction = $("#txtMdlNextAction").val().trim();
            var isClosed = $("#chkMdlDoNotFollowUp").is(":checked");

            if (!enquiryId || enquiryId === "0") {
                toastr.warning("Invalid Enquiry ID.");
                return;
            }

            if (!followUpDate) {
                toastr.warning("Please select Follow Up Date.");
                return;
            }

            if (discussion === "") {
                toastr.warning("Please enter discussion details.");
                $("#txtMdlDiscussion").focus();
                return;
            }

            var model = {
                StudentEnquiryID: (parseInt(enquiryId) > 0 ? parseInt(enquiryId) : 0),
                EncryptedID: enquiryId,
                FollowUpObj: {
                    StudentEnquiryFollowUpID: 0,
                    FollowUpDate: followUpDate,
                    NextFollowUpDate: nextFollowUpDate,
                    FollowUpType: followUpType,
                    FollowUpByUserID: followUpBy,
                    Discussion: discussion,
                    NextActionRemark: nextAction,
                    IsClosed: isClosed
                },
                FollowUpDate: followUpDate,
                NextFollowUpDate: nextFollowUpDate,
                FollowUpType: followUpType,
                FollowUpByUserID: followUpBy,
                Discussion: discussion,
                NextActionRemark: nextAction,
                IsClosed: isClosed
            };

            // Call SaveQuickFollowUp or SaveStudentEnquiryFollowUpEntry
            $.ajax({
                type: "POST",
                url: "/bctechadmin/SaveQuickFollowUp",
                data: JSON.stringify(model),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#btnSaveMdlFollowUp").prop("disabled", true).html("<i class='ri-loader-4-line spin me-1'></i> Saving...");
                },
                success: function (res) {
                    $("#btnSaveMdlFollowUp").prop("disabled", false).html("<i class='ri-save-line me-1'></i> Save Follow Up");

                    if (res && (res.IsSuccess || res.Status)) {
                        toastr.success(res.Message || "Follow Up saved successfully.");
                        $("#mdlAddFollowUp").modal("hide");
                        FetchFollowUpData();
                    } else {
                        toastr.error(res ? res.Message : "Error saving follow up.");
                    }
                },
                error: function (err) {
                    $("#btnSaveMdlFollowUp").prop("disabled", false).html("<i class='ri-save-line me-1'></i> Save Follow Up");
                    console.error("Save error:", err);
                    toastr.error("Server error occurred.");
                }
            });
        }

        function DeleteEnquiry(encryptedId) {
            if (typeof Swal !== "undefined") {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        PerformDelete(encryptedId);
                    }
                });
            } else {
                if (confirm("Are you sure you want to delete this enquiry?")) {
                    PerformDelete(encryptedId);
                }
            }
        }

        function PerformDelete(encryptedId) {
            $.ajax({
                type: "POST",
                url: "/bctechadmin/DeleteStudentEnquiry",
                data: JSON.stringify({ id: encryptedId }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (res) {
                    if (res.IsSuccess) {
                        toastr.success(res.Message || "Enquiry deleted successfully.");
                        FetchFollowUpData();
                    } else {
                        toastr.error(res.Message || 'Failed to delete record.');
                    }
                },
                error: function () {
                    toastr.error("An error occurred while deleting record.");
                }
            });
        }

        function FormatDateTime(dateTimeStr) {
            if (!dateTimeStr) return "-";
            var d = new Date(dateTimeStr);
            if (isNaN(d.getTime())) return dateTimeStr;
            return ("0" + d.getDate()).slice(-2) + "/" + ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear() + " " + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
    </script>
}
