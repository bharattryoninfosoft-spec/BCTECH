
@{
    ViewBag.Title = "CoursequestionView";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<style>
    #tblDisplayMCQ, #tblDisplayMCQExcel {
        font-size: 13.5px;
    }

    #mcqStatusFilterContainer {
        border-color: #e2e8f0;
    }

    body[data-theme="dark"] #mcqStatusFilterContainer {
        background-color: #1e293b !important;
        border-color: #334155 !important;
    }

    body[data-theme="dark"] #mcqStatusFilterContainer label.text-secondary {
        color: #94a3b8 !important;
    }

    /* Practical Exam Table Overrides for style.css */
    #tblPracticalList {
        table-layout: auto !important;
        width: 100% !important;
    }

    #tblPracticalList th,
    #tblPracticalList td {
        overflow: visible !important;
        text-overflow: clip !important;
        white-space: normal !important;
        vertical-align: middle !important;
        padding: 10px 12px !important;
    }

    #tblPracticalList th.nowrap-cell,
    #tblPracticalList td.nowrap-cell {
        white-space: nowrap !important;
    }

    /* Fix style.css line 16339 .btn padding: 14px 35px */
    #tblPracticalList .btn-action-view {
        padding: 6px 12px !important;
        font-size: 12px !important;
        line-height: 1.2 !important;
        font-weight: 500 !important;
        border-radius: 6px !important;
        white-space: nowrap !important;
        height: auto !important;
    }

    #tblPracticalList .btn-action-del {
        padding: 6px 10px !important;
        font-size: 13px !important;
        line-height: 1.2 !important;
        border-radius: 6px !important;
        white-space: nowrap !important;
        height: auto !important;
    }

    #tblPracticalList .btn-status-toggle {
        padding: 4px 10px !important;
        font-size: 11px !important;
        line-height: 1.2 !important;
        font-weight: 500 !important;
        border-radius: 20px !important;
        white-space: nowrap !important;
        height: auto !important;
    }

        #tblDisplayMCQ th, #tblDisplayMCQExcel th {
            font-weight: 600;
            background-color: #f8fafc;
            color: #334155;
        }

        #tblDisplayMCQ td, #tblDisplayMCQ th, #tblDisplayMCQExcel td, #tblDisplayMCQExcel th {
            vertical-align: top !important;
            padding: 10px 12px;
        }

        #tblDisplayMCQ img, #tblDisplayMCQExcel img {
            max-width: 100% !important;
            height: auto !important;
        }

    .mcq-question-cell p, .mcq-answer-cell p {
        margin-bottom: 4px;
    }

    .mcq-objectives-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .mcq-objectives-cell .mcq-opt-item {
            display: flex;
            align-items: baseline;
            gap: 6px;
        }

        .mcq-objectives-cell .mcq-opt-label {
            font-weight: 700;
            color: #1e293b;
            flex-shrink: 0;
            min-width: 18px;
        }

        .mcq-objectives-cell .mcq-opt-text {
            flex: 1;
            min-width: 0;
            word-break: break-word;
        }

            .mcq-objectives-cell .mcq-opt-text p {
                display: inline !important;
                margin: 0 !important;
                padding: 0 !important;
                text-indent: 0 !important;
            }

                .mcq-objectives-cell .mcq-opt-text p + p {
                    display: block !important;
                    margin-top: 2px !important;
                }

    #tblDisplayMCQ_wrapper, #tblDisplayMCQExcel_wrapper {
        padding-top: 4px;
    }

        #tblDisplayMCQ_wrapper .dataTables_filter, #tblDisplayMCQExcel_wrapper .dataTables_filter {
            margin-bottom: 12px;
        }

            #tblDisplayMCQ_wrapper .dataTables_filter label, #tblDisplayMCQExcel_wrapper .dataTables_filter label {
                font-weight: 500;
                color: #475569;
            }

            #tblDisplayMCQ_wrapper .dataTables_filter input, #tblDisplayMCQExcel_wrapper .dataTables_filter input {
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                padding: 5px 12px;
                margin-left: 8px;
                outline: none;
                font-size: 13.5px;
            }

                #tblDisplayMCQ_wrapper .dataTables_filter input:focus, #tblDisplayMCQExcel_wrapper .dataTables_filter input:focus {
                    border-color: #4f46e5;
                    box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.15);
                }

        #tblDisplayMCQ_wrapper .dataTables_length, #tblDisplayMCQExcel_wrapper .dataTables_length {
            margin-bottom: 12px;
        }

            #tblDisplayMCQ_wrapper .dataTables_length label, #tblDisplayMCQExcel_wrapper .dataTables_length label {
                font-weight: 500;
                color: #475569;
            }

            #tblDisplayMCQ_wrapper .dataTables_length select, #tblDisplayMCQExcel_wrapper .dataTables_length select {
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                padding: 5px 10px;
                margin: 0 4px;
                outline: none;
                font-size: 13.5px;
            }

        #tblDisplayMCQ_wrapper .dataTables_info, #tblDisplayMCQExcel_wrapper .dataTables_info {
            font-size: 13px;
            color: #64748b;
            padding-top: 10px;
        }

        #tblDisplayMCQ_wrapper .dataTables_paginate, #tblDisplayMCQExcel_wrapper .dataTables_paginate {
            padding-top: 8px;
        }

            #tblDisplayMCQ_wrapper .dataTables_paginate .paginate_button, #tblDisplayMCQExcel_wrapper .dataTables_paginate .paginate_button {
                padding: 4px 10px !important;
                border-radius: 5px !important;
                font-size: 13px !important;
                cursor: pointer;
            }

                #tblDisplayMCQ_wrapper .dataTables_paginate .paginate_button.current, #tblDisplayMCQExcel_wrapper .dataTables_paginate .paginate_button.current {
                    background: #16a34a !important;
                    border-color: #16a34a !important;
                    color: #fff !important;
                }
</style>

<!-- Start Main Content Area -->

<div class="main-content-container overflow-hidden">


    <div class="row">



        <!-- Button trigger modal -->
        <!-- Modal -->
        <div class="modal fade" id="staticBackdrop3" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdrop3Label" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdrop3Label" style="font-size: 1.20rem !important;"></h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="txtCourseID" name="txtCourseID" value="0" />
                        <input type="hidden" id="hfQuestionID" name="hfQuestionID" value="0" />

                        <div class="card-body">


                            <div id="divMCQQuestions">
                                <!-- Nav Tabs -->
                                <ul class="nav nav-tabs mb-4" id="mcqModalTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active fw-medium fs-15" id="tab-displaymcq" data-bs-toggle="tab" data-bs-target="#tab-pane-displaymcq" type="button" role="tab" aria-controls="tab-pane-displaymcq" aria-selected="true">
                                            <i class="ri-checkbox-circle-line me-1"></i> Display MCQ Questions
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link fw-medium fs-15" id="tab-question" data-bs-toggle="tab" data-bs-target="#tab-pane-question" type="button" role="tab" aria-controls="tab-pane-question" aria-selected="false">
                                            <i class="ri-question-line me-1"></i> Question
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link fw-medium fs-15" id="tab-objective" data-bs-toggle="tab" data-bs-target="#tab-pane-objective" type="button" role="tab" aria-controls="tab-pane-objective" aria-selected="false">
                                            <i class="ri-list-check-2 me-1"></i> Objective
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link fw-medium fs-15" id="tab-answer" data-bs-toggle="tab" data-bs-target="#tab-pane-answer" type="button" role="tab" aria-controls="tab-pane-answer" aria-selected="false">
                                            <i class="ri-checkbox-circle-line me-1"></i> Answer
                                        </button>
                                    </li>

                                </ul>

                                <!-- Tab Contents -->
                                <div class="tab-content" id="mcqModalTabsContent">
                                    <!-- 0 Tab: Display MCQ -->
                                    <div class="tab-pane fade show active" id="tab-pane-displaymcq" role="tabpanel" aria-labelledby="tab-displaymcq" tabindex="0">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                                    <div>
                                                        <h6 class="mb-0 fw-semibold text-secondary fs-16">
                                                            <i class="ri-questionnaire-line me-1 text-primary"></i> MCQ Questions List
                                                        </h6>
                                                        <small class="text-muted" id="lblCourseQuestionCount">Total Questions: 0</small>
                                                    </div>

                                                    <!-- MCQ Status Filter (Active / Deactive) Radio Buttons -->
                                                    <div class="d-flex align-items-center bg-light px-3 py-1 rounded-3 border" id="mcqStatusFilterContainer" style="height: 38px;">
                                                        <div class="form-check form-check-inline m-0 me-3 d-flex align-items-center">
                                                            <input class="form-check-input cursor-pointer me-1" type="radio" name="rdoMCQStatusFilter" id="rdoMCQActive" value="active" checked style="cursor: pointer;">
                                                            <label class="form-check-label fw-semibold text-success fs-13" for="rdoMCQActive" style="cursor: pointer;">
                                                                <i class="ri-checkbox-circle-line me-1"></i>Active
                                                            </label>
                                                        </div>
                                                        <div class="form-check form-check-inline m-0 d-flex align-items-center">
                                                            <input class="form-check-input cursor-pointer me-1" type="radio" name="rdoMCQStatusFilter" id="rdoMCQDeactive" value="deactive" style="cursor: pointer;">
                                                            <label class="form-check-label fw-semibold text-secondary fs-13" for="rdoMCQDeactive" style="cursor: pointer;">
                                                                <i class="ri-close-circle-line me-1"></i>Deactive
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex gap-2">
                                                        <button type="button" class="btn btn-primary btn-sm text-white" onclick="addNewMCQQuestion()">
                                                            <i class="ri-add-line me-1"></i> Add New Question
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="refreshMCQGrid()" title="Reload Questions">
                                                            <i class="ri-refresh-line"></i>
                                                        </button>
                                                    </div>
                                                </div>

                                                <div class="table-responsive">
                                                    <table id="tblDisplayMCQ" class="table table-bordered table-hover align-middle w-100" style="width: 100%;">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th class="text-center" style="width: 60px; min-width: 50px;">SR. No.</th>
                                                                <th class="text-center" style="width: 125px; min-width: 110px;">Operation</th>
                                                                <th style="width: 35%; min-width: 220px;">Question</th>
                                                                <th style="width: 30%; min-width: 220px;">Objectives</th>
                                                                <th style="width: 25%; min-width: 180px;">Answer</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tblDisplayMCQBody">
                                                            <tr>
                                                                <td colspan="5" class="text-center py-4 text-muted">
                                                                    <i class="ri-loader-4-line ri-spin fs-20 align-middle me-1"></i> Loading MCQ Questions...
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 1st Tab: Question -->
                                    <div class="tab-pane fade" id="tab-pane-question" role="tabpanel" aria-labelledby="tab-question" tabindex="0">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="mb-20">
                                                    <label class="label fs-16 mb-2">Question <span class="text-danger">*</span></label>
                                                    <div class="position-relative">
                                                        <textarea id="txtQuestion" name="txtQuestion" class="form-control" rows="5" placeholder="Enter Question"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2nd Tab: Objective -->
                                    <div class="tab-pane fade" id="tab-pane-objective" role="tabpanel" aria-labelledby="tab-objective" tabindex="0">
                                        <div class="row">
                                            <div class="col-lg-6 col-md-6">
                                                <div class="mb-20">
                                                    <label class="label fs-16 mb-2">Option A <span class="text-danger">*</span></label>
                                                    <div class="position-relative">
                                                        <textarea id="txtOBA" name="txtOBA" class="form-control" rows="3" placeholder="Enter Option A"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6 col-md-6">
                                                <div class="mb-20">
                                                    <label class="label fs-16 mb-2">Option B <span class="text-danger">*</span></label>
                                                    <div class="position-relative">
                                                        <textarea id="txtOBB" name="txtOBB" class="form-control" rows="3" placeholder="Enter Option B"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6 col-md-6">
                                                <div class="mb-20">
                                                    <label class="label fs-16 mb-2">Option C <span class="text-muted fs-13">(Optional)</span></label>
                                                    <div class="position-relative">
                                                        <textarea id="txtOBC" name="txtOBC" class="form-control" rows="3" placeholder="Enter Option C"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6 col-md-6">
                                                <div class="mb-20">
                                                    <label class="label fs-16 mb-2">Option D <span class="text-muted fs-13">(Optional)</span></label>
                                                    <div class="position-relative">
                                                        <textarea id="txtOBD" name="txtOBD" class="form-control" rows="3" placeholder="Enter Option D"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 3rd Tab: Answer -->
                                    <div class="tab-pane fade" id="tab-pane-answer" role="tabpanel" aria-labelledby="tab-answer" tabindex="0">
                                        <div class="row">
                                            <div class="col-lg-4 col-md-6">
                                                <div class="mb-20">
                                                    <label class="label fs-16 mb-2">Correct Objective / Answer <span class="text-danger">*</span></label>
                                                    <div class="position-relative">
                                                        <select id="DDLobjectives" name="DDLobjectives" class="form-select">
                                                            <option value="">-- Select Answer --</option>
                                                            <option value="A">A</option>
                                                            <option value="B">B</option>
                                                            <option value="C">C</option>
                                                            <option value="D">D</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="mb-20">
                                                    <label class="label fs-16 mb-2">Answer Description</label>
                                                    <div class="position-relative">
                                                        <textarea id="txtansdesc" name="txtansdesc" class="form-control" rows="4" placeholder="Enter Answer Description"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>



                            </div>


                            <div id="divMCQExcel" style="display: none;">
                                <div class="card border-0 shadow-sm rounded-3">
                                    <div class="card-body p-4">

                                        <!-- Header section -->
                                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                                            <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 50px; height: 50px; background-color: #f0fdf4; border: 1px solid #bbf7d0;">
                                                <i class="ri-file-excel-2-fill fs-24" style="color: #16a34a;"></i>
                                            </div>
                                            <div>
                                                <h5 class="mb-1 fw-bold text-dark">Bulk Upload MCQ Questions via Excel</h5>
                                                <p class="text-muted mb-0 fs-13">Upload an Excel (.xlsx, .xls) file to automatically import and save multiple choice questions for this course.</p>
                                            </div>
                                        </div>

                                        <!-- File Upload Box / Dropzone -->
                                        <div class="mb-4">
                                            <label for="fuMCQExcel" id="mcqExcelDropZone" class="d-block border border-2 border-dashed rounded-3 p-4 text-center m-0"
                                                   style="background-color: #fafafa; border-color: #cbd5e1; cursor: pointer; transition: all 0.2s ease-in-out;">
                                                <div class="py-3">
                                                    <i class="ri-upload-cloud-2-line fs-48" style="color: #16a34a; pointer-events: none;"></i>
                                                    <h6 class="mt-3 mb-1 fw-semibold text-secondary" style="pointer-events: none;">Click here to browse or drag &amp; drop Excel file</h6>
                                                    <p class="text-muted fs-13 mb-2" style="pointer-events: none;">Supported format: <strong>.xlsx, .xls</strong></p>
                                                    <span class="btn btn-outline-success btn-sm px-3 py-1 fw-medium" style="pointer-events: none;">
                                                        <i class="ri-folder-open-line me-1"></i> Browse Excel File
                                                    </span>
                                                </div>
                                            </label>
                                            <input type="file" id="fuMCQExcel" name="fuMCQExcel" accept=".xlsx, .xls" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; opacity: 0;" onchange="onMCQExcelSelected(this)" />

                                            <!-- Selected file info bar (hidden initially) -->
                                            <div id="divSelectedFileInfo" class="mt-3 p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center d-none">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="ri-file-excel-2-line fs-24 text-success"></i>
                                                    <div>
                                                        <div class="fw-semibold text-dark fs-14" id="lblSelectedFileName">filename.xlsx</div>
                                                        <div class="text-muted fs-12" id="lblSelectedFileSize">0 KB</div>
                                                    </div>
                                                </div>
                                                <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2" onclick="clearMCQExcelFile(event)" title="Remove file">
                                                    <i class="ri-close-line"></i> Remove
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Download Sample Excel Section (Directly under Excel upload) -->
                                        <div class="p-3 rounded-3 border mb-4" style="background-color: #f0fdf4; border-color: #bbf7d0;">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background-color: #dcfce7;">
                                                        <i class="ri-file-download-line fs-20" style="color: #15803d;"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold text-dark fs-14">Download Sample Excel Template</div>
                                                        <div class="text-muted fs-12">Download the demo Excel file with sample questions &amp; predefined columns.</div>
                                                    </div>
                                                </div>
                                                <a href="/Content/MCQ-Demo.xlsx" download="MCQ-Demo.xlsx" class="btn btn-sm text-white fw-medium d-inline-flex align-items-center gap-1 px-3 py-2 rounded-2" style="background-color: #16a34a; border-color: #16a34a;">
                                                    <i class="ri-download-2-line"></i> Download Sample Excel
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Back button when no file is previewed -->
                                        <div class="d-flex justify-content-end align-items-center pt-3 border-top mt-3" id="divMCQExcelTopBackBtn">
                                            <button type="button" class="btn btn-outline-secondary px-3 py-2" onclick="cancelMCQExcelUpload()">
                                                <i class="ri-arrow-left-line me-1"></i> Back to Questions List
                                            </button>
                                        </div>

                                    </div>
                                </div>





                                <div class="card border-0 shadow-sm rounded-3 mt-4 d-none" id="cardMCQExcelTable">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                            <div>
                                                <h6 class="mb-0 fw-semibold text-secondary fs-16" id="lblMCQExcelTableTitle">
                                                    <i class="ri-questionnaire-line me-1 text-success"></i> Course MCQ Questions List
                                                </h6>
                                                <small class="text-muted" id="lblMCQExcelQuestionCount">Total Questions: 0</small>
                                            </div>
                                            <div class="d-flex gap-2 align-items-center">
                                                <span class="badge bg-light text-dark border px-2 py-1 fs-12" id="badgeMCQExcelTableStatus">
                                                    <i class="ri-database-2-line me-1 text-primary"></i> Saved Course Questions
                                                </span>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="refreshMCQExcelGrid()" title="Reload Questions">
                                                    <i class="ri-refresh-line"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table id="tblDisplayMCQExcel" class="table table-bordered table-hover align-middle w-100" style="width: 100%;">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="text-center" style="width: 60px; min-width: 50px;">SR. No.</th>
                                                        <th class="text-center" style="width: 125px; min-width: 110px;" id="thMCQExcelOperation">Operation</th>
                                                        <th style="width: 35%; min-width: 220px;">Question</th>
                                                        <th style="width: 30%; min-width: 220px;">Objectives</th>
                                                        <th style="width: 25%; min-width: 180px;">Answer</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tblDisplayMCQExcelBody">
                                                    <tr>
                                                        <td colspan="5" class="text-center py-4 text-muted">
                                                            <i class="ri-loader-4-line ri-spin fs-20 align-middle me-1"></i> Loading MCQ Questions...
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- Upload progress bar (at bottom) -->
                                        <div id="mcqExcelProgress" class="mt-3 mb-2 d-none">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fs-13 fw-medium text-secondary"><i class="ri-loader-4-line ri-spin me-1"></i> Saving MCQ questions into database...</span>
                                                <span class="fs-13 text-muted">Please wait...</span>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width: 100%;"></div>
                                            </div>
                                        </div>

                                        <!-- Upload Action Buttons (at bottom) -->
                                        <div class="d-flex justify-content-end align-items-center gap-2 pt-3 mt-3 border-top">
                                            <button type="button" class="btn btn-outline-secondary px-3 py-2" onclick="cancelMCQExcelUpload()">
                                                <i class="ri-arrow-left-line me-1"></i> Back to Questions List
                                            </button>
                                            <button type="button" class="btn btn-success px-4 py-2 text-white fw-medium d-inline-flex align-items-center gap-2" id="btnUploadMCQExcel" onclick="uploadMCQExcelFile()">
                                                <i class="ri-upload-cloud-line fs-18"></i> Upload &amp; Save Questions
                                            </button>
                                        </div>

                                    </div>
                                </div>


                            </div>



                            <div id="divPracticalExcel" style="display: none;">
                                <!-- Practical PDF Upload Card -->
                                <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: #ffffff; border: 1px solid #fee2e2 !important;">
                                    <div class="card-body p-4">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background-color: #fef2f2; width: 44px; height: 44px;">
                                                <i class="material-symbols-outlined fs-24 text-danger">picture_as_pdf</i>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold text-dark mb-0 fs-16">Upload Practical Exam PDF</h5>
                                                <p class="text-muted fs-12 mb-0">Upload course practical question paper / exam material (.PDF format).</p>
                                            </div>
                                        </div>

                                        <!-- Drag & Drop Zone -->
                                        <div id="dropZonePracticalPdf" class="border border-2 border-dashed rounded-3 p-4 text-center position-relative mb-3"
                                             style="background-color: #fffaf0; border-color: #fca5a5 !important; cursor: pointer; transition: all 0.2s ease;">
                                            <input type="file" id="fuPracticalPdf" accept=".pdf,application/pdf" style="display: none;" onchange="onPracticalPdfSelected(this)" />
                                            <div id="dropZonePracticalPdfPrompt">
                                                <i class="ri-file-pdf-2-line fs-42 text-danger d-block mb-2"></i>
                                                <h6 class="fw-semibold text-dark fs-14 mb-1">Click to browse or Drag &amp; Drop Practical PDF here</h6>
                                                <p class="text-muted fs-12 mb-0">Accepted format: <strong>.PDF only</strong> (Max size: 30MB)</p>
                                            </div>
                                            <!-- Selected file info preview -->
                                            <div id="divPracticalSelectedFileInfo" class="d-none">
                                                <div class="d-flex align-items-center justify-content-center gap-3 p-3 bg-white rounded-2 border">
                                                    <i class="ri-file-pdf-fill fs-36 text-danger"></i>
                                                    <div class="text-start">
                                                        <div class="fw-bold text-dark fs-14" id="lblPracticalPdfName">filename.pdf</div>
                                                        <small class="text-muted fs-12" id="lblPracticalPdfSize">0 KB</small>
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-outline-danger ms-3 py-1 px-2" onclick="clearPracticalPdfFile(event)" title="Remove file">
                                                        <i class="ri-close-line"></i> Remove
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Description -->
                                        <div class="mb-3">
                                            <label for="txtPracticalDescription" class="form-label fs-13 fw-semibold text-secondary mb-1">
                                                Exam Description / Instructions <span class="text-muted fw-normal">(Optional)</span>
                                            </label>
                                            <textarea id="txtPracticalDescription" class="form-control fs-13" rows="2" placeholder="e.g. Practical Exam Task Paper - 100 Marks (Time: 2 Hours)"></textarea>
                                        </div>

                                        <!-- Status isActive Toggle -->
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" id="chkPracticalIsActive" checked style="cursor: pointer;">
                                            <label class="form-check-label fs-13 fw-semibold text-secondary" for="chkPracticalIsActive" style="cursor: pointer;">
                                                Status: <span class="text-success fw-bold" id="lblPracticalStatusTxt">Active</span> <span class="text-muted fw-normal">(isActive in database)</span>
                                            </label>
                                        </div>

                                        <!-- Progress bar -->
                                        <div id="practicalUploadProgress" class="d-none mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1 fs-12">
                                                <span class="text-danger fw-semibold"><i class="ri-loader-4-line ri-spin me-1"></i> Uploading &amp; Saving PDF to database...</span>
                                                <span class="text-muted">Please wait...</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" style="width: 100%;"></div>
                                            </div>
                                        </div>

                                        <!-- Action buttons -->
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2 border-top">
                                            <small class="text-muted fs-12"><i class="ri-shield-check-line text-success me-1"></i> PDF is saved to server and linked into database</small>
                                            <button type="button" class="btn btn-danger px-4 py-2 text-white fw-medium d-inline-flex align-items-center gap-2" id="btnUploadPracticalPdf" onclick="uploadPracticalPdfFile()">
                                                <i class="ri-upload-cloud-line fs-18"></i> Upload &amp; Save PDF
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Uploaded Practical PDFs List -->
                                <div class="card border-0 shadow-sm rounded-3">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <h6 class="mb-0 fw-bold text-dark fs-15">
                                                    <i class="ri-folder-pdf-line text-danger me-1"></i> Uploaded Practical PDFs
                                                </h6>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill fs-11" id="badgePracticalCount">0 Files</span>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="loadPracticalExamList()" title="Refresh List">
                                                <i class="ri-refresh-line"></i> Refresh
                                            </button>
                                        </div>

                                        <div class="table-responsive rounded-2 border">
                                            <table class="table table-hover align-middle mb-0" id="tblPracticalList">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="text-center" style="width: 50px;">#</th>
                                                        <th style="min-width: 200px;">PDF Document</th>
                                                        <th style="min-width: 180px;">Description</th>
                                                        <th class="text-center nowrap-cell" style="width: 105px;">Status</th>
                                                        <th class="nowrap-cell" style="width: 170px;">Uploaded On</th>
                                                        <th class="text-center nowrap-cell" style="width: 160px; min-width: 155px;">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tblPracticalListBody">
                                                    <tr>
                                                        <td colspan="6" class="text-center py-4 text-muted">
                                                            <i class="ri-loader-4-line ri-spin fs-20 align-middle me-1 text-danger"></i> Loading practical exam documents...
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>



                        </div>



                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger text-white" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary text-white" id="btnSaveQuestion" onclick="SaveMCQQuestion()"><i class="ri-save-line me-1"></i> Save Question</button>
                    </div>
                </div>
            </div>
        </div>



        <div class="col-md-12 col-lg-12">
            <div class="row justify-content-center" id="divCourselist">










                <div class="col-sm-6 col-lg-3">
                    <div class="card bg-white rounded-10 border-0 mb-4 shadow-sm">
                        <div class="position-relative">
                            <a href="product-details.html" class="text-decoration-none d-block">
                                <img src="assets/images/product1.jpg" class="w-100 rounded-10" alt="product1">
                            </a>
                        </div>

                        <div class="p-20 text-center">
                            <h3 class="mb-10">
                                <a href="product-details.html" class="text-decoration-none text-secondary hover-text">Luxury Rendering</a>
                            </h3>

                            <!-- Action Buttons Container -->
                            <div class="d-flex flex-column gap-2">
                                <!-- Row 1: MCQ (Blue/Indigo) & Excel (Green) -->
                                <div class="d-flex gap-2">
                                    <!-- MCQ Button -->
                                    <button type="button" class="btn w-50 d-flex align-items-center justify-content-center gap-2 fw-medium rounded-2"
                                            style="padding: 10px; color: #4f46e5; background-color: #eef2ff; border: 1px solid #c7d2fe;" data-bs-toggle="modal" data-bs-target="#staticBackdrop3" onclick="getmcqmodel(1)">
                                        <i class="material-symbols-outlined fs-20">quiz</i>
                                        <span class="fs-15">MCQ</span>
                                    </button>

                                    <!-- Excel Button -->
                                    <button type="button" class="btn w-50 d-flex align-items-center justify-content-center gap-2 fw-medium rounded-2"
                                            style="padding: 10px; color: #15803d; background-color: #f0fdf4; border: 1px solid #bbf7d0;" data-bs-toggle="modal" data-bs-target="#staticBackdrop3" onclick="getexcelmodel(1)">
                                        <i class="material-symbols-outlined fs-20">description</i>
                                        <span class="fs-15">Excel</span>
                                    </button>
                                </div>

                                <!-- Row 2: Practical (PDF Red - Centered) -->
                                <div class="d-flex justify-content-center">
                                    <button type="button" class="btn w-50 d-flex align-items-center justify-content-center gap-2 fw-medium rounded-2"
                                            style="padding: 10px; color: #dc2626; background-color: #fef2f2; border: 1px solid #fecaca;" data-bs-toggle="modal" data-bs-target="#staticBackdrop3" onclick="getpracticlemodel(1)">
                                        <i class="material-symbols-outlined fs-20">computer</i>
                                        <span class="fs-15">Practical</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>







            </div>
        </div>
    </div>
</div>






@section Scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>


        var CourseID = '@(ViewBag.CourseID ?? "")';
        var mode = '@(ViewBag.mode ?? "")';

        function initCKEditors() {
            var editors = ['#txtQuestion', '#txtOBA', '#txtOBB', '#txtOBC', '#txtOBD', '#txtansdesc'];

            editors.forEach(function (sel) {
                var elemId = sel.replace('#', '');
                var isLarge = (sel === '#txtQuestion' || sel === '#txtansdesc');
                var h = isLarge ? 160 : 100;

                if (typeof CKEDITOR !== 'undefined') {
                    if (!CKEDITOR.instances[elemId]) {
                        CKEDITOR.replace(elemId, {
                            height: h
                        });
                    }
                } else if ($.fn.summernote) {
                    if (!$(sel).next('.note-editor').length) {
                        $(sel).summernote({
                            height: h,
                            placeholder: 'Type here...'
                        });
                    }
                }
            });
        }

        $(function () {
            if (typeof EditCourse === "function" && CourseID != "" && CourseID != "0") {
                EditCourse(CourseID);
            }

            if (mode == "E") {
                $("#btnSave").html('<i class="ri-save-line me-2"></i> Update Course');
            } else {
                $("#btnSave").html('<i class="ri-save-line me-2"></i> Save Course');
            }

            if (mode == "V") {
                $("input,select,textarea").prop("disabled", true);
                $(".chkMasterCourse").prop("disabled", true);
                if ($.fn.summernote) {
                    $('#txtQuestion, #txtOBA, #txtOBB, #txtOBC, #txtOBD, #txtansdesc').summernote("disable");
                }
                $("#btnSave").hide();
                $("#fuCourseImage").hide();
                if (typeof ToggleMasterCourse === "function") {
                    ToggleMasterCourse();
                }
            }
        });

        $(document).ready(function () {
            if ($.fn.dataTable) {
                $.fn.dataTable.ext.errMode = 'none';
            }
            GetCourseList();
            initCKEditors();

            $('#staticBackdrop3').on('shown.bs.modal', function () {
                initCKEditors();
                if ($.fn.DataTable && $.fn.DataTable.isDataTable('#tblDisplayMCQ')) {
                    $('#tblDisplayMCQ').DataTable().columns.adjust().draw();
                }
                if ($.fn.DataTable && $.fn.DataTable.isDataTable('#tblDisplayMCQExcel')) {
                    $('#tblDisplayMCQExcel').DataTable().columns.adjust().draw();
                }
            });

            $('#mcqModalTabs button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                initCKEditors();
                if ($(e.target).attr('id') === 'tab-displaymcq') {
                    if ($.fn.DataTable && $.fn.DataTable.isDataTable('#tblDisplayMCQ')) {
                        $('#tblDisplayMCQ').DataTable().columns.adjust().draw();
                    }
                }
            });

            initMCQExcelDropZone();
        });

        var CourseListArray = [];
        var CourseArray = [];


        function GetCourseList() {

            $.ajax({
                url: "/bctechadmin/GetCourseGridList",
                type: "GET",
                dataType: "json",

                success: function (res) {
                    CourseArray = Array.isArray(res) ? res : (res.data || []);

                    console.log(CourseArray);


                    var $courseList = $("#divCourselist");
                    $courseList.empty();

                    // Support both direct array and { data: [...] } response
                    var courses = Array.isArray(res) ? res : (res.data || []);

                    if (!courses.length) {
                        $courseList.html(
                            '<div class="col-12 text-center">' +
                            '<p class="text-muted">No courses available.</p>' +
                            '</div>'
                        );
                        return;
                    }

                    var html = [];

                    $.each(courses, function (i, item) {

                        var courseId = Number(item.CourseID) || 0;

                        var courseTitle = $("<div>")
                            .text(item.CourseTitle || "Untitled Course")
                            .html();
                        //"/Content/Upload/CourseImage/" +
                        var imageUrl = item.CourseImage
                            ? "/Content/Upload/CourseImage/" + item.CourseImage
                            : "/Content/Admin/assets/images/no-image.png";



                        //alert(imageUrl);
                        var safeImageUrl = $("<div>")
                            .text(imageUrl)
                            .html();

                        html.push(
                            '<div class="col-sm-6 col-lg-3">' +
                            '<div class="card bg-white rounded-10 border-0 mb-4 shadow-sm">' +

                            '<div class="position-relative">' +
                            '<img src="https://erp.bctech.org.in/' + safeImageUrl + '"' +
                            ' class="w-100 rounded-10"' +
                            ' alt="' + courseTitle + '"' +
                            ' style="height:180px; object-fit:cover;"' +
                            ' onerror="this.onerror=null;this.src=\'/Content/images/no-image.png\';">' +
                            '</div>' +

                            '<div class="p-20 text-center">' +

                            '<h3 class="mb-10">' +
                            '<a href="javascript:void(0)"' +
                            ' class="text-decoration-none text-secondary hover-text">' +
                            courseTitle +
                            '</a>' +
                            '</h3>' +

                            '<div class="d-flex flex-column gap-2">' +

                            '<div class="d-flex gap-2">' +
                            '<button type="button" class="btn w-50 d-flex align-items-center justify-content-center gap-2 fw-medium rounded-2" style="padding: 10px; color: #4f46e5; background-color: #eef2ff; border: 1px solid #c7d2fe;" data-bs-toggle="modal" data-bs-target="#staticBackdrop3" onclick="getmcqmodel(' + courseId + ')">' +
                            '<i class="material-symbols-outlined fs-20">quiz</i>' +
                            '<span class="fs-15">MCQ</span>' +
                            '</button>' +

                            '<button type="button" class="btn w-50 d-flex align-items-center justify-content-center gap-2 fw-medium rounded-2" style="padding: 10px; color: #15803d; background-color: #f0fdf4; border: 1px solid #bbf7d0;" data-bs-toggle="modal" data-bs-target="#staticBackdrop3" onclick="getexcelmodel(' + courseId + ')">' +
                            '<i class="material-symbols-outlined fs-20">description</i>' +
                            '<span class="fs-15">Excel</span>' +
                            '</button>' +

                            '</div>' +

                            '<div class="d-flex justify-content-center">' +
                            '<button type="button"' +
                            ' class="btn w-100 d-flex align-items-center justify-content-center gap-2 fw-medium rounded-2"' +
                            ' style="padding:10px;color:#dc2626;background-color:#fef2f2;border:1px solid #fecaca;"' +
                            ' data-bs-toggle="modal"' +
                            ' data-bs-target="#staticBackdrop3"' +
                            ' onclick="getpracticlemodel(' + courseId + ')">' +
                            '<i class="material-symbols-outlined fs-20">computer</i>' +
                            '<span class="fs-15">Practical</span>' +
                            '</button>' +
                            '</div>' +

                            '</div>' +
                            '</div>' +
                            '</div>' +
                            '</div>'
                        );

                    });

                    // Append all course cards at once
                    $courseList.html(html.join(""));

                },

                error: function (xhr, status, error) {

                    console.error("GetCourseList Error:", error);
                    console.error("Response:", xhr.responseText);

                    $("#divCourselist").html(
                        '<div class="col-12 text-center">' +
                        '<p class="text-danger">Unable to load courses. Please try again.</p>' +
                        '</div>'
                    );
                }
            });

        }



        function getEditorValue(sel) {
            var elemId = sel.replace('#', '');
            if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances[elemId]) {
                return CKEDITOR.instances[elemId].getData();
            } else if ($.fn.summernote && $(sel).next('.note-editor').length) {
                return $(sel).summernote('code');
            }
            return $(sel).val();
        }

        function setEditorValue(sel, val) {
            var elemId = sel.replace('#', '');
            if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances[elemId]) {
                CKEDITOR.instances[elemId].setData(val || '');
            } else if ($.fn.summernote && $(sel).next('.note-editor').length) {
                $(sel).summernote('code', val || '');
            } else {
                $(sel).val(val || '');
            }
        }

        function resetMCQForm(switchTabToDisplay) {
            $('#hfQuestionID').val('0');
            setEditorValue('#txtQuestion', '');
            setEditorValue('#txtOBA', '');
            setEditorValue('#txtOBB', '');
            setEditorValue('#txtOBC', '');
            setEditorValue('#txtOBD', '');
            $('#DDLobjectives').val('');
            setEditorValue('#txtansdesc', '');
            $("#btnSaveQuestion").html('<i class="ri-save-line me-1"></i> Save Question');

            if (switchTabToDisplay !== false) {
                var firstTab = document.querySelector('#tab-displaymcq');
                if (firstTab && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
                    var tabTrigger = new bootstrap.Tab(firstTab);
                    tabTrigger.show();
                }
            }
        }

        function addNewMCQQuestion() {
            resetMCQForm(false);
            var qTab = document.querySelector('#tab-question');
            if (qTab && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
                var tabTrigger = new bootstrap.Tab(qTab);
                tabTrigger.show();
            }
        }

        function refreshMCQGrid() {
            var courseId = parseInt($("#txtCourseID").val()) || 0;
            if (courseId) {
                LoadMCQQuestionGrid(courseId);
            }
        }

        function getmcqmodel(courseID) {
            var courses = (typeof CourseArray !== 'undefined' && CourseArray.length) ? CourseArray : (typeof CourseListArray !== 'undefined' ? CourseListArray : []);
            var CourseData = courses.find(function (item) {
                return item.CourseID == courseID;
            });

            $("#divMCQQuestions").show();
            $("#divMCQExcel").hide();
            $("#divPracticalExcel").hide();
            $("#btnSaveQuestion").show();

            var courseTitle = CourseData ? CourseData.CourseTitle : ("Course #" + courseID);
            resetMCQForm(true);
            $("#staticBackdrop3Label").html("MCQ Question - " + courseTitle);
            $("#txtCourseID").val(courseID);
            $("#btnSaveQuestion").html('<i class="ri-save-line me-1"></i> Save Question');

            $("#rdoMCQActive").prop("checked", true);

            LoadMCQQuestionGrid(courseID);
        }

        // Register custom DataTable filter for MCQ Active/Deactive status
        if ($.fn.dataTable && $.fn.dataTable.ext && !window.mcqStatusFilterRegistered) {
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (!settings || !settings.nTable || settings.nTable.id !== 'tblDisplayMCQ') {
                    return true;
                }
                var filterVal = $('input[name="rdoMCQStatusFilter"]:checked').val();
                if (!filterVal || filterVal === 'all') {
                    return true;
                }
                var rowNode = settings.aoData[dataIndex] ? settings.aoData[dataIndex].nTr : null;
                if (!rowNode) return true;
                var rowIsActive = $(rowNode).attr('data-isactive');
                if (filterVal === 'active' || filterVal === '1') {
                    return rowIsActive === '1';
                }
                if (filterVal === 'deactive' || filterVal === '0') {
                    return rowIsActive === '0';
                }
                return true;
            });
            window.mcqStatusFilterRegistered = true;
        }

        $(document).on('change', 'input[name="rdoMCQStatusFilter"]', function () {
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#tblDisplayMCQ')) {
                $('#tblDisplayMCQ').DataTable().draw();
            }
        });

        function destroyDisplayMCQDataTable() {
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#tblDisplayMCQ')) {
                try {
                    $('#tblDisplayMCQ').DataTable().destroy();
                } catch (e) {
                    console.warn("DataTable destroy warning:", e);
                }
            }
        }

        function initDisplayMCQDataTable() {
            destroyDisplayMCQDataTable();

            // Safety check: ensure table body has rows and that rows have 5 columns
            var $rows = $('#tblDisplayMCQBody tr');
            if ($rows.length === 0) {
                return;
            }
            var $firstRowCells = $rows.first().children('td');
            if ($firstRowCells.length !== 5) {
                // Not a valid 5-column data row (e.g. colspan message row), do not initialize DataTable
                return;
            }

            if ($.fn.DataTable) {
                try {
                    $('#tblDisplayMCQ').DataTable({
                        pageLength: 20,
                        lengthMenu: [[20, 50, 100, -1], [20, 50, 100, "All"]],
                        ordering: false,
                        autoWidth: false,
                        responsive: true,
                        drawCallback: function (settings) {
                            var api = this.api();
                            var startIndex = api.context[0]._iDisplayStart;
                            api.column(0, { page: 'current' }).nodes().each(function (cell, i) {
                                cell.innerHTML = (startIndex + i + 1);
                            });

                            var info = api.page.info();
                            $("#lblCourseQuestionCount").text("Total Questions: " + info.recordsDisplay);
                        },
                        language: {
                            search: "Search:",
                            searchPlaceholder: "Search Question, Objective, Answer...",
                            lengthMenu: "Show _MENU_ questions",
                            info: "Showing _START_ to _END_ of _TOTAL_ questions",
                            infoEmpty: "Showing 0 to 0 of 0 questions",
                            infoFiltered: "(filtered from _MAX_ total questions)",
                            emptyTable: "No MCQ questions available for this filter.",
                            paginate: {
                                previous: '<i class="ri-arrow-left-s-line"></i> Prev',
                                next: 'Next <i class="ri-arrow-right-s-line"></i>'
                            }
                        }
                    });
                } catch (e) {
                    console.warn("DataTable init warning:", e);
                }
            }
        }

        function hasOptionValue(val) {
            if (!val) return false;
            if (typeof val !== 'string') val = String(val);
            if (/<img/i.test(val)) return true;
            var clean = val.replace(/<[^>]*>/g, '').replace(/&nbsp;|&#160;/gi, '').trim();
            return clean.length > 0;
        }

        function cleanOptionHtml(html) {
            if (!html) return '';
            var trimmed = html.trim();
            var match = trimmed.match(/^<p(?:\s+[^>]*)?>([\s\S]*?)<\/p>$/i);
            if (match && !/<p(?:\s+[^>]*)?>/i.test(match[1])) {
                trimmed = match[1].trim();
            }
            return trimmed;
        }

        function renderOptionItem(label, val) {
            return '<div class="mcq-opt-item">' +
                   '<strong class="mcq-opt-label">' + label + '.</strong> ' +
                   '<div class="mcq-opt-text">' + cleanOptionHtml(val) + '</div>' +
                   '</div>';
        }

        function LoadMCQQuestionGrid(courseId) {
            if (!courseId) {
                courseId = parseInt($("#txtCourseID").val()) || 0;
            }
            if (!courseId) return;
            
            destroyDisplayMCQDataTable();

            $("#tblDisplayMCQBody").html('<tr><td colspan="5" class="text-center py-4 text-muted"><i class="ri-loader-4-line ri-spin fs-22 align-middle me-2"></i> Loading MCQ Questions...</td></tr>');

            $.ajax({
                url: "/bctechadmin/GetMCQQuestionList",
                type: "GET",
                data: { course_id: courseId },
                dataType: "json",
                success: function (res) {
                    if (res && res.Status) {
                        var list = res.Data || [];
                        $("#lblCourseQuestionCount").text("Total Questions: " + list.length);

                        if (list.length === 0) {
                            destroyDisplayMCQDataTable();
