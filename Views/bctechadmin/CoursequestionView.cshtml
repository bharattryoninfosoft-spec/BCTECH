        function SaveMCQQuestion() {
            var courseId = parseInt($("#txtCourseID").val()) || 0;
            var questionId = parseInt($("#hfQuestionID").val()) || 0;
            var questions = getEditorValue('#txtQuestion');
            var oba = getEditorValue('#txtOBA');
            var obb = getEditorValue('#txtOBB');
            var obc = getEditorValue('#txtOBC');
            var obd = getEditorValue('#txtOBD');
            var ddlAns = $("#DDLobjectives").val();
            var ansDesc = getEditorValue('#txtansdesc');

            if (!courseId) {
                toastr.warning("Course ID is missing. Please select course again.");
                return;
            }

            var qText = $("<div>").html(questions).text().trim();
            if (!qText && !questions.includes('<img')) {
                toastr.warning("Please enter Question.");
                var qTab = new bootstrap.Tab(document.querySelector('#tab-question'));
                qTab.show();
                return;
            }

            var obaText = $("<div>").html(oba).text().trim();
            var obbText = $("<div>").html(obb).text().trim();
            var obcText = $("<div>").html(obc).text().trim();
            var obdText = $("<div>").html(obd).text().trim();

            if (!obaText || !obbText) {
                toastr.warning("Please provide Option A and Option B.");
                var objTab = new bootstrap.Tab(document.querySelector('#tab-objective'));
                objTab.show();
                return;
            }

            if (!ddlAns) {
                toastr.warning("Please select Correct Answer Option in Answer tab.");
                var ansTab = new bootstrap.Tab(document.querySelector('#tab-answer'));
                ansTab.show();
                return;
            }

            if (ddlAns === "C" && !obcText) {
                toastr.warning("Option C cannot be empty when selected as correct answer.");
                var objTab = new bootstrap.Tab(document.querySelector('#tab-objective'));
                objTab.show();
                return;
            }

            if (ddlAns === "D" && !obdText) {
                toastr.warning("Option D cannot be empty when selected as correct answer.");
                var objTab = new bootstrap.Tab(document.querySelector('#tab-objective'));
                objTab.show();
                return;
            }

            var isUpdate = (questionId > 0);
            var btnText = isUpdate ? 'Updating...' : 'Saving...';
            var defaultBtnHtml = isUpdate ? '<i class="ri-save-line me-1"></i> Update Question' : '<i class="ri-save-line me-1"></i> Save Question';

            if (!hasOptionValue(obc)) {
                obc = '';
            }
            if (!hasOptionValue(obd)) {
                obd = '';
            }

            var postData = {
                question_id: questionId,
                course_id: courseId,
                questions: questions,
                txtOBA: oba,
                txtOBB: obb,
                txtOBC: obc,
                txtOBD: obd,
                DDLobjectives: ddlAns,
                txtansdesc: ansDesc
            };

            $("#btnSaveQuestion").prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> ' + btnText);

            $.ajax({
                url: "/bctechadmin/SaveMCQQuestion",
                type: "POST",
                data: postData,
                dataType: "json",
                success: function (res) {
                    $("#btnSaveQuestion").prop("disabled", false).html(defaultBtnHtml);
                    if (res && res.Status) {
                        toastr.success(res.Message || (isUpdate ? "MCQ Question updated successfully!" : "MCQ Question saved successfully!"));
                        resetMCQForm(true);
                        LoadMCQQuestionGrid(courseId);
                    } else {
                        toastr.error(res && res.Message ? res.Message : "Failed to save Question.");
                    }
                },
                error: function (xhr, status, error) {
                    $("#btnSaveQuestion").prop("disabled", false).html(defaultBtnHtml);
                    toastr.error("Server error occurred while saving: " + error);
                }
            });
        }

        function EditMCQQuestion(questionId) {
            $.ajax({
                url: "/bctechadmin/GetMCQQuestionByID",
                type: "GET",
                data: { question_id: questionId },
                dataType: "json",
                success: function (res) {
                    if (res && res.Status && res.Data) {
                        var d = res.Data;
                        $("#hfQuestionID").val(d.question_id);
                        $("#txtCourseID").val(d.course_id);
                        $("#staticBackdrop3Label").html("Edit MCQ Question - " + (d.CourseTitle || ""));
                        setEditorValue('#txtQuestion', d.questions);
                        setEditorValue('#txtOBA', d.OptionA_Text);
                        setEditorValue('#txtOBB', d.OptionB_Text);
                        setEditorValue('#txtOBC', d.OptionC_Text);
                        setEditorValue('#txtOBD', d.OptionD_Text);
                        $("#DDLobjectives").val(d.CorrectOption || "");
                        setEditorValue('#txtansdesc', d.answer_description);
                        $("#btnSaveQuestion").html('<i class="ri-save-line me-1"></i> Update Question');

                        // Switch to Question tab
                        var qTab = document.querySelector('#tab-question');
                        if (qTab && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
                            var tabTrigger = new bootstrap.Tab(qTab);
                            tabTrigger.show();
                        }

                        toastr.info("Question loaded for editing. Make your changes and click 'Update Question'.");
                    } else {
                        toastr.error(res && res.Message ? res.Message : "Question not found.");
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("Error fetching Question: " + error);
                }
            });
        }

        function escapeMCQHtml(text) {
            if (!text) return '';
            return $('<div>').text(String(text)).html();
        }

        function DeleteMCQQuestion(questionId, btn) {
            if (!confirm("Are you sure you want to permanently delete this MCQ Question? This will delete the Question, Objectives, and Answer records.")) {
                return;
            }

            $.ajax({
                url: "/bctechadmin/DeleteMCQQuestion",
                type: "POST",
                data: { question_id: questionId },
                dataType: "json",
                success: function (res) {
                    if (res && res.Status) {
                        toastr.success(res.Message || "Question deleted successfully.");

                        var tableId = btn ? $(btn).closest('table').attr('id') : null;
                        if (tableId && $.fn.DataTable && $.fn.DataTable.isDataTable('#' + tableId)) {
                            var dt = $('#' + tableId).DataTable();
                            var $tr = $(btn).closest('tr');
                            dt.row($tr).remove().draw(false);
                        }

                        var currentCount = parseInt($("#lblCourseQuestionCount").text().replace(/\D/g, '')) || 0;
                        if (currentCount > 0) {
                            $("#lblCourseQuestionCount").text("Total Questions: " + (currentCount - 1));
                        }

                        var excelCount = parseInt($("#lblMCQExcelQuestionCount").text().replace(/\D/g, '')) || 0;
                        if (excelCount > 0) {
                            $("#lblMCQExcelQuestionCount").text("Total Questions: " + (excelCount - 1));
                        }

                        if (parseInt($("#hfQuestionID").val()) === questionId) {
                            resetMCQForm(false);
                        }
                    } else {
                        toastr.error(res && res.Message ? res.Message : "Failed to delete Question.");
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("Error deleting Question: " + error);
                }
            });
        }

        function ToggleMCQStatus(questionId, status, btn) {
            var $btn = $(btn);
            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

            $.ajax({
                url: "/bctechadmin/ToggleMCQQuestionStatus",
                type: "POST",
                data: { question_id: questionId, status: status },
                dataType: "json",
                success: function (res) {
                    $btn.prop('disabled', false);
                    if (res && res.Status) {
                        toastr.success(res.Message || "Question status updated.");

                        if (status === 1) {
                            $btn.removeClass('btn-secondary').addClass('btn-success')
                                .attr('title', 'Click to Deactivate')
                                .attr('onclick', 'ToggleMCQStatus(' + questionId + ', 0, this)')
                                .html('<i class="ri-checkbox-circle-line"></i> <span>Active</span>');
                            $btn.closest('tr').attr('data-isactive', '1');
                        } else {
                            $btn.removeClass('btn-success').addClass('btn-secondary')
                                .attr('title', 'Click to Activate')
                                .attr('onclick', 'ToggleMCQStatus(' + questionId + ', 1, this)')
                                .html('<i class="ri-close-circle-line"></i> <span>Deactive</span>');
                            $btn.closest('tr').attr('data-isactive', '0');
                        }

                        // Update DataTables internal cache without resetting page or clearing search filter
                        var tableId = $btn.closest('table').attr('id');
                        if (tableId && $.fn.DataTable && $.fn.DataTable.isDataTable('#' + tableId)) {
                            var dt = $('#' + tableId).DataTable();
                            var $tr = $btn.closest('tr');
                            dt.row($tr).invalidate().draw(false);
                        }
                    } else {
                        $btn.html(originalHtml);
                        toastr.error(res && res.Message ? res.Message : "Failed to update status.");
                    }
                },
                error: function (xhr, status, error) {
                    $btn.prop('disabled', false).html(originalHtml);
                    toastr.error("Error updating status: " + error);
                }
            });
        }

