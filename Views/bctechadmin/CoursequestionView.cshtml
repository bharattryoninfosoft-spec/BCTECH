        function handlePracticalPdfFile(file) {
            if (!file) return;

            var ext = (file.name || "").split('.').pop().toLowerCase();
            if (ext !== 'pdf') {
                toastr.warning("Please select a valid PDF file (.pdf).");
                clearPracticalPdfFile();
                return;
            }

            if (file.size > 30 * 1024 * 1024) {
                toastr.warning("File is too large! Maximum allowed size is 30MB.");
                clearPracticalPdfFile();
                return;
            }

            currentSelectedPracticalPdf = file;

            var sizeFormatted = "";
            if (file.size < 1024) sizeFormatted = file.size + " bytes";
            else if (file.size < 1048576) sizeFormatted = (file.size / 1024).toFixed(1) + " KB";
            else sizeFormatted = (file.size / 1048576).toFixed(2) + " MB";

            $("#lblPracticalPdfName").text(file.name);
            $("#lblPracticalPdfSize").text(sizeFormatted);
            $("#dropZonePracticalPdfPrompt").addClass("d-none");
            $("#divPracticalSelectedFileInfo").removeClass("d-none");
        }

        function clearPracticalPdfFile(e) {
            if (e) e.stopPropagation();
            currentSelectedPracticalPdf = null;
            $("#fuPracticalPdf").val("");
            $("#lblPracticalPdfName").text("");
            $("#lblPracticalPdfSize").text("");
            $("#divPracticalSelectedFileInfo").addClass("d-none");
            $("#dropZonePracticalPdfPrompt").removeClass("d-none");
        }

        function uploadPracticalPdfFile() {
            if (!currentSelectedPracticalPdf) {
                toastr.warning("Please select or drop a PDF file first.");
                return;
            }

            var courseID = currentPracticalCourseID || $("#txtCourseID").val();
            if (!courseID || Number(courseID) <= 0) {
                toastr.error("Invalid Course selected.");
                return;
            }

            var desc = $("#txtPracticalDescription").val() || "";
            var isActive = $("#chkPracticalIsActive").is(":checked");

            var formData = new FormData();
            formData.append("course_id", courseID);
            formData.append("description", desc);
            formData.append("isActive", isActive);
            formData.append("pdfFile", currentSelectedPracticalPdf);

            $("#btnUploadPracticalPdf").prop("disabled", true).html('<i class="ri-loader-4-line ri-spin fs-18"></i> Uploading...');
            $("#practicalUploadProgress").removeClass("d-none");

            $.ajax({
                url: "/bctechadmin/UploadPracticalExamPdf",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    $("#btnUploadPracticalPdf").prop("disabled", false).html('<i class="ri-upload-cloud-line fs-18"></i> Upload &amp; Save PDF');
                    $("#practicalUploadProgress").addClass("d-none");

                    if (res && res.Status) {
                        toastr.success(res.Message || "Practical PDF uploaded and saved successfully!");
                        clearPracticalPdfFile();
                        $("#txtPracticalDescription").val("");
                        $("#chkPracticalIsActive").prop("checked", true);
                        $("#lblPracticalStatusTxt").text("Active").removeClass("text-secondary").addClass("text-success");
                        loadPracticalExamList();
                    } else {
                        toastr.error((res && res.Message) || "Failed to upload Practical PDF.");
                    }
                },
                error: function (xhr, status, error) {
                    $("#btnUploadPracticalPdf").prop("disabled", false).html('<i class="ri-upload-cloud-line fs-18"></i> Upload &amp; Save PDF');
                    $("#practicalUploadProgress").addClass("d-none");
                    toastr.error("Upload error: " + error);
                }
            });
        }

