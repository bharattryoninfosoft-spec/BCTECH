                    }
                },
                error: function (xhr, status, error) {
                    destroyDisplayMCQExcelDataTable();
                    $("#tblDisplayMCQExcelBody").html('<tr><td colspan="5" class="text-center py-4 text-danger">Error reading Excel file: ' + error + '</td></tr>');
                }
            });
        }

