        function initPracticalPdfDropZone() {
            var dropZone = document.getElementById("dropZonePracticalPdf");
            if (!dropZone) return;

            dropZone.onclick = function (e) {
                if (e.target.closest('button')) return;
                var fileInput = document.getElementById("fuPracticalPdf");
                if (fileInput) fileInput.click();
            };

            dropZone.ondragover = function (e) {
                e.preventDefault();
                dropZone.style.backgroundColor = "#fee2e2";
                dropZone.style.borderColor = "#dc2626";
            };

            dropZone.ondragleave = function (e) {
                e.preventDefault();
                dropZone.style.backgroundColor = "#fffaf0";
                dropZone.style.borderColor = "#fca5a5";
            };

            dropZone.ondrop = function (e) {
                e.preventDefault();
                dropZone.style.backgroundColor = "#fffaf0";
                dropZone.style.borderColor = "#fca5a5";
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    handlePracticalPdfFile(e.dataTransfer.files[0]);
                }
            };
        }

        function onPracticalPdfSelected(input) {
            if (input && input.files && input.files.length > 0) {
