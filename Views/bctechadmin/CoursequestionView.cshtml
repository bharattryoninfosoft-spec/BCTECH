        function getexcelmodel(courseID) {
            var courses = (typeof CourseArray !== 'undefined' && CourseArray.length) ? CourseArray : (typeof CourseListArray !== 'undefined' ? CourseListArray : []);
            var CourseData = courses.find(function (item) {
                return item.CourseID == courseID;
            });

            var courseTitle = CourseData ? CourseData.CourseTitle : ("Course #" + courseID);

            $("#divMCQQuestions").hide();
            $("#divMCQExcel").show();
