                contentType: false,
                processData: false,
                success: function (res) {
                    if (res && res.Status && res.Data) {
                        var parsed = res.Data.map(function (item) {
                            return {
                                rowIndex: item.RowIndex,
                                Question: item.Question,
                                OptionA: item.A,
                                OptionB: item.B,
                                OptionC: item.C,
                                OptionD: item.D,
                                Answer: item.Answer,
                                Describe: item.Describe
                            };
