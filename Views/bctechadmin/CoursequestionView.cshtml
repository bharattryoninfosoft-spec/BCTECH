        function initMCQExcelDropZone() {
            var dropZone = document.getElementById('mcqExcelDropZone');
            if (!dropZone || dropZone._hasDropInit) return;
            dropZone._hasDropInit = true;

            // Global window drag protection to prevent browser from navigating away on dropped files
            window.addEventListener('dragover', function (e) {
                if (e.dataTransfer && e.dataTransfer.types && Array.from(e.dataTransfer.types).includes('Files')) {
                    e.preventDefault();
                }
            }, false);

            window.addEventListener('drop', function (e) {
                if (e.dataTransfer && e.dataTransfer.types && Array.from(e.dataTransfer.types).includes('Files')) {
                    e.preventDefault();
                }
            }, false);

            dropZone.addEventListener('dragenter', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.style.borderColor = '#16a34a';
                dropZone.style.backgroundColor = '#f0fdf4';
            }, false);

            dropZone.addEventListener('dragover', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (e.dataTransfer) {
                    e.dataTransfer.dropEffect = 'copy';
                }
                dropZone.style.borderColor = '#16a34a';
                dropZone.style.backgroundColor = '#f0fdf4';
            }, false);

            dropZone.addEventListener('dragleave', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.style.borderColor = '#cbd5e1';
                dropZone.style.backgroundColor = '#fafafa';
            }, false);

            dropZone.addEventListener('drop', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.style.borderColor = '#cbd5e1';
                dropZone.style.backgroundColor = '#fafafa';

                var dt = e.dataTransfer;
                var files = dt ? dt.files : null;
                if (files && files.length > 0) {
                    var file = files[0];
                    currentSelectedMCQExcelFile = file;

                    var fileInput = document.getElementById('fuMCQExcel');
                    if (fileInput) {
                        try {
                            var dataTransfer = new DataTransfer();
                            dataTransfer.items.add(file);
                            fileInput.files = dataTransfer.files;
                        } catch (ex) {
                            try { fileInput.files = files; } catch (e2) {}
                        }
                    }

                    handleMCQExcelFile(file);
                }
            }, false);
        }
    </script>
}



