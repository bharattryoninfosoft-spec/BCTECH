        function handleMCQExcelFile(file) {
            if (!file) return;

            var fileName = file.name || "";
            var ext = fileName.split('.').pop().toLowerCase();

            if (ext !== 'xlsx' && ext !== 'xls') {
                toastr.warning("Please select a valid Excel file (.xlsx, .xls).");
                clearMCQExcelFile();
                return;
            }

            currentSelectedMCQExcelFile = file;

