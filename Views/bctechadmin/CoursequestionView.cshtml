        function loadMCQExcelPreview(file) {
            if (!file) return;

            $("#cardMCQExcelTable").removeClass("d-none");
            $("#divMCQExcelTopBackBtn").addClass("d-none");

            destroyDisplayMCQExcelDataTable();
            $("#lblMCQExcelTableTitle").html('<i class="ri-file-excel-2-line text-success me-1"></i> Excel File Preview: <span class="text-primary">' + escapeMCQHtml(file.name) + '</span>');
            $("#badgeMCQExcelTableStatus").removeClass().addClass("badge bg-warning-subtle text-warning border border-warning px-2 py-1 fs-12")
                .html('<i class="ri-eye-line me-1"></i> Excel Preview (Unsaved)');
            $("#lblMCQExcelQuestionCount").text("Reading Excel file...");
            $("#tblDisplayMCQExcelBody").html('<tr><td colspan="5" class="text-center py-4 text-muted"><i class="ri-loader-4-line ri-spin fs-22 align-middle me-2 text-success"></i> Reading Excel questions...</td></tr>');

            if (typeof XLSX !== 'undefined') {
                var reader = new FileReader();
                reader.onload = function (e) {
                    try {
                        var data = new Uint8Array(e.target.result);
                        var workbook = XLSX.read(data, { type: 'array' });
                        var sheetName = workbook.SheetNames[0];
                        var worksheet = workbook.Sheets[sheetName];
                        var rawRows = XLSX.utils.sheet_to_json(worksheet, { header: 1, defval: '' });

                        if (!rawRows || rawRows.length <= 1) {
                            destroyDisplayMCQExcelDataTable();
                            $("#tblDisplayMCQExcelBody").html('<tr><td colspan="5" class="text-center py-4 text-warning"><i class="ri-alert-line fs-20 me-1"></i> No questions found in the Excel file. Please ensure data starts from Row 2.</td></tr>');
                            $("#lblMCQExcelQuestionCount").text("0 Questions detected");
                            return;
                        }

                        var parsedRows = [];
                        for (var i = 1; i < rawRows.length; i++) {
                            var r = rawRows[i];
                            if (!r || r.length === 0) continue;

                            var q = String(r[0] || '').trim();
                            var a = String(r[1] || '').trim();
                            var b = String(r[2] || '').trim();
                            var c = String(r[3] || '').trim();
                            var d = String(r[4] || '').trim();
                            var ans = String(r[5] || '').trim();
                            var desc = String(r[6] || '').trim();

                            if (!q && !a && !b && !c && !d && !ans) continue;

                            var normAns = ans.toUpperCase();
                            if (normAns === '1') normAns = 'A';
                            else if (normAns === '2') normAns = 'B';
                            else if (normAns === '3') normAns = 'C';
                            else if (normAns === '4') normAns = 'D';

                            if (normAns !== 'A' && normAns !== 'B' && normAns !== 'C' && normAns !== 'D') {
                                if (a && normAns === a.toUpperCase()) normAns = 'A';
                                else if (b && normAns === b.toUpperCase()) normAns = 'B';
                                else if (c && normAns === c.toUpperCase()) normAns = 'C';
                                else if (d && normAns === d.toUpperCase()) normAns = 'D';
                                else normAns = normAns || 'A';
                            }

                            parsedRows.push({
                                rowIndex: i + 1,
                                Question: q,
                                OptionA: a,
                                OptionB: b,
                                OptionC: c,
                                OptionD: d,
                                Answer: normAns,
                                Describe: desc
                            });
                        }

                        if (parsedRows.length === 0) {
                            destroyDisplayMCQExcelDataTable();
                            $("#tblDisplayMCQExcelBody").html('<tr><td colspan="5" class="text-center py-4 text-warning"><i class="ri-alert-line fs-20 me-1"></i> No valid questions found in Excel file.</td></tr>');
                            $("#lblMCQExcelQuestionCount").text("0 Questions detected");
                            return;
                        }

                        renderMCQExcelPreviewRows(parsedRows);
                    } catch (err) {
                        console.error("XLSX parse error:", err);
                        fallbackServerPreview(file);
                    }
                };
                reader.onerror = function () {
                    fallbackServerPreview(file);
                };
                reader.readAsArrayBuffer(file);
            } else {
                fallbackServerPreview(file);
            }
        }

        function renderMCQExcelPreviewRows(parsedRows) {
            window.currentMCQParsedExcelRows = parsedRows;
            $("#cardMCQExcelTable").removeClass("d-none");
            $("#divMCQExcelTopBackBtn").addClass("d-none");
            destroyDisplayMCQExcelDataTable();
            $("#lblMCQExcelQuestionCount").text("Preview: " + parsedRows.length + " Questions Found in Excel (Ready to Upload)");

            var rowsHtml = [];
            $.each(parsedRows, function (i, item) {
                var isValid = item.Question && item.OptionA && item.OptionB && item.Answer;
                var statusBadge = isValid
                    ? '<span class="badge bg-success-subtle text-success border border-success px-2 py-1"><i class="ri-check-line"></i> Row #' + item.rowIndex + '</span>'
                    : '<span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1" title="Question, Option A, Option B, and Answer are required"><i class="ri-error-warning-line"></i> Row #' + item.rowIndex + ' (Incomplete)</span>';

                var opCol = '<div class="d-flex flex-column align-items-center gap-1" style="min-width: 110px;">' +
                            statusBadge +
                            '<span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1 fs-11">Ready to Save</span>' +
                            '</div>';

                var qCol = '<div class="mcq-question-cell fw-medium" style="max-height: 250px; overflow-y: auto;">' + escapeMCQHtml(item.Question) + '</div>';

                var objItems = [];
                if (item.OptionA) objItems.push(renderOptionItem('A', escapeMCQHtml(item.OptionA)));
                if (item.OptionB) objItems.push(renderOptionItem('B', escapeMCQHtml(item.OptionB)));
                if (item.OptionC) objItems.push(renderOptionItem('C', escapeMCQHtml(item.OptionC)));
                if (item.OptionD) objItems.push(renderOptionItem('D', escapeMCQHtml(item.OptionD)));

                var objCol = '<div class="mcq-objectives-cell">' + objItems.join('') + '</div>';

                var descHtml = '';
                if (item.Describe) {
                    descHtml = '<div class="mt-2 p-2 bg-light rounded border text-muted small"><strong class="text-secondary">Desc:</strong> <div>' + escapeMCQHtml(item.Describe) + '</div></div>';
                }

                var ansCol = '<div class="mcq-answer-cell">' +
                             '<div><span class="badge bg-success-subtle text-success fs-13 border border-success px-2 py-1"><i class="ri-check-line fw-bold me-1"></i>Option <strong>' + (item.Answer || 'A') + '</strong></span></div>' +
                             descHtml +
                             '</div>';

                rowsHtml.push('<tr>' +
                              '<td class="text-center align-top fw-semibold text-secondary">' + (i + 1) + '</td>' +
                              '<td class="text-center align-top">' + opCol + '</td>' +
                              '<td class="align-top">' + qCol + '</td>' +
                              '<td class="align-top">' + objCol + '</td>' +
                              '<td class="align-top">' + ansCol + '</td>' +
                              '</tr>');
            });

            $("#tblDisplayMCQExcelBody").html(rowsHtml.join(""));
            initDisplayMCQExcelDataTable();
            toastr.info("Excel file loaded! Showing " + parsedRows.length + " questions in preview below.");
        }

        function fallbackServerPreview(file) {
            $("#cardMCQExcelTable").removeClass("d-none");
            $("#divMCQExcelTopBackBtn").addClass("d-none");

            var formData = new FormData();
            formData.append("excelFile", file);

