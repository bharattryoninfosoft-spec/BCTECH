
@{
    ViewBag.Title = "StudentDocumentMaster";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}


<div class="card bg-white rounded-10 border border-white mb-4">

    <div class="justify-content-between align-items-center flex-wrap gap-3 p-20">

        <form class="table-src-form position-relative m-0">
            <input type="text" id="txtSearch" class="form-control w-350" placeholder="Search Student Document...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
        <!--
        <a href="javascript:void(0);" class="text-primary fs-16 text-decoration-none"
           onclick="OpenStudentDocumentModal()">
            + Add Student Document
        </a>-->


        <a href="javascript:void(0);" class="btn btn-primary text-white" onclick="OpenStudentDocumentModal()">
            <i class="ri-add-line"></i> Add Student Document
        </a>


    </div>

    <div class="default-table-area mx-minus-1 table-contact-list">

        <div class="table-responsive">

            <table class="table-common" id="tblStudentDocument">

                <thead>

                    <tr>
                        <th>SR</th>
                        <th>Student Document</th>
                        <th>Created Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="col-lg-12">
            <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
                <span class="fs-15" id="lblShowing"></span>

                <nav class="custom-pagination" aria-label="Page navigation example">
                    <ul class="pagination mb-0 justify-content-center" id="pagination"></ul>
                </nav>
            </div>
        </div>

    </div>

    <!-- Modal -->

    <div class="modal fade" id="StudentDocumentModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">Student Document</h5>

                    <button class="btn-close" data-bs-dismiss="modal"></button>

                </div>

                <div class="modal-body">

                    <input type="hidden" id="hfStudentDocumentID" value="0" />

                    <div class="mb-3">

                        <label class="form-label">Student Document</label>

                        <input type="text"
                               id="txtStudentDocumentTitle"
                               class="form-control"
                               maxlength="200"
                               placeholder="Enter Student Document" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button class="btn btn-primary text-white"
                            onclick="SaveStudentDocument()">
                        Save
                    </button>

                </div>

            </div>

        </div>

    </div>

    @section Scripts{
        <script>

            var StudentDocuments = [];
            var filteredStudentDocuments = [];
            var currentPage = 1;
            var pageSize = 10;

            $(document).ready(function () {

                GetStudentDocument();

                $("#txtSearch").on("keyup", function () {

                    var search = $(this).val().toLowerCase().trim();

                    filteredStudentDocuments = StudentDocuments.filter(function (x) {

                        return x.StudentDocumentTitle.toLowerCase().includes(search);

                    });

                    currentPage = 1;

                    BindGrid();

                });

            });

            function GetStudentDocument() {

                $.ajax({

                    url: "/BCTECHAdmin/GetStudentDocumentList",

                    type: "GET",

                    dataType: "json",

                    success: function (data) {

                        StudentDocuments = data;
                        filteredStudentDocuments = data;

                        currentPage = 1;

                        BindGrid();

                    }

                });

            }

            function BindGrid() {

                var html = "";

                var start = (currentPage - 1) * pageSize;
                var end = Math.min(start + pageSize, filteredStudentDocuments.length);

                for (var i = start; i < end; i++) {

                    var item = filteredStudentDocuments[i];

                    html += `
                        <tr>

                             <td>${i + 1}</td>
                            <td hidden>${item.StudentDocumentID}</td>

                            <td>${item.StudentDocumentTitle}</td>

                            <td>${item.DateAndTime}</td>

                            <td>

                                <a href="javascript:void(0)"
                                   onclick="EditStudentDocument(${item.StudentDocumentID})">

                                    <i class="ri-edit-line text-primary"></i>

                                </a>

                                &nbsp;&nbsp;

                                <a href="javascript:void(0)"
                                   onclick="DeleteStudentDocument(${item.StudentDocumentID})">

                                    <i class="ri-delete-bin-line text-danger"></i>

                                </a>

                            </td>

                        </tr>`;
                }

                $("#tblStudentDocument tbody").html(html);

                $("#lblShowing").text(

                    `Showing ${filteredStudentDocuments.length == 0 ? 0 : start + 1}
                         to ${end}
                         of ${filteredStudentDocuments.length} entries`

                );

                CreatePagination();

            }

            function CreatePagination() {

                var totalPages = Math.ceil(filteredStudentDocuments.length / pageSize);

                var html = "";

                html += `
                    <li class="page-item ${currentPage == 1 ? 'disabled' : ''}">
                        <a class="page-link"
                           href="javascript:void(0)"
                           ${currentPage == 1 ? '' : `onclick="ChangePage(${currentPage - 1})"`}>
                            <i class="material-symbols-outlined">west</i>
                        </a>
                    </li>`;

                for (var i = 1; i <= totalPages; i++) {

                    html += `
                        <li class="page-item">

                            <a class="page-link ${currentPage == i ? 'active' : ''}"
                               href="javascript:void(0)"
                               onclick="ChangePage(${i})">

                                ${i}

                            </a>

                        </li>`;

                }

                html += `
                    <li class="page-item ${currentPage == totalPages ? 'disabled' : ''}">
                        <a class="page-link"
                           href="javascript:void(0)"
                           ${currentPage == totalPages ? '' : `onclick="ChangePage(${currentPage + 1})"`}>
                            <i class="material-symbols-outlined">east</i>
                        </a>
                    </li>`;

                $("#pagination").html(html);

            }

            function ChangePage(page) {

                var totalPages = Math.ceil(filteredStudentDocuments.length / pageSize);

                if (page < 1 || page > totalPages)
                    return;

                currentPage = page;

                BindGrid();

            }

            function OpenStudentDocumentModal() {

                $("#hfStudentDocumentID").val(0);

                $("#txtStudentDocumentTitle").val("");

                $("#StudentDocumentModal").modal("show");

            }

            function SaveStudentDocument() {

                if ($("#txtStudentDocumentTitle").val().trim() == "") {

                    toastr.warning("Please Enter Student Document.");

                    $("#txtStudentDocumentTitle").focus();

                    return;

                }

                $.ajax({

                    url: "/BCTECHAdmin/SaveStudentDocument",

                    type: "POST",

                    data: {

                        StudentDocumentID: $("#hfStudentDocumentID").val(),

                        StudentDocumentTitle: $("#txtStudentDocumentTitle").val()

                    },

                    success: function (res) {

                        if (res.Status) {
                            toastr.success(res.Message);
                            $("#StudentDocumentModal").modal("hide");
                            GetStudentDocument();
                        }
                        else {
                            toastr.warning(res.Message);
                        }
                    }

                });

            }

            function EditStudentDocument(id) {

                $.ajax({

                    url: "/BCTECHAdmin/GetStudentDocumentByID",

                    type: "GET",

                    data: { id: id },

                    success: function (item) {

                        $("#hfStudentDocumentID").val(item.StudentDocumentID);

                        $("#txtStudentDocumentTitle").val(item.StudentDocumentTitle);

                        $("#StudentDocumentModal").modal("show");

                    }

                });

            }

            function DeleteStudentDocument(id) {

                Swal.fire({

                    title: "Are you sure?",

                    text: "You won't be able to recover this record!",

                    icon: "warning",

                    showCancelButton: true,

                    confirmButtonText: "Yes, Delete",

                    cancelButtonText: "Cancel"

                }).then((result) => {

                    if (result.isConfirmed) {

                        $.ajax({

                            url: "/BCTECHAdmin/DeleteStudentDocument",

                            type: "POST",

                            data: { id: id },

                            success: function (response) {

                                if (response == "Success") {

                                    Swal.fire({

                                        icon: "success",

                                        title: "Deleted",

                                        text: "Student Document Deleted Successfully",

                                        timer: 1500,

                                        showConfirmButton: false

                                    });

                                    GetStudentDocument();

                                }

                            }

                        });

                    }

                });

            }

        </script>
    }

</div>
