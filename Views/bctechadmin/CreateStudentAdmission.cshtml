        // Load Edit / View Data By ID
        function LoadAdmissionDataByID(encryptedId) {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentByID",
                data: { id: encryptedId },
                dataType: "json",
                success: function (res) {
                    var d = (res && res.Data) ? res.Data : (res && res.IsSuccess ? res : null);
                    if (d && d.StudentID > 0) {
                        $("#hfStudentID").val(d.StudentID);
                        $("#txtEnrollmentNo").val(d.StudentStringEnrollmentNo || d.StudentEnrollmentNo || "");
                        if (d.AdmissionDateTime) $("#txtAdmissionDate").val(d.AdmissionDateTime.split('T')[0]);

                        $("#ddlBranch").val(d.BranchID).trigger("change.select2");
                        LoadBatchDropdown(d.BranchID, d.BatchID);

                        $("#txtStudentName").val(d.StudentFullName || d.StudentName);
                        $("#txtMobileNo").val(d.StudentMobileNo);
                        $("#txtWhatsappNo").val(d.WhatsAppNo);
                        $("#txtEmail").val(d.StudentEmail);
                        $("#txtStudentAadhar").val(d.StudentAadhar || "");
                        if (d.StudentPhoto) {
                            $("#hfStudentPhoto").val(d.StudentPhoto);
                            $("#imgStudentImage").attr("src", d.StudentPhoto).show();
                            $("#browseImageArea").hide();
                        }
                        if (d.DOB) $("#txtDOB").val(d.DOB.split('T')[0]);

                        $("#ddlGender").val(d.Gender || "").trigger("change.select2");
                        $("#ddlBloodGroup").val(d.BloodGroup || "").trigger("change.select2");
                        $("#txtQualification").val(d.EducationQualification);
                        $("#txtSchoolCollege").val(d.SchoolCollegeName);

                        $("#txtFatherName").val(d.FatherName);
                        $("#txtFatherMobile").val(d.FatherMobileNo);
                        $("#txtFatherAlternateMobile").val(d.FatherAlternateMobileNo);
                        $("#txtFatherOccupation").val(d.FatherOccupation);
                        $("#txtFatherEmail").val(d.FatherEmail);

                        $("#txtMotherName").val(d.MotherName);
                        $("#txtMotherMobile").val(d.MotherMobileNo);
                        $("#txtMotherOccupation").val(d.MotherOccupation);
                        $("#txtMotherEmail").val(d.MotherEmail);

                        $("#txtAddress").val(d.Address);
                        $("#txtCity").val(d.City || "");
                        $("#txtState").val(d.State || "");
                        $("#txtPincode").val(d.Pincode || "");

                        if (d.AreaLocation) {
                            var bindArea = function () {
                                var found = false;
                                $("#ddlArea option").each(function () {
                                    if ($(this).text().trim().toLowerCase() === String(d.AreaLocation).trim().toLowerCase()) {
                                        $("#ddlArea").val($(this).val()).trigger("change.select2");
                                        found = true;
                                        return false;
                                    }
                                });
                                if (!found && $("#ddlArea option").length <= 1) {
                                    setTimeout(bindArea, 100);
                                }
                            };
                            bindArea();
                        }

                        // Populate Course List Grid
                        $("#tblCourse > tbody").empty();
                        if (d.CourseList && d.CourseList.length > 0)
                        {
                            $.each(d.CourseList, function (i, item) {
                                AddCourseRow(item);
                            });
                        } else {
                            AddCourseRow();
                        }

                        // Populate Installment List Grid
                        $("#tblInstallment tbody").empty();
                        if (d.InstallmentList && d.InstallmentList.length > 0) {
                            var firstTitle = (d.InstallmentList[0].FeesTitle || "").toLowerCase();
                            var hasAdmission = firstTitle.includes("admission") || firstTitle.includes("registration");
                            var courseCount = (d.InstallmentList.length > 1 && hasAdmission) ? (d.InstallmentList.length - 1) : d.InstallmentList.length;
                            $("#txtNoOfInstallments").val(courseCount);
                            $.each(d.InstallmentList, function (i, item) {
                                if (i === 0) {
                                    item.PaymentTypeID = d.PaymentTypeID;
                                    item.TransactionNo = d.TransactionNo;
                                }
                                AddInstallmentRow(item);
                            });
                            if (d.InstallmentList.length > 1) {
                                var instAmt = d.InstallmentList[1].Amount || d.InstallmentList[1].FeesAmount || 0;
                                $("#txtAmountOfInstallment").val(parseFloat(instAmt).toFixed(2));
                            } else if (d.InstallmentList.length === 1) {
                                var instAmt = d.InstallmentList[0].Amount || d.InstallmentList[0].FeesAmount || 0;
                                $("#txtAmountOfInstallment").val(parseFloat(instAmt).toFixed(2));
                            }
                        } else {
                            GenerateInstallmentRows();
                        }

                        // Populate Student Documents Grid
                        $("#tblStudentDocument tbody").empty();
                        DocumentRow = 0;
                        if (d.DocumentList && d.DocumentList.length > 0) {
                            $.each(d.DocumentList, function (i, item) {
                                AddDocumentRow(item);
                            });
                        } else {
                            AddDocumentRow();
                        }

                        // Apply View Mode Controls if mode=V
                        if ($("#hfMode").val() === "V") {
                            ApplyViewMode();
                        }
                    } else {
                        LoadEnquiryIntoAdmission(encryptedId);
                    }
                },
                error: function () {
                    LoadEnquiryIntoAdmission(encryptedId);
                }
            });
        }

        function LoadEnquiryIntoAdmission(encryptedId) {
            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetStudentEnquiryByID",
                data: { id: encryptedId },
                dataType: "json",
                success: function (res) {
                    var d = (res && res.Data) ? res.Data : (res && res.IsSuccess ? res : null);
                    if (d && (d.StudentEnquiryID > 0 || d.StudentName)) {
                        var enquiryId = d.StudentEnquiryID || 0;

                        var selectEnquiryOption = function () {
                            if (enquiryId > 0) {
                                if ($("#ddlStudentEnquiry option[value='" + enquiryId + "']").length === 0) {
                                    var enqNo = d.EnquiryNo || '';
                                    var name = d.StudentName || '';
                                    var mobile = d.StudentMobileNo || '';
                                    var opt = new Option(name + (enqNo ? ' [' + enqNo + ']' : ''), enquiryId, true, true);
                                    $(opt).attr('data-enquiry-no', enqNo).attr('data-mobile', mobile);
                                    $("#ddlStudentEnquiry").append(opt);
                                }
                                $("#ddlStudentEnquiry").val(enquiryId).trigger("change");
                            }
                        };

                        if ($("#ddlStudentEnquiry option").length > 1) {
                            selectEnquiryOption();
                        } else {
                            setTimeout(selectEnquiryOption, 300);
                        }
                    }
                }
            });
        }

        // Apply View Mode Disabled State
        function ApplyViewMode() {
            $("#frmStudentAdmission").find("input, select, textarea, button").prop("disabled", true);
            $(".select2").prop("disabled", true).trigger("change.select2");
            $("#btnAddCourse, #btnGenerateInstallments, #btnAddInstallment, #btnAddDocument, #btnSave").hide();
            $(".action-col").hide();
        }

        // Master Dropdowns Loader
        function LoadDropdowns(callback) {
            $.when(
                $.ajax({ type: "POST", url: "/bctechadmin/GetBranchDropdown", contentType: "application/json; charset=utf-8", dataType: "json", data: "{}" }),
                $.ajax({ type: "POST", url: "/bctechadmin/GetIsStudentCourseDropdown", contentType: "application/json; charset=utf-8", dataType: "json", data: "{}" }),
                //$.ajax({ type: "POST", url: "/bctechadmin/GetCourseDropdown", contentType: "application/json; charset=utf-8", dataType: "json", data: "{}" }),
                $.ajax({ type: "POST", url: "/bctechadmin/GetLocationDropdown", contentType: "application/json; charset=utf-8", dataType: "json", data: "{}" }),
                $.ajax({ type: "POST", url: "/bctechadmin/GetFeesTypeDropdown", contentType: "application/json; charset=utf-8", dataType: "json", data: "{}" }),
                $.ajax({ type: "POST", url: "/bctechadmin/GetStudentDocumentDropdown", contentType: "application/json; charset=utf-8", dataType: "json", data: "{}" })
            ).done(function (branchesRes, coursesRes, locationRes, feesTypeRes, docsRes) {

                RenderSelectOptions("ddlBranch", ParseResponseData(branchesRes), "BranchID", "BranchName", "Select Branch");
                globalCourseList = ParseResponseData(coursesRes);
                globalLocationList = ParseResponseData(locationRes);
                globalFeesTypeList = ParseResponseData(feesTypeRes);
                globalStudentDocumentList = ParseResponseData(docsRes);
                RenderSelectOptions("ddlArea", globalLocationList, "LocationID", "AreaLocation", "Select Area");

                LoadAutoCompleteData();

                if (typeof callback === "function") {
                    callback();
                }
            });
        }

        function LoadAutoCompleteData() {
            $.ajax({
                type: "POST",
                url: "/bctechadmin/GetQualificationAndSchoolAutoComplete",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: "{}",
                success: function (res) {
                    if (res) {
                        if (res.Qualifications && res.Qualifications.length > 0) {
                            var qHtml = "";
                            $.each(res.Qualifications, function (i, item) {
                                qHtml += "<option value='" + item + "'>";
                            });
                            $("#dlQualification").html(qHtml);
                        }
                        if (res.Schools && res.Schools.length > 0) {
                            var sHtml = "";
                            $.each(res.Schools, function (i, item) {
                                sHtml += "<option value='" + item + "'>";
                            });
                            $("#dlSchoolCollege").html(sHtml);
                        }
                    }
                }
            });
        }

        // Load Batch Dropdown by Branch
        function LoadBatchDropdown(branchID, selectedBatchID) {
            if (!branchID) {
                $("#ddlBatch").html("<option value=''>Select Batch</option>").trigger("change");
                return;
            }

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetBranchBatchList",
                data: { SearchText: "", PageNumber: 1, PageSize: 100 },
                dataType: "json",
                success: function (res) {
                    var batchList = res.Data || res;
                    RenderSelectOptions("ddlBatch", batchList, "BatchID", "BatchTitle", "Select Batch");
                    if (selectedBatchID) {
                        $("#ddlBatch").val(selectedBatchID).trigger("change.select2");
                    }
                }
            });
        }

        // Helper: Render Options
        function RenderSelectOptions(elementId, dataList, valueKey, textKey, defaultText) {
            var html = "<option value=''>" + defaultText + "</option>";
            $.each(dataList, function (i, item) {
                var val = String(item[valueKey] || item.ID || "");
                var txt = item[textKey] || item.Name;
                html += "<option value='" + val + "'>" + txt + "</option>";
            });

            var $el = $("#" + elementId);
            $el.html(html);

            if ($el.hasClass("select2-hidden-accessible")) {
                $el.select2('destroy').select2({ width: '100%', placeholder: defaultText, allowClear: true });
            }
        }

        // Helper: Parse AJAX Response
        function ParseResponseData(res) {
            if (!res) return [];
            var data = Array.isArray(res) && res.length > 1 && res[1] === "success" ? res[0] : res;
            if (typeof data === "string") {
                try { data = JSON.parse(data); } catch (e) { data = []; }
            }
            return Array.isArray(data) ? data : [];
        }

        function ResetSaveAdmissionButton() {
            $("#btnSave").prop("disabled", false).html('<i class="ri-save-line"></i> Save Admission');
        }

        // Save Student Admission
        function SaveStudentAdmission() {
            if ($("#btnSave").prop("disabled")) {
                return;
            }

            if ($("#txtAdmissionDate").val() === "") {
                toastr.warning("Please select Admission Date.");
                $("#txtAdmissionDate").focus();
                ResetSaveAdmissionButton();
                return;
            }
            if ($("#ddlBranch").val() === "") {
                toastr.warning("Please select Branch.");
                ResetSaveAdmissionButton();
                return;
            }
            if ($("#ddlBatch").val() === "") {
                toastr.warning("Please select Batch.");
                ResetSaveAdmissionButton();
                return;
            }
            if ($("#txtStudentName").val().trim() === "") {
                toastr.warning("Please enter Student Name.");
                $("#txtStudentName").focus();
                ResetSaveAdmissionButton();
                return;
            }
            if ($("#txtMobileNo").val().trim() === "" || $("#txtMobileNo").val().length !== 10) {
                toastr.warning("Please enter valid 10 digit Mobile Number.");
                $("#txtMobileNo").focus();
                ResetSaveAdmissionButton();
                return;
            }

            if ($("#txtStudentAadhar").val().trim() !== "" && $("#txtStudentAadhar").val().trim().length !== 12) {
                toastr.warning("Please enter valid 12 digit Aadhar Number.");
                $("#txtStudentAadhar").focus();
                ResetSaveAdmissionButton();
                return;
            }

            var courseList = [];
            var courseValid = true;

            $("#tblCourse > tbody > tr.main-course-row").each(function () {
                var courseID = parseInt($(this).find(".selectCourse").val()) || 0;
                var fee = parseFloat($(this).find(".fee").val()) || 0;
                var discount = parseFloat($(this).find(".discount").val()) || 0;
                var finalFee = parseFloat($(this).find(".finalfee").val()) || 0;
                var remark = $(this).find(".remark").val();

                if (courseID === 0) {
                    courseValid = false;
                    return false;
                }

                courseList.push({
                    StudentID: parseInt($("#hfStudentID").val()) || 0,
                    CourseID: courseID,
                    CourseFee: fee,
                    Discount: discount,
                    FinalFee: finalFee,
                    Remarks: remark
                });
            });

            if (!courseValid || courseList.length === 0) {
                toastr.warning("Please select a valid Course for all rows in Course Grid.");
                ResetSaveAdmissionButton();
                return;
            }

            var installmentList = [];
            var totalInstFee = 0;
            $("#tblInstallment tbody tr").each(function () {
                var dueDate = $(this).find(".inst-duedate").val();
                var feesTypeID = parseInt($(this).find(".inst-feestype").val()) || null;
                var title = $(this).find(".inst-feestype option:selected").text().trim();
                var amount = parseFloat($(this).find(".inst-amount").val()) || 0;
                totalInstFee += amount;
                if (dueDate) {
                    installmentList.push({
                        StudentID: parseInt($("#hfStudentID").val()) || 0,
                        DueDate: dueDate,
                        FeesDate: dueDate,
                        FeesTypeID: feesTypeID,
                        FeesTitle: title,
                        Amount: amount,
                        FeesAmount: amount
                    });
                }
            });

            var totalCourseFee = GetTotalCourseFinalFee();
            var firstRowSelectText = $("#tblInstallment tbody tr:first .inst-feestype option:selected").text().toLowerCase();
            var firstRowAmt = parseFloat($("#tblInstallment tbody tr:first .inst-amount").val()) || 0;
            var hasAdmissionFee = firstRowSelectText.includes("admission") || firstRowSelectText.includes("registration");
            var expectedTotalFee = hasAdmissionFee ? (totalCourseFee + firstRowAmt) : totalCourseFee;

            if (Math.abs(expectedTotalFee - totalInstFee) > 0.01) {
                toastr.error("Total Installment Amount (" + totalInstFee.toFixed(2) + ") must equal Total Course Final Fee (" + totalCourseFee.toFixed(2) + ").");
                ResetSaveAdmissionButton();
                return;
            }

            var selectedAreaText = $("#ddlArea option:selected").val() ? $("#ddlArea option:selected").text() : "";

            // Payment Mode & Transaction No validation
            var selectedPayMode = $("input[name='rdoAdmissionPaymentType']:checked").val() || "Cash";
            var paymentTypeId = selectedPayMode === "UPI" ? 4 : 1;
            var transactionNo = "";

            if (selectedPayMode === "UPI") {
                transactionNo = $("#txtAdmissionTransactionNo").val() ? $("#txtAdmissionTransactionNo").val().trim() : "";
                if (transactionNo === "") {
                    toastr.warning("Please enter Transaction No for UPI payment.");
                    $("#txtAdmissionTransactionNo").focus();
                    ResetSaveAdmissionButton();
                    return;
                }
            }

            var documentList = [];
            $("#tblStudentDocument tbody tr").each(function () {
                var docID = parseInt($(this).find(".selectDocument").val()) || 0;
                var docPath = $(this).find(".doc-file-path").val() || "";
                var docName = $(this).find(".doc-file-name").val() || "";
                if (docID > 0) {
                    documentList.push({
                        StudentID: parseInt($("#hfStudentID").val()) || 0,
                        StudentDocumentID: docID,
                        DocumentPath: docPath,
                        DocumentName: docName
                    });
                }
            });

            var admissionModel = {
                StudentID: parseInt($("#hfStudentID").val()) || 0,
                StudentEnquiryID: $("#ddlStudentEnquiry").val() ? parseInt($("#ddlStudentEnquiry").val()) : null,
                BranchID: parseInt($("#ddlBranch").val()) || 0,
                BatchID: parseInt($("#ddlBatch").val()) || 0,
                AdmissionDate: $("#txtAdmissionDate").val(),
                StudentStringEnrollmentNo: $("#txtEnrollmentNo").val().trim(),
                NoOfInstallments: parseInt($("#txtNoOfInstallments").val()) || 3,
                StudentFullName: $("#txtStudentName").val().trim(),
                StudentMobileNo: $("#txtMobileNo").val().trim(),
                WhatsAppNo: $("#txtWhatsappNo").val().trim(),
                StudentEmail: $("#txtEmail").val().trim(),
                StudentPhoto: $("#hfStudentPhoto").val() || $("#imgStudentImage").attr("src") || "",
                StudentAadhar: $("#txtStudentAadhar").val().trim(),
                DOB: $("#txtDOB").val() || null,
                Gender: $("#ddlGender").val(),
                BloodGroup: $("#ddlBloodGroup").val(),
                EducationQualification: $("#txtQualification").val().trim(),
                SchoolCollegeName: $("#txtSchoolCollege").val().trim(),
                FatherName: $("#txtFatherName").val().trim(),
                FatherMobileNo: $("#txtFatherMobile").val().trim(),
                FatherAlternateMobileNo: $("#txtFatherAlternateMobile").val().trim(),
                FatherOccupation: $("#txtFatherOccupation").val().trim(),
                FatherEmail: $("#txtFatherEmail").val().trim(),
                MotherName: $("#txtMotherName").val().trim(),
                MotherMobileNo: $("#txtMotherMobile").val().trim(),
                MotherOccupation: $("#txtMotherOccupation").val().trim(),
                MotherEmail: $("#txtMotherEmail").val().trim(),
                Address: $("#txtAddress").val().trim(),
                AreaLocation: selectedAreaText,
                City: $("#txtCity").val().trim(),
                State: $("#txtState").val().trim(),
                Pincode: $("#txtPincode").val().trim(),
                PaymentTypeID: paymentTypeId,
                TransactionNo: transactionNo,
                CourseList: courseList,
                InstallmentList: installmentList,
                DocumentList: documentList
            };

            var actionUrl = admissionModel.StudentID > 0 ? "/bctechadmin/UpdateStudent" : "/bctechadmin/SaveStudent";

            // Turant Button Disable karna and "Save Admission" Button me Loader rakhna
            $("#btnSave").prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Save Admission');

            $.ajax({
                type: "POST",
                url: actionUrl,
                data: JSON.stringify(admissionModel),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    // Success ya Error aane par Button ko Disable to Enabled karna
                    ResetSaveAdmissionButton();

                    if (response.IsSuccess || response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved Successfully',
                            text: response.Message || "Student Admission saved successfully."
                           

                            

                        }).then(function () {


                            if (response.ReceiptId != "0")
                            {
                                window.open("/bctechadmin/StudentFeeReceiptPrint?id=" + response.ReceiptId, "_blank");
                            }
                            
                            window.location.href = "/bctechadmin/StudentList";
                        });
                    } else {
                        Swal.fire('Error', response.Message || "Failed to save record.", 'error');
                    }
                },
                error: function (xhr, status, error) {
                    // Error aane par Button ko Disable to Enabled karna
                    ResetSaveAdmissionButton();
                    Swal.fire('Error', "An error occurred while saving: " + (error || "Unknown error"), 'error');
                }
            });
        }
        function previewStudentImage(input) {
            if (input.files && input.files[0]) {
                var file = input.files[0];
                var reader = new FileReader();
                reader.onload = function (e) {
                    $("#imgStudentImage").attr("src", e.target.result).show();
                    $("#browseImageArea").hide();
                };
                reader.readAsDataURL(file);

                var formData = new FormData();
                formData.append("file", file);
                $.ajax({
                    type: "POST",
                    url: "/bctechadmin/UploadStudentPhoto",
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (res) {
                        if (res && res.IsSuccess) {
                            $("#hfStudentPhoto").val(res.FilePath);
                            toastr.success("Photo uploaded successfully.");
                        } else {
                            toastr.error(res.Message || "Photo upload failed.");
                        }
                    },
                    error: function () {
                        toastr.error("Error uploading photo.");
                    }
                });
            }
        }

        function clearStudentImage() {
            $("#fileStudentPhoto").val("");
            $("#imgStudentImage").attr("src", "").hide();
            $("#browseImageArea").show();
            $("#hfStudentPhoto").val("");
        }


        function validateFloatKeyPress(el, evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode;
            var number = el.value.split('.');
            if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
                return false;
            }
            //just one dot (thanks ddlab)
            if (number.length > 1 && charCode == 46) {
                return false;
            }
            //get the carat position
            var caratPos = getSelectionStart(el);
            var dotPos = el.value.indexOf(".");
            if (caratPos > dotPos && dotPos > -1 && (number[1].length > 6)) {
                return false;
            }
            return true;
        }

        function getSelectionStart(o) {
            if (o.createTextRange) {
                var r = document.selection.createRange().duplicate()
                r.moveEnd('character', o.value.length)
                if (r.text == '') return o.value.length
                return o.value.lastIndexOf(r.text)
            } else return o.selectionStart
        }


    </script>
}