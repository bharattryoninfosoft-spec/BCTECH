        function RenderDocumentPreview(rowId, filePath, fileName) {
            var $preview = $("#previewDoc_" + rowId);
            if (!filePath) {
                $preview.empty();
                return;
            }
            var ext = filePath.split('.').pop().toLowerCase();
            var isViewMode = $("#hfMode").val() === "V";
            var displayName = fileName || filePath.split('/').pop();

            var html = '<div class="d-flex align-items-center gap-2 mt-1 p-1 px-2 border rounded bg-light">';
            if (ext === "pdf") {
                html += '<i class="ri-file-pdf-fill text-danger fs-20"></i>';
            } else {
                html += '<img src="' + filePath + '" class="rounded border" style="width: 32px; height: 32px; object-fit: cover;" />';
            }
            html += '<a href="' + filePath + '" target="_blank" class="text-truncate text-primary fw-medium fs-12 text-decoration-underline" style="max-width: 250px;" title="' + displayName + '">' + displayName + '</a>';
            if (!isViewMode) {
                html += '<a href="javascript:void(0);" class="text-danger ms-auto fs-16" onclick="ClearUploadedDoc(' + rowId + ')" title="Remove File"><i class="ri-close-circle-line"></i></a>';
            }
            html += '</div>';
            $preview.html(html);
        }

