@{
    ViewBag.Title = ViewBag.PageTitle ?? "Create Student Admission";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<input type="hidden" id="hfStudentID" value="@ViewBag.StudentID" />
<input type="hidden" id="hfMode" value="@ViewBag.Mode" />
<input type="hidden" id="hfLoggedInUserID" value="@ViewBag.LoggedInUserID" />

<style>
    .image-upload-box {
        width: 100%;
        height: 150px;
        border: 1px solid #d5dbe5;
        border-radius: 5px;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

    /* Browse area */
    #browseImageArea {
        text-align: center;
    }

    /* Image Icon */
    .image-upload-icon {
        width: 30px;
        height: 30px;
        background-color: #e8f1ff;
        color: #0d6efd;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px auto;
    }

        .image-upload-icon i {
            font-size: 14px;
        }

    /* Browse Images Link */
    .browse-image-link {
        color: #0066ff;
        text-decoration: underline;
        font-size: 14px;
        cursor: pointer;
    }

        .browse-image-link:hover {
            color: #004dcc;
        }

    /* Preview Image */
    #imgStudentImage {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 5px;
    }

    /* Master Course Sub-Courses Table Styling */
    [id^="divMasterCourse_"] {
        border-left: 3px solid #ffc107 !important;
    }

    [id^="tblMasterCourse_"] tbody tr {
        transition: background-color 0.2s ease;
    }

        [id^="tblMasterCourse_"] tbody tr.table-selected,
        [id^="tblMasterCourse_"] tbody tr.table-selected > td {
            background-color: #e8f4ff !important;
        }
</style>

<form id="frmStudentAdmission" autocomplete="off">

    <!-- ================= Admission & Enquiry Details ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom">
            <h5 class="mb-0 text-dark font-weight-bold">Admission Details</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Select Enquiry (Optional)</label>
                    <select id="ddlStudentEnquiry" class="form-select select2">
                        <option value="">-- Direct Admission --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Enrollment No <span class="text-danger">*</span></label>
                    <input type="text" id="txtEnrollmentNo" class="form-control" readonly placeholder="Auto Generated" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Admission Date <span class="text-danger">*</span></label>
                    <input type="date" id="txtAdmissionDate" class="form-control" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Branch <span class="text-danger">*</span></label>
                    <select id="ddlBranch" class="form-select select2">
                        <option value="">Select Branch</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Batch <span class="text-danger">*</span></label>
                    <select id="ddlBatch" class="form-select select2">
                        <option value="">Select Batch</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Student Information ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom">
            <h5 class="mb-0 text-dark font-weight-bold">Student Information</h5>
        </div>
        <div class="card-body">

            <div class="row">
                <!-- Student Image - Left Side -->
                <div class="col-md-2 mb-3">
                    <label class="form-label">Student Image</label>

                    <div class="image-upload-box" id="imageUploadBox">

                        <!-- Default Browse Area -->
                        <div id="browseImageArea">
                            <div class="image-upload-icon">
                                <i class="fa fa-image"></i>
                            </div>

                            <a href="javascript:void(0);"
                               class="browse-image-link"
                               onclick="$('#fileStudentPhoto').click();">
                                Browse Images
                            </a>
                        </div>

                        <!-- Image Preview -->
                        <img id="imgStudentImage"
                             src=""
                             alt="Student Image"
                             style="display:none;">

                    </div>

                    <input type="file"
                           id="fileStudentPhoto"
                           accept="image/*"
                           style="display:none;"
                           onchange="previewStudentImage(this);">
                    <input type="hidden" id="hfStudentPhoto" />

                    <div class="mt-2 d-flex gap-2">

                        <button type="button"
                                class="btn btn-primary btn-sm flex-fill"
                                onclick="$('#fileStudentPhoto').click();"
                                title="Upload Image" style=" padding: 10px 35px;">
                            <i class="fa fa-upload"></i>
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm flex-fill"
                                onclick="clearStudentImage();"
                                title="Clear Image" style=" padding: 10px 35px;">
                            <i class="fa fa-times"></i>
                        </button>

                    </div>



                </div>


                <div class="col-md-10 mb-3">


                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Student Name <span class="text-danger">*</span></label>
                            <input type="text" id="txtStudentName" maxlength="150" class="form-control" placeholder="Student Full Name" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Mobile No <span class="text-danger">*</span></label>
                            <input type="tel" id="txtMobileNo" maxlength="10" class="form-control" placeholder="10 Digit Mobile Number" onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">WhatsApp No</label>
                            <input type="text" id="txtWhatsappNo" maxlength="10" class="form-control" placeholder="WhatsApp Number" onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Aadhar Card No</label>
                            <input type="tel" id="txtStudentAadhar" class="form-control" placeholder="0000 0000 0000" maxlength="12" onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">DOB</label>
                            <input type="date" id="txtDOB" class="form-control" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Gender</label>
                            <select id="ddlGender" class="form-select select2">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Blood Group</label>
                            <select id="ddlBloodGroup" class="form-select select2">
                                <option value="">Select Blood Group</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" id="txtEmail" class="form-control" placeholder="Email Address" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Qualification</label>
                            <input type="text" id="txtQualification" list="dlQualification" class="form-control" placeholder="Qualification" autocomplete="off" />
                            <datalist id="dlQualification"></datalist>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">School / College Name</label>
                            <input type="text" id="txtSchoolCollege" list="dlSchoolCollege" class="form-control" placeholder="School / College Name" autocomplete="off" />
                            <datalist id="dlSchoolCollege"></datalist>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>

    <!-- ================= Parent Information ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom">
            <h5 class="mb-0 text-dark font-weight-bold">Parent Information</h5>
        </div>
        <div class="card-body">
            <h6 class="text-primary mb-3">Father Details</h6>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Father Name</label>
                    <input type="text" id="txtFatherName" class="form-control" maxlength="150" placeholder="Father Name" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Father Mobile</label>
                    <input type="text" id="txtFatherMobile" class="form-control" maxlength="10" placeholder="Father Mobile" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Alternate Mobile</label>
                    <input type="text" id="txtFatherAlternateMobile" class="form-control" maxlength="10" placeholder="Alternate Mobile" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Occupation</label>
                    <input type="text" id="txtFatherOccupation" class="form-control" maxlength="100" placeholder="Father Occupation" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Father Email</label>
                    <input type="email" id="txtFatherEmail" class="form-control" placeholder="Father Email" />
                </div>
            </div>

            <hr />

            <h6 class="text-primary mb-3">Mother Details</h6>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Mother Name</label>
                    <input type="text" id="txtMotherName" class="form-control" maxlength="150" placeholder="Mother Name" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Mother Mobile</label>
                    <input type="text" id="txtMotherMobile" class="form-control" maxlength="10" placeholder="Mother Mobile" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Occupation</label>
                    <input type="text" id="txtMotherOccupation" class="form-control" maxlength="100" placeholder="Mother Occupation" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Mother Email</label>
                    <input type="email" id="txtMotherEmail" class="form-control" placeholder="Mother Email" />
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Address Information ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom">
            <h5 class="mb-0 text-dark font-weight-bold">Address Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="form-label">Address</label>
                    <textarea id="txtAddress" rows="2" class="form-control" placeholder="Residential Address"></textarea>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Area / Location</label>
                    <select id="ddlArea" class="form-select select2">
                        <option value="">Select Area</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">City</label>
                    <input type="text" id="txtCity" class="form-control" placeholder="City" readonly>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">State</label>
                    <input type="text" id="txtState" class="form-control" placeholder="State" readonly>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Pincode</label>
                    <input type="text" id="txtPincode" maxlength="6" class="form-control" placeholder="Pincode" readonly>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= Course Details ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 text-dark font-weight-bold">Course Details</h5>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="btnAddCourse" class="btn btn-primary btn-sm">
                    <i class="ri-add-line"></i> Add Course
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="tblCourse">
                    <thead class="table-light">
                        <tr>
                            <th width="50" class="text-center">#</th>
                            <th width="25%">Course <span class="text-danger">*</span></th>
                            <th width="15%">Course Fee</th>
                            <th width="12%">Discount (%)</th>
                            <th width="15%">Discount (Rs.)</th>
                            <th width="15%">Final Fee</th>
                            <th>Remarks</th>
                            <th width="70" class="text-center action-col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="5" class="text-end font-weight-bold">Total Final Fee:</th>
                            <th class="text-end font-weight-bold text-primary fs-15" id="lblTotalFinalFee">0.00</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= Installment Details ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">

            <h5 class="mb-0 text-dark font-weight-bold">Installment Details</h5>
            <div class="d-flex align-items-center gap-2">
                <label class="mb-0 text-dark font-weight-bold fs-13 me-1">Amount of Installments:</label>
                <input type="tel" id="txtAmountOfInstallment" class="form-control form-control-sm text-end fw-bold" placeholder="0.00" style="width: 100px;" onkeypress="return validateFloatKeyPress(this,event);" />
                <label class="mb-0 text-dark font-weight-bold fs-13 me-1 ms-2">No. of Installments:</label>
                <input type="tel" id="txtNoOfInstallments" class="form-control form-control-sm text-center fw-bold" value="" min="1" max="24" style="width: 75px;" onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                <button type="button" id="btnAddInstallment" class="btn btn-primary btn-sm">
                    <i class="ri-add-line"></i> Add Installment Row
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="tblInstallment">
                    <thead class="table-light">
                        <tr>
                            <th width="50" class="text-center">#</th>
                            <th width="25%">DUE DATE <span class="text-danger">*</span></th>
                            <th width="40%">FEES TITLE / COURSE <span class="text-muted fs-11">(Optional)</span></th>
                            <th width="25%">AMOUNT <span class="text-danger">*</span></th>
                            <th width="70" class="text-center action-col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end font-weight-bold">Total Installment Amount:</th>
                            <th class="text-end font-weight-bold text-success fs-15" id="lblTotalInstallmentAmount">0.00</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>





    <!-- ================= Student Documents ================= -->
    <div class="card bg-white rounded-10 border border-white mb-4">
        <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark font-weight-bold">Student Documents</h5>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="btnAddDocument" class="btn btn-primary btn-sm">
                    <i class="ri-add-line"></i> Add Document
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0" id="tblStudentDocument">
                    <thead class="table-light">
                        <tr>
                            <th width="50" class="text-center">#</th>
                            <th width="38%">DOCUMENT TITLE <span class="text-danger">*</span></th>
                            <th width="52%">UPLOAD FILE (PDF, JPG, PNG)</th>
                            <th width="60" class="text-center action-col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


</form>

<!-- ================= Footer Buttons ================= -->
<div class="card bg-white rounded-10 border border-white mb-4">
    <div class="card-body text-end">
        <a href="@Url.Action("StudentList", "bctechadmin")" class="btn btn-secondary me-2">
            <i class="ri-arrow-left-line"></i> Back
        </a>
        <button type="button" id="btnSave" class="btn btn-primary">
            <i class="ri-save-line"></i> Save Admission
        </button>
    </div>
</div>
@section Scripts{
    <script>



        function previewStudentImage(input) {

            if (input.files && input.files[0]) {

                var file = input.files[0];

                // Check image
                if (!file.type.startsWith("image/")) {
                    alert("Please select a valid image.");
                    input.value = "";
                    return;
                }

                var reader = new FileReader();

                reader.onload = function (e) {

                    $("#imgStudentImage")
                        .attr("src", e.target.result)
                        .show();

                    $("#browseImageArea").hide();
                };

                reader.readAsDataURL(file);
            }
        }


        function clearStudentImage() {

            // Clear file input
            $("#fileStudentPhoto").val("");

            // Clear image
            $("#imgStudentImage")
                .attr("src", "")
                .hide();

            // Show browse area
            $("#browseImageArea").show();
        }

        var CourseRow = 0;
        var InstallmentRow = 0;
        var DocumentRow = 0;
        var globalCourseList = [];
        var globalLocationList = [];
        var globalFeesTypeList = [];
        var globalStudentDocumentList = [];
        var isAutoFillingFromEnquiry = false;
        var currentInstallmentMode = "count";

        $(document).ready(function () {
            $("body").attr("sidebar-data-theme", "sidebar-hide");

            // Extract QueryString Params 'id' and 'mode'
            var urlParams = new URLSearchParams(window.location.search);
            var encryptedId = urlParams.get('id') || "";
            var modeParam = urlParams.get('mode') || $("#hfMode").val() || "";
            $("#hfMode").val(modeParam);

            // Safe Select2 Initialization
            if ($.fn.select2) {
                $(".select2").not("#ddlStudentEnquiry, [id^='ddlCourse_']").select2({
                    width: '100%',
                    placeholder: 'Select',
                    allowClear: true
                });
            }

            // Set Current Date Default
            var today = new Date().toISOString().split('T')[0];
            $("#txtAdmissionDate").val(today);

            // Load Dropdowns and Bind Data
            LoadDropdowns(function () {
                LoadEnquiryDropdownOptions();
                if (encryptedId !== "") {
                    LoadAdmissionDataByID(encryptedId);
                } else {
                    AddCourseRow(); // Default row for new admission
                    GenerateInstallmentRows(); // Generate default 3 installment rows
                    AddDocumentRow(); // Default row for student documents
                }
            });
            // ==========================================
            // 1. MISSING FUNCTION: LoadEnquiryDropdownOptions
            // ==========================================
            function LoadEnquiryDropdownOptions() {
                $.ajax({
                    type: "POST",
                    url: "/bctechadmin/GetEnquiryDropdown",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (res) {
                        var options = '<option value="">-- Direct Admission --</option>';
                        var dataList = Array.isArray(res) ? res : (res.Data || []);

                        if (dataList && dataList.length > 0) {
                            $.each(dataList, function (i, item) {
                                var id = item.StudentEnquiryID || item.EncryptedID || item.ID;
                                var name = item.CleanStudentName || item.StudentName || item.StudentFullName || '';
                                var enquiryNo = item.EnquiryNo || '';
                                var mobile = item.StudentMobileNo || '';
                                var source = item.SourceName || '';

                                options += '<option value="' + id + '" ' +
                                    'data-enquiry-no="' + enquiryNo + '" ' +
                                    'data-mobile="' + mobile + '" ' +
                                    'data-source="' + source + '">' +
                                    name +
                                    '</option>';
                            });
                        }

                        $("#ddlStudentEnquiry").html(options);

                        if ($.fn.select2) {
                            $("#ddlStudentEnquiry").select2({
                                width: '100%',
                                placeholder: '-- Direct Admission --',
                                allowClear: true,
                                templateResult: typeof formatEnquiryOption === "function" ? formatEnquiryOption : null,
                                templateSelection: typeof formatEnquirySelection === "function" ? formatEnquirySelection : null
                            });
                        }
                    },
                    error: function () {
                        toastr.error("Failed to load enquiry dropdown options.");
                    }
                });
            }

            // ==========================================
            // 2. Select2 Enquiry Option Formatters
            // ==========================================
            function formatEnquiryOption(item) {
                if (!item.id) return item.text;

                var $elem = $(item.element);
                var enquiryNo = $elem.attr('data-enquiry-no') || $elem.data('enquiry-no') || '';
                var mobile = $elem.attr('data-mobile') || $elem.data('mobile') || '';
                var source = $elem.attr('data-source') || $elem.data('source') || '';

                if (enquiryNo || mobile) {
                    var subText = '';
                    if (enquiryNo) subText += '<span class="text-muted me-2 fs-11"><i class="ri-hashtag text-primary me-1"></i>' + enquiryNo + '</span>';
                    if (mobile) subText += '<span class="text-muted fs-11"><i class="ri-phone-line text-success me-1"></i>' + mobile + '</span>';

                    return $(
                        '<div class="d-flex justify-content-between align-items-center py-1">' +
                        '<div>' +
                        '<div class="fw-semibold text-dark fs-13 mb-0">' + item.text + '</div>' +
                        '<div>' + subText + '</div>' +
                        '</div>' +
                        (source ? '<div><span class="badge bg-light text-secondary border fs-11">' + source + '</span></div>' : '') +
                        '</div>'
                    );
                }

                return $('<div class="py-1 fw-semibold text-dark fs-13">' + item.text + '</div>');
            }

            function formatEnquirySelection(item) {
                if (!item.id) return item.text;
                var enquiryNo = $(item.element).attr('data-enquiry-no') || $(item.element).data('enquiry-no') || '';
                return item.text + (enquiryNo ? ' [' + enquiryNo + ']' : '');
            }
            // Branch Change Handler
            $("#ddlBranch").on("change", function () {
                var branchID = parseInt($(this).val()) || 0;
                var currentStudentID = parseInt($("#hfStudentID").val()) || 0;

                LoadBatchDropdown(branchID);

                if (isAutoFillingFromEnquiry) return;

                if (branchID > 0 && currentStudentID === 0) {
                    $.ajax({
                        type: "POST",
                        url: "/bctechadmin/GetNextEnrollmentNo",
                        data: JSON.stringify({ branchID: branchID }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (res) {
                            if (res && res.IsSuccess && res.EnrollmentNo) {
                                $("#txtEnrollmentNo").val(res.EnrollmentNo);
                            }
                        }
                    });
                } else if (branchID === 0 && currentStudentID === 0) {
                    $("#txtEnrollmentNo").val("");
                }
            });

            // Enquiry Select Handler
            $("#ddlStudentEnquiry").on("change", function () {
                var enquiryID = $(this).val();
                if (enquiryID && enquiryID !== "0" && enquiryID !== "") {
                    LoadDataFromEnquiry(enquiryID);
                } else {
                    ClearEnquiryAutoFillData();
