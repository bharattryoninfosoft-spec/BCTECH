        function courseSelectedID(element) {
            if (!element) return;

            var $select = $(element);
            var courseId = "";

            if (typeof element === "object") {
                courseId = $select.val() || (element.value !== undefined ? element.value : "");
            } else {
                courseId = element;
            }

            var selectId = $select.attr("id") || "";
            var rowNum = selectId.replace("ddlCourse_", "");
            if (!rowNum || isNaN(rowNum)) {
                var $tr = $select.closest("tr");
                var $div = $tr.find("[id^='divMasterCourse_']");
                if ($div.length) {
                    rowNum = $div.attr("id").replace("divMasterCourse_", "");
                }
            }

            if (!rowNum) return;

            var $divMaster = $("#divMasterCourse_" + rowNum);
            var $tblBody = $("#tblMasterCourse_" + rowNum + " tbody");
            var $countBadge = $("#spnSubCourseCount_" + rowNum);
            var $selectAll = $("#chkSelectAllMaster_" + rowNum);

            if (!courseId || courseId === "0" || courseId === "") {
                $divMaster.slideUp(150);
                $tblBody.empty();
                return;
            }

            var studentIdVal = $("#hfStudentID").val() || "";

            $.ajax({
                type: "GET",
                url: "/bctechadmin/GetMasterCourseStudentList",
                data: { CourseID: parseInt(courseId) || 0, StudentID: studentIdVal },
                dataType: "json",
                success: function (res) {
                    var list = (res && res.Data) ? res.Data : [];
                    $tblBody.empty();

                    if (list && list.length > 0) {

                        $divMaster.show();

                        var html = "";
                        var isViewMode = $("#hfMode").val() === "V";
                        var srNo = 1;
                        $.each(list, function (i, item) {
                            var subFee = parseFloat(item.CourseFee) || 0;
                            var chkId = "chkSub_" + rowNum + "_" + item.CourseID;

                            html += "<tr class='table-primary table-selected'>";
                            html += "  <td class='text-center' style='width: 35px;'>";
                            html += parseInt(srNo) + parseInt(i);
                            html += "  </td>";
                            html += "  <td>";
                            html += "    <label class='form-check-label fw-medium mb-0 fs-12'  style='cursor: pointer;'>" + item.CourseTitle + "</label>";
                            html += "  </td>";
                            html += "  <td style='width: 130px;'>";
                            html += "    <label class='form-check-label fw-medium mb-0 fs-12'  style='cursor: pointer;'> <i class='fa fa-inr'></i> " + item.CourseFee + "</label>";
                            html += "  </td>";
                            html += "</tr>";
                        });

                        $tblBody.html(html);
                        if ($countBadge.length) {
                            $countBadge.text(list.length + " Modules");
                        }
                        if ($selectAll.length) {
                            $selectAll.prop("checked", true);
                        }
                        $divMaster.slideDown(200);
                    } else {
                        $divMaster.slideUp(150);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("GetMasterCourseStudentList Error:", error);
                    $divMaster.slideUp(150);
                }
            });
        }

