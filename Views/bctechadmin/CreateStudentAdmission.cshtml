        // Calculate Row Fee Helpers
        function CalculateRowFeeFromPercent(row) {
            var fee = parseFloat(row.find(".fee").val()) || 0;
            var discountPercent = parseFloat(row.find(".discount-percent").val()) || 0;

            if (discountPercent > 100) {
                toastr.error("Discount % cannot exceed 100%.");
                row.find(".discount-percent").val(100);
                discountPercent = 100;
            }

            var discountAmount = (fee * discountPercent) / 100;
            row.find(".discount").val(discountAmount.toFixed(2));

            var finalFee = fee - discountAmount;
            row.find(".finalfee").val((finalFee < 0 ? 0 : finalFee).toFixed(2));
            UpdateInstallmentAmountsFromCourse();
        }

        function CalculateRowFeeFromAmount(row) {
            var fee = parseFloat(row.find(".fee").val()) || 0;
            var discountAmount = parseFloat(row.find(".discount").val()) || 0;

            if (discountAmount > fee) {
                toastr.error("Discount Amount cannot exceed Course Fee.");
                row.find(".discount").val(fee.toFixed(2));
                discountAmount = fee;
            }

            var discountPercent = fee > 0 ? (discountAmount / fee) * 100 : 0;
            row.find(".discount-percent").val(discountPercent > 0 ? discountPercent.toFixed(2) : "");

            var finalFee = fee - discountAmount;
            row.find(".finalfee").val((finalFee < 0 ? 0 : finalFee).toFixed(2));
            UpdateInstallmentAmountsFromCourse();
        }

        function CalculateRowFee(row) {
            if (row.find(".discount-percent").val() !== "") {
                CalculateRowFeeFromPercent(row);
            } else {
                CalculateRowFeeFromAmount(row);
            }
        }

        // Helper: Add Months to Date String (1-Month Gap)
        function addMonthsToDate(dateStr, monthsToAdd) {
            if (!dateStr) {
                var today = new Date();
                dateStr = today.toISOString().split('T')[0];
            }
            var parts = dateStr.split('-');
            if (parts.length < 3) return dateStr;

            var year = parseInt(parts[0]);
            var month = parseInt(parts[1]) - 1;
            var day = parseInt(parts[2]);

            var targetDate = new Date(year, month + monthsToAdd, day);
            var expectedMonth = (month + monthsToAdd) % 12;
            if (expectedMonth < 0) expectedMonth += 12;
            if (targetDate.getMonth() !== expectedMonth) {
                targetDate.setDate(0);
            }

            var yyyy = targetDate.getFullYear();
            var mm = String(targetDate.getMonth() + 1).padStart(2, '0');
            var dd = String(targetDate.getDate()).padStart(2, '0');
            return yyyy + '-' + mm + '-' + dd;
        }

        // Helper: Get Total Course Final Fee
        function GetTotalCourseFinalFee() {
            var total = 0;
            $("#tblCourse > tbody > tr.main-course-row .finalfee").each(function () {
                total += parseFloat($(this).val()) || 0;
            });
            return total;
        }

        // Helper: Get Ordinal Text (1st, 2nd, 3rd, 4th, ..., 24th)
        function getOrdinalText(n) {
            var s = ["th", "st", "nd", "rd"];
            var v = n % 100;
            return n + (s[(v - 20) % 10] || s[v] || s[0]);
        }

        // Generate Installments based on txtAmountOfInstallment or txtNoOfInstallments & 1-Month Gap
        function GenerateInstallmentRows(mode) {
            if (mode) {
                currentInstallmentMode = mode;
            }

            var totalCourseFee = GetTotalCourseFinalFee();
            var baseDate = $("#txtAdmissionDate").val() || new Date().toISOString().split('T')[0];
            var regFee = 200.00;

            // Preserve existing Registration/Admission fee & payment mode if already present in Row 1
            var existingFirstRowText = $("#tblInstallment tbody tr:first .inst-feestype option:selected").text().toLowerCase();
            if (existingFirstRowText.includes("admission") || existingFirstRowText.includes("registration")) {
                var existingFirstAmt = parseFloat($("#tblInstallment tbody tr:first .inst-amount").val());
                if (!isNaN(existingFirstAmt) && existingFirstAmt >= 0) {
                    regFee = existingFirstAmt;
                }
            }
            var existingPayType = $("input[name='rdoAdmissionPaymentType']:checked").val() || "Cash";
            var existingTxnNo = $("#txtAdmissionTransactionNo").val() || "";

            var amounts = [];

            if (currentInstallmentMode === "amount") {
                var targetAmt = parseFloat($("#txtAmountOfInstallment").val()) || 0;
                if (targetAmt > 0 && totalCourseFee > 0) {
                    if (targetAmt >= totalCourseFee) {
                        amounts.push(totalCourseFee);
                    } else {
                        var fullCount = Math.floor(totalCourseFee / targetAmt);
                        var remainder = Math.round((totalCourseFee - (fullCount * targetAmt)) * 100) / 100;
                        for (var i = 0; i < fullCount; i++) {
                            amounts.push(targetAmt);
                        }
                        if (remainder > 0) {
                            amounts.push(remainder);
                        }
                    }
                    $("#txtNoOfInstallments").val(amounts.length);
                } else {
                    var count = parseInt($("#txtNoOfInstallments").val()) || 1;
                    if (count <= 0) count = 1;
                    var baseAmount = Math.floor((totalCourseFee / count) * 100) / 100;
                    var remainder = Math.round((totalCourseFee - (baseAmount * count)) * 100) / 100;
                    for (var i = 0; i < count; i++) {
                        amounts.push(baseAmount + (i === 0 ? remainder : 0));
                    }
                }
            } else {
                var count = parseInt($("#txtNoOfInstallments").val()) || 1;
                if (count <= 0) count = 1;
                var baseAmount = Math.floor((totalCourseFee / count) * 100) / 100;
                var remainder = Math.round((totalCourseFee - (baseAmount * count)) * 100) / 100;
                for (var i = 0; i < count; i++) {
                    amounts.push(baseAmount + (i === 0 ? remainder : 0));
                }
                if (document.activeElement && document.activeElement.id !== "txtAmountOfInstallment") {
                    if (totalCourseFee > 0 && count > 0) {
                        var avgAmt = totalCourseFee / count;
                        $("#txtAmountOfInstallment").val(avgAmt.toFixed(2));
                    }
                }
            }

            $("#tblInstallment tbody").empty();
            InstallmentRow = 0;

            // Row 1: Admission Fees
            AddInstallmentRow({
                DueDate: baseDate,
                FeesTitle: "Admission Fees",
                Amount: regFee,
                PaymentType: existingPayType,
                TransactionNo: existingTxnNo
            });

            var firstInstDate = addMonthsToDate(baseDate, 1);

            for (var j = 0; j < amounts.length; j++) {
                var dueDate = addMonthsToDate(firstInstDate, j);
                var amt = amounts[j];
                var title = getOrdinalText(j + 1) + " Installment";

                AddInstallmentRow({
                    DueDate: dueDate,
                    FeesTitle: title,
                    Amount: amt
                });
            }

            UpdateTotalInstallmentAmountLabel();
        }

        // Update Installment Amounts when Course Fees / Discounts change
        function UpdateInstallmentAmountsFromCourse() {
            var rowCount = $("#tblInstallment tbody tr").length;
            var totalFee = GetTotalCourseFinalFee();

            $("#lblTotalFinalFee").text(totalFee.toFixed(2));

            if (totalFee <= 0) {
                UpdateTotalInstallmentAmountLabel();
                return;
            }

            var instAmountEntered = parseFloat($("#txtAmountOfInstallment").val()) || 0;

            if (currentInstallmentMode === "amount" && instAmountEntered > 0) {
                GenerateInstallmentRows("amount");
                return;
            }

            if (rowCount <= 0) {
                $("#lblTotalInstallmentAmount").text("0.00");
                return;
            }

            var $rows = $("#tblInstallment tbody tr");
            var hasAdmissionFeeRow = false;
            var firstRowSelectText = $("#tblInstallment tbody tr:first .inst-feestype option:selected").text().toLowerCase();
            if (firstRowSelectText.includes("admission") || firstRowSelectText.includes("registration") || rowCount > 1) {
                hasAdmissionFeeRow = true;
            }

            if (hasAdmissionFeeRow && rowCount > 1) {
                var firstRowAmt = parseFloat($("#tblInstallment tbody tr:first .inst-amount").val());
                if (isNaN(firstRowAmt) || firstRowAmt === 0) {
                    $("#tblInstallment tbody tr:first .inst-amount").val("200.00");
                }

                var courseRows = $rows.slice(1);
                var courseCount = courseRows.length;
                if (courseCount <= 0) courseCount = 1;

                var baseAmount = Math.floor((totalFee / courseCount) * 100) / 100;
                var remainder = Math.round((totalFee - (baseAmount * courseCount)) * 100) / 100;

                courseRows.each(function (index) {
                    var amt = baseAmount + (index === 0 ? remainder : 0);
                    $(this).find(".inst-amount").val((amt < 0 ? 0 : amt).toFixed(2));
                });
                if (document.activeElement && document.activeElement.id !== "txtAmountOfInstallment") {
                    if (totalFee > 0 && courseCount > 0) {
                        $("#txtAmountOfInstallment").val((totalFee / courseCount).toFixed(2));
                    }
                }
                UpdateTotalInstallmentAmountLabel();
                return;
            }

            var baseAmount = Math.floor((totalFee / rowCount) * 100) / 100;
            var remainder = Math.round((totalFee - (baseAmount * rowCount)) * 100) / 100;

            $("#tblInstallment tbody tr").each(function (index) {
                var amt = baseAmount + (index === 0 ? remainder : 0);
                $(this).find(".inst-amount").val((amt < 0 ? 0 : amt).toFixed(2));
            });

            if (document.activeElement && document.activeElement.id !== "txtAmountOfInstallment") {
                if (totalFee > 0 && rowCount > 0) {
                    $("#txtAmountOfInstallment").val((totalFee / rowCount).toFixed(2));
                }
            }

            UpdateTotalInstallmentAmountLabel();
        }

        function UpdateTotalInstallmentAmountLabel() {
            var totalInst = 0;
            $("#tblInstallment tbody .inst-amount").each(function () {
                totalInst += parseFloat($(this).val()) || 0;
            });
            $("#lblTotalInstallmentAmount").text(totalInst.toFixed(2));

            var totalCourse = GetTotalCourseFinalFee();
            var firstRowSelectText = $("#tblInstallment tbody tr:first .inst-feestype option:selected").text().toLowerCase();
            var expectedTotal = totalCourse;
            if (firstRowSelectText.includes("admission") || firstRowSelectText.includes("registration")) {
                var firstAmt = parseFloat($("#tblInstallment tbody tr:first .inst-amount").val()) || 200;
                expectedTotal = totalCourse + firstAmt;
            }
            if (Math.abs(totalInst - expectedTotal) > 0.01) {
                $("#lblTotalInstallmentAmount").removeClass("text-success").addClass("text-danger");
            } else {
                $("#lblTotalInstallmentAmount").removeClass("text-danger").addClass("text-success");
            }
        }

        // Update Due Dates when Admission Date changes
        function UpdateInstallmentDueDates() {
            var baseDate = $("#txtAdmissionDate").val() || new Date().toISOString().split('T')[0];
            var firstInstDate = addMonthsToDate(baseDate, 1);
            $("#tblInstallment tbody tr").each(function (index) {
                if (index === 0) {
                    $(this).find(".inst-duedate").val(baseDate);
                } else {
                    var newDate = addMonthsToDate(firstInstDate, index - 1);
                    $(this).find(".inst-duedate").val(newDate);
                }
            });
        }

