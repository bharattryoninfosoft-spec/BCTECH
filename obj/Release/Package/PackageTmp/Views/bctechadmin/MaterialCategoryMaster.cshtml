
@{
    ViewBag.Title = "MaterialCategoryMaster";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}



<div class="card bg-white rounded-10 border border-white mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-20">
        <form class="table-src-form position-relative m-0">
            <input type="text"
                   id="txtSearch"
                   class="form-control w-350"
                   placeholder="Search Material Category...">
            <div class="src-btn position-absolute top-50 start-0 translate-middle-y bg-transparent p-0 border-0">
                <span class="material-symbols-outlined">search</span>
            </div>
        </form>
        <a href="javascript:void(0);" class="text-primary fs-16 text-decoration-none"
           onclick="OpenMaterialCategoryModal()">
            + Add Material Category
        </a>
    </div>
    <div class="default-table-area mx-minus-1 table-contact-list">
        <div class="table-responsive">
            <table class="table-common" id="tblMaterialCategory">
                <thead>
                    <tr>
                        <th>SR</th>
                        <th>Category Code</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="d-flex justify-content-center justify-content-sm-between align-items-center text-center flex-wrap gap-2 showing-wrap pt-15 p-20">
            <span class="fs-15" id="lblShowing"></span>

            <nav class="custom-pagination" aria-label="Page navigation example">
                <ul class="pagination mb-0 justify-content-center" id="pagination">
                </ul>
            </nav>
        </div>
    </div>
</div>
<div class="modal fade" id="MaterialCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Material Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="hfMaterialCategoryID" value="0" />

                <div class="row">

                    <!-- Category Code -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Category Code <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               id="txtCategoryCode"
                               class="form-control"
                               maxlength="50"
                               placeholder="Enter Category Code">
                    </div>

                    <!-- Category Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Category Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               id="txtCategoryName"
                               class="form-control"
                               maxlength="200"
                               placeholder="Enter Category Name">
                    </div>

                    <!-- Description -->
                    <div class="col-md-12 mb-3">
                        <label class="form-label">
                            Description
                        </label>
                        <textarea id="txtDescription"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Enter Description"></textarea>
                    </div>

                    <!-- Active -->
                    <div class="col-md-12">
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chkIsActive"
                                   checked>

                            <label class="form-check-label" for="chkIsActive">
                                Active
                            </label>
                        </div>
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button type="button"  id="btnSaveMaterialCategory"  class="btn btn-primary text-white"  onclick="SaveMaterialCategory()"> Save </button>

            </div>

        </div>
    </div>
</div>
@section Scripts{
    <script>
        var pageNumber = 1;
        $(document).ready(function () {
            GetMaterialCategoryList();
            $("#txtSearch").keyup(function () {
                pageNumber = 1;
                GetMaterialCategoryList();
            });
        });
        function GetMaterialCategoryList() {
            $.ajax({
                type: "POST",
                url: "/bctechadmin/GetMaterialCategoryList",
                data: {
                    Search: $.trim($("#txtSearch").val()),
                    PageNumber: pageNumber
                },
                success: function (response) {

                    var html = "";

                    if (response.Data && response.Data.length > 0) {

                        $.each(response.Data, function (index, item) {

                            html += "<tr>";

                            var srNo = ((pageNumber - 1) * 10) + index + 1;
                            html += "<td>" + srNo + "</td>";
                            html += "<td>" + item.CategoryCode + "</td>";
                            html += "<td>" + item.CategoryName + "</td>";
                            html += "<td>" + item.Description + "</td>";

                            if (item.IsActive) {
                                html += "<td><span class='badge bg-success'>Active</span></td>";
                            }
                            else {
                                html += "<td><span class='badge bg-danger'>Inactive</span></td>";
                            }

                            html += "<td class='text-center'>";

                            html += "<a href='javascript:void(0)' onclick='ViewMaterialCategory(" + item.MaterialCategoryID + ")' class='text-info me-2'>";
                            html += "<i class='ri-eye-line fs-18'></i>";
                            html += "</a>";

                            html += "<a href='javascript:void(0)' onclick='EditMaterialCategory(" + item.MaterialCategoryID + ")' class='text-primary me-2'>";
                            html += "<i class='ri-edit-line fs-18'></i>";
                            html += "</a>";

                            html += "<a href='javascript:void(0)' onclick='DeleteMaterialCategory(" + item.MaterialCategoryID + ")' class='text-danger'>";
                            html += "<i class='ri-delete-bin-line fs-18'></i>";
                            html += "</a>";

                            html += "</td>";

                            html += "</tr>";

                        });

                    }
                    else {

                        html += "<tr>";
                        html += "<td colspan='6' class='text-center'>No Record Found</td>";
                        html += "</tr>";

                    }

                    $("#tblMaterialCategory tbody").html(html);

                    // Pagination
                    $("#lblShowing").html(response.ShowingText);
                    $("#pagination").html(response.Pagination);

                },
                error: function () {

                    toastr.error("Unable to load data.");

                }

            });

        }
        function OpenMaterialCategoryModal() {

            $("#hfMaterialCategoryID").val(0);
            $("#txtCategoryCode").val("").prop("readonly", false);
            $("#txtCategoryName").val("").prop("readonly", false);
            $("#txtDescription").val("").prop("readonly", false);
            $("#chkIsActive").prop("checked", true);
            $("#chkIsActive").prop("disabled", false);
            $("#btnSaveMaterialCategory").prop("disabled", false);
            ShowMaterialCategoryModal();
        }
        function EditMaterialCategory(id) {

            $.ajax({
                type: "POST",
                url: "/bctechadmin/GetMaterialCategoryByID",
                data: { MaterialCategoryID: id },
                success: function (response) {

                    if (response.Status == 1) {

                        $("#hfMaterialCategoryID").val(response.Data.MaterialCategoryID);
                        $("#txtCategoryCode").val(response.Data.CategoryCode);
                        $("#txtCategoryName").val(response.Data.CategoryName);
                        $("#txtDescription").val(response.Data.Description);
                        $("#chkIsActive").prop("checked", response.Data.IsActive);
                        $("#btnSaveMaterialCategory").prop("disabled", false);
                        ShowMaterialCategoryModal();
                    }
                    else {
                        toastr.error(response.Message);
                    }
                }
            });
        }
        function ViewMaterialCategory(MaterialCategoryID) {

            $.ajax({
                type: "POST",
                url: "/bctechadmin/GetMaterialCategoryByID",
                data: {
                    MaterialCategoryID: MaterialCategoryID
                },
                success: function (response) {

                    if (response.Status == 1) {

                        var item = response.Data;

                        $("#hfMaterialCategoryID").val(item.MaterialCategoryID);
                        $("#txtCategoryCode").val(item.CategoryCode);
                        $("#txtCategoryName").val(item.CategoryName);
                        $("#txtDescription").val(item.Description);
                        $("#chkIsActive").prop("checked", item.IsActive);

                        // Readonly Mode
                        $("#txtCategoryCode").prop("readonly", true);
                        $("#txtCategoryName").prop("readonly", true);
                        $("#txtDescription").prop("readonly", true);
                        $("#chkIsActive").prop("disabled", true);

                        // Hide Save Button
                        $("#btnSaveMaterialCategory").prop("disabled", true);
                        ShowMaterialCategoryModal();
                        // Bootstrap 5 Alternative
                        // var modal = new bootstrap.Modal(document.getElementById("MaterialCategoryModal"));
                        // modal.show();

                    }
                    else {

                        toastr.error(response.Message);

                    }

                },
                error: function () {

                    toastr.error("Something went wrong.");

                }

            });

        }
        function DeleteMaterialCategory(id) {

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to recover this record!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Delete it!"
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        type: "POST",
                        url: "/bctechadmin/DeleteMaterialCategory",
                        data: { MaterialCategoryID: id },
                        success: function (response) {

                            if (response.Status == 1) {
                                toastr.success(response.Message);
                                GetMaterialCategoryList();
                            }
                            else {
                                toastr.error(response.Message);
                            }
                        }
                    });

                }

            });

        }
        function SaveMaterialCategory() {
            debugger;
            var MaterialCategoryID = $("#hfMaterialCategoryID").val();
            var CategoryCode = $("#txtCategoryCode").val().trim();
            var CategoryName = $("#txtCategoryName").val().trim();
            var Description = $("#txtDescription").val().trim();
            var IsActive = $("#chkIsActive").is(":checked");

            // Validation
            if ($.trim(CategoryCode) == "") {
                toastr.warning("Please Enter Category Code.");
                $("#txtCategoryCode").focus();
                return;
            }

            if ($.trim(CategoryName) == "") {
                toastr.warning("Please Enter Category Name.");
                $("#txtCategoryName").focus();
                return;
            }

            var formData = new FormData();

            formData.append("MaterialCategoryID", MaterialCategoryID);
            formData.append("CategoryCode", CategoryCode);
            formData.append("CategoryName", CategoryName);
            formData.append("Description", Description);
            formData.append("IsActive", IsActive);

            $.ajax({
                type: "POST",
                url: "/bctechadmin/SaveMaterialCategory",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {

                    if (response.Status == 1) {

                        toastr.success(response.Message);

                        HideMaterialCategoryModal();

                        GetMaterialCategoryList();
                    }
                    else {

                        toastr.error(response.Message);
                    }
                },
                error: function () {

                    toastr.error("Something went wrong.");
                }
            });
        }
        function ShowMaterialCategoryModal() {

            var modalElement = document.getElementById("MaterialCategoryModal");

            var modal = bootstrap.Modal.getOrCreateInstance(modalElement);

            modal.show();
        }
        function HideMaterialCategoryModal() {

            bootstrap.Modal.getInstance(
                document.getElementById("MaterialCategoryModal")
            ).hide();
        }
    </script>
    }