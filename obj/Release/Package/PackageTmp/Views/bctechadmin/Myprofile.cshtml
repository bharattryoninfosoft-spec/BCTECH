@model BCTECHERP.Models.UserMasterModel

@{
    ViewBag.Title = "My Profile";
    ViewData["PageTitle"] = "My Profile";
    ViewData["ParentMenu"] = "Account";
    Layout = "~/Views/bctechadmin/LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="row">

            <!-- Left Profile -->
            <div class="col-lg-4">

                <div class="card border-0 shadow rounded-3 bg-white">

                    <div class="card-body text-center">

                        <img id="imgProfile"
                             src="@(string.IsNullOrEmpty(Model.ProfilePhoto)
            ? Url.Content("~/Content/Admin/assets/images/admin.png")
            : Url.Content("~/Content/Upload/UserProfilePhoto/" + Model.ProfilePhoto))"
                             class="rounded-circle border"
                             style="width:150px;height:150px;object-fit:cover;" />

                        <h3 class="mt-3 mb-1">
                            @Model.FirstName @Model.MiddleName @Model.LastName
                        </h3>

                        <span class="badge bg-primary fs-6">
                            @Model.UserCategory
                        </span>

                        <hr />

                        <div class="mb-3">

                            <label class="btn btn-outline-primary w-100">

                                <i class="ri-camera-line"></i>

                                Change Profile Picture

                                <input type="file"
                                       id="ProfilePhoto"
                                       hidden />

                            </label>

                        </div>

                    </div>

                </div>

            </div>



            <!-- Right Profile -->

            <div class="col-lg-8 ">

                <div class="card border-0 shadow rounded-3 bg-white">

                    <div class="card-header">

                        <h5 class="mb-0">
                            Personal Information
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="row">
                            <input type="hidden" id="hfUserID" value="@Model.UserID" />
                            <div class="col-md-4 mb-3">

                                <label>First Name</label>

                                <input id="txtFirstName" class="form-control" value="@Model.FirstName" />

                            </div>

                            <div class="col-md-4 mb-3">

                                <label>Middle Name</label>
                                <input id="txtMiddleName" class="form-control" value="@Model.MiddleName" />

                            </div>

                            <div class="col-md-4 mb-3">

                                <label>Last Name</label>
                                <input id="txtLastName" class="form-control" value="@Model.LastName" />

                            </div>

                            <div class="col-md-6 mb-3" >
                                <label>Username</label>
                                <input type="text"
                                       id="txtUsername"
                                       class="form-control"
                                       value="@Model.Username"
                                       readonly />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label>User Category</label>
                                <input type="text"
                                       id="txtUserCategory"
                                       class="form-control"
                                       value="@Model.UserCategory"
                                       readonly />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label>Mobile No</label>

                                <input type="text"
                                       id="txtMobileNo"
                                       class="form-control"
                                       value="@Model.MobileNo" />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label>Alternate Mobile No</label>

                                <input type="text"
                                       id="txtAlternateMobileNo"
                                       class="form-control"
                                       value="@Model.AlternateMobileNo" />


                            </div>

                            <div class="col-md-6 mb-3">

                                <label>Email Address</label>

                                <input type="email"
                                       id="txtEmailAddress"
                                       class="form-control"
                                       value="@Model.EmailAddress" readonly/>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label>Gender</label>

                                <select id="ddlGender"  class="form-select">

                                    <option value="Male" @(Model.Gender == "Male" ? "selected" : "")>
                                        Male
                                    </option>

                                    <option value="Female" @(Model.Gender == "Female" ? "selected" : "")>
                                        Female
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-4 mb-3">

                                <label>Date Of Birth</label>

                                <input type="date"
                                       id="txtDOB"
                                       class="form-control"
                                       value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" />

                            </div>

                            <div class="col-md-4 mb-3">

                                <label>City</label>

                                <input id="txtCity" class="form-control" value="@Model.City" />

                            </div>

                            <div class="col-md-4 mb-3">

                                <label>State</label>

                                <input id="txtState" class="form-control" value="@Model.State" />

                            </div>

                            <div class="col-md-4 mb-3">

                                <label>Pincode</label>

                                <input id="txtPincode" class="form-control" value="@Model.Pincode" />

                            </div>

                            <div class="col-md-8 mb-3">

                                <label>Address</label>

                                <textarea id="txtAddress" class="form-control">@Model.Address</textarea>

                            </div>

                        </div>

                        <hr />

                        <button type="button"
                                class="btn btn-primary"
                                onclick="UpdateProfile();">
                            <i class="ri-save-line me-1"></i>
                            Update Profile
                        </button>

                    </div>

                </div>

            </div>

        </div>
</div>
    </div>
<br/>
        @section Scripts{
            <script>
                function UpdateProfile() {

                    var formData = new FormData();

                    formData.append("UserID", $("#hfUserID").val());
                    formData.append("FirstName", $("#txtFirstName").val());
                    formData.append("MiddleName", $("#txtMiddleName").val());
                    formData.append("LastName", $("#txtLastName").val());
                    formData.append("Gender", $("#ddlGender").val());
                    formData.append("DateOfBirth", $("#txtDOB").val());
                    formData.append("MobileNo", $("#txtMobileNo").val());
                    formData.append("AlternateMobileNo", $("#txtAlternateMobileNo").val());
                    formData.append("EmailAddress", $("#txtEmailAddress").val());
                    formData.append("Address", $("#txtAddress").val());
                    formData.append("City", $("#txtCity").val());
                    formData.append("State", $("#txtState").val());
                    formData.append("Pincode", $("#txtPincode").val());

                    var file = $("#ProfilePhoto")[0].files[0];

                    if (file != null)
                        formData.append("ProfilePhoto", file);

                    $.ajax({

                        url: "/bctechadmin/UpdateMyProfile",

                        type: "POST",

                        data: formData,

                        contentType: false,

                        processData: false,

                        beforeSend: function () {

                            $(".btn-primary").prop("disabled", true);

                        },

                        success: function (res) {

                            if (res == "done") {

                                toastr.success("Profile Updated Successfully");

                                setTimeout(function () {

                                    location.reload();

                                }, 1000);

                            }
                            else {

                                toastr.error(res);

                            }

                        },

                        complete: function () {

                            $(".btn-primary").prop("disabled", false);

                        }

                    });

                }
                $("#ProfilePhoto").change(function () {

                    var reader = new FileReader();

                    reader.onload = function (e) {

                        $("#imgProfile").attr("src", e.target.result);

                    }

                    reader.readAsDataURL(this.files[0]);

                });
            </script>
        }
